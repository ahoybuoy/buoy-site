---
// A ruled, ring-edged item: title, description, optional example chips, optional link.
// `icon` is still accepted for old callers but no longer drawn (no icon tiles).
interface Props {
  title: string
  description: string
  icon?: string
  href?: string
  examples?: string[]
}

const { title, description, href, examples } = Astro.props
---

<article class="ui-card feature-card">
  <h3 class="feature-title">
    {href ? <a href={href} class="ui-rowlink">{title}</a> : title}
  </h3>
  <p class="feature-desc">{description}</p>

  {examples && examples.length > 0 && (
    <ul class="feature-examples">
      {examples.map((ex) => <li><code class="ui-code">{ex}</code></li>)}
    </ul>
  )}

  {href && (
    <p class="feature-more"><a href={href} class="ui-link">Learn more</a></p>
  )}
</article>

<style>
  .feature-card { display: flex; flex-direction: column; height: 100%; padding: 24px; }
  .feature-title { margin: 0; font-size: 1.125rem; line-height: 1.3; letter-spacing: -0.01em; color: var(--color-ink); }
  .feature-desc { margin: 8px 0 0; font-size: 15px; line-height: 1.55; color: var(--color-body); }
  .feature-examples { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .feature-examples .ui-code { font-size: 12px; }
  .feature-more { margin: auto 0 0; padding-top: 18px; font-size: 14px; }
</style>
