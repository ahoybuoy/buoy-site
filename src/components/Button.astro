---
// Thin wrapper over the ui-btn classes in src/styles/site.css.
// primary = orange, secondary = ring-edged surface, ghost = plain. sm 40px, md 44px, lg 48px.
interface Props {
  href?: string
  variant?: 'primary' | 'secondary' | 'ghost'
  size?: 'sm' | 'md' | 'lg'
  external?: boolean
  class?: string
  type?: 'button' | 'submit' | 'reset'
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
  type = 'button',
} = Astro.props

const sizes = { sm: 'ui-btn--sm', md: '', lg: 'ui-btn--lg' }
const classes = ['ui-btn', `ui-btn--${variant}`, sizes[size], className].filter(Boolean).join(' ')
---

{href ? (
  <a
    href={href}
    class={classes}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
