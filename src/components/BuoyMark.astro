---
// The Buoy logomark: a squircle life ring in four pieces (outer radius 12, hole
// radius 6, gaps 5.6, piece ends rounded 1.2 on a 40 unit grid). Orange by default.
// Size is the visible mark height in px; the svg box is 40/36 larger so the
// shape lines up with surrounding text.
const { size = 24, color = '#FF4F00', class: className = '', style = '' } = Astro.props
const box = (size * 40) / 36
---
<svg
  viewBox="0 0 40 40"
  width={box}
  height={box}
  aria-hidden="true"
  class={className}
  style={`flex-shrink:0;${style}`}
>
  <path fill={color} d="M16 2H14A12 12 0 0 0 2 14V16A1.2 1.2 0 0 0 3.2 17.2H9.87A1.2 1.2 0 0 0 11.058 16.167A6 6 0 0 1 16.167 11.058A1.2 1.2 0 0 0 17.2 9.87V3.2A1.2 1.2 0 0 0 16 2ZM24 2H26A12 12 0 0 1 38 14V16A1.2 1.2 0 0 1 36.8 17.2H30.13A1.2 1.2 0 0 1 28.942 16.167A6 6 0 0 0 23.833 11.058A1.2 1.2 0 0 1 22.8 9.87V3.2A1.2 1.2 0 0 1 24 2ZM24 38H26A12 12 0 0 0 38 26V24A1.2 1.2 0 0 0 36.8 22.8H30.13A1.2 1.2 0 0 0 28.942 23.833A6 6 0 0 1 23.833 28.942A1.2 1.2 0 0 0 22.8 30.13V36.8A1.2 1.2 0 0 0 24 38ZM16 38H14A12 12 0 0 1 2 26V24A1.2 1.2 0 0 1 3.2 22.8H9.87A1.2 1.2 0 0 1 11.058 23.833A6 6 0 0 0 16.167 28.942A1.2 1.2 0 0 1 17.2 30.13V36.8A1.2 1.2 0 0 1 16 38Z"/>
</svg>
