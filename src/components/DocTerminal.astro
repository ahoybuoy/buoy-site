---
interface Props {
  command: string
  lines?: Array<{
    text: string
    type?: 'output' | 'success' | 'warning' | 'info' | 'muted'
  }>
  class?: string
}

const { command, lines = [], class: className = '' } = Astro.props

const copyText = command
---

<div class={`doc-terminal ui-term ${className}`}>
  <div class="ui-term-bar">
    <span>Terminal</span>
    <button type="button" class="doc-terminal-copy ui-icon-btn" data-copy={copyText} aria-label="Copy command">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
      </svg>
    </button>
  </div>

  <div class="ui-term-body">
    <div class="doc-terminal-cmd">
      <span class="ui-t-prompt shrink-0">$</span>
      <span class="ui-t-hi">{command}</span>
    </div>

    {lines.length > 0 && (
      <div class="doc-terminal-out">
        {lines.map((line) => {
          const colorClass = {
            output: '',
            success: 'ui-t-ok',
            warning: 'ui-t-warn',
            info: 'ui-t-info',
            muted: 'ui-t-dim',
          }[line.type || 'output']

          return (
            <div class={colorClass} set:html={line.text} />
          )
        })}
      </div>
    )}
  </div>
</div>

<style>
  .doc-terminal-cmd { display: flex; align-items: flex-start; gap: 8px; }
  .doc-terminal-out { margin-top: 8px; white-space: pre-wrap; }
</style>

<script>
  document.querySelectorAll('.doc-terminal-copy').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy')
      if (text) {
        await navigator.clipboard.writeText(text)
        const svg = btn.querySelector('svg')
        if (svg) {
          const original = svg.outerHTML
          svg.outerHTML = `<svg class="w-3.5 h-3.5 ui-t-ok" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`
          setTimeout(() => {
            btn.querySelector('svg')!.outerHTML = original
          }, 2000)
        }
      }
    })
  })
</script>
