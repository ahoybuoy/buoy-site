---
// Realistic: Moonlit sea (contract: ./WAVES.md).
// WebGL. A night sea in perspective from a faint horizon down to the viewer; a moon's
// glitter path of thousands of tiny glints that twinkle and travel toward the viewer.
// The boat rides the near swell, whose moonlit rim is the drawn water line.
---

<div class="wave-background moonlit-sea" data-moonlit-sea>
  <canvas class="moonlit-sea__canvas"></canvas>
  <div class="wave-container-1 moonlit-sea__surface"></div>
</div>

<style>
  .moonlit-sea {
    --moon-deep: color-mix(in oklab, var(--color-bg) 75%, oklch(0.05 0.02 255));
    --moon-haze: color-mix(in oklab, var(--color-bg) 55%, oklch(0.42 0.05 245));
    --moon-glint: oklch(0.97 0.015 235);
    --boat-hero-sink: 0px;
    --boat-hero-draft: 3;
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .moonlit-sea__canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .moonlit-sea__surface { position: absolute; left: 0; right: 0; top: 60%; height: 0; pointer-events: none; }
</style>

<script>
  import { mountSea, glQuad, colorReader, glSea, GLSL_HEIGHT, GLSL_COMMON, type Wave } from './realistic/kit'

  const FRAG = GLSL_COMMON + GLSL_HEIGHT + /* glsl */ `
uniform float u_hz, u_moonX;
uniform vec3 c_deep, c_haze, c_glint, c_bg;

void main() {
  vec2 p = cssPx();
  float x = p.x, y = p.y;
  float sy = u_water + seaH(x);
  float mx = x - u_moonX;

  // Sky: the moon's glow low over the horizon, fading into the page ground
  if (y < u_hz) {
    float d = length(vec2(mx / u_res.x * 1.4, (u_hz - y) / max(u_hz, 1.0) * 1.2));
    float g = 0.22 * exp(-d * 3.5);
    float line = exp(-(u_hz - y) / 1.2) * 0.35;
    vec3 col = c_haze * (g + line * 0.8);
    float a = clamp(g + line, 0.0, 1.0);
    gl_FragColor = vec4(col + c_glint * line * 0.15, a);
    return;
  }

  // Perspective: z = 1 on the water line, larger toward the horizon
  float dd = max(y - u_hz, 0.6);
  float span = max(u_water - u_hz, 10.0);
  float z = span / dd;
  float wx = mx * z / 400.0;
  float pathW = 0.22 + 0.05 * sin(u_t * 0.3);
  float mask = exp(-wx * wx / (pathW * pathW));
  float wide = exp(-wx * wx / (pathW * pathW * 6.0));

  // Water body: dark, a touch of haze at the horizon, deeper toward the viewer
  float fog = clamp(z / 8.0, 0.0, 1.0);
  vec3 col = mix(c_deep, c_haze * 0.75, fog * 0.7);
  // Rolling swells as soft bands of sheen in the path
  float band = 0.5 + 0.5 * sin(z * 9.0 + u_t * 1.4 + sin(wx * 3.0 + u_t * 0.5));
  col += c_haze * (0.10 * wide + 0.12 * mask * band) * (0.5 + 0.5 * fog);

  // Glints: one candidate per cell of the sea plane, cells drifting toward the viewer
  float lit = 0.0;
  for (int layer = 0; layer < 3; layer++) {
    float fl = float(layer);
    vec2 cs = vec2(80.0 + fl * 37.0, 30.0 + fl * 13.0);
    vec2 g = vec2(wx * cs.x, z * cs.y + u_t * (1.6 + fl * 0.5) * cs.y / 30.0 + fl * 0.37);
    vec2 id = floor(g), f = fract(g);
    float r = hash21(id + fl * 17.0);
    vec2 c = vec2(0.25 + 0.5 * hash21(id + 3.1), 0.25 + 0.5 * hash21(id + 7.7));
    // cell size in screen px (horizontal, vertical)
    vec2 cpx = vec2(400.0 / (cs.x * z), span / (cs.y * z * z));
    vec2 dpx = (f - c) * cpx;
    float rad = 0.55 + 0.6 * mask;
    float spot = exp(-dot(dpx, dpx) / (rad * rad));
    float tw = pow(0.5 + 0.5 * sin(u_t * (2.5 + r * 6.0) + r * 40.0), 6.0);
    float keep = step(1.0 - (0.08 + 0.9 * mask), r);
    lit += spot * tw * keep * (0.3 + 0.9 * mask) * (0.35 + 0.65 * band);
  }
  // Fade the glitter into the haze near the horizon (sub-pixel there)
  lit *= smoothstep(18.0, 3.0, z);

  // The near swell: deeper water below its moonlit rim
  float below = smoothstep(sy - 0.7, sy + 0.7, y);
  // the near swell reads by tone: the water beyond it carries a little more sky
  col = mix(col + c_haze * 0.07, col * 0.5 + c_deep * 0.25, below);
  float edge = smoothstep(0.0, 0.25, x / u_res.x) * smoothstep(1.0, 0.75, x / u_res.x);
  float rim = exp(-pow((y - sy) / 0.9, 2.0)) * 0.35 * mask;
  // Light gathers under the rim a few px down
  float under = below * exp(-(y - sy) / 14.0) * 0.12 * wide;

  col += c_glint * (lit + rim) + c_haze * under;
  // Horizon line
  col += c_glint * exp(-(y - u_hz) / 1.0) * 0.18;
  gl_FragColor = vec4(col, 1.0);
}
`

  function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!
    const q = glQuad(canvas, FRAG)
    if (!q) return
    const waves: Wave[] = [
      { len: 760, amp: 7, speed: 34, phase: 0.6 },
      { len: 330, amp: 3.5, speed: 46, phase: 2.1 },
      { len: 170, amp: 1.5, speed: 58, phase: 4.0 },
      { len: 95, amp: 0.4, speed: 70, phase: 1.3 },
    ]
    let C: Record<string, number[]> = {}
    mountSea(root, canvas, {
      waves,
      readColors: () => {
        const r = colorReader(root)
        C = {
          c_deep: r.read('--moon-deep', '#03070e').rgb,
          c_haze: r.read('--moon-haze', '#26384f').rgb,
          c_glint: r.read('--moon-glint', '#f2f7ff').rgb,
          c_bg: r.read('--color-bg', '#05080f').rgb,
        }
        r.done()
      },
      renderScale: 0.8,
      setup: () => {},
      draw: (t, s) => {
        q.f1('u_t', t)
        q.f2('u_res', s.w, s.h)
        q.f1('u_dpr', s.dpr)
        q.f1('u_water', s.waterY)
        q.f1('u_hz', s.waterY - Math.min(140, (s.h - s.waterY) * 0.42))
        q.f1('u_moonX', s.w * (s.w < 600 ? 0.6 : 0.66))
        glSea(q, waves, s)
        for (const k in C) q.f3(k, C[k])
        q.draw()
      },
    })
  }

  document.querySelectorAll<HTMLElement>('[data-moonlit-sea]').forEach((root) => {
    if (root.dataset.init) return
    root.dataset.init = '1'
    init(root)
  })
</script>
