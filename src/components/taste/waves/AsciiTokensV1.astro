---
// Digital: ASCII tokens v1 (original), frozen reconstruction. The ASCII ocean grid, but every
// row spells real design-system tokens and values in sequence, drifting along the row. The
// swell lives in per-character brightness: from a distance it reads as sea, up close as
// tokens. The surface is where the bright text body begins (clipped to the exact sampled line).
---

<div class="wave-background ascii-tokens-v1" data-ascii-tokens-v1>
  <canvas class="dg-canvas"></canvas>
  <div class="wave-container-1 dg-surface"></div>
</div>

<style>
  .ascii-tokens-v1 {
    --tok-ink: color-mix(in oklab, var(--color-bg) 20%, oklch(0.85 0.06 228));
    --tok-font: var(--font-mono, 'JetBrains Mono', ui-monospace, monospace);
    --boat-hero-sink: 0px;
    --boat-hero-draft: 3px;
    position: absolute; inset: 0; overflow: hidden; z-index: 0;
  }
  .dg-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dg-surface { position: absolute; left: 0; right: 0; top: 60%; height: 0; pointer-events: none; }
</style>

<script>
  import { mount, field, smooth, type Frame } from './digital/sea'

  const TOKENS = [
    'var(--color-primary)', '--spacing-4', '#3b82f6', '16px', '--radius-md', 'var(--bg-surface)', '1.5rem',
    '--font-size-sm', '0.875rem', 'var(--space-2)', '#0f172a', '--shadow-lg', '24px', 'rgba(0,0,0,.12)',
    '--color-border', 'var(--text-muted)', '--line-height-tight', '1.25', '#e2e8f0', '--z-modal', '1000',
    'var(--radius-full)', '9999px', '--duration-fast', '150ms', '--ease-out', 'cubic-bezier(.16,1,.3,1)',
    '--color-danger-500', '#ef4444', 'var(--spacing-8)', '2rem', '--font-weight-semibold', '600',
    '--breakpoint-md', '768px', 'var(--color-accent)', 'oklch(0.62 0.19 255)', '--gap-3', '12px',
    '--opacity-disabled', '0.4', 'var(--focus-ring)', '--border-width', '1px', '--size-icon', '20px',
  ]
  const ROWLEN = 900
  const rowCache = new Map<number, string>()
  function rowText(r: number) {
    let s = rowCache.get(r)
    if (s) return s
    let seed = (r * 2654435761) >>> 0
    const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296)
    s = ''
    while (s.length < ROWLEN) s += TOKENS[Math.floor(rnd() * TOKENS.length)] + ' '
    s = s.slice(0, ROWLEN)
    rowCache.set(r, s)
    return s
  }
  const CHARS = Array.from(new Set(TOKENS.join(' ').split('')))
  const IDX = new Map(CHARS.map((c, i) => [c, i]))

  const BUCKETS = 7
  let atlas: HTMLCanvasElement | null = null
  let cw = 8, ch = 16, gw = 0, gh = 0

  function build(f: Frame) {
    const root = f.ctx.canvas.parentElement!
    const font = getComputedStyle(root).getPropertyValue('--tok-font').trim() || 'monospace'
    const fs = f.mobile ? 11 : 13
    f.ctx.font = `500 ${fs}px ${font}`
    cw = f.ctx.measureText('M').width
    ch = Math.round(fs * 1.45)
    gw = Math.ceil(cw * f.dpr) + 2; gh = ch * f.dpr
    atlas = document.createElement('canvas')
    atlas.width = gw * CHARS.length; atlas.height = gh
    const a = atlas.getContext('2d')!
    a.scale(f.dpr, f.dpr)
    a.font = `500 ${fs}px ${font}`
    a.textBaseline = 'middle'
    a.fillStyle = f.c.ink
    CHARS.forEach((c, i) => a.fillText(c, (i * gw) / f.dpr + 1 / f.dpr, ch / 2))
  }

  function draw(f: Frame) {
    if (!atlas) build(f)
    const { ctx, w, h, waterY, t, scale } = f
    const amp = 24 * scale
    const hz = waterY * (f.mobile ? 0.5 : 0.6)
    const S = 4
    const line: number[] = []
    for (let x = -S; x <= w + S; x += S) line.push(waterY + field(x, 0, t, scale))
    const clipTo = (below: boolean) => {
      ctx.beginPath()
      ctx.moveTo(-S, below ? h : 0)
      for (let i = 0; i < line.length; i++) ctx.lineTo(-S + i * S, line[i])
      ctx.lineTo(w + S, below ? h : 0)
      ctx.closePath()
      ctx.clip()
    }
    const cols = Math.ceil(w / cw) + 2
    const minSurf = Math.min(...line), maxSurf = Math.max(...line)

    // pass 0: far sea above the surface (faint); pass 1: the body below (bright)
    for (const below of [false, true]) {
      ctx.save()
      clipTo(below)
      const groups: number[][] = Array.from({ length: BUCKETS }, () => [])
      for (let r = 0, y = hz; y < h + ch; r++, y += ch) {
        if (below && y + ch / 2 < minSurf) continue
        if (!below && y - ch / 2 > maxSurf) break
        const text = rowText(r)
        const speed = (10 + (r % 5) * 3) * (r % 2 ? 1 : -1)
        const shift = t * speed
        const c0 = Math.floor(shift / cw)
        const frac = shift - c0 * cw
        for (let c = -1; c < cols; c++) {
          const x = c * cw - frac
          const ch0 = text[(((c + c0) % ROWLEN) + ROWLEN) % ROWLEN]
          if (ch0 === ' ') continue
          const xc = x + cw / 2
          let a: number
          if (below) {
            const sy = line[Math.max(0, Math.min(line.length - 1, Math.round((xc + S) / S)))]
            const depth = Math.max(0, y - sy)
            const fall = 1 - smooth(0, Math.max(110, (h - waterY) * 0.95), depth)
            const n = Math.max(0, Math.min(1, 0.5 - field(xc * 1.8 + depth * 0.6, 30 + depth * 4, t * 1.3, scale) / amp / 2))
            a = Math.min(1, (0.05 + 0.95 * Math.pow(n, 2.5)) * (0.35 + 0.65 * fall) + 0.3 * (1 - smooth(0, ch * 2.5, depth)))
          } else {
            const p = smooth(hz, waterY, y)
            const n = Math.max(0, Math.min(1, 0.5 - field(xc, (1 - p) * 2400, t, scale) / amp / 2))
            a = (0.02 + 0.16 * n * n) * p
          }
          if (a < 0.04) continue
          groups[Math.min(BUCKETS - 1, Math.floor(a * BUCKETS))].push(IDX.get(ch0) ?? 0, x, y)
        }
      }
      for (let b = 0; b < BUCKETS; b++) {
        const g = groups[b]
        if (!g.length) continue
        ctx.globalAlpha = (b + 0.6) / BUCKETS
        for (let i = 0; i < g.length; i += 3) ctx.drawImage(atlas!, g[i] * gw, 0, gw, gh, g[i + 1] - 1 / f.dpr, g[i + 2] - ch / 2, gw / f.dpr, ch)
      }
      ctx.restore()
    }
    ctx.globalAlpha = 1
  }

  document.querySelectorAll<HTMLElement>('[data-ascii-tokens-v1]').forEach((root) => mount(root, {
    colors: { ink: ['--tok-ink', '#a9c9e6'] },
    setup: () => { atlas = null; document.fonts?.ready.then(() => { atlas = null }) },
    draw,
    surface: (x, f, t) => f.waterY + field(x, 0, t, f.scale),
  }))
</script>
