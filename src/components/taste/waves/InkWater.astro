---
// Experimental: Ink water. WebGL fragment shader; the water line is the shared swell
// (experimental/kit.ts), mirrored in JS for the boat sampler.
---

<div class="wave-background ink-water" data-ink-water>
  <canvas class="xp-canvas"></canvas>
  <div class="wave-container-1 xp-surface"></div>
</div>

<style>
  .ink-water {
    --ink-ground: var(--color-bg);
    --ink-ink: oklch(0.42 0.1 250);
    --ink-mist: oklch(0.78 0.05 225);
    --ink-line: oklch(0.95 0.02 225);
    --boat-hero-sink: 0px;
    position: absolute; inset: 0; overflow: hidden; z-index: 0;
  }
  .xp-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .xp-surface { position: absolute; left: 0; right: 0; top: 56%; height: 0; pointer-events: none; }
</style>

<script>
  import { run, glPass, GLSL_PX, colorReader, type Swell } from './experimental/kit'
  import FRAG from './experimental/ink-water.glsl?raw'

  const WAVES: Swell[] = [[900, 12, 40, 1.7], [400, 5, 52, 0.3], [210, 2, 66, 3.3]]

  function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!
    const g = glPass(canvas, GLSL_PX + FRAG)
    if (!g) return
    let cols: Record<string, number[]> = {}
    run(root, canvas, {
      waves: WAVES,
      res: 0.5,
      colors() { const c = colorReader(root); cols = { uGround: c('--ink-ground', '#0b1626'), uInk: c('--ink-ink', '#2c4f8a'), uMist: c('--ink-mist', '#a9c4e0'), uLine: c('--ink-line', '#e8f2ff') } },
      draw(t, _dt, H) {
        g.swell(WAVES, t, H)
        for (const k in cols) g.f3(k, cols[k])
        g.draw()
      },
    })
  }
  document.querySelectorAll<HTMLElement>('[data-ink-water]').forEach((r) => { if (!r.dataset.init) { r.dataset.init = '1'; init(r) } })
</script>
