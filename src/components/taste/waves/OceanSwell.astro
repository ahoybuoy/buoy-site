---
// Realistic: Ocean swell. Reference wave style (contract: ./WAVES.md).
// Three canvas layers of Gerstner swells, hazier and slower toward the horizon,
// darker with depth, with foam and light on the crests. Colours come from the
// CSS custom properties below, so they follow the ground.
---

<div class="wave-background ocean-swell" data-ocean-swell>
  <canvas class="ocean-swell__canvas"></canvas>
  <!-- Invisible: its vertical middle is the water line of the front swell -->
  <div class="wave-container-1 ocean-swell__surface"></div>
</div>

<style>
  .ocean-swell {
    /* Palette, resolved by the script (any CSS colour, var() and color-mix() fine) */
    --swell-crest: color-mix(in oklab, var(--color-bg) 55%, oklch(0.58 0.11 238));
    --swell-deep: color-mix(in oklab, var(--color-bg) 70%, oklch(0.07 0.03 250));
    --swell-haze: color-mix(in oklab, var(--color-bg) 70%, oklch(0.5 0.08 240));
    --swell-foam: oklch(0.96 0.02 230);
    --swell-glint: var(--color-buoy);
    /* The boat lands on the front swell's line, no extra depth */
    --boat-hero-sink: 0px;

    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .ocean-swell__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .ocean-swell__surface {
    position: absolute;
    left: 0;
    right: 0;
    top: 58%;
    height: 0;
    pointer-events: none;
  }
</style>

<script>
  import { createWaveClock, waveEnvelope, type WaveParams } from './params'
  type Wave = { len: number; amp: number; speed: number; phase: number; dir: number }
  type Layer = { y: number; amp: number; waves: Wave[]; haze: number; foam: number }

  function resolver(host: HTMLElement) {
    const probe = document.createElement('span')
    probe.style.display = 'none'
    host.appendChild(probe)
    const cs = getComputedStyle(host)
    return (name: string, fallback: string) => {
      probe.style.color = ''
      probe.style.color = cs.getPropertyValue(name).trim() || fallback
      return getComputedStyle(probe).color || fallback
    }
  }

  function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!
    const surface = root.querySelector<HTMLElement>('.ocean-swell__surface')!
    const ctx = canvas.getContext('2d')!
    const reduced = matchMedia('(prefers-reduced-motion: reduce)')
    let w = 0, h = 0, dpr = 1, waterY = 0
    let colors = { crest: '', deep: '', haze: '', foam: '', glint: '' }

    const readColors = () => {
      const c = resolver(root)
      colors = {
        crest: c('--swell-crest', '#1f4f86'),
        deep: c('--swell-deep', '#06101c'),
        haze: c('--swell-haze', '#2a4d78'),
        foam: c('--swell-foam', '#eef6ff'),
        glint: c('--swell-glint', '#ff4f00'),
      }
      root.querySelector('span')?.remove()
    }

    // Back to front. y is the mean line as a fraction from the water line
    // (negative = toward the horizon). Wavelengths in px, speed in px/s.
    const rnd = (a: number, b: number) => a + Math.random() * (b - a)
    const mk = (len: number, amp: number, speed: number): Wave => ({ len, amp, speed, phase: rnd(0, Math.PI * 2), dir: 1 })
    const layers: Layer[] = [
      { y: -0.2, amp: 0.55, haze: 0.5, foam: 0.4, waves: [mk(380, 9, 30), mk(190, 4, 38), mk(110, 2, 46)] },
      { y: -0.08, amp: 0.75, haze: 0.25, foam: 0.6, waves: [mk(520, 12, 40), mk(250, 6, 50), mk(130, 3, 60)] },
      { y: 0, amp: 1, haze: 0, foam: 1, waves: [mk(700, 13, 52), mk(320, 7, 64), mk(160, 3.5, 78)] },
    ]

    function resize() {
      const r = root.getBoundingClientRect()
      dpr = Math.min(2, window.devicePixelRatio || 1)
      w = Math.max(1, Math.round(r.width))
      h = Math.max(1, Math.round(r.height))
      canvas.width = Math.round(w * dpr)
      canvas.height = Math.round(h * dpr)
      waterY = surface.offsetTop
      draw(last)
    }

    // Gerstner: points bunch toward crests, which sharpens them (wide troughs, peaked tops).
    // Live params (params.ts): intensity and the variation sets scale amplitude, chop
    // shortens and steepens the shorter components.
    const STEP = 3
    const CHOP0 = 0.3
    let P: WaveParams = { intensity: 1, speed: 1, chop: CHOP0, variation: 0.3 }
    const waveOut = new Float64Array(3)
    function waveAt(layer: Layer, x0: number, t: number, scale: number) {
      const dc = P.chop - CHOP0
      const env = P.intensity * waveEnvelope(x0, t, P.variation)
      let dx = 0, dy = 0, ampSum = 0
      const nW = layer.waves.length
      for (let j = 0; j < nW; j++) {
        const wv = layer.waves[j]
        const f = j / Math.max(1, nW - 1)
        const len = wv.len * (1 - 0.35 * dc * f)
        const k = (Math.PI * 2) / len
        const a = wv.amp * layer.amp * scale * env * Math.max(0.3, 1 + 1.0 * dc * f)
        const th = k * (x0 - wv.speed * t) + wv.phase
        const steep = Math.min(1.3, 0.95 + 0.45 * dc + 0.12 * Math.max(0, P.intensity - 1))
        const q = steep / (k * a * nW + 1e-6)
        dx -= Math.min(q, 1.4) * a * k * a * Math.sin(th)
        dy -= a * Math.cos(th)
        ampSum += a
      }
      waveOut[0] = x0 + dx; waveOut[1] = dy; waveOut[2] = ampSum ? -dy / ampSum : 0
      return waveOut
    }
    function sample(layer: Layer, t: number, scale: number, out: Float32Array) {
      const n = out.length / 4
      for (let i = 0; i < n; i++) {
        const x0 = -40 + i * STEP
        const r = waveAt(layer, x0, t, scale)
        out[i * 4] = r[0]
        out[i * 4 + 1] = r[1]
        out[i * 4 + 2] = r[2]
        out[i * 4 + 3] = x0
      }
    }

    // Smooth 1D value noise, for broken, varied foam
    const hash = (i: number) => { const s = Math.sin(i * 127.1 + 311.7) * 43758.5453; return s - Math.floor(s) }
    const noise = (x: number) => { const i = Math.floor(x), f = x - i, u = f * f * (3 - 2 * f); return hash(i) * (1 - u) + hash(i + 1) * u }
    const smooth = (a: number, b: number, x: number) => { const u = Math.max(0, Math.min(1, (x - a) / (b - a))); return u * u * (3 - 2 * u) }

    // Curve through the samples (midpoint quadratics, no polyline corners)
    function trace(base: number, n: number, move: boolean) {
      const X = (i: number) => buf[i * 4], Y = (i: number) => base + buf[i * 4 + 1]
      move ? ctx.moveTo(X(0), Y(0)) : ctx.lineTo(X(0), Y(0))
      for (let i = 1; i < n - 1; i++) ctx.quadraticCurveTo(X(i), Y(i), (X(i) + X(i + 1)) / 2, (Y(i) + Y(i + 1)) / 2)
      ctx.lineTo(X(n - 1), Y(n - 1))
    }

    let buf = new Float32Array(0)
    let last = 0
    const BUCKETS = 10
    const paths: Path2D[] = []

    function draw(t: number) {
      if (!w || !colors.crest) return
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, w, h)
      const scale = Math.min(1, Math.max(0.55, w / 1200))
      const n = Math.ceil((w + 80) / STEP) + 1
      if (buf.length !== n * 4) buf = new Float32Array(n * 4)
      const span = Math.max(h - waterY, 40) + waterY * 0.5

      layers.forEach((L, li) => {
        const base = waterY + L.y * span
        sample(L, t, scale, buf)

        // Body: lit just under the surface, darkening with depth; back layers sit in haze
        const g = ctx.createLinearGradient(0, base - 24 * scale, 0, h)
        g.addColorStop(0, L.haze ? colors.haze : colors.crest)
        g.addColorStop(Math.min(0.6, 70 / Math.max(1, h - base)), L.haze ? colors.haze : colors.crest)
        g.addColorStop(1, colors.deep)
        ctx.beginPath()
        trace(base, n, true)
        ctx.lineTo(buf[(n - 1) * 4], h)
        ctx.lineTo(buf[0], h)
        ctx.closePath()
        ctx.globalAlpha = 0.82 + 0.18 * (1 - L.haze)
        ctx.fillStyle = g
        ctx.fill()
        if (L.haze) { ctx.globalAlpha = L.haze * 0.3; ctx.fillStyle = colors.haze; ctx.fill() }

        // Translucency: light through the thin crests, a soft band just under the line
        if (L.haze < 0.5) {
        const band = ctx.createLinearGradient(0, base - 16 * scale, 0, base + 26 * scale)
        band.addColorStop(0, colors.foam)
        band.addColorStop(1, 'transparent')
        ctx.globalAlpha = 0.05 + 0.05 * L.foam
        ctx.fillStyle = band
        ctx.fill()
        }

        // Hairline rim, very faint
        ctx.globalAlpha = 0.07 + 0.1 * L.foam
        ctx.strokeStyle = colors.foam
        ctx.lineWidth = 0.75
        ctx.beginPath()
        trace(base, n, true)
        ctx.stroke()

        // Foam: thin, broken lines along the crests. Alpha varies with crest height and with
        // noise carried by the water (x0), quantised into buckets so it stays cheap.
        if (L.foam < 0.3) { ctx.globalAlpha = 1; return }
        for (let b = 0; b < BUCKETS; b++) paths[b] = new Path2D()
        for (let i = 0; i < n - 1; i++) {
          const c = buf[i * 4 + 2]
          if (c < 0.15) continue
          const x0 = buf[i * 4 + 3]
          const nz = noise(x0 * 0.045 + li * 13.1 + t * 0.15) * noise(x0 * 0.11 - t * 0.3 + li * 5.3)
          const a = smooth(0.2, 0.85, c) * (0.25 + 0.75 * smooth(0.06, 0.4, nz))
          if (a < 0.04) continue
          const bkt = Math.min(BUCKETS - 1, Math.floor(a * BUCKETS))
          const lift = -0.6 * c
          paths[bkt].moveTo(buf[i * 4], base + buf[i * 4 + 1] + lift)
          paths[bkt].lineTo(buf[(i + 1) * 4], base + buf[(i + 1) * 4 + 1] + lift)
        }
        ctx.lineCap = 'round'
        ctx.strokeStyle = colors.foam
        for (let b = 0; b < BUCKETS; b++) {
          const a = (b + 0.5) / BUCKETS
          // soft halo, then the line itself
          ctx.globalAlpha = a * 0.12 * L.foam
          ctx.lineWidth = 6 * scale
          ctx.stroke(paths[b])
          ctx.globalAlpha = a * 0.85 * L.foam
          ctx.lineWidth = (0.5 + a * 0.9) * scale
          ctx.stroke(paths[b])
        }

        // Spindrift: the crests travel right (+x, same way as the boat), so fine motes leave
        // each crest on its leading (right) side, carried downwind: out, a touch up, then
        // forward and down past the front face. Front layer only.
        if (L.foam === 1) {
          ctx.fillStyle = colors.foam
          for (let i = 1; i < n - 1; i++) {
            const c = buf[i * 4 + 2]
            if (c < 0.8) continue
            // leading edge only: the water drops away to the right of this point
            if (buf[(i + 1) * 4 + 1] <= buf[(i - 1) * 4 + 1]) continue
            const x0 = buf[i * 4 + 3]
            const hsh = hash(Math.floor(x0 / 5))
            if (hsh > 0.3) continue
            const life = (t * 1.1 + hsh * 7) % 1
            const fx = (5 + 16 * life) * life * scale
            const fy = (-5 * life + 14 * life * life) * scale
            ctx.globalAlpha = Math.sin(Math.PI * life) * smooth(0.8, 1, c) * 0.5
            ctx.beginPath()
            ctx.arc(buf[i * 4] + fx, base + buf[i * 4 + 1] - 1 + fy, (0.45 + hsh * 1.6) * scale * (1 - 0.4 * life), 0, Math.PI * 2)
            ctx.fill()
          }
        }
        ctx.globalAlpha = 1
      })
    }

    let raf = 0, visible = true
    const clock = createWaveClock(root, { chop: CHOP0, variation: 0.3 }, 4)
    clock.setRunning(() => raf !== 0 && !reduced.matches)
    const tick = (now: number) => { const f = clock.at(now); P = f.p; last = f.t; return f.t }
    const loop = (now: number) => {
      draw(tick(now))
      raf = requestAnimationFrame(loop)
    }
    const run = () => {
      cancelAnimationFrame(raf)
      raf = 0
      if (reduced.matches) { draw(tick(performance.now())); return }
      if (visible && !document.hidden) raf = requestAnimationFrame(loop)
    }

    // Surface sampler (WAVES.md): the front swell at this frame's time and params.
    // Gerstner moves points sideways, so invert x first (a few fixed-point steps).
    const front = layers[layers.length - 1]
    const scaleNow = () => Math.min(1, Math.max(0.55, w / 1200))
    const evalAt = (x0: number, t: number) => { const r = waveAt(front, x0, t, scaleNow()); return [r[0], r[1]] }
    const rawHeight = (x: number, t: number) => {
      let x0 = x
      for (let i = 0; i < 5; i++) x0 += x - evalAt(x0, t)[0]
      return waterY + evalAt(x0, t)[1]
    }
    const heightAt = (x: number, t: number) => {
      return rawHeight(x, t)
    }
    ;(root as any).buoySurface = (x: number, aheadMs = 0) => {
      const now = document.timeline.currentTime as number
      tick(now)
      const t = aheadMs ? clock.ahead(aheadMs) : last
      return { y: heightAt(x, t), slope: (heightAt(x + 2, t) - heightAt(x - 2, t)) / 4 }
    }

    readColors()
    resize()
    new ResizeObserver(resize).observe(root)
    new IntersectionObserver((e) => { visible = e.some((x) => x.isIntersecting); run() }).observe(root)
    document.addEventListener('visibilitychange', run)
    reduced.addEventListener('change', run)
    // Follow theme/ground changes (html class or injected styles)
    new MutationObserver(() => { readColors(); draw(last) }).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] })
    run()
  }

  document.querySelectorAll<HTMLElement>('[data-ocean-swell]').forEach((root) => {
    if (root.dataset.init) return
    root.dataset.init = '1'
    init(root)
  })
</script>
