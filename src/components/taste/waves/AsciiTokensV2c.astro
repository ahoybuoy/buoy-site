---
// Digital: ASCII tokens v2c, frozen: v2b plus row-to-row glide (critically damped spring,
// 160ms, per column; 7-column blur on the edge).
---

<div class="wave-background ascii-tokens-v2c" data-ascii-tokens-v2c>
  <canvas class="dg-canvas"></canvas>
  <div class="wave-container-1 dg-surface"></div>
</div>

<style>
  .ascii-tokens-v2c {
    --tok-ink: color-mix(in oklab, var(--color-bg) 20%, oklch(0.85 0.06 228));
    --tok-bright: oklch(0.93 0.035 225);
    --tok-font: var(--font-mono, 'JetBrains Mono', ui-monospace, monospace);
    --boat-hero-sink: 0px;
    /* The sampler returns the top of the lit glyphs; the hull just kisses them */
    --boat-hero-draft: 1px;
    /* The letters draw the wake (bow wave, trail), so hide BoatHero's line wake */
    --boat-hero-wake: transparent;
    position: absolute; inset: 0; overflow: hidden; z-index: 0;
  }
  .dg-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dg-surface { position: absolute; left: 0; right: 0; top: 60%; height: 0; pointer-events: none; }
</style>

<script>
  import { mount, field, smooth, P, type Frame } from './digital/sea'

  const TOKENS = [
    'var(--color-primary)', '--spacing-4', '#3b82f6', '16px', '--radius-md', 'var(--bg-surface)', '1.5rem',
    '--font-size-sm', '0.875rem', 'var(--space-2)', '#0f172a', '--shadow-lg', '24px', 'rgba(0,0,0,.12)',
    '--color-border', 'var(--text-muted)', '--line-height-tight', '1.25', '#e2e8f0', '--z-modal', '1000',
    'var(--radius-full)', '9999px', '--duration-fast', '150ms', '--ease-out', 'cubic-bezier(.16,1,.3,1)',
    '--color-danger-500', '#ef4444', 'var(--spacing-8)', '2rem', '--font-weight-semibold', '600',
    '--breakpoint-md', '768px', 'var(--color-accent)', 'oklch(0.62 0.19 255)', '--gap-3', '12px',
    '--opacity-disabled', '0.4', 'var(--focus-ring)', '--border-width', '1px', '--size-icon', '20px',
  ]
  function rowText(r: number, len: number) {
    let seed = (r * 2654435761 + 7) >>> 0
    const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296)
    let s = ''
    while (s.length < len) s += TOKENS[Math.floor(rnd() * TOKENS.length)] + '  '
    return s.slice(0, len)
  }
  const SPRAY = ["'", '°', '*', ',', '.']
  const CHARS = Array.from(new Set((TOKENS.join(' ') + SPRAY.join('')).split('')))
  const IDX = new Map(CHARS.map((c, i) => [c, i]))

  const BUCKETS = 6
  type Grid = { cols: number; rows: number; top: number; glyph: Int16Array; op: Float32Array; tone: Uint8Array }
  let atlas: HTMLCanvasElement | null = null
  let cw = 8, ch = 18, gw = 0, gh = 0
  let grid: Grid | null = null
  let capTop = 4                       // glyph cap-top offset inside its cell (px)
  let edgeV: Float32Array | null = null
  let edgeE: Float32Array | null = null // eased visible edge per column (glyph tops of the top lit row)
  let lastNow = 0
  const ripples: { x: number; y: number; t0: number }[] = []
  // Splash droplets (root.buoySplash): ballistic, drawn as spray glyphs snapped to the grid
  const drops: { x: number; y: number; vx: number; vy: number; t0: number }[] = []
  let boatPrevX = NaN, boatVX = 0

  function build(f: Frame) {
    const root = f.ctx.canvas.parentElement!
    const font = getComputedStyle(root).getPropertyValue('--tok-font').trim() || 'monospace'
    const fs = f.mobile ? 11 : 13
    f.ctx.font = `500 ${fs}px ${font}`
    // Snap the advance to device pixels so every glyph sits on the same sub-pixel phase
    cw = Math.round(f.ctx.measureText('M').width * f.dpr) / f.dpr
    ch = Math.round(fs * 1.45)
    gw = Math.round(cw * f.dpr); gh = ch * f.dpr
    atlas = document.createElement('canvas')
    atlas.width = gw * CHARS.length; atlas.height = gh * 2
    const a = atlas.getContext('2d')!
    a.scale(f.dpr, f.dpr)
    a.font = `500 ${fs}px ${font}`
    a.textBaseline = 'alphabetic'
    const base = Math.round(ch * 0.5 + fs * 0.36)
    capTop = base - fs * 0.73
    for (const [row, col] of [[0, f.c.ink], [1, f.c.bright]] as const) {
      a.fillStyle = col
      CHARS.forEach((c, i) => a.fillText(c, i * cw, row * ch + base))
    }
    const hz = Math.round(f.waterY * (f.mobile ? 0.5 : 0.6))
    const cols = Math.ceil(f.w / cw) + 1, rows = Math.ceil((f.h - hz) / ch) + 1
    const g: Grid = { cols, rows, top: hz, glyph: new Int16Array(cols * rows), op: new Float32Array(cols * rows), tone: new Uint8Array(cols * rows) }
    for (let r = 0; r < rows; r++) {
      const text = rowText(r, cols)
      for (let c = 0; c < cols; c++) g.glyph[r * cols + c] = text[c] === ' ' ? -1 : IDX.get(text[c]) ?? -1
    }
    grid = g
  }


  // Visible edge: the cap-top of the first lit row under the water line (cells whose centre
  // is below the line are always on), as a step per column
  function rawEdge(c: number, f: Frame, t: number) {
    const g = grid!
    const sy = f.waterY + field(c * cw + cw / 2, 0, t, f.scale)
    const r = Math.ceil((sy - g.top - ch / 2) / ch)
    return g.top + r * ch + capTop
  }
  // Sampler: a short triangle blur across neighbouring columns, lerped between columns
  function edgeAt(x: number, f: Frame, t: number) {
    if (!grid) return f.waterY + field(x, 0, t, f.scale)
    const live = edgeE && Math.abs(t - f.t) < 0.1
    const col = (c: number) => {
      c = Math.max(0, Math.min(grid!.cols - 1, c))
      return live ? edgeE![c] : rawEdge(c, f, t)
    }
    const blur = (c: number) => (col(c - 3) + 2 * col(c - 2) + 3 * col(c - 1) + 4 * col(c) + 3 * col(c + 1) + 2 * col(c + 2) + col(c + 3)) / 16
    const u = x / cw - 0.5, c0 = Math.floor(u), fr = u - c0
    return blur(c0) * (1 - fr) + blur(c0 + 1) * fr
  }

  function draw(f: Frame) {
    if (!atlas || !grid) build(f)
    const g = grid!
    const { ctx, w, h, waterY, t, scale } = f
    const now = performance.now()
    const dt = lastNow ? Math.min(0.1, (now - lastNow) / 1000) : 1
    lastNow = now
    const k = 1 - Math.exp(-dt / 0.12)   // ~120ms fade per character
    // Edge follows each column's step with a critically damped spring (no overshoot), a bit
    // slower than the 120ms glyph fade, so a row lighting up raises the water as a glide
    if (!edgeE || edgeE.length !== g.cols) {
      edgeE = new Float32Array(g.cols); edgeV = new Float32Array(g.cols)
      for (let c = 0; c < g.cols; c++) edgeE[c] = rawEdge(c, f, f.t)
    } else {
      const wn = 1 / 0.16, sub = Math.max(1, Math.ceil(dt / 0.008)), hs = Math.min(dt, 0.1) / sub
      for (let c = 0; c < g.cols; c++) {
        const target = rawEdge(c, f, f.t)
        let x = edgeE[c], v = edgeV![c]
        for (let s = 0; s < sub; s++) { v += (wn * wn * (target - x) - 2 * wn * v) * hs; x += v * hs }
        edgeE[c] = x; edgeV![c] = v
      }
    }
    const amp = 24 * scale
    const root = ctx.canvas.parentElement!
    const rootBox = root.getBoundingClientRect()

    // Boat: centre and drift speed, for the bow wave and wake
    const boat = root.closest('[data-boat-hero]')?.querySelector<HTMLElement>('[data-wave-boat]')
    let bx = NaN, by = NaN
    if (boat && getComputedStyle(boat).opacity !== '0') {
      const b = boat.getBoundingClientRect()
      bx = b.left + b.width / 2 - rootBox.left; by = b.bottom - rootBox.top
      if (Number.isFinite(boatPrevX) && dt > 0) boatVX += ((bx - boatPrevX) / Math.max(dt, 1e-3) - boatVX) * 0.1
      boatPrevX = bx
    }
    const dir = boatVX >= 0 ? 1 : -1
    while (ripples.length && now - ripples[0].t0 > 900) ripples.shift()

    const groups: number[][] = Array.from({ length: 2 * BUCKETS }, () => [])
    const lift = 0.5 * (P.intensity - 1) + 0.3 * P.variation
    for (let r = 0; r < g.rows; r++) {
      const y = g.top + r * ch
      const yc = y + ch / 2
      for (let c = 0; c < g.cols; c++) {
        const i = r * g.cols + c
        const gi = g.glyph[i]
        if (gi < 0) continue
        const x = c * cw, xc = x + cw / 2
        const sy = waterY + field(xc, 0, t, scale)
        const depth = yc - sy
        let on = 0, tone = 0
        if (depth > 0) {
          // Body: denser near the surface and on the swell's high water, thinning with depth
          const n = Math.max(0, Math.min(1, 0.5 - field(xc * 1.7, 30 + depth * 4, t * 1.25, scale) / amp / 2))
          const deep = smooth(0, Math.max(120, (h - waterY) * (0.9 + 0.3 * lift)), depth)
          on = depth < ch ? 1 : n > 0.25 + 0.6 * deep - 0.15 * lift ? 1 : 0
          tone = depth < ch * 1.1 ? 1 : 0
        } else {
          // Far sea: a few letters on the far crests only
          const p = smooth(g.top, waterY, yc)
          const n = 0.5 - field(xc, (1 - p) * 2400, t, scale) / amp / 2
          on = n * p > 0.62 - 0.12 * lift ? 1 : 0
          if (on) tone = 0
        }
        // Bow wave and wake: letters switch on around the boat, trailing behind it
        if (Number.isFinite(bx)) {
          const dx = (xc - bx) * dir, dy = yc - by
          const bow = dx > -6 && dx < 26 && depth > 0 && depth < ch * 2.2
          const wake = dx < 0 && dx > -260 && Math.abs(dy) < ch * (0.6 + -dx / 160) && depth > 0
            && ((c * 7 + r * 3) % 5) < 5 * (1 + dx / 260)
          if (bow || wake) { on = 1; tone = 1 }
        }
        // Splash ripple: a ring of letters flicking on outward
        for (const rp of ripples) {
          const age = (now - rp.t0) / 1000
          if (age > 0.75) continue
          const front = 40 + age * 420
          const d = Math.abs(xc - rp.x)
          if (Math.abs(d - front) < cw * 2.5 && depth > 0 && depth < ch * 1.6) { on = 1; tone = 1 }
        }
        const o = g.op[i] += (on - g.op[i]) * k
        if (o < 0.04) continue
        if (on) g.tone[i] = tone
        const toneNow = g.tone[i]
        const a = toneNow ? o : o * (0.42 + 0.3 * (1 - smooth(0, h - waterY, depth)))
        groups[toneNow * BUCKETS + Math.min(BUCKETS - 1, Math.floor(a * BUCKETS))].push(gi, x, y)
      }
    }
    // Droplets: whole glyphs on the grid, gone once they fall back into the water
    const occupied = new Set<number>()
    const sprayAt = new Map<number, string>()
    for (let j = drops.length - 1; j >= 0; j--) {
      const dp = drops[j]
      const age = (now - dp.t0) / 1000
      const x = dp.x + dp.vx * age, y = dp.y + dp.vy * age + 900 * age * age
      const falling = dp.vy + 1800 * age > 0
      if (age > 0.8 || (falling && y > waterY + field(x, 0, t, scale))) { drops.splice(j, 1); continue }
      const c = Math.round(x / cw - 0.5), r = Math.round((y - g.top) / ch - 0.5)
      if (c < 0 || r < 0 || c >= g.cols || occupied.has(r * g.cols + c)) continue
      occupied.add(r * g.cols + c)
      // Phase glyphs: big near the apex, small as it falls; never the same as a neighbour
      const vyNow = dp.vy + 1800 * age
      const apex = Math.abs(vyNow) < 220
      const opts = apex ? ['*', '°'] : falling ? (age > 0.4 ? ['.', ','] : [',', "'"]) : ["'", '°']
      let gch = opts[(j + (apex ? 0 : 1)) % 2]
      const key = r * g.cols + c
      if (sprayAt.get(key - 1) === gch || sprayAt.get(key + 1) === gch) gch = opts[1 - opts.indexOf(gch)]
      sprayAt.set(key, gch)
      const glyph = IDX.get(gch)!
      const a = Math.max(0.2, 1 - age * 0.9)
      groups[BUCKETS + Math.min(BUCKETS - 1, Math.floor(a * BUCKETS))].push(glyph, c * cw, g.top + r * ch)
    }
    for (let q = 0; q < groups.length; q++) {
      const gr = groups[q]
      if (!gr.length) continue
      const tone = q >= BUCKETS ? 1 : 0
      ctx.globalAlpha = ((q % BUCKETS) + 1) / BUCKETS
      for (let i = 0; i < gr.length; i += 3) ctx.drawImage(atlas!, gr[i] * gw, tone * gh, gw, gh, gr[i + 1], gr[i + 2], cw, ch)
    }
    ctx.globalAlpha = 1
  }

  document.querySelectorAll<HTMLElement>('[data-ascii-tokens-v2c]').forEach((root) => {
    // Own splash (WAVES.md): spray glyphs arcing up and back, letters flicking on outward
    ;(root as any).buoySplash = (x: number, y: number, info: { kind?: string; strength?: number } = {}) => {
      const k = Math.max(0.5, Math.min(2, info.strength ?? 1)) * (info.kind === 'toss' ? 0.8 : 1)
      const t0 = performance.now()
      ripples.push({ x, y, t0 })
      // Seeded per splash: varied angles and speeds, biased downwind (right, the boat's heading)
      let seed = (t0 * 1000) >>> 0 || 1
      const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296)
      const n = 9 + Math.round(rnd() * 3)
      for (let i = 0; i < n; i++) {
        const ang = -Math.PI / 2 + (rnd() * 2 - 0.75) * 1.05      // mostly up, leaning right
        const sp = (230 + rnd() * 420) * k
        drops.push({ x: x + (rnd() * 2 - 0.6) * 10, y: y - 2, vx: Math.cos(ang) * sp * 0.9, vy: Math.sin(ang) * sp, t0: t0 - rnd() * 60 })
      }
    }
    mount(root, {
      colors: { ink: ['--tok-ink', '#a9c9e6'], bright: ['--tok-bright', '#e6f0fb'] },
      setup: () => { atlas = null; grid = null; edgeE = null; document.fonts?.ready.then(() => { atlas = null }) },
      draw,
      surface: (x, f, t) => edgeAt(x, f, t),
    })
  })
</script>
