---
// Fixed copy of src/components/Button.astro: explicit transition properties,
// no outline removal on :focus, touch-action set.
interface Props {
  href?: string
  variant?: 'primary' | 'secondary'
  size?: 'md' | 'lg'
  external?: boolean
  class?: string
}
const { href, variant = 'primary', size = 'md', external = false, class: className = '' } = Astro.props
const base = 'inline-flex items-center justify-center font-medium rounded-lg touch-manipulation transition-[background-color,border-color,transform] duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-buoy'
const variants = {
  primary: 'bg-buoy text-navy-dark hover:bg-buoy-light active:bg-buoy-dark glow-buoy hover:scale-105 motion-reduce:hover:scale-100',
  secondary: 'bg-navy-light/50 text-light border border-navy-light/50 hover:bg-navy-light hover:border-lavender/50',
}
const sizes = { md: 'px-5 py-2.5 text-sm gap-2', lg: 'px-6 py-3 text-base gap-2' }
const Tag = href ? 'a' : 'button'
---
<Tag
  href={href}
  type={href ? undefined : 'button'}
  class={`${base} ${variants[variant]} ${sizes[size]} ${className}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
</Tag>
