---
// Fixed copy of LeadCaptureSection + LeadMagnetForm, one variant only (no swap after load).
const items = [
  'Hardcoded hex values instead of tokens',
  'Arbitrary pixel values outside your scale',
  'Inline styles overriding components',
  '!important used to force changes',
]
---
<section class="py-16 bg-navy relative" aria-labelledby="vg-lead-title">
  <div class="absolute inset-0 bg-gradient-to-b from-navy-dark/50 via-transparent to-navy-dark/50" aria-hidden="true"></div>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
    <div class="min-w-0">
      <p class="inline-flex px-3 py-1 bg-buoy/10 border border-buoy/30 rounded-full text-buoy text-sm mb-6">Free PDF</p>
      <h2 id="vg-lead-title" class="text-2xl sm:text-3xl font-bold text-light mb-4 leading-tight">Get the Drift Checklist</h2>
      <p class="text-lg text-slate mb-6">20 warning signs to look for in your next code review.</p>

      <form id="vg-lead-form" class="flex flex-col sm:flex-row gap-3" novalidate>
        <label for="vg-lead-email" class="sr-only">Work email</label>
        <input
          id="vg-lead-email"
          type="email"
          name="email"
          inputmode="email"
          autocomplete="email"
          spellcheck="false"
          autocapitalize="off"
          placeholder="you@company.com…"
          required
          aria-describedby="vg-lead-status"
          class="flex-1 min-w-0 px-4 py-3 bg-navy-light/50 border border-navy-light/50 rounded-lg text-light placeholder-slate transition-colors hover:border-slate-dark focus-visible:border-buoy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-buoy"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-buoy text-navy-dark font-medium rounded-lg whitespace-nowrap touch-manipulation glow-buoy transition-[background-color,opacity] duration-200 hover:bg-buoy-light active:bg-buoy-dark disabled:opacity-50 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-buoy"
        >Get the Checklist</button>
      </form>
      <p id="vg-lead-status" class="text-sm mt-3 min-h-5 text-slate" aria-live="polite">No spam. Unsubscribe anytime.</p>
    </div>

    <div class="hidden lg:block">
      <div class="bg-navy-dark border border-navy-light/30 rounded-xl p-6 shadow-2xl">
        <p class="text-xs text-slate mb-4 pb-4 border-b border-navy-light/20 font-mono" translate="no">drift-checklist.pdf</p>
        <ul class="space-y-3 text-sm text-slate">
          {items.map((item) => (
            <li class="flex items-start gap-3">
              <span class="w-4 h-4 border border-slate/50 rounded mt-0.5 flex-shrink-0" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
          <li class="flex items-start gap-3 opacity-60">
            <span class="w-4 h-4 border border-slate/50 rounded mt-0.5 flex-shrink-0" aria-hidden="true"></span>
            <span>+16 more…</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('vg-lead-form') as HTMLFormElement | null
  const input = document.getElementById('vg-lead-email') as HTMLInputElement | null
  const status = document.getElementById('vg-lead-status')
  if (form && input && status) {
    const button = form.querySelector('button') as HTMLButtonElement
    const label = button.textContent || ''
    const say = (text: string, tone: 'slate' | 'critical' | 'success') => {
      status.textContent = text
      status.className = `text-sm mt-3 min-h-5 text-${tone}`
    }
    const fail = (text: string) => {
      input.setAttribute('aria-invalid', 'true')
      say(text, 'critical')
      input.focus()
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      input.removeAttribute('aria-invalid')
      if (!input.checkValidity()) return fail('Enter a full email address, like you@company.com.')
      button.disabled = true
      button.textContent = 'Sending…'
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value, leadMagnet: 'drift-checklist' }),
        })
        if (res.ok) {
          say('Check your email. The checklist is on its way.', 'success')
          form.reset()
        } else {
          fail('That did not go through. Check the address and send it again.')
        }
      } catch {
        fail('You appear to be offline. Reconnect and send it again.')
      } finally {
        button.disabled = false
        button.textContent = label
      }
    })
  }
</script>
