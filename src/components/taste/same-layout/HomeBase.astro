<script>
  // Lead capture: same endpoint and payload as LeadMagnetForm.astro.
  const form = document.getElementById('sl-lead-form') as HTMLFormElement | null;
  const success = document.getElementById('sl-lead-success');
  const error = document.getElementById('sl-lead-error');
  if (form && success && error) {
    const leadMagnet = form.dataset.leadMagnet || 'drift-checklist';
    const button = form.querySelector('button') as HTMLButtonElement;
    const email = form.querySelector('input[name="email"]') as HTMLInputElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      button.textContent = button.dataset.loading || 'Sending...';
      success.hidden = true;
      error.hidden = true;
      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value, leadMagnet }),
        });
        const data = await response.json();
        if (response.ok) {
          success.hidden = false;
          form.hidden = true;
          fetch('/api/track', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ event: 'lead_magnet_download', properties: { lead_magnet: leadMagnet } }),
            keepalive: true,
          }).catch(() => {});
        } else {
          error.textContent = data.message || 'Something went wrong. Please try again.';
          error.hidden = false;
        }
      } catch {
        error.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.label || 'Get the Checklist';
      }
    });
  }
</script>

<script>
  // Hero boat escape, copied from src/pages/index.astro: the boat wiggles free
  // from the end of the hero sentence and drops into the waves. It does nothing
  // (and removes the inline boat) when a skin hides the wave decor.
  function initHeroBoatAnimation() {
    const boatInline = document.getElementById('heroBoatInline');
    const boatEmoji = document.getElementById('heroBoatEmoji');
    const waveBoat = document.getElementById('waveBoat');

    if (!boatInline || !boatEmoji) return;

    const decor = document.querySelector('.sl-decor--waves');
    const decorHidden = !decor || getComputedStyle(decor).display === 'none' || getComputedStyle(decor).visibility === 'hidden';
    if (decorHidden || getComputedStyle(boatInline).display === 'none') {
      boatInline.hidden = true;
      return;
    }

    // Reduced motion: just show the wave boat
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (waveBoat) waveBoat.classList.add('visible');
      return;
    }

    // An empty inline-block sits with its bottom edge on the line's baseline.
    function baselineY(el: HTMLElement) {
      const probe = document.createElement('span');
      probe.style.cssText = 'display:inline-block;width:0;height:0;';
      el.appendChild(probe);
      const y = probe.getBoundingClientRect().bottom;
      probe.remove();
      return y;
    }

    // Measured right before the fall, so the layout (fonts, reveal animations) has settled.
    function measureLanding() {
      const isMobile = window.innerWidth < 768;
      const baseDrop = isMobile ? 30 : 37;
      const startRect = boatEmoji!.getBoundingClientRect();
      const startBaseline = baselineY(boatEmoji!);
      const origin = `0px ${startBaseline - startRect.top}px`;
      if (!waveBoat) {
        return { dx: 0, dy: baseDrop, scale: 1, origin, waveBottomPx: null, waveLeftPct: null };
      }
      const waveParent = (waveBoat.offsetParent || waveBoat.parentElement) as HTMLElement;
      const parentRect = waveParent.getBoundingClientRect();
      const cbLeft = parentRect.left + waveParent.clientLeft;
      const cbWidth = waveParent.clientWidth;
      const waveBottomPx = parentRect.bottom - (startRect.bottom + baseDrop) - 4;
      const waveLeftPct = ((startRect.left - cbLeft) / cbWidth) * 100;
      waveBoat.style.bottom = waveBottomPx + 'px';
      waveBoat.style.left = waveLeftPct + '%';
      const waveRect = waveBoat.getBoundingClientRect();
      const scale = parseFloat(getComputedStyle(waveBoat).fontSize) / parseFloat(getComputedStyle(boatEmoji!).fontSize);
      return {
        dx: waveRect.left - startRect.left,
        dy: baselineY(waveBoat) - startBaseline,
        scale: Number.isFinite(scale) && scale > 0 ? scale : 1,
        origin,
        waveBottomPx,
        waveLeftPct,
      };
    }

    const LIFT_MS = 130;
    const DROP_MS = 500;

    setTimeout(() => {
      const wiggle = boatEmoji.animate([
        { transform: 'rotate(0deg)', offset: 0 },
        { transform: 'rotate(8deg) translateX(1px)', offset: 0.15 },
        { transform: 'rotate(-7deg) translateX(-1px)', offset: 0.30 },
        { transform: 'rotate(12deg) translateX(2px) translateY(-2px)', offset: 0.50 },
        { transform: 'rotate(-10deg) translateX(-2px)', offset: 0.65 },
        { transform: 'rotate(5deg) translateX(1px)', offset: 0.80 },
        { transform: 'rotate(-2deg)', offset: 0.92 },
        { transform: 'rotate(0deg)', offset: 1 },
      ], { duration: 600, easing: 'ease-in-out' });

      wiggle.finished.then(() => {
        const { dx, dy, scale, origin, waveBottomPx, waveLeftPct } = measureLanding();
        boatEmoji.style.transformOrigin = origin;

        const fall = boatEmoji.animate([
          { translate: '0 0', easing: 'ease-out' },
          { translate: '0 -6px', offset: LIFT_MS / (LIFT_MS + DROP_MS), easing: 'cubic-bezier(0.5, 0, 0.9, 0.55)' },
          { translate: `${dx}px ${dy}px` },
        ], { duration: LIFT_MS + DROP_MS, fill: 'forwards' });

        const grow = boatEmoji.animate([
          { scale: '1' },
          { scale: String(scale) },
        ], { delay: LIFT_MS, duration: DROP_MS, easing: 'ease-out', fill: 'both' });

        Promise.all([fall.finished, grow.finished]).then(() => {
          const landedRect = boatEmoji.getBoundingClientRect();
          createSplash(
            landedRect.left + landedRect.width / 2,
            landedRect.top + landedRect.height * 0.7 + 6
          );

          boatInline.style.visibility = 'hidden';
          if (!waveBoat || waveLeftPct == null) return;

          // Stored so toss landing can match drop landing on all screen sizes
          (window as any)._buoyBoatBottom = waveBottomPx;

          const landedLeftPct = waveLeftPct;
          waveBoat.classList.add('launching');

          const launchDuration = 3000;
          const launchDistance = 13;
          const endLeftPct = landedLeftPct + launchDistance;

          const launchAnim = waveBoat.animate([
            { left: landedLeftPct + '%' },
            { left: endLeftPct + '%' }
          ], {
            duration: launchDuration,
            easing: 'cubic-bezier(0.3, 0, 0.8, 0.8)',
            fill: 'forwards'
          });

          launchAnim.finished.then(() => {
            launchAnim.cancel();
            waveBoat.style.left = '';
            waveBoat.classList.remove('launching');
            waveBoat.classList.add('visible');

            const driftProgress = (endLeftPct + 5) / 110;
            const driftDelay = -(driftProgress * 25);
            waveBoat.style.animationDelay = `0s, ${driftDelay}s`;
          });
        });
      });
    }, 850);
  }

  function createSplash(x: number, y: number) {
    const waveBg = document.querySelector('.sl-decor--waves .wave-background');
    if (!waveBg) return;
    const bgRect = waveBg.getBoundingClientRect();

    const container = document.createElement('div');
    Object.assign(container.style, {
      position: 'absolute',
      left: (x - bgRect.left) + 'px',
      top: (y - bgRect.top) + 'px',
      zIndex: '1',
      pointerEvents: 'none',
    });

    const isLight = document.documentElement.classList.contains('light');
    for (let i = 0; i < 10; i++) {
      const drop = document.createElement('div');
      const angle = (-150 + (120 * i / 9)) * (Math.PI / 180);
      const speed = 18 + Math.random() * 28;
      const dx = Math.cos(angle) * speed;
      const dy = Math.sin(angle) * speed;
      const size = 3 + Math.random() * 4;
      const alpha = (0.65 + Math.random() * 0.3).toFixed(2);
      const dropColor = isLight
        ? `rgba(255, 255, 255, ${alpha})`
        : `rgba(${60 + Math.random() * 60 | 0}, ${140 + Math.random() * 60 | 0}, 255, ${(0.5 + Math.random() * 0.3).toFixed(2)})`;

      Object.assign(drop.style, {
        position: 'absolute',
        width: size + 'px',
        height: size + 'px',
        borderRadius: '50%',
        background: dropColor,
        left: '-2px',
        top: '-2px',
      });
      drop.style.setProperty('--dx', dx + 'px');
      drop.style.setProperty('--dy', dy + 'px');
      drop.style.animation = `sl-splash-drop ${(0.4 + Math.random() * 0.3).toFixed(2)}s ease-out ${(Math.random() * 0.08).toFixed(3)}s forwards`;
      container.appendChild(drop);
    }

    const ring = document.createElement('div');
    Object.assign(ring.style, {
      position: 'absolute',
      width: '20px',
      height: '8px',
      border: isLight ? '2px solid rgba(255, 255, 255, 0.75)' : '2px solid rgba(100, 180, 255, 0.5)',
      borderRadius: '50%',
      left: '0',
      top: '0',
      animation: 'sl-splash-ring 0.7s ease-out forwards',
    });
    container.appendChild(ring);

    waveBg.appendChild(container);
    setTimeout(() => container.remove(), 1200);
  }

  initHeroBoatAnimation();
  // Expose splash so the boat drag script can call it
  (window as any)._buoySplash = createSplash;
</script>
