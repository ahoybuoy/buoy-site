---
interface FlagItem {
  name: string
  description: string
  required?: boolean
  default?: string
}

interface Props {
  items: FlagItem[]
  class?: string
}

const { items, class: className = '' } = Astro.props
---

<table class={`flags-list ui-table mb-6 ${className}`}>
  <thead><tr><th>Flag</th><th>What it does</th></tr></thead>
  <tbody>
    {items.map((item) => (
      <tr>
        <th class="align-baseline"><code class="ui-c-ok text-sm">{item.name}</code></th>
        <td class="text-sm">
          {item.description}
          {item.required && <span class="ml-1.5 text-xs font-medium ui-c-crit">required</span>}
          {item.default && <span class="ml-1.5 text-[var(--color-muted)]">(default: <code class="text-xs">{item.default}</code>)</span>}
        </td>
      </tr>
    ))}
  </tbody>
</table>
