---
import BuoyLogo from './BuoyLogo.astro'
import { siteConfig } from '../config'

// `layout="full"` widens the bar to the window; `alignment` is accepted for old callers and ignored.
const { layout = 'contained' } = Astro.props
const APP_URL = 'https://github.com/marketplace/buoy-design'

const featureItems = [
  { label: 'Drift Detection', href: '/features/drift-detection', description: 'Find design inconsistencies' },
  { label: 'Hardcoded Values', href: '/features/hardcoded-values', description: 'Colors & spacing not using tokens' },
  { label: 'Duplicate Detection', href: '/features/duplicate-detection', description: 'Find component clones' },
  { label: 'Naming Consistency', href: '/features/naming-consistency', description: 'Enforce conventions' },
  { label: 'Inline Styles', href: '/features/hardcoded-values', description: 'Inline CSS using tokens' },
  { label: 'Accessibility Checks', href: '/features/accessibility-checks', description: 'A11y at build time' },
  { label: 'Framework Sprawl', href: '/features/framework-sprawl', description: 'Multiple UI libraries' },
  { label: 'Bootstrap', href: '/features/bootstrap', description: 'Extract tokens from code' },
  { label: 'Build', href: '/features/build', description: 'Generate token files' },
  { label: 'GitHub App', href: '/features/github-action', description: 'PR drift reports' },
  { label: 'CI Integration', href: '/features/ci', description: 'Any CI pipeline' },
  { label: 'Ignore Rules', href: '/features/ignore', description: 'Intentional exceptions' },
  { label: 'Severity Rules', href: '/features/severity-rules', description: 'Promote & enforce drift' },
]

const useCaseItems = [
  { label: 'One Command', href: '/one-command', description: 'Understand your codebase instantly' },
  { label: 'Take Control', href: '/take-control', description: 'Design tokens were step one' },
  { label: 'Enforce Your Rules', href: '/enforce', description: 'Make your system enforceable' },
  { label: 'Your Rules', href: '/your-rules', description: 'AI writes code, you write rules' },
  { label: 'Design System Teams', href: '/use-cases/design-system-teams', description: 'Enforce adoption' },
  { label: 'Frontend Teams', href: '/use-cases/frontend-teams', description: 'Maintain consistency' },
  { label: 'Enterprise', href: '/use-cases/enterprise', description: 'Multi-repo at scale' },
]

const compareItems = [
  { label: 'vs LLM Code Review', href: '/compare/llm-code-review' },
  { label: 'vs Manual Audits', href: '/compare/manual-audits' },
  { label: 'vs ESLint', href: '/compare/eslint' },
  { label: 'vs Chromatic', href: '/compare/chromatic' },
  { label: 'vs Percy', href: '/compare/percy' },
  { label: 'vs Figma Plugins', href: '/compare/figma-plugins' },
  { label: 'vs Style Dictionary', href: '/compare/style-dictionary' },
]

const menus = [
  { label: 'Features', items: featureItems, wide: true },
  { label: 'Use Cases', items: useCaseItems },
  { label: 'Compare', items: compareItems, lgOnly: true },
]

const plainLinks = [
  { label: 'Scan a repo', href: '/scan' },
  { label: 'Reports', href: '/reports' },
  { label: 'Docs', href: '/docs' },
  { label: 'Pricing', href: '/pricing' },
]
---

<header class="site-nav">
  <div class:list={['site-nav-row', layout === 'full' ? 'site-nav-full' : 'ui-wrap']}>
    <a href="/" class="site-logo" aria-label="Buoy home">
      <BuoyLogo size="1.5rem" />
    </a>

    <nav class="site-links" aria-label="Main">
      {menus.map((m) => (
        <div class:list={['site-dd', m.lgOnly && 'site-lg-only']}>
          <button type="button" class="site-navlink" aria-haspopup="true">
            {m.label}
            <svg class="site-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="site-dd-panel">
            <div class:list={['site-dd-list', m.wide && 'site-dd-wide']}>
              {m.items.map((item) => (
                <a href={item.href} class="site-dd-item">
                  <span class="site-dd-label">{item.label}</span>
                  {'description' in item && <span class="site-dd-desc">{item.description}</span>}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
      {plainLinks.map((l) => <a href={l.href} class="site-navlink">{l.label}</a>)}
      <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="site-navlink site-lg-only">GitHub</a>
    </nav>

    <div class="site-actions">
      <button id="theme-toggle" type="button" class="site-iconbtn site-desktop" aria-label="Toggle theme">
        <svg class="theme-icon-sun" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
        </svg>
        <svg class="theme-icon-moon hidden" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
        </svg>
      </button>
      <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary ui-btn--sm">Install the app</a>
      <button type="button" class="site-menu-btn" id="mobile-menu-button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
        <span class="site-swap" aria-hidden="true">
          <svg class="site-swap-a" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3.5 6.5h13M3.5 13.5h13"/></svg>
          <svg class="site-swap-b" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l10 10M15 5L5 15"/></svg>
        </span>
      </button>
    </div>
  </div>

  <div class="site-menu" id="mobile-menu">
    <div class="ui-wrap site-menu-inner">
      <nav class="site-menu-list" aria-label="Menu">
        {plainLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>
      {menus.map((m) => (
        <div class="site-menu-group">
          <p class="site-menu-head">{m.label}</p>
          <div class="site-menu-sub">
            {m.items.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </div>
      ))}
      <button id="mobile-theme-toggle" type="button" class="ui-btn ui-btn--secondary ui-btn--block site-menu-theme">
        <span class="mobile-theme-label">Switch to light mode</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile menu
  const button = document.getElementById('mobile-menu-button')
  const menu = document.getElementById('mobile-menu')
  const setOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open))
    menu?.classList.toggle('is-open', open)
  }
  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false)
      button.focus()
    }
  })
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false)
  })

  // Theme toggle
  function updateToggleUI(theme: 'dark' | 'light') {
    document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.toggle('hidden', theme === 'light'))
    document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.toggle('hidden', theme === 'dark'))
    const mobileLabel = document.querySelector('.mobile-theme-label')
    if (mobileLabel) mobileLabel.textContent = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
  }

  function setTheme(theme: 'dark' | 'light') {
    document.documentElement.classList.toggle('light', theme === 'light')
    localStorage.setItem('theme', theme)
    updateToggleUI(theme)
  }

  function toggleTheme() {
    setTheme(document.documentElement.classList.contains('light') ? 'dark' : 'light')
  }

  updateToggleUI(document.documentElement.classList.contains('light') ? 'light' : 'dark')
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme)
  document.getElementById('mobile-theme-toggle')?.addEventListener('click', toggleTheme)
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) setTheme(e.matches ? 'light' : 'dark')
  })
</script>

<style>
  .site-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: color-mix(in oklab, var(--color-bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--color-line);
  }
  .site-nav-row { display: flex; align-items: center; height: 64px; gap: 24px; }
  .site-nav-full { padding-inline: var(--gutter); }
  .site-logo { display: inline-flex; align-items: center; height: 44px; color: var(--color-ink); border-radius: 8px; flex: none; }

  .site-links { display: flex; align-items: center; gap: 4px; margin-left: 8px; margin-right: auto; }
  .site-navlink {
    display: inline-flex; align-items: center; gap: 4px; height: 40px; padding-inline: 12px;
    border: 0; background: transparent; cursor: pointer;
    border-radius: 8px; font-family: var(--font-body); font-size: 14px; font-weight: 500; white-space: nowrap;
    color: var(--color-body);
    transition: color 120ms ease-out, background-color 120ms ease-out;
  }
  .site-navlink:hover, .site-dd:focus-within > .site-navlink { color: var(--color-ink); background: var(--color-sunken); }
  .site-caret { color: var(--color-muted); transition: rotate 200ms var(--ease-swap); }
  .site-dd:hover .site-caret, .site-dd:focus-within .site-caret { rotate: 180deg; }

  .site-dd { position: relative; }
  .site-dd-panel {
    position: absolute; top: 100%; left: -6px; padding-top: 8px;
    opacity: 0; translate: 0 -4px; visibility: hidden;
    transition: opacity 150ms ease-out, translate 150ms ease-out, visibility 0s linear 150ms;
  }
  .site-dd:hover .site-dd-panel, .site-dd:focus-within .site-dd-panel {
    opacity: 1; translate: 0 0; visibility: visible;
    transition: opacity 200ms ease-out, translate 200ms ease-out, visibility 0s;
  }
  .site-dd-list {
    display: grid; gap: 2px; width: 260px; padding: 6px;
    border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--ring-lift);
  }
  .site-dd-wide { width: 500px; grid-template-columns: 1fr 1fr; }
  .site-dd-item { display: flex; flex-direction: column; padding: 8px 10px; border-radius: 10px; transition: background-color 100ms ease-out; }
  .site-dd-item:hover { background: var(--color-sunken); }
  .site-dd-label { font-size: 14px; font-weight: 500; color: var(--color-ink); }
  .site-dd-desc { font-size: 12.5px; color: var(--color-muted); }

  .site-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .site-iconbtn {
    display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px;
    border: 0; border-radius: 10px; background: transparent; color: var(--color-body); cursor: pointer;
    transition: color 120ms ease-out, background-color 120ms ease-out, scale 150ms ease-out;
  }
  .site-iconbtn:hover { color: var(--color-ink); background: var(--color-sunken); }
  .site-iconbtn:active { scale: 0.96; }

  .site-menu-btn {
    display: none; align-items: center; justify-content: center;
    width: 44px; height: 44px; margin-right: -12px;
    border: 0; background: transparent; color: var(--color-ink); border-radius: 10px; cursor: pointer;
    transition: scale 150ms ease-out, background-color 120ms ease-out;
  }
  .site-menu-btn:hover { background: var(--color-sunken); }
  .site-menu-btn:active { scale: 0.96; }
  .site-swap { position: relative; display: block; width: 20px; height: 20px; }
  .site-swap svg {
    position: absolute; inset: 0; display: block;
    transition-property: opacity, filter, scale; transition-duration: 300ms; transition-timing-function: var(--ease-swap);
  }
  .site-swap-b { opacity: 0; scale: 0.25; filter: blur(4px); }
  .site-menu-btn[aria-expanded='true'] .site-swap-a { opacity: 0; scale: 0.25; filter: blur(4px); }
  .site-menu-btn[aria-expanded='true'] .site-swap-b { opacity: 1; scale: 1; filter: blur(0); }

  .site-menu {
    display: none;
    position: absolute; left: 0; right: 0; top: 100%;
    max-height: calc(100svh - 64px); overflow-y: auto;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 16px 24px -16px oklch(0 0 0 / 0.5);
    opacity: 0; translate: 0 -8px; visibility: hidden;
    transition: opacity 150ms ease-out, translate 150ms ease-out, visibility 0s linear 150ms;
  }
  .site-menu.is-open { opacity: 1; translate: 0 0; visibility: visible; transition: opacity 200ms ease-out, translate 200ms ease-out, visibility 0s; }
  .site-menu-inner { padding-block: 8px 20px; }
  .site-menu-list { display: grid; }
  .site-menu-list a {
    display: flex; align-items: center; min-height: 48px;
    font-size: 16px; font-weight: 500; color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .site-menu-group { padding-block: 14px 6px; border-bottom: 1px solid var(--color-line); }
  .site-menu-head { margin: 0 0 4px; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .site-menu-sub { display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; }
  .site-menu-sub a { display: flex; align-items: center; min-height: 40px; font-size: 14.5px; color: var(--color-body); }
  .site-menu-theme { margin-top: 16px; }

  @media (max-width: 1100px) { .site-lg-only { display: none; } }
  @media (max-width: 860px) {
    .site-links, .site-desktop { display: none; }
    .site-menu-btn { display: inline-flex; }
    .site-menu { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-menu-btn, .site-swap svg, .site-menu, .site-menu.is-open, .site-dd-panel, .site-caret { transition-duration: 0s; transition-delay: 0s; }
    .site-menu-btn:active, .site-iconbtn:active { scale: 1; }
    .site-swap-b, .site-menu-btn[aria-expanded='true'] .site-swap-a { scale: 1; filter: none; }
  }
</style>
