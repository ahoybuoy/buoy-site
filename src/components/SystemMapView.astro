---
/**
 * The system map for one repository: four lanes (tokens, primitives + icons,
 * composites, pages) and an inspector. Data is the packed map JSON, embedded
 * in the page so it renders without a second request.
 */
import type { PackedMap } from '../scripts/system-map'
interface Props { map: PackedMap }
const { map } = Astro.props
const s = map.stats
const composites = s.components - s.pages - s.primitives - s.icons
const lanes: number[] = [0, 0, 0, 0]
for (const n of map.nodes) lanes[[0, 1, 1, 2, 3][n[0]]!]!++
---

<div class="system-map" data-system-map>
  <div class="stats">
    <span><b>{s.tokens}</b>tokens</span>
    <span><b>{s.primitives}</b>primitives</span>
    <span><b>{s.icons}</b>icons</span>
    <span><b>{composites}</b>composites</span>
    <span><b>{s.pages}</b>pages</span>
    <span><b>{s.tokensUnused}</b>tokens no component uses</span>
    <span class="d"><b>{s.driftInComponents}</b>drift findings</span>
  </div>
  <div class="main">
    <div class="board">
      <div class="lanes">
        {['Tokens', 'Primitives + icons', 'Composites', 'Pages'].map((t, i) => <div>{t}<span>{lanes[i]}</span></div>)}
      </div>
      <canvas data-map-canvas aria-label="System map: tokens, primitives, composites and pages as dots, with connections for the selected item"></canvas>
      <div class="legend">
        <span><i style="background:var(--map-down)"></i>feeds (downstream)</span>
        <span><i style="background:var(--map-up)"></i>built from (upstream)</span>
        <span><i class="ring"></i>has drift</span>
        <span>Faint dots are not connected to the selection</span>
      </div>
    </div>
    <aside class="side">
      <label for="map-q" class="note">Find a token, component or page</label>
      <input id="map-q" data-map-search list="map-names" placeholder="Button, primary, settings…" autocomplete="off" />
      <datalist id="map-names"></datalist>
      <div data-map-info></div>
    </aside>
  </div>
  <div class="tip" data-map-tip hidden></div>
  <script type="application/json" data-map-json set:html={JSON.stringify(map).replace(/</g, '\\u003c')} />
</div>

<style>
  .system-map {
    --map-line: rgba(148, 163, 184, 0.18); --map-dot: #7d8aa3; --map-dim: #1f2a3d; --map-ink: #f1efe8;
    --map-muted: #94a3b8; --map-down: #f07a33; --map-up: #6f9bff; --map-drift: #ff6464;
    display: grid; gap: 16px; color: #f1efe8;
  }
  .stats { display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 13px; color: var(--map-muted); font-variant-numeric: tabular-nums; }
  .stats b { color: var(--map-ink); font: 600 15px ui-monospace, Menlo, monospace; margin-right: 4px; }
  .stats .d b { color: var(--map-drift); }
  .main { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 16px; align-items: stretch; }
  @media (max-width: 900px) { .main { grid-template-columns: minmax(0, 1fr); } }
  /* Side by side, the panel matches the map's height and scrolls inside;
     contain: size keeps its long lists from stretching the row. */
  @media (min-width: 901px) { .side { contain: size; overflow-y: auto; align-content: start; } }
  .board, .side { background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 12px; }
  .board { overflow: hidden; min-width: 0; }
  .lanes { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--map-line); }
  .lanes div { padding: 10px 12px 8px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--map-muted); display: flex; justify-content: space-between; gap: 6px; }
  .lanes div + div { border-left: 1px solid var(--map-line); }
  canvas { display: block; width: 100%; cursor: crosshair; }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12px; color: var(--map-muted); padding: 10px 12px; border-top: 1px solid var(--map-line); }
  .legend i { display: inline-block; width: 18px; height: 2px; vertical-align: middle; margin-right: 6px; }
  .legend i.ring { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid var(--map-drift); }
  .side { padding: 16px; display: grid; gap: 14px; min-width: 0; }
  .side input { width: 100%; font-size: 14px; padding: 8px 10px; border-radius: 6px; border: 1px solid rgba(148, 163, 184, 0.3); background: rgba(2, 6, 23, 0.5); color: var(--map-ink); }
  .tip { position: fixed; pointer-events: none; background: var(--map-ink); color: #0b1220; font: 12px ui-monospace, Menlo, monospace; padding: 4px 8px; border-radius: 4px; z-index: 50; white-space: nowrap; }
  .system-map :global(.note) { font-size: 12px; color: var(--map-muted); }
  .system-map :global(.kind) { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--map-down); }
  .system-map :global(.name) { font-size: 20px; font-weight: 700; line-height: 1.2; margin-top: 2px; overflow-wrap: anywhere; }
  .system-map :global(.path) { font: 12px ui-monospace, Menlo, monospace; color: var(--map-muted); overflow-wrap: anywhere; margin-top: 4px; }
  [data-map-info] { display: grid; gap: 14px; min-width: 0; }
  .system-map :global(.big) { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 10px 14px; }
  .system-map :global(.big div) { font-size: 12px; color: var(--map-muted); }
  .system-map :global(.big b) { display: block; font: 600 20px ui-monospace, Menlo, monospace; color: var(--map-ink); }
  .system-map :global(.big .dn b) { color: var(--map-down); }
  .system-map :global(.big .upc b) { color: var(--map-up); }
  .system-map :global(.big .dr b) { color: var(--map-drift); }
  .system-map :global(h3) { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--map-muted); margin: 0 0 6px; }
  .system-map :global(.map-list) { display: grid; gap: 2px; max-height: 220px; overflow: auto; }
  .system-map :global(.map-list button) { display: flex; justify-content: space-between; gap: 8px; text-align: left; padding: 4px 6px; border-radius: 4px; font-size: 13px; min-width: 0; color: var(--map-ink); }
  .system-map :global(.map-list button span:first-child) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .system-map :global(.map-list button span:last-child) { font: 12px ui-monospace, Menlo, monospace; color: var(--map-muted); flex: none; }
  .system-map :global(.map-list button:hover) { background: rgba(240, 122, 51, 0.15); }
  .system-map :global(.map-list button:focus-visible), .side input:focus-visible { outline: 2px solid var(--map-down); outline-offset: 2px; }
  .system-map :global(.sw) { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; border: 1px solid var(--map-line); }
  .system-map :global(.drift) { font-size: 13px; color: var(--map-drift); display: grid; gap: 4px; }
</style>

<script>
  import { mountSystemMap, type PackedMap } from '../scripts/system-map'
  for (const root of document.querySelectorAll<HTMLElement>('[data-system-map]')) {
    const json = root.querySelector<HTMLScriptElement>('[data-map-json]')?.textContent
    if (json) mountSystemMap(root, JSON.parse(json) as PackedMap)
  }
</script>
