---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'
import LeadMagnetCallout from '../components/LeadMagnetCallout.astro'
import MarkPattern from '../components/MarkPattern.astro'
import { siteConfig } from '../config'

const values = [
  {
    title: 'Clarity Over Reports',
    description: 'Every scan ends with clear next steps. Not another dashboard to check: actionable fixes you can apply now.'
  },
  {
    title: 'Automation Over Manual Work',
    description: "If a fix is safe and obvious, we do it for you. Your time is better spent building, not hunting through files."
  },
  {
    title: 'Measurement Over Guessing',
    description: "\"About 60% adopted\" isn't good enough. Real numbers let you prove ROI and track improvement."
  },
  {
    title: 'Open Source at Core',
    description: 'The CLI is free forever. It lives in your codebase, not on our servers. Your whole team uses it.'
  },
]

const timeline = [
  {
    phase: 'Now',
    title: 'CLI + CI Integration',
    description: 'Drift detection, auto-fixes, and coverage tracking in your terminal and CI pipeline.'
  },
  {
    phase: 'Next',
    title: 'MCP Server',
    description: 'Real-time drift prevention in AI editors like Cursor and Claude. Stop drift before it happens.'
  },
  {
    phase: 'Future',
    title: 'Figma Sync',
    description: 'Keep design tokens synchronized between Figma and code. One source of truth.'
  },
]
---

<Layout
  title="About Buoy | Design Drift Detection"
  description="Buoy catches design drift in AI-generated code. Find issues, fix them automatically, and measure the improvement."
>
  <Nav />

  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="wake" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head">
          <h1>Design systems shouldn't be optional</h1>
          <p class="ui-lede">
            AI writes code fast. But it doesn't know your design system exists.
            Buoy bridges that gap: finding drift, fixing it, and measuring the improvement.
          </p>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap ui-split">
        <div class="ui-head"><h2>The problem</h2></div>
        <div class="ab-story">
          <p>Your team invested months building a design system. Components, tokens, documentation, the works.</p>
          <p>
            Then AI coding assistants arrived. Copilot, Cursor, Claude: they write code 10x faster.
            But they don't know your design system exists.
          </p>
          <p>
            The AI writes <code class="ui-code"><span class="ui-old">color: #3b82f6</span></code> instead of <code class="ui-code"><span class="ui-token">var(--color-primary)</span></code>.
            It creates a new button instead of importing yours.
            It ignores your naming conventions.
          </p>
          <p class="ab-strong">The code works. It passes review. But your design system is slowly becoming irrelevant.</p>
        </div>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Our solution</h2></div>
        <ol class="ui-steps ab-steps">
          <li><span class="ui-step-n">1</span><div><h3>Find</h3><p>Scan your codebase. Get every issue with exact file, line, and suggested fix.</p></div></li>
          <li><span class="ui-step-n">2</span><div><h3>Fix</h3><p>One command applies all safe fixes. Watch dozens of files update in seconds.</p></div></li>
          <li><span class="ui-step-n">3</span><div><h3>Measure</h3><p>See your coverage improve. Prove ROI to leadership with real data.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>What we believe</h2></div>
        <dl class="ab-values">
          {values.map((value) => (
            <div><dt>{value.title}</dt><dd>{value.description}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Where we're headed</h2></div>
        <table class="ui-table ab-road">
          <tbody>
            {timeline.map((item, index) => (
              <tr>
                <th scope="row" class={index === 0 ? 'ui-c-ok' : index === 1 ? 'ui-c-buoy' : 'ui-c-lavender'}>{item.phase}</th>
                <td><strong>{item.title}</strong><span>{item.description}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Learn more</h2></div>
        <div class="ab-learn">
          <LeadMagnetCallout
            leadMagnet="why-developers-bypass"
            headline="Why developers bypass design systems"
            subhead="Understanding the real reasons helps you fix the problem. Research-backed insights."
            buttonText="Get the Report"
          />
          <article class="ui-card ui-card--pad">
            <p class="ui-eyebrow">Open research</p>
            <h3 class="ab-h3">Buoy accuracy research</h3>
            <p>Follow the benchmark methodology, current limitations, and evidence we require before publishing industry claims.</p>
            <div class="ui-actions ab-mt"><Button href="/state-of-design-systems" variant="secondary">Read the methodology</Button></div>
          </article>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head ui-head--center">
          <h2>Ready to catch design drift?</h2>
          <p>One command. 2 minutes. No signup required.</p>
        </div>
        <div class="ui-actions ab-center">
          <Button href="/demo" size="lg">Get started</Button>
          <Button href={siteConfig.githubUrl} variant="secondary" size="lg" external>View on GitHub</Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .ab-story { display: grid; gap: 18px; font-size: 17px; }
  .ab-story p { margin: 0; }
  .ab-strong { color: var(--color-ink); font-weight: 600; }
  .ab-steps { margin-top: 40px; }
  .ab-values { margin: 40px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; border-top: 1px solid var(--color-line-strong); }
  .ab-values > div { padding: 20px 0; border-bottom: 1px solid var(--color-line); }
  .ab-values dt { font-family: var(--font-display); font-weight: 600; font-size: 19px; color: var(--color-ink); }
  .ab-values dd { margin: 6px 0 0; }
  @media (max-width: 760px) { .ab-values { grid-template-columns: minmax(0, 1fr); } }
  .ab-road { margin-top: 36px; max-width: 760px; }
  .ab-road th { width: 96px; font-weight: 600; font-size: 14px; text-transform: none; letter-spacing: 0; vertical-align: top; }
  .ab-road td { display: grid; gap: 2px; }
  .ab-road strong { color: var(--color-ink); }
  .ab-road span { font-size: 14.5px; color: var(--color-muted); }
  .ab-learn { margin-top: 40px; display: grid; gap: 24px; }
  .ab-h3 { margin: 4px 0 8px; font-size: var(--text-h3); color: var(--color-ink); }
  .ab-mt { margin-top: 20px; }
  .ab-center { justify-content: center; margin-top: 28px; }
</style>
