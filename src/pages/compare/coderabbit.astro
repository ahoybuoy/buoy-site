---
import CompareLayout from '../../layouts/CompareLayout.astro'

const comparison = [
  { aspect: 'Focus', coderabbit: 'Code quality, bugs, security', buoy: 'Design system compliance' },
  { aspect: 'Knows', coderabbit: 'General best practices', buoy: 'Your specific tokens and patterns' },
  { aspect: 'Catches', coderabbit: 'Logic errors, security issues', buoy: '#3b82f6 instead of --color-primary' },
  { aspect: 'Output', coderabbit: 'PR comments', buoy: 'PR comments with token suggestions' },
  { aspect: 'Learning', coderabbit: 'General code patterns', buoy: 'Your design system rules' },
  { aspect: 'Integration', coderabbit: 'Standalone', buoy: 'Exports rules to CodeRabbit' },
]
---

<CompareLayout
  title="Buoy vs CodeRabbit | Design System Compliance for AI Code Review"
  description="CodeRabbit reviews your code. Buoy teaches it your design system. Use both together for complete coverage."
  keywords="coderabbit design system, ai code review, design tokens"
  heroTitle="Buoy + CodeRabbit = Design System Compliance"
  heroDescription="CodeRabbit reviews your code. Buoy teaches it your design system."
  competitor="CodeRabbit"
>
  <div slot="hero" class="ui-tray"><div class="ui-panel">
    <div class="ui-panel-head">Button.tsx</div>
    <pre class="hf-code"><code>const styles = {'{'}
  color: <span class="ui-old">'#3b82f6'</span>,
{'}'}</code></pre>
    <dl class="hf-rows">
      <div><dt>CodeRabbit</dt><dd class="hf-them">Knows: "This code has issues."</dd></div>
      <div><dt class="ui-c-buoy">Buoy</dt><dd>Knows: <span class="ui-old">#3b82f6</span> should be <span class="ui-token">var(--color-primary)</span> in YOUR codebase.</dd></div>
    </dl>
  </div></div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>Feature comparison</h2>
        <p>CodeRabbit reviews code in general. Buoy brings your specific tokens and patterns.</p>
      </div>
      <table class="ui-table cmp-table mt-10">
        <thead><tr><th scope="col">Aspect</th><th scope="col">CodeRabbit</th><th scope="col" class="cmp-buoy">Buoy</th></tr></thead>
        <tbody>
          {comparison.map((row) => (
            <tr><th scope="row">{row.aspect}</th><td class="cmp-them">{row.coderabbit}</td><td class="cmp-buoy">{row.buoy}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What each tool catches</h2></div>
      <div class="ui-cols">
        <article class="ui-col">
          <h3>CodeRabbit catches</h3>
          <ul class="ui-ruled">
            <li>Unused variables</li>
            <li>Security vulnerabilities</li>
            <li>Performance issues</li>
            <li>Code style issues</li>
          </ul>
        </article>
        <article class="ui-col">
          <h3 class="ui-c-buoy">Buoy catches</h3>
          <ul class="ui-ruled">
            <li>Hardcoded colors: <span class="ui-old">#ff0000</span> <span class="ui-token">var(--color-error)</span></li>
            <li>Magic numbers: <span class="ui-old">padding: 17px</span> <span class="ui-token">var(--spacing-4)</span></li>
            <li>Tailwind arbitrary values: <span class="ui-old">p-[13px]</span> <span class="ui-token">p-4</span></li>
            <li>Component naming drift</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap ui-split">
      <div class="ui-head">
        <h2>Better together</h2>
        <p>CodeRabbit is great at code review. Export your design system rules to it and it reviews against your tokens too.</p>
      </div>
      <div class="ui-tray"><div class="ui-term">
        <div class="ui-term-bar">Terminal</div>
        <pre><code><span class="ui-t-dim"># Export rules in CodeRabbit format</span>
<span class="ui-t-prompt">$</span> buoy show health --format json

<span class="ui-t-dim"># This generates .coderabbit.yaml rules that teach</span>
<span class="ui-t-dim"># CodeRabbit your design tokens</span></code></pre>
      </div></div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>How it works</h2></div>
      <ol class="ui-steps">
        <li><span class="ui-step-n">1</span><div><h3>Buoy scans</h3><p>Your design system (tokens, components, patterns)</p></div></li>
        <li><span class="ui-step-n">2</span><div><h3>Buoy exports</h3><p>Rules in CodeRabbit's format</p></div></li>
        <li><span class="ui-step-n">3</span><div><h3>CodeRabbit enforces</h3><p>Your design system in every PR</p></div></li>
      </ol>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap ui-split">
      <div class="ui-head">
        <h2>Already using CodeRabbit?</h2>
        <p>Add Buoy in 2 minutes. Your design system is now part of every code review.</p>
      </div>
      <div class="ui-tray"><div class="ui-term">
        <div class="ui-term-bar">Terminal</div>
        <pre><code><span class="ui-t-prompt">$</span> npx ahoybuoy dock
<span class="ui-t-prompt">$</span> buoy show health --format json</code></pre>
      </div></div>
    </div>
  </section>
</CompareLayout>

<style is:global>
  .hf-code { margin: 0; padding: 18px 20px; font-size: 13px; line-height: 1.7; background: var(--color-term); color: var(--color-body); }
  .hf-rows { margin: 0; border-top: 1px solid var(--color-line); }
  .hf-rows > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 13px 20px; border-bottom: 1px solid var(--color-line); font-size: 14px; line-height: 1.5; }
  .hf-rows > div:last-child { border-bottom: 0; }
  .hf-rows dt { font-weight: 600; color: var(--color-ink); }
  .hf-rows dd { margin: 0; color: var(--color-ink); }
  .hf-rows dd.hf-them { color: var(--color-muted); }
</style>
