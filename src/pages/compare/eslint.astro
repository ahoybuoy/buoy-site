---
import CompareLayout from '../../layouts/CompareLayout.astro'

const comparison = [
  { aspect: 'Primary use', eslint: 'Code quality and syntax', buoy: 'Design system drift' },
  { aspect: 'Context awareness', eslint: 'Code patterns only', buoy: 'Understands design tokens' },
  { aspect: 'Hardcoded colors', eslint: 'No detection', buoy: 'Full detection with suggestions' },
  { aspect: 'Duplicate components', eslint: 'No detection', buoy: 'Semantic duplicate finding' },
  { aspect: 'Design tokens', eslint: 'No understanding', buoy: 'Maps to your tokens' },
  { aspect: 'Adoption metrics', eslint: 'None', buoy: 'Full coverage stats' },
  { aspect: 'Configuration', eslint: 'Complex rule setup', buoy: 'Works out of the box' },
  { aspect: 'Use together?', eslint: 'Yes', buoy: 'Yes, they complement each other' },
]
---

<CompareLayout
  title="Buoy vs ESLint | Design System Context Awareness"
  description="ESLint catches syntax errors. Buoy understands design system context, detecting semantic drift ESLint can't see."
  keywords="eslint design system, eslint alternative, semantic code analysis"
  heroTitle="ESLint for Code Quality, Buoy for Design"
  heroDescription="ESLint catches code quality issues. Buoy catches design system drift. Use both together."
  competitor="ESLint"
>
  <div slot="hero" class="ui-tray"><div class="ui-panel">
    <div class="ui-panel-head">Card.tsx</div>
    <pre class="hf-code"><code>&lt;div style={'{{'} color: <span class="ui-old">'#3b82f6'</span> {'}}'} /&gt;</code></pre>
    <dl class="hf-rows">
      <div><dt>ESLint</dt><dd class="hf-them">Valid JavaScript. Nothing to report.</dd></div>
      <div><dt class="ui-c-buoy">Buoy</dt><dd><span class="ui-sev ui-sev-warning">Warning</span> Hardcoded color, use <span class="ui-token">var(--primary)</span></dd></div>
    </dl>
  </div></div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>The key difference</h2>
        <p>ESLint asks: <span class="ui-c-warn">"Is this valid JavaScript?"</span></p>
        <p>Buoy asks: <span class="ui-c-buoy">"Does this follow your design system?"</span></p>
      </div>
      <table class="ui-table cmp-table mt-10">
        <thead>
          <tr><th scope="col">Aspect</th><th scope="col">ESLint</th><th scope="col" class="cmp-buoy">Buoy</th></tr>
        </thead>
        <tbody>
          {comparison.map((row) => (
            <tr><th scope="row">{row.aspect}</th><td class="cmp-them">{row.eslint}</td><td class="cmp-buoy">{row.buoy}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>What ESLint can't catch</h2>
        <p>Hardcoded colors are only the start. Both of these pass ESLint too. Buoy flags each one against your design system.</p>
      </div>
      <div class="cmp-eslint-grid mt-10">
        <div class="ui-tray"><div class="ui-term">
          <div class="ui-term-bar">Duplicate components</div>
          <pre><code><span class="ui-t-ok">ESLint: valid exports</span>
<span class="ui-t-warn">Buoy: 4 Button implementations found</span>
export {'{'} Button {'}'} from './Button'
export {'{'} ButtonNew {'}'} from './ButtonNew'
export {'{'} MyButton {'}'} from './MyButton'</code></pre>
        </div></div>
        <div class="ui-tray"><div class="ui-term">
          <div class="ui-term-bar">Token usage</div>
          <pre><code><span class="ui-t-ok">ESLint: valid CSS</span>
<span class="ui-t-warn">Buoy: 16px instead of --spacing-md</span>
padding: <span class="ui-old">16px</span>; <span class="ui-t-dim">/* use</span> <span class="ui-token">var(--spacing-md)</span> <span class="ui-t-dim">*/</span></code></pre>
        </div></div>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap ui-split">
      <div class="ui-head">
        <h2>Use both together</h2>
        <p>ESLint and Buoy are complementary. ESLint catches code quality issues. Buoy catches design system drift. Run both in your CI pipeline.</p>
      </div>
      <div class="ui-tray"><div class="ui-panel">
        <div class="ui-panel-head">.github/workflows/ci.yml</div>
        <pre class="cmp-yaml"><code>- name: Lint
  run: npm run lint        <span class="ui-t-dim"># ESLint</span>

- name: Design Drift Check
  run: npx ahoybuoy drift  <span class="ui-t-dim"># Buoy</span></code></pre>
      </div></div>
    </div>
  </section>
</CompareLayout>

<style is:global>
  .hf-code { margin: 0; padding: 18px 20px; font-size: 13px; line-height: 1.7; background: var(--color-term); color: var(--color-body); }
  .hf-rows { margin: 0; border-top: 1px solid var(--color-line); }
  .hf-rows > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 13px 20px; border-bottom: 1px solid var(--color-line); font-size: 14px; line-height: 1.5; }
  .hf-rows > div:last-child { border-bottom: 0; }
  .hf-rows dt { font-weight: 600; color: var(--color-ink); }
  .hf-rows dd { margin: 0; color: var(--color-ink); }
  .hf-rows dd.hf-them { color: var(--color-muted); }
</style>
<style>
  .cmp-eslint-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 20px; }
  .cmp-yaml { margin: 0; padding: 18px 20px; font-size: 13px; line-height: 1.7; background: var(--color-term); color: var(--color-body); }
</style>
