---
import CompareLayout from '../../layouts/CompareLayout.astro'

const comparison = [
  { aspect: 'What it detects', percy: 'Visual changes in screenshots', buoy: 'Structural drift in code' },
  { aspect: 'Detection method', percy: 'Pixel-level comparison', buoy: 'AST code analysis' },
  { aspect: 'Scope', percy: 'Rendered pages/components', buoy: 'Entire codebase' },
  { aspect: 'Hardcoded values', percy: 'Not detected', buoy: 'Detected with suggestions' },
  { aspect: 'Duplicate components', percy: 'Not detected', buoy: 'Semantic detection' },
  { aspect: 'Token coverage', percy: 'Not tracked', buoy: 'Full metrics' },
  { aspect: 'Requires rendering', percy: 'Yes (browser/CI)', buoy: 'No (static analysis)' },
  { aspect: 'Speed', percy: 'Minutes (rendering + upload)', buoy: 'Seconds (local scan)' },
  { aspect: 'Free tier', percy: '5,000 snapshots/mo', buoy: 'Unlimited (CLI)' },
]
---

<CompareLayout
  title="Buoy vs Percy | Structural vs Visual Drift Detection"
  description="Percy catches visual regressions via screenshots. Buoy scans your codebase for structural design drift. Different problems, different solutions."
  keywords="percy alternative, visual regression alternative, design system testing, browserstack percy"
  heroTitle="Pixel Diffs vs Code Analysis"
  heroDescription="Percy catches pixel-level visual changes. Buoy catches structural drift in your code. They solve different problems."
  competitor="Percy"
>
  <div slot="hero" class="ui-tray"><div class="ui-panel">
    <div class="ui-panel-head">Card.css</div>
    <pre class="hf-code"><code>.card {'{'}
  padding: <span class="ui-old">16px</span>;
{'}'}</code></pre>
    <dl class="hf-rows">
      <div><dt>Percy</dt><dd class="hf-them">Identical screenshot. No diff.</dd></div>
      <div><dt class="ui-c-buoy">Buoy</dt><dd><span class="ui-sev ui-sev-warning">Warning</span> <span class="ui-old">16px</span> bypasses the token, use <span class="ui-token">spacing-4</span></dd></div>
    </dl>
  </div></div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-cols">
        <article class="ui-col">
          <h3>Percy answers</h3>
          <p class="ui-col-sub">"Did the visual appearance of my UI change?"</p>
          <ul class="ui-ruled">
            <li>Pixel-level screenshot comparison</li>
            <li>Requires rendering in a browser</li>
            <li>Great for catching visual regressions</li>
          </ul>
        </article>
        <article class="ui-col">
          <h3 class="ui-c-buoy">Buoy answers</h3>
          <p class="ui-col-sub">"Is my codebase following the design system?"</p>
          <ul class="ui-ruled">
            <li>Static code analysis</li>
            <li>No rendering required</li>
            <li>Great for catching design drift</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Feature comparison</h2></div>
      <table class="ui-table cmp-table mt-10">
        <thead><tr><th scope="col">Aspect</th><th scope="col">Percy</th><th scope="col" class="cmp-buoy">Buoy</th></tr></thead>
        <tbody>
          {comparison.map((row) => (
            <tr><th scope="row">{row.aspect}</th><td class="cmp-them">{row.percy}</td><td class="cmp-buoy">{row.buoy}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What Percy misses</h2></div>
      <ul class="ui-ruled ui-ruled--top cmp-list">
        <li><strong>Hardcoded values that render correctly.</strong> <code class="ui-old">#3b82f6</code> and <code class="ui-token">var(--primary)</code> render as the same blue pixel. Percy sees identical screenshots. Buoy knows one bypasses your design system.</li>
        <li><strong>Code that's never rendered.</strong> Conditional components, error states, and edge cases might not get screenshot coverage. Buoy scans all code paths, rendered or not.</li>
        <li><strong>Duplicate component implementations.</strong> Two components that look identical in screenshots might be completely separate implementations. Percy can't tell. Buoy identifies them as candidates for consolidation.</li>
      </ul>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Speed comparison</h2></div>
      <div class="ui-cols">
        <article class="ui-col">
          <h3>Percy</h3>
          <p class="cmp-big ui-tnum">2-10 minutes</p>
          <p class="ui-col-sub">Per CI run. Render pages, take screenshots, upload to cloud, compare, return results.</p>
        </article>
        <article class="ui-col">
          <h3 class="ui-c-buoy">Buoy</h3>
          <p class="cmp-big ui-tnum ui-c-ok">5-30 seconds</p>
          <p class="ui-col-sub">Local or CI. Scan code, analyze AST, report issues.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>Better together</h2>
        <p>Percy and Buoy solve different problems. Use Percy to catch unintended visual changes. Use Buoy to ensure your code follows design system patterns.</p>
      </div>
      <table class="ui-table cmp-table mt-10">
        <thead><tr><th scope="col">Use it when</th><th scope="col">Percy</th><th scope="col" class="cmp-buoy">Buoy</th></tr></thead>
        <tbody>
          <tr><th scope="row">Goal</th><td class="cmp-them">You need to catch unintended visual changes</td><td class="cmp-buoy">You need to enforce design system usage</td></tr>
          <tr><th scope="row">Finding</th><td class="cmp-them">You're doing cross-browser testing</td><td class="cmp-buoy">You want to find hardcoded values</td></tr>
          <tr><th scope="row">Output</th><td class="cmp-them">You want screenshot documentation</td><td class="cmp-buoy">You're measuring token adoption</td></tr>
          <tr><th scope="row">Timing</th><td class="cmp-them">You're testing responsive layouts</td><td class="cmp-buoy">You want fast feedback in development</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</CompareLayout>

<style>
  .cmp-list > li { color: var(--color-body); max-width: 760px; }
  .cmp-list strong { color: var(--color-ink); }
  .cmp-big { margin: 12px 0 4px; font-family: var(--font-display); font-size: 40px; line-height: 1.1; font-weight: 700; color: var(--color-ink); }
</style>

<style is:global>
  .hf-code { margin: 0; padding: 18px 20px; font-size: 13px; line-height: 1.7; background: var(--color-term); color: var(--color-body); }
  .hf-rows { margin: 0; border-top: 1px solid var(--color-line); }
  .hf-rows > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 13px 20px; border-bottom: 1px solid var(--color-line); font-size: 14px; line-height: 1.5; }
  .hf-rows > div:last-child { border-bottom: 0; }
  .hf-rows dt { font-weight: 600; color: var(--color-ink); }
  .hf-rows dd { margin: 0; color: var(--color-ink); }
  .hf-rows dd.hf-them { color: var(--color-muted); }
</style>
