---
import CompareLayout from '../../layouts/CompareLayout.astro'

const comparison = [
  { aspect: 'Focus', greptile: 'Codebase understanding', buoy: 'Design system compliance' },
  { aspect: 'Strength', greptile: 'Semantic code search, context', buoy: 'Token matching, pattern detection' },
  { aspect: 'Learns from', greptile: 'Your entire codebase', buoy: 'Your design tokens and components' },
  { aspect: 'Reviews', greptile: 'Code logic and patterns', buoy: 'Design consistency' },
  { aspect: 'Adapts via', greptile: 'Developer feedback (thumbs up/down)', buoy: 'Token definitions and config' },
  { aspect: 'Integration', greptile: 'Reads CLAUDE.md automatically', buoy: 'Writes to CLAUDE.md' },
]
---

<CompareLayout
  title="Buoy vs Greptile | Codebase-Aware Design Reviews"
  description="Greptile understands your codebase. Buoy adds design system expertise. Together: reviews that understand both your code AND your design system."
  keywords="greptile design system, ai code review, codebase context"
  heroTitle="Buoy + Greptile = Codebase-Aware Design Reviews"
  heroDescription="Greptile understands your codebase. Buoy adds design system expertise."
  competitor="Greptile"
>
  <div slot="hero" class="ui-tray"><div class="ui-panel">
    <div class="ui-panel-head">CLAUDE.md</div>
    <pre class="hf-code"><code><span class="ui-t-dim">## Design system</span>
<span class="ui-t-dim">Use tokens, not raw values:</span>
<span class="ui-old">#3b82f6</span> <span class="ui-t-dim">-&gt;</span> <span class="ui-token">var(--color-primary)</span></code></pre>
    <dl class="hf-rows">
      <div><dt>Greptile</dt><dd class="hf-them">Builds a semantic graph of your codebase. Reads CLAUDE.md automatically.</dd></div>
      <div><dt class="ui-c-buoy">Buoy</dt><dd>Writes design system context into CLAUDE.md with <code class="ui-code">buoy onboard</code>.</dd></div>
    </dl>
  </div></div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>Feature comparison</h2>
        <p>Greptile builds a semantic graph of your codebase. Buoy adds <span class="ui-c-buoy">design system context to that graph</span>.</p>
      </div>
      <table class="ui-table cmp-table mt-10">
        <thead><tr><th scope="col">Aspect</th><th scope="col">Greptile</th><th scope="col" class="cmp-buoy">Buoy</th></tr></thead>
        <tbody>
          {comparison.map((row) => (
            <tr><th scope="row">{row.aspect}</th><td class="cmp-them">{row.greptile}</td><td class="cmp-buoy">{row.buoy}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What each tool catches</h2></div>
      <div class="ui-cols">
        <article class="ui-col">
          <h3>Greptile catches</h3>
          <ul class="ui-ruled">
            <li>Logic inconsistencies</li>
            <li>Broken patterns</li>
            <li>Missing error handling</li>
            <li>Code that contradicts existing patterns</li>
          </ul>
        </article>
        <article class="ui-col">
          <h3 class="ui-c-buoy">Buoy catches</h3>
          <ul class="ui-ruled">
            <li>Hardcoded design values</li>
            <li>Token misuse</li>
            <li>Component drift</li>
            <li>Design system anti-patterns</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>The Greptile + Buoy workflow</h2></div>
      <table class="ui-table ui-table--stack mt-8">
        <tbody>
          <tr><th scope="row">Greptile learns from your team</th><td>Watches which comments get thumbs up/down, learns from developer replies, adapts to your preferences.</td></tr>
          <tr><th scope="row" class="ui-c-buoy">Buoy adds design expertise</th><td>Knows your exact token values, tracks component patterns, flags design system drift.</td></tr>
        </tbody>
      </table>
      <p class="ui-after mt-8">Together: <span class="ui-c-buoy">reviews that understand both your code AND your design system.</span></p>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split">
      <div class="ui-head">
        <h2>Already using Greptile?</h2>
        <p>Add Buoy context in seconds. Greptile automatically reads <code class="ui-code">CLAUDE.md</code>, <code class="ui-code">.cursorrules</code> and <code class="ui-code">agents.md</code>, so your design system becomes part of its context.</p>
      </div>
      <div class="ui-tray"><div class="ui-term">
        <div class="ui-term-bar">Terminal</div>
        <pre><code><span class="ui-t-dim"># Option 1: Update CLAUDE.md (Greptile reads this)</span>
<span class="ui-t-prompt">$</span> npx ahoybuoy dock
<span class="ui-t-prompt">$</span> buoy onboard

<span class="ui-t-dim"># Option 2: Export dedicated Greptile config</span>
<span class="ui-t-prompt">$</span> buoy show health --format json &gt; greptile-buoy.json</code></pre>
      </div></div>
    </div>
  </section>
</CompareLayout>

<style is:global>
  .hf-code { margin: 0; padding: 18px 20px; font-size: 13px; line-height: 1.7; background: var(--color-term); color: var(--color-body); }
  .hf-rows { margin: 0; border-top: 1px solid var(--color-line); }
  .hf-rows > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 13px 20px; border-bottom: 1px solid var(--color-line); font-size: 14px; line-height: 1.5; }
  .hf-rows > div:last-child { border-bottom: 0; }
  .hf-rows dt { font-weight: 600; color: var(--color-ink); }
  .hf-rows dd { margin: 0; color: var(--color-ink); }
  .hf-rows dd.hf-them { color: var(--color-muted); }
</style>
