---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import LeadMagnetForm from '../components/LeadMagnetForm.astro'
import MarkPattern from '../components/MarkPattern.astro'

const reasons = [
  "They can't find what they need",
  "The system doesn't cover their case",
  'Using the system is harder than not',
  'The system slows them down',
  "They don't know it exists",
  "It doesn't match how they work",
  'Nobody enforces it',
]
const learn = [
  { title: 'Root Cause Analysis', desc: 'Why bypass happens, with real examples from production codebases' },
  { title: 'Practical Fixes', desc: 'Specific solutions for each of the 7 reasons' },
  { title: 'The Adoption Equation', desc: 'A framework for measuring and improving adoption' },
  { title: 'Improvement Framework', desc: '5-step process for continuous improvement' },
]
const who = [
  { title: 'Design System Teams', desc: 'Understand why adoption stalls and how to fix it' },
  { title: 'Engineering Leads', desc: 'Build a culture of consistency without being the bad guy' },
  { title: 'Frontend Developers', desc: 'Advocate for changes that make the system easier to use' },
]
---

<Layout
  title="Why Developers Bypass Your Design System | Free Guide | Buoy"
  description="7 reasons developers go off-system, and what to do about it. Hint: it's not their fault."
>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="field" drift={0.25} class="ui-pattern lp-pat-side" />
      <div class="ui-wrap ui-split lm-hero">
        <div>
          <p class="ui-eyebrow">Free ebook</p>
          <div class="ui-head"><h1>Why Developers Bypass Your Design System</h1></div>
          <p class="ui-lede">You built the system. You documented it. Six months later, your codebase is full of hardcoded values. Here's why, and what to do about it.</p>
          <div class="lm-form"><LeadMagnetForm leadMagnet="why-developers-bypass" buttonText="Get the Guide" successMessage="Check your email for the download!" /></div>
          <p class="ui-note">No spam. Unsubscribe anytime.</p>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-tray">
            <div class="ui-panel">
              <div class="ui-panel-head"><span>The 7 reasons</span></div>
              <ol class="lm-list">
                {reasons.map((r, i) => <li><span class="lm-n ui-tnum">{i + 1}</span>{r}</li>)}
              </ol>
              <p class="lm-foot"><span class="ui-c-ok">+ Solutions</span> for each problem</p>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <blockquote class="lm-quote">
          <p>"Developers bypass design systems because of friction, gaps, and invisibility. These are <span class="ui-c-ok">system problems</span>, not people problems."</p>
          <footer>The goal isn't compliance. It's making compliance effortless.</footer>
        </blockquote>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>What you'll learn</h2></div>
        <ol class="wb-learn">
          {learn.map((l, i) => <li><span class="wb-n ui-tnum">0{i + 1}</span><h3>{l.title}</h3><p>{l.desc}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Who this is for</h2></div>
        <table class="ui-table lm-table">
          <tbody>{who.map((w) => <tr><th scope="row">{w.title}</th><td>{w.desc}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head"><h2>Get the guide</h2><p>2,000 words. 7 problems. 7 solutions. Free.</p></div>
          <div><LeadMagnetForm leadMagnet="why-developers-bypass" idSuffix="end" buttonText="Send It to Me" successMessage="Done! Check your inbox." /><p class="ui-note">No spam. Unsubscribe anytime.</p></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 72%); mask-image: linear-gradient(100deg, transparent 38%, #000 72%); }
  @media (max-width: 960px) { :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); } }

  .lm-hero { align-items: center; }
  .lm-form { margin-top: 32px; max-width: 480px; }
  .lm-list { list-style: none; margin: 0; padding: 0; }
  .lm-list li { display: flex; gap: 14px; align-items: baseline; padding: 12px 18px; border-top: 1px solid var(--color-line); color: var(--color-ink); font-size: 15px; }
  .lm-list li:first-child { border-top: 0; }
  .lm-n { font-family: var(--font-display); font-weight: 700; color: var(--color-buoy-light); width: 1ch; }
  .lm-foot { margin: 0; padding: 12px 18px; border-top: 1px solid var(--color-line); font-size: 14px; color: var(--color-muted); }
  .lm-table { margin-top: 32px; }
  .lm-quote { margin: 0 auto; max-width: 820px; text-align: center; }
  .lm-quote p { margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: 1.3; font-weight: 600; color: var(--color-ink); text-wrap: balance; }
  .lm-quote footer { margin-top: 16px; color: var(--color-muted); font-size: 15px; }
  .ui-col h3 { font-size: 1.125rem; }
  .ui-col p { margin-top: 8px; color: var(--color-body); font-size: 15px; }
  .wb-learn { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 56px; border-top: 1px solid var(--color-line-strong); }
  .wb-learn li { padding: 24px 0; border-bottom: 1px solid var(--color-line); }
  .wb-n { font-family: var(--font-mono); font-size: 13px; color: var(--color-ok); }
  .wb-learn h3 { margin: 8px 0 0; font-size: 1.25rem; }
  .wb-learn p { margin: 6px 0 0; color: var(--color-body); }
  @media (max-width: 760px) { .wb-learn { grid-template-columns: minmax(0, 1fr); } }
</style>
