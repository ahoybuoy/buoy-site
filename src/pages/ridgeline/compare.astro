---
/**
 * Two sites' ridgelines side by side: /ridgeline/compare?a=stripe.com&b=linear.app
 * Reads the latest public ridgeline of each; a site without one gets a link to make it.
 */
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import MarkPattern from '../../components/MarkPattern.astro'
---

<Layout title="Compare two sites as ridgelines | Buoy" description="Two websites side by side as ridgelines: rhythm, density, and how many button looks each one uses.">
  <Nav />
  <main class="ui-nav-offset">
  <section class="ui-section ui-section--first ui-section--last !pt-12 ui-section--patterned">
    <MarkPattern pattern="wake" drift={0.3} fade class="ui-pattern !opacity-[0.1]" />
    <div class="ui-wrap">
      <a href="/ridgeline" class="ui-rowlink text-sm">← All ridgelines</a>
      <h1 class="mt-5 text-[length:var(--text-h1)] leading-[1.05]">Compare two sites</h1>
      <p class="ui-lede mt-3 max-w-2xl">Two websites side by side as ridgelines: rhythm, density, and how many button looks each one uses.</p>
      <form id="cmp" class="ui-scan mt-8 max-w-[760px]">
        <label for="cmp-a" class="ui-sr">First site</label>
        <input id="cmp-a" name="a" placeholder="stripe.com" autocomplete="off" class="max-sm:!flex-none max-sm:border-b max-sm:border-[var(--color-line)]" />
        <span aria-hidden="true" class="hidden sm:block self-center text-[var(--color-muted)] text-sm px-1">vs</span>
        <label for="cmp-b" class="ui-sr">Second site</label>
        <input id="cmp-b" name="b" placeholder="linear.app" autocomplete="off" class="max-sm:!flex-none" />
        <button class="ui-btn ui-btn--primary">Compare</button>
      </form>
      <p class="ui-note mt-4">Try <a class="ui-rowlink" href="/ridgeline/compare?a=stripe.com&b=linear.app">stripe.com vs linear.app</a></p>
      <div id="cmp-out" class="grid gap-4 mt-10" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
        {['First site', 'Second site'].map((label) => (
          <div class="h-40 sm:h-auto sm:aspect-[5/6] sm:max-h-[520px] rounded-[var(--radius-card)] bg-[var(--color-term)] shadow-[var(--ring-term)] grid place-items-center text-sm text-[var(--color-muted)]">{label}</div>
        ))}
      </div>
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<script>
  import { API, draw, prepare, type RidgelineData } from '../../scripts/ridgeline'

  const params = new URLSearchParams(location.search)
  const form = document.getElementById('cmp') as HTMLFormElement
  const a = form.querySelector<HTMLInputElement>('#cmp-a')!
  const b = form.querySelector<HTMLInputElement>('#cmp-b')!
  a.value = params.get('a') ?? ''
  b.value = params.get('b') ?? ''
  const out = document.getElementById('cmp-out')!

  async function card(site: string): Promise<HTMLElement> {
    const box = document.createElement('figure')
    box.className = 'rounded-[var(--radius-card)] bg-[var(--color-term)] shadow-[var(--ring-term)] p-3 m-0'
    const cap = document.createElement('figcaption')
    cap.className = 'flex justify-between gap-2 text-sm text-[var(--color-muted)] pt-3 ui-tnum'
    try {
      const res = await fetch(`${API}/public/ridgeline?url=${encodeURIComponent(site)}`)
      if (!res.ok) throw new Error('none')
      const v = await res.json() as { result: RidgelineData }
      const d = v.result
      const cv = document.createElement('canvas')
      cv.width = 700
      cv.height = 840
      cv.className = 'w-full h-auto'
      draw(cv, d, prepare(d, 80), { components: true })
      const link = document.createElement('a')
      link.href = `/ridgeline/${d.host}`
      link.className = 'ui-rowlink'
      link.textContent = d.host
      const n = document.createElement('span')
      n.textContent = `${d.looks} button looks · ${d.rare} used once`
      cap.append(link, n)
      box.append(cv, cap)
    } catch {
      const p = document.createElement('p')
      p.className = 'text-sm text-[var(--color-muted)] p-6'
      p.append(`${site} has no ridgeline yet. `)
      const make = document.createElement('a')
      make.href = `/ridgeline/${site.replace(/^https?:\/\//, '').replace(/\/$/, '')}`
      make.className = 'ui-link'
      make.textContent = 'Make one'
      p.append(make)
      box.append(p)
    }
    return box
  }

  async function run() {
    const sites = [a.value.trim(), b.value.trim()].filter(Boolean)
    if (sites.length === 0) return
    out.replaceChildren(...await Promise.all(sites.map(card)))
  }
  form.addEventListener('submit', (ev) => {
    ev.preventDefault()
    const q = new URLSearchParams({ a: a.value.trim(), b: b.value.trim() })
    history.replaceState(null, '', `?${q}`)
    run()
  })
  run()
</script>
