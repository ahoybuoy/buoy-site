---
/**
 * buoy.design/ridgeline: type any website, get its ridgeline. Below the form,
 * the public wall of everyone's latest ridgelines (private ones never show).
 */
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import RidgelineForm from '../../components/RidgelineForm.astro'
import MarkPattern from '../../components/MarkPattern.astro'

// A placeholder ridgeline drawn at build time, so the hero is never an empty box
// while (or if) the live linear.app render loads.
let seed = 7
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280)
const W = 900, H = 1000, ROWS = 46, COLS = 60
const ridges = Array.from({ length: ROWS }, (_, r) => {
  const y0 = 120 + r * ((H - 200) / ROWS)
  const busy = Math.sin(r / 4.2) * 0.5 + 0.6
  const pts = Array.from({ length: COLS + 1 }, (_, c) => {
    const x = 60 + (c / COLS) * (W - 120)
    const mid = 1 - Math.abs(c / COLS - 0.5) * 2
    const h = Math.max(0, rand() * 46 * busy * mid ** 1.6 + (rand() > 0.93 ? 30 * mid : 0))
    return [x, y0 - h]
  })
  const d = 'M' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join(' L')
  const mark = rand() > 0.72 ? { x: pts[Math.floor(10 + rand() * 40)][0], y: y0, kind: rand() > 0.8 ? 'rare' : rand() > 0.5 ? 'button' : 'heading' } : null
  return { d, fill: `${d} L${W - 60} ${y0} L60 ${y0} Z`, mark }
})
const markColor: Record<string, string> = { button: '#43b0f1', rare: '#ff6b57', heading: '#e8b04a' }
---

<Layout title="Ridgeline: any website as one picture | Buoy" description="Type any website and see it as a ridgeline: every band of the page as one line, with its buttons, inputs and headings marked. Share it, or compare two sites.">
  <Nav />
  <main class="ui-nav-offset">
  <section class="ui-section ui-section--first ui-section--patterned">
    <MarkPattern pattern="wake" drift={0.3} fade class="ui-pattern !opacity-[0.12]" />
    <div class="ui-wrap grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-[length:var(--text-h1)] leading-[1.05]">Any website as one picture</h1>
        <p class="ui-lede mt-5 max-w-xl">
          Each line is a band of the page, top to bottom. Height is how much is happening there. Buttons, inputs and headings are marked, and button looks used only once show up in <span class="ui-c-crit">red</span>.
        </p>
        <div class="mt-8"><RidgelineForm id="ridge-hero" autofocus /></div>
        <p class="ui-note mt-4">Public pages only. Public ridgelines appear on the wall below; to remove one, email support@buoy.design.</p>
      </div>
      <figure class="ui-figure m-0">
        <a href="/ridgeline/linear.app" class="relative block rounded-[var(--radius-card)] bg-[var(--color-term)] shadow-[var(--ring-term)] overflow-hidden" aria-label="Example: linear.app">
          <svg id="ridge-hero-ph" viewBox={`0 0 ${W} ${H}`} class="absolute inset-0 w-full h-full" aria-hidden="true">
            {ridges.map((r) => (
              <g>
                <path d={r.fill} fill="var(--color-term)" />
                <path d={r.d} fill="none" stroke="#f1efe8" stroke-opacity="0.55" stroke-width="1.4" stroke-linejoin="round" />
                {r.mark && <rect x={r.mark.x} y={r.mark.y - 3} width="26" height="3" rx="1.5" fill={markColor[r.mark.kind]} />}
              </g>
            ))}
          </svg>
          <canvas id="ridge-hero-art" width="900" height="1000" class="relative block w-full h-auto"></canvas>
        </a>
        <figcaption class="flex justify-between gap-4 mt-3 text-sm text-[var(--color-muted)]">
          <span class="flex flex-wrap gap-x-4 gap-y-1">
            <span><i class="inline-block w-3.5 h-[3px] rounded-sm align-middle mr-1.5" style="background:#43b0f1"></i>button</span>
            <span><i class="inline-block w-3.5 h-[3px] rounded-sm align-middle mr-1.5" style="background:#ff6b57"></i>used once</span>
            <span><i class="inline-block w-3.5 h-[3px] rounded-sm align-middle mr-1.5" style="background:#2fbf8f"></i>input</span>
            <span><i class="inline-block w-3.5 h-[3px] rounded-sm align-middle mr-1.5" style="background:#e8b04a"></i>heading</span>
          </span>
          <a href="/ridgeline/linear.app" class="ui-rowlink shrink-0">linear.app →</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="ui-section ui-section--band ui-section--last">
    <div class="ui-wrap">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <h2 class="text-[length:var(--text-h2)]">The wall</h2>
        <a href="/ridgeline/compare" class="ui-link text-sm">Compare two sites →</a>
      </div>
      <div id="ridge-wall" class="grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr))">
        <p class="ui-note col-span-full" data-wall-empty>Loading the latest ridgelines…</p>
        {Array.from({ length: 6 }, (_, k) => (
          <div class="aspect-[360/450] rounded-[var(--radius-inner)] bg-[var(--color-term)] shadow-[var(--ring-term)] motion-safe:animate-pulse" style={`animation-delay:${k * 120}ms`} data-wall-ph></div>
        ))}
      </div>
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<script>
  import { API, drawThumb, draw, prepare, type RidgelineData } from '../../scripts/ridgeline'

  const wall = document.getElementById('ridge-wall')!
  type Item = { url: string; host: string; title: string; looks: number; rare: number; thumb: { data: string; bands: number; bins: number } | null }
  fetch(`${API}/public/ridgelines/recent?limit=48`).then((r) => r.json()).then((body: { items: Item[] }) => {
    const items = body.items.filter((i) => i.thumb)
    if (items.length === 0) {
      wall.querySelector('[data-wall-empty]')!.textContent = 'No ridgelines yet. Make the first one above.'
      wall.querySelectorAll('[data-wall-ph]').forEach((el) => el.remove())
      return
    }
    wall.replaceChildren(...items.map((i) => {
      const path = new URL(i.url).pathname
      const a = document.createElement('a')
      a.href = `/ridgeline/${i.host}${path === '/' ? '' : path}`
      a.className = 'block rounded-[var(--radius-inner)] bg-[var(--color-term)] shadow-[var(--ring-term)] p-2 transition-shadow hover:shadow-[var(--ring-hover)]'
      const cv = document.createElement('canvas')
      cv.width = 360
      cv.height = 420
      cv.className = 'w-full h-auto'
      drawThumb(cv, i.host, i.thumb!)
      const cap = document.createElement('div')
      cap.className = 'flex justify-between gap-2 text-xs text-[var(--color-muted)] pt-2 px-1 ui-tnum'
      const name = document.createElement('span')
      name.className = 'text-[var(--color-ink)] truncate'
      name.textContent = i.host + (path === '/' ? '' : path)
      const n = document.createElement('span')
      n.textContent = `${i.looks} looks`
      cap.append(name, n)
      a.append(cv, cap)
      return a
    }))
  }).catch(() => {
    wall.querySelector('[data-wall-empty]')!.innerHTML = 'The wall is unavailable right now. <a class="ui-rowlink" href="/ridgeline/linear.app">See linear.app</a> or make one above.'
    wall.querySelectorAll<HTMLElement>('[data-wall-ph]').forEach((el) => { el.classList.remove('motion-safe:animate-pulse'); el.style.opacity = '0.45' })
  })

  // Hero art: the newest linear.app ridgeline, if there is one.
  fetch(`${API}/public/ridgeline?url=linear.app`).then((r) => (r.ok ? r.json() : null)).then((v: { result: RidgelineData } | null) => {
    if (!v?.result) return
    const cv = document.getElementById('ridge-hero-art') as HTMLCanvasElement
    draw(cv, v.result, prepare(v.result, 80), { components: true })
    document.getElementById('ridge-hero-ph')?.remove()
  }).catch(() => {})
</script>
