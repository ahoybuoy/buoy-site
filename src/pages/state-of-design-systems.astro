---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'

const measures = [
  'Precision and false-positive rate by drift type',
  'High-confidence fix success and post-fix test results',
  'Token and component adoption across representative frameworks',
  'Which findings maintainers consider useful enough to act on',
]
---

<Layout
  title="Buoy Accuracy Benchmark | Research in Progress"
  description="Buoy is building a transparent, manually reviewed benchmark for design-system drift detection and safe fixes."
>
  <Nav />
  <main>
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-navy to-navy-dark"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-buoy/10 border border-buoy/30 rounded-full text-buoy text-sm mb-6">
          Research in progress
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold text-light mb-6">A benchmark we can defend</h1>
        <p class="text-xl text-slate max-w-2xl mx-auto mb-8">
          We are manually reviewing representative React, Tailwind, Vue, and monorepo projects before publishing accuracy or industry claims. Sample size, methodology, and limitations will ship with the results.
        </p>
        <Button href="https://github.com/ahoybuoy/buoy" external>Follow the open-source work →</Button>
      </div>
    </section>

    <section class="py-20 bg-navy">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <p class="text-buoy font-medium mb-3">What we will publish</p>
            <h2 class="text-3xl font-bold text-light mb-4">Product evidence, not decorative statistics</h2>
            <p class="text-slate">
              Repository-scale crash coverage is useful, but it is not the same as ground-truth accuracy. The public benchmark will separate automated coverage checks from manually annotated findings.
            </p>
          </div>
          <ul class="space-y-4">
            {measures.map((measure) => (
              <li class="flex items-start gap-3 bg-navy-dark border border-navy-light/20 rounded-xl p-5 text-slate">
                <span class="text-buoy">◆</span>
                <span>{measure}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="py-20 bg-navy-dark">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-light mb-4">Evaluate your own codebase now</h2>
        <p class="text-slate text-lg mb-8">Buoy can run locally today. Review the findings against your own design-system knowledge and tell us what is useful or noisy.</p>
        <div class="bg-navy border border-navy-light/30 rounded-xl p-5 mb-8 text-left">
          <code class="text-buoy">npx ahoybuoy show health</code>
        </div>
        <Button href="/contact" variant="secondary">Share benchmark feedback</Button>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
