---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import DocTerminal from '../components/DocTerminal.astro'
import MarkPattern from '../components/MarkPattern.astro'

const measures = [
  'Precision and false-positive rate by drift type',
  'High-confidence fix success and post-fix test results',
  'Token and component adoption across representative frameworks',
  'Which findings maintainers consider useful enough to act on',
]
---

<Layout
  title="Buoy Accuracy Benchmark | Research in Progress"
  description="Buoy is building a transparent, manually reviewed benchmark for design-system drift detection and safe fixes."
>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="scan" drift={0.25} class="ui-pattern lp-pat-side" />
      <div class="ui-wrap">
        <div class="ui-head">
          <p class="ui-eyebrow ui-c-buoy">Research in progress</p>
          <h1>A benchmark we can defend</h1>
          <p>We are manually reviewing representative React, Tailwind, Vue, and monorepo projects before publishing accuracy or industry claims. Sample size, methodology, and limitations will ship with the results.</p>
        </div>
        <div class="ui-actions">
          <a href="https://github.com/ahoybuoy/buoy" target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary">Follow the open-source work</a>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap ui-split">
        <div class="ui-head">
          <p class="ui-eyebrow ui-c-buoy">What we will publish</p>
          <h2>Product evidence, not decorative statistics</h2>
          <p>Repository-scale crash coverage is useful, but it is not the same as ground-truth accuracy. The public benchmark will separate automated coverage checks from manually annotated findings.</p>
        </div>
        <ul class="ui-ruled ui-ruled--top">
          {measures.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </section>

    <section class="ui-section ui-section--last">
      <div class="ui-wrap ui-split sd-mid">
        <div class="ui-head">
          <h2>Evaluate your own codebase now</h2>
          <p>Buoy can run locally today. Review the findings against your own design-system knowledge and tell us what is useful or noisy.</p>
          <div class="ui-actions"><a href="/contact" class="ui-btn ui-btn--secondary">Share benchmark feedback</a></div>
        </div>
        <DocTerminal command="npx ahoybuoy show health" />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 72%); mask-image: linear-gradient(100deg, transparent 38%, #000 72%); }
  @media (max-width: 960px) { :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); } }

  .sd-center { justify-content: center; }
  .sd-mid { align-items: center; }
</style>
