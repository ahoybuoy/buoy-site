---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import LeadMagnetForm from '../components/LeadMagnetForm.astro'
import MarkPattern from '../components/MarkPattern.astro'

const cats = [
  { title: 'Colors', count: '5 patterns' },
  { title: 'Spacing', count: '4 patterns' },
  { title: 'Typography', count: '4 patterns' },
  { title: 'Components', count: '5 patterns' },
  { title: 'CSS Smells', count: '4 patterns' },
]
const ref = [
  { issue: 'Hardcoded color', q: '"Can we use a token?"' },
  { issue: 'Arbitrary spacing', q: '"What\'s the closest scale value?"' },
  { issue: 'Inline styles', q: '"Can a prop or variant handle this?"' },
  { issue: '!important', q: '"What\'s causing the specificity issue?"' },
]
---

<Layout
  title="PR Review Cheat Sheet for Design Consistency | Free PDF | Buoy"
  description="Copy-paste comments to catch design drift in code reviews. What to look for and exactly what to say."
>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.25} class="ui-pattern lp-pat-side" />
      <div class="ui-wrap ui-split lm-hero">
        <div>
          <p class="ui-eyebrow">Free cheat sheet</p>
          <div class="ui-head"><h1>PR Review Cheat Sheet for Design Consistency</h1></div>
          <p class="ui-lede">What to look for in every PR. Exactly what to say when you find it. Copy-paste comments that catch drift before it ships.</p>
          <div class="lm-form"><LeadMagnetForm leadMagnet="pr-review-cheatsheet" buttonText="Get the Cheat Sheet" successMessage="Check your email for the download!" /></div>
          <p class="ui-note">No spam. Unsubscribe anytime.</p>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-tray">
            <div class="ui-panel">
              <div class="ui-panel-head"><span class="ui-mono">src/components/Banner.tsx</span></div>
              <div class="pr-diff ui-mono">
                <div><span class="pr-ln">41</span>{'  <div style={{'}</div>
                <div class="pr-add"><span class="pr-ln">42</span>{'+   background: "#3a81f5",'}</div>
              </div>
              <div class="pr-comment">
                <p class="pr-who">Review comment on line <span class="ui-tnum">42</span></p>
                <p>This looks like a <span class="ui-c-crit">hardcoded color</span>. Can we use a <span class="ui-c-ok">design token</span> instead?</p>
                <p>If this matches an existing token, please use that. If it's a new color we need, let's add it to the system first.</p>
              </div>
            </div>
          </div>
          <figcaption>One of 20+ ready-to-use comments in the cheat sheet.</figcaption>
        </figure>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>What's covered</h2></div>
        <dl class="pr-cats">
          {cats.map((c) => <div><dt>{c.title}</dt><dd class="ui-tnum">{c.count.split(' ')[0]}<span> patterns</span></dd></div>)}
        </dl>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Quick reference table</h2></div>
        <table class="ui-table lm-table">
          <thead><tr><th scope="col">Issue</th><th scope="col">Question to ask</th></tr></thead>
          <tbody>{ref.map((r) => <tr><th scope="row" class="ui-c-crit">{r.issue}</th><td class="lm-q">{r.q}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--band ui-section--patterned">
      <MarkPattern pattern="pulse" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head"><h2>Get the cheat sheet</h2><p>Print it. Pin it. Use it.</p></div>
          <div><LeadMagnetForm leadMagnet="pr-review-cheatsheet" idSuffix="end" buttonText="Send It to Me" successMessage="Done! Check your inbox." /><p class="ui-note">No spam. Unsubscribe anytime.</p></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 72%); mask-image: linear-gradient(100deg, transparent 38%, #000 72%); }
  @media (max-width: 960px) { :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); } }

  .lm-hero { align-items: center; }
  .lm-form { margin-top: 32px; max-width: 480px; }
  .lm-comment { padding: 18px; color: var(--color-body); font-size: 15px; line-height: 1.6; }
  .lm-comment p + p { margin-top: 10px; }
  .lm-table { margin-top: 32px; }
  .lm-q { color: var(--color-ink); }
  .pr-diff { padding-block: 8px; font-size: 13px; line-height: 1.9; color: var(--color-body); overflow-x: auto; }
  .pr-diff > div { padding-right: 18px; white-space: pre; }
  .pr-ln { display: inline-block; width: 44px; padding-right: 14px; text-align: right; color: var(--color-muted); }
  .pr-add { background: var(--color-add-bg); color: var(--color-add-ink); }
  .pr-comment { margin: 12px; padding: 16px; border-radius: 12px; background: var(--color-surface); box-shadow: var(--ring); font-size: 15px; line-height: 1.6; color: var(--color-body); }
  .pr-comment p + p { margin-top: 8px; }
  .pr-who { font-size: 13px; color: var(--color-muted); }
  .pr-cats { margin: 32px 0 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--color-line-strong); }
  .pr-cats > div { padding: 20px 16px 0 0; display: flex; flex-direction: column-reverse; gap: 6px; }
  .pr-cats > div + div { padding-left: 20px; border-left: 1px solid var(--color-line); }
  .pr-cats dd { margin: 0; font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; line-height: 1; color: var(--color-buoy-light); }
  .pr-cats dd span { font-family: var(--font-body); font-size: 14px; font-weight: 400; color: var(--color-muted); }
  .pr-cats dt { color: var(--color-ink); font-weight: 600; }
  @media (max-width: 760px) { .pr-cats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 20px; } .pr-cats > div + div { padding-left: 0; border-left: 0; } }
</style>
