---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import DocTerminal from '../components/DocTerminal.astro'
import MarkPattern from '../components/MarkPattern.astro'
import { siteConfig } from '../config'

const have = ['Design tokens defined', 'Component library built', 'Documentation published', 'Naming conventions set']
const happens = ['Hardcoded colors slip through', 'Duplicate components multiply', 'AI ignores your system', 'Drift compounds daily']
const findings = [
  { sev: 'critical', file: 'checkout/PaymentForm.tsx:24', old: '#3B82F6', token: 'var(--color-primary)', msg: 'Hardcoded color' },
  { sev: 'critical', file: 'checkout/CartItem.tsx:15', old: '14px', token: 'var(--spacing-sm)', msg: 'Magic number' },
  { sev: 'warning', file: 'checkout/Button.tsx:8', old: '', token: '', msg: 'Consider using <Button> component' },
]
const enforced = [
  { t: 'Color Enforcement', d: 'Every hex code, RGB value, and color name checked against your palette.' },
  { t: 'Spacing Enforcement', d: 'No more random pixel values. Every margin and padding validated.' },
  { t: 'Component Enforcement', d: 'New custom components flagged when existing ones should be used.' },
  { t: 'Typography Enforcement', d: 'Font sizes, weights, and families locked to your type scale.' },
  { t: 'Naming Enforcement', d: 'Consistent naming conventions across all files and components.' },
  { t: 'Pattern Enforcement', d: 'Deprecated patterns caught, accessibility issues flagged.' },
]
const before = ['"I hope the devs read the docs"', '"I\'ll catch it in the next audit"', '"Maybe code review will spot it"', '"We\'ll fix it in the refactor"']
const after = ['"I see exactly what needs attention before review"', '"Every PR is automatically checked"', '"Critical issues are flagged immediately"', '"Drift is stopped at the source"']
const yaml = `drift:
  enforce:
    - type: close-match
      reason: "Typos must be fixed"
    - file: "src/checkout/**"
      type: hardcoded-color
      reason: "Checkout uses tokens only"`
---

<Layout title="CI Enforcement - Block Drift at the PR | Buoy">
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="scan" drift={0.3} class="ui-pattern lp-pat-side" />
      <div class="ui-wrap lp-hero ui-split lp-hero-split">
        <div>
        <p class="ui-eyebrow">Design system enforcement</p>
        <div class="ui-head"><h1>Your design system has rules.<br /><span class="ui-c-buoy">Now they're enforceable.</span></h1></div>
        <p class="ui-lede">You spent months defining tokens, components, and patterns. It's time they actually get used.</p>
        <div class="ui-actions">
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary ui-btn--lg">Start enforcing now</a>
          <a href="#the-gap" class="ui-btn ui-btn--secondary ui-btn--lg">See the gap</a>
        </div>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-tray">
            <div class="ui-panel">
              <div class="ui-panel-head"><span><strong class="lp-ink">feat: Add new checkout flow</strong> <span class="lp-muted">#247 opened by a developer</span></span><span class="ui-c-crit lp-small">Changes requested</span></div>
              <ul class="lp-checks">
                <li><span class="ui-c-ok">Passed</span> Tests</li>
                <li><span class="ui-c-ok">Passed</span> Build</li>
                <li><span class="ui-c-crit">Failed</span> Buoy Design Check: 3 issues found</li>
              </ul>
              <ul class="lp-findings">
                {findings.map((f) => (
                  <li>
                    <span class={`ui-sev ui-sev-${f.sev}`}>{f.sev === 'critical' ? 'Critical' : 'Warning'}</span>
                    <span class="ui-mono lp-file">{f.file}</span>
                    <span class="lp-msg">{f.msg}{f.old && <> <span class="ui-old ui-mono">{f.old}</span> <span class="ui-token ui-mono">{f.token}</span></>}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <figcaption>Every problem. Caught automatically, before merge.</figcaption>
        </figure>
      </div>
    </section>

    <section id="the-gap" class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Rules without enforcement are just suggestions.</h2><p>Your design system documentation is beautiful. But documentation doesn't stop bad code from shipping.</p></div>
        <div class="ui-cols ui-cols--3">
          <article class="ui-col"><h3>What you have</h3><ul class="ui-ruled">{have.map((h) => <li>{h}</li>)}</ul></article>
          <article class="ui-col"><h3 class="ui-c-crit">The gap</h3><p class="lp-muted">No enforcement layer. So:</p><ul class="ui-ruled">{happens.map((h) => <li>{h}</li>)}</ul></article>
          <article class="ui-col"><h3 class="ui-c-ok">Buoy fills the gap</h3><p class="lp-muted">Automated enforcement in every PR.</p></article>
        </div>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>You set the threshold.</h2><p>Buoy scans every PR and flags issues before they merge. Decide which ones block, per file or per type.</p></div>
        <div class="lp-split lp-yaml">
          <div>
            <div class="ui-term">
              <div class="ui-term-bar"><span>.buoy.yaml</span></div>
              <pre>{yaml}</pre>
            </div>
            <p class="ui-note">Enforcement rules are configurable in <a href="/docs/configuration" class="ui-link">.buoy.yaml</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Every rule you set. Every line of code.</h2><p>Buoy enforces your entire design system specification automatically.</p></div>
        <table class="ui-table lp-table"><tbody>{enforced.map((e) => <tr><th scope="row">{e.t}</th><td>{e.d}</td></tr>)}</tbody></table>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>From hoping to knowing.</h2></div>
        <div class="ui-cols">
          <article class="ui-col"><h3 class="ui-c-crit">Before Buoy</h3><ul class="ui-ruled">{before.map((l) => <li>{l}</li>)}</ul></article>
          <article class="ui-col"><h3 class="ui-c-ok">After Buoy</h3><ul class="ui-ruled">{after.map((l) => <li>{l}</li>)}</ul></article>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Your rules. Actually followed.</h2><p>No more hoping. No more auditing. No more fixing drift after the fact. Just clean, consistent code that follows your design system.</p></div>
        <dl class="lp-stats">
          <div><dt>% of PRs checked</dt><dd class="ui-tnum">100</dd></div>
          <div><dt>config files to start</dt><dd class="ui-tnum">0</dd></div>
          <div><dt>seats to pay for</dt><dd class="ui-tnum">0</dd></div>
        </dl>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="wake" drift={0.3} fade class="ui-pattern" />

      <div class="ui-wrap ui-split lp-cta">
        <div class="ui-head">
          <h2>Start enforcing in 30 seconds.</h2>
          <p>Free. Open source. No signup required. Your rules deserve to be followed.</p>
          <div class="ui-actions"><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--secondary">View on GitHub</a></div>
        </div>
        <div>
          <DocTerminal command="npx ahoybuoy show health" />
          <p class="ui-note">The Code Control layer that design has been missing.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .lp-hero-split { align-items: center; }
  .lp-hero-split .ui-head h1 { font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem); }

  :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 72%); mask-image: linear-gradient(100deg, transparent 38%, #000 72%); }
  @media (max-width: 960px) { :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); } }

  .lp-hero { padding-block: 32px 24px; }
  .lp-split { margin-top: 40px; }
  .lp-muted { color: var(--color-muted); font-size: 15px; }
  .lp-ink { color: var(--color-ink); }
  .lp-small { font-size: 13px; white-space: nowrap; }
  .lp-checks, .lp-findings { list-style: none; margin: 0; padding: 0; }
  .lp-checks li { padding: 10px 18px; border-top: 1px solid var(--color-line); font-size: 14px; color: var(--color-ink); }
  .lp-checks li span { display: inline-block; width: 64px; font-size: 13px; font-weight: 600; }
  .lp-findings { background: var(--color-sunken); }
  .lp-findings li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 2px 12px; padding: 12px 18px; border-top: 1px solid var(--color-line); font-size: 14px; }
  .lp-file { color: var(--color-muted); font-size: 12.5px; }
  .lp-msg { grid-column: 2; color: var(--color-ink); }
  .lp-table { margin-top: 32px; }
  .ui-col h3 { font-size: 1.2rem; }
  .ui-col p { margin-top: 8px; }
  .lp-stats { margin: 40px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-line-strong); }
  .lp-stats > div { padding-top: 20px; display: flex; flex-direction: column-reverse; gap: 6px; }
  .lp-stats dd { margin: 0; font-family: var(--font-display); font-size: 3rem; font-weight: 700; line-height: 1; color: var(--color-ink); }
  .lp-stats dt { color: var(--color-muted); font-size: 15px; }
  .lp-cta { align-items: center; }
  .lp-yaml { max-width: 720px; }
</style>
