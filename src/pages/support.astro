---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import MarkPattern from '../components/MarkPattern.astro'

const supportOptions = [
  {
    title: 'Documentation',
    description: 'Guides, CLI reference, and integration docs',
    href: '/docs',
    cta: 'Browse Docs'
  },
  {
    title: 'GitHub Discussions',
    description: 'Ask questions, share ideas, get community help',
    href: 'https://github.com/ahoybuoy/buoy/discussions',
    cta: 'Join Discussion'
  },
  {
    title: 'Report a Bug',
    description: 'Found an issue? Let us know on GitHub',
    href: 'https://github.com/ahoybuoy/buoy/issues/new',
    cta: 'Open Issue'
  },
]
---

<Layout
  title="Support | Buoy - Design Drift Detection"
  description="Get help with Buoy. Browse documentation, join community discussions, or contact our team directly."
  keywords="buoy support, buoy help, design drift tool support"
>
  <Nav />

  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="scan" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head">
          <h1>How can we help?</h1>
          <p class="ui-lede">Find answers in our docs, connect with the community, or reach out directly.</p>
        </div>
        <ol class="ui-cols ui-cols--3 su-opts">
          {supportOptions.map((option) => (
            <li class="ui-col">
              <h3>{option.title}</h3>
              <p>{option.description}</p>
              <p class="ui-col-foot"><a href={option.href} class="ui-link">{option.cta}</a></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap su-split">
        <div class="ui-head">
          <h2>Contact us</h2>
          <p>Have a question that isn't covered in the docs? Send us a message and we'll get back to you.</p>
          <ul class="ui-ruled ui-ruled--top su-facts">
            <li><span>Bugs and feature requests</span><a href="https://github.com/ahoybuoy/buoy/issues/new" class="ui-rowlink">GitHub issues</a></li>
            <li><span>Community help</span><a href="https://github.com/ahoybuoy/buoy/discussions" class="ui-rowlink">Discussions</a></li>
            <li><span>Pricing and plans</span><a href="/pricing" class="ui-rowlink">Pricing</a></li>
            <li><span>What data leaves your repo</span><a href="/privacy#subprocessors" class="ui-rowlink">Privacy</a></li>
          </ul>
        </div>

        <form id="support-form" class="ui-card ui-card--pad su-form">
          <div class="su-row">
            <label class="su-field">
              <span>Name</span>
              <input type="text" id="name" name="name" required placeholder="Your name" />
            </label>
            <label class="su-field">
              <span>Email</span>
              <input type="email" id="email" name="email" required placeholder="you@company.com" />
            </label>
          </div>
          <label class="su-field">
            <span>Subject</span>
            <select id="subject" name="subject" required>
              <option value="">Select a topic</option>
              <option value="general">General Question</option>
              <option value="bug">Bug Report</option>
              <option value="feature">Feature Request</option>
              <option value="enterprise">Enterprise Inquiry</option>
              <option value="billing">Billing Question</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label class="su-field">
            <span>Message</span>
            <textarea id="message" name="message" rows="5" required placeholder="How can we help?"></textarea>
          </label>

          <div id="form-status" class="hidden">
            <div class="ui-msg"></div>
          </div>

          <button type="submit" class="ui-btn ui-btn--primary ui-btn--block">Send Message</button>
        </form>
      </div>
    </section>

    <section class="ui-section ui-section--last su-org">
      <div class="ui-wrap">
        <div class="ui-head ui-head--center">
          <p class="ui-tier-name ui-tier-org">Organization</p>
          <h2>Own a design system?</h2>
          <p>
            The Organization plan adds an org-wide drift record and a direct line to the
            people building Buoy, from $500 a month. Hands-on sprints with Dylan start at $10,000.
          </p>
        </div>
        <div class="ui-actions su-center">
          <a href="/services" class="ui-btn ui-btn--primary">See the Organization plan</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .su-opts { margin-top: 48px; }
  .su-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 64px; align-items: start; }
  @media (max-width: 960px) { .su-split { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
  .su-facts { margin-top: 32px; }
  .su-facts li { display: flex; justify-content: space-between; gap: 16px; font-size: 15px; }
  .su-facts span:last-child { color: var(--color-muted); text-align: right; }
  .su-form { display: grid; gap: 18px; }
  .su-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  @media (max-width: 640px) { .su-row { grid-template-columns: minmax(0, 1fr); } }
  .su-field { display: grid; gap: 8px; }
  .su-field > span { font-size: 14px; font-weight: 500; color: var(--color-ink); }
  .su-field input, .su-field select, .su-field textarea {
    width: 100%; padding: 11px 14px; border: 0; border-radius: var(--radius-btn);
    background: var(--color-sunken); color: var(--color-ink); font: inherit; font-size: 15px;
    box-shadow: var(--ring); transition: box-shadow 150ms ease;
  }
  .su-field textarea { resize: vertical; min-height: 128px; }
  .su-field input::placeholder, .su-field textarea::placeholder { color: var(--color-muted); }
  .su-field input:focus, .su-field select:focus, .su-field textarea:focus { outline: none; box-shadow: var(--ring-hover), 0 0 0 2px var(--color-buoy); }
  .su-form button:disabled { opacity: 0.5; cursor: not-allowed; }
  .su-org { padding-block: 88px; }
  .su-center { justify-content: center; margin-top: 28px; }
</style>

<script>
  const form = document.getElementById('support-form') as HTMLFormElement;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement;
  const statusContent = statusDiv?.querySelector('div');

  function showStatus(type: 'success' | 'error', message: string) {
    if (!statusDiv || !statusContent) return;

    statusDiv.classList.remove('hidden');
    statusContent.className = `ui-msg ${type === 'success' ? 'ui-msg--ok' : 'ui-msg--err'}`;
    statusContent.textContent = message;
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';

    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());

    try {
      const response = await fetch('/api/support', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        showStatus('success', 'Message sent! We\'ll get back to you soon.');
        form.reset();
      } else {
        const error = await response.json();
        showStatus('error', error.message || 'Something went wrong. Please try again.');
      }
    } catch (err) {
      showStatus('error', 'Failed to send message. Please try again or email us directly.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>
