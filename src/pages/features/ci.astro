---
import FeatureLayout from '../../layouts/FeatureLayout.astro'
import LeadMagnetCallout from '../../components/LeadMagnetCallout.astro'

const ciProviders = [
  { name: 'GitHub Actions', example: 'npx ahoybuoy drift check' },
  { name: 'GitLab CI', example: 'npx ahoybuoy drift check --format json' },
  { name: 'CircleCI', example: 'npx ahoybuoy drift check --fail-on warning' },
  { name: 'Jenkins', example: 'npx ahoybuoy drift check' },
  { name: 'Azure Pipelines', example: 'npx ahoybuoy drift check' },
  { name: 'Bitbucket Pipelines', example: 'npx ahoybuoy drift check' },
]

const outputFormats = [
  { format: 'CLI (default)', description: 'Human-readable output for terminal', flag: '--format cli' },
  { format: 'JSON', description: 'Machine-readable for custom integrations', flag: '--format json' },
  { format: 'JUnit XML', description: 'For CI systems that parse JUnit reports', flag: '--format junit' },
  { format: 'SARIF', description: 'For GitHub Code Scanning', flag: '--format sarif' },
]

const relatedFeatures = [
  { title: 'GitHub App', description: 'Automatic PR reviews', href: '/features/github-action' },
  { title: 'Drift Detection', description: 'What CI is checking for', href: '/features/drift-detection' },
]
---

<FeatureLayout
  title="Design System CI/CD Checks | Buoy"
  description="Add design drift detection to your CI pipeline. Block PRs with critical drift. Get JSON output for custom integrations."
  keywords="design system ci cd, component library checks, automated design review"
  heroTitle="Design System CI/CD Checks"
  heroDescription="Add drift detection to any CI pipeline. Block PRs, generate reports, and enforce design system compliance automatically."
  exampleCaption="Critical drift fails the job with exit code 1."
  related={relatedFeatures}
  pattern="tide"
  ctaPattern="pulse"
>
  <p slot="hero-extra" class="fx-hero-note"><strong>100% deterministic.</strong> No AI. No API keys. No data sent externally.</p>

  <div slot="example" class="ui-term fx-term">
    <div class="ui-term-bar"><span>CI · design-drift</span></div>
    <pre><span class="ui-t-prompt">$</span> <span class="ui-t-hi">npx ahoybuoy drift check --fail-on critical</span>

<span class="ui-t-crit">CRITICAL</span>  Button.tsx:12  Missing aria-label
          <span class="ui-t-ok">→ Fix: Add aria-label=&#123;buttonText&#125;</span>
<span class="ui-t-warn">WARNING</span>   Card.tsx:8     Hardcoded <span class="ui-t-crit">#ffffff</span> <span class="ui-t-dim">→</span> <span class="ui-t-ok">var(--color-bg)</span>

<span class="ui-t-crit">✗ Critical drift found. Exiting with code 1.</span>
<span class="ui-t-dim">Error: Process completed with exit code 1.</span></pre>
  </div>

  <section class="ui-section">
    <div class="ui-wrap ui-split">
      <div>
        <div class="ui-head"><h2>Works with any CI</h2><p>One command. The exit code decides the merge.</p></div>
        <div class="ui-tray fx-block">
          <div class="ui-panel">
            <div class="ui-panel-head"><span class="ui-mono">Basic CI command</span></div>
            <pre class="fx-pre"><span class="c"># Run drift check in CI mode</span>{`
npx ahoybuoy drift check

`}<span class="c"># Exit codes:</span>{`
`}<span class="c"># </span><span class="s">0</span><span class="c"> = No critical drift</span>{`
`}<span class="c"># </span><del>1</del><span class="c"> = Critical drift found (blocks merge)</span>{`
`}<span class="c"># 2 = Error running scan</span></pre>
          </div>
        </div>
      </div>
      <table class="ui-table fx-table">
        <caption class="ui-sr">CI providers and commands</caption>
        <thead><tr><th scope="col">Provider</th><th scope="col">Command</th></tr></thead>
        <tbody>
          {ciProviders.map((p) => <tr><th scope="row">{p.name}</th><td><code>{p.example}</code></td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Output formats</h2></div>
      <table class="ui-table ui-table--stack fx-block">
        <caption class="ui-sr">Output formats and flags</caption>
        <thead><tr><th scope="col">Format</th><th scope="col">Use</th><th scope="col" class="ui-end">Flag</th></tr></thead>
        <tbody>
          {outputFormats.map((f) => (
            <tr><th scope="row">{f.format}</th><td>{f.description}</td><td class="ui-end"><code class="ui-code">{f.flag}</code></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap ui-split">
      <div class="ui-head">
        <h2>Failure thresholds</h2>
        <p>Fail on <span class="ui-sev ui-sev-critical">critical</span> issues, on <span class="ui-sev ui-sev-warning">warnings</span> too, or never, and set custom counts per severity.</p>
      </div>
      <div class="ui-tray">
        <div class="ui-panel">
          <div class="ui-panel-head"><span class="ui-mono">Configure when to fail</span></div>
          <pre class="fx-pre"><span class="c"># Fail on any critical issues (recommended)</span>{`
npx ahoybuoy drift check --fail-on `}<span class="k">critical</span>{`

`}<span class="c"># Fail on warnings too (stricter)</span>{`
npx ahoybuoy drift check --fail-on `}<span class="k">warning</span>{`

`}<span class="c"># Never fail, just report (audit mode)</span>{`
npx ahoybuoy drift check --fail-on `}<span class="k">none</span>{`

`}<span class="c"># Custom thresholds</span>{`
npx ahoybuoy drift check \\
  --max-critical `}<span class="s">0</span>{` \\
  --max-warning `}<span class="s">10</span>{` \\
  --max-info `}<span class="s">50</span></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head ui-head--center">
        <h2>Health score gate</h2>
        <p>Set a minimum health score in your config. No CLI flags needed: <code class="ui-code">buoy drift check</code> exits with code 1 when the score drops below your threshold.</p>
      </div>
      <dl class="ci-gate" aria-label="Example: a score of 68 against a threshold of 70 fails the check">
        <div><dt>Health score</dt><dd class="ui-c-crit ui-tnum">68</dd></div>
        <div><dt>failBelow</dt><dd class="ui-tnum">70</dd></div>
        <div><dt>Exit code</dt><dd class="ui-c-crit ui-tnum">1</dd></div>
      </dl>
      <div class="ui-tray fx-block ci-gate-yaml">
        <div class="ui-panel">
          <div class="ui-panel-head"><span class="ui-mono">.buoy.yaml</span></div>
          <pre class="fx-pre"><span class="c"># Config-based gate, no flags required</span>{`
`}<span class="k">health:</span>{`
  failBelow: `}<span class="s">70</span>{`    `}<span class="c"># Exit code 1 if health score &lt; 70</span></pre>
        </div>
      </div>
      <div class="ui-cols">
        <div class="ui-col">
          <h3 class="ui-mono">health.failBelow</h3>
          <p class="ui-col-sub ui-c-buoy">Config</p>
          <p>Lives in <code class="ui-code">.buoy.yaml</code>. Enforced automatically. Same threshold everywhere: local, CI, every developer.</p>
        </div>
        <div class="ui-col">
          <h3 class="ui-mono">--fail-on</h3>
          <p class="ui-col-sub ui-c-buoy">CLI flag</p>
          <p>Per-invocation. Threshold based on severity counts. Use alongside the health gate for layered CI gating.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Full GitHub Actions example</h2></div>
      <div class="ui-tray fx-block">
        <div class="ui-panel">
          <div class="ui-panel-head"><span class="ui-mono">.github/workflows/design-drift.yml</span></div>
          <pre class="fx-pre">{`name: Design Drift Check
on:
  pull_request:
    branches: [main]

jobs:
  drift-check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install dependencies
        run: npm ci

      - name: Run Buoy drift check
        run: `}<span class="s">npx ahoybuoy drift check --fail-on critical</span>{`
        `}<span class="c"># Also respects health.failBelow from .buoy.yaml</span>{`

      - name: Upload SARIF (optional)
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: buoy-results.sarif`}</pre>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap fx-narrow">
      <LeadMagnetCallout
        leadMagnet="pr-review-cheatsheet"
        headline="Setting up CI? Get the PR review cheat sheet."
        subhead="What to look for in design system PRs. A quick reference for your team's code reviews."
        buttonText="Get the Cheat Sheet"
      />
    </div>
  </section>
</FeatureLayout>

<style>
  .ci-gate { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 48px auto 0; max-width: 720px; border-top: 1px solid var(--color-line-strong); }
  .ci-gate > div { padding: 20px 8px 0; text-align: center; }
  .ci-gate > div + div { border-left: 1px solid var(--color-line); }
  .ci-gate dt { font-size: 13px; color: var(--color-muted); }
  .ci-gate dd { margin: 6px 0 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); line-height: 1; color: var(--color-ink); }
  .ci-gate dd.ui-c-crit { color: var(--color-crit); }
  .ci-gate-yaml { max-width: 720px; margin-inline: auto; }
</style>
