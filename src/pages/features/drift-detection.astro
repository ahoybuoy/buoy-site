---
import FeatureLayout from '../../layouts/FeatureLayout.astro'
import Terminal from '../../components/Terminal.astro'
import BuoyMark from '../../components/BuoyMark.astro'
import LeadMagnetCallout from '../../components/LeadMagnetCallout.astro'

const terminalLines = [
  { text: '', delay: 600 },
  { text: '<span class="text-slate">Scanning for design drift...</span>', type: 'output', delay: 800 },
  { text: '', delay: 1200 },
  { text: 'Found <span class="text-warning">31</span> issues across <span class="text-light">89</span> files', type: 'output', delay: 1400 },
  { text: '', delay: 1600 },
  { text: '<span class="text-critical font-semibold">CRITICAL (3)</span>', type: 'output', delay: 1800 },
  { text: '├─ Button.tsx:12 Missing aria-label', type: 'critical', delay: 2000 },
  { text: '│  <span class="text-success">→ Fix: Add aria-label=&#123;buttonText&#125;</span>', type: 'output', delay: 2200 },
  { text: '└─ Modal.tsx:45 Focus trap conflict', type: 'critical', delay: 2400 },
  { text: '   <span class="text-success">→ Fix: Use FocusTrap from design system</span>', type: 'output', delay: 2600 },
  { text: '', delay: 2800 },
  { text: '<span class="text-warning font-semibold">WARNING (12)</span>', type: 'output', delay: 3000 },
  { text: '├─ Card.tsx:8 Hardcoded #ffffff → var(--color-bg)', type: 'warning', delay: 3200 },
  { text: '├─ Header.tsx:3 NavHeader deprecated → Navigation', type: 'warning', delay: 3400 },
  { text: '└─ <span class="text-slate-dark">... and 10 more</span>', type: 'muted', delay: 3600 },
  { text: '', delay: 3800 },
  { text: '<span class="text-buoy font-semibold">Add to CI to catch at the PR →</span>', type: 'output', delay: 4000 },
]

const features = [
  { title: 'Hardcoded Values', description: 'Find colors, spacing, and fonts that bypass your design tokens.', examples: ['#ff0000', '16px', 'Arial'], href: '/features/hardcoded-values' },
  { title: 'Duplicate Components', description: 'Detect similar components that should be consolidated.', examples: ['Button', 'ButtonNew', 'MyButton'], href: '/features/duplicate-detection' },
  { title: 'Naming Drift', description: 'Catch inconsistent naming conventions across your codebase.', examples: ['btn vs Button', 'color vs colour'], href: '/features/naming-consistency' },
  { title: 'Prop Mismatches', description: 'Find when the same prop has different types across components.', examples: ['onClick vs onPress', 'size: string | number'], href: '/features/prop-consistency' },
  { title: 'Deprecated Patterns', description: 'Track components marked as deprecated still in use.', examples: ['deprecated annotation', 'legacy components'] },
  { title: 'Framework Sprawl', description: 'Detect multiple UI frameworks competing in your codebase.', examples: ['React + Vue + ...'], href: '/features/framework-sprawl' },
  { title: 'Accessibility Issues', description: 'Find missing ARIA labels, focus traps, and contrast issues.', examples: ['Missing aria-label', 'Low contrast'], href: '/features/accessibility-checks' },
  { title: 'Orphaned Components', description: 'Components in code but missing from Figma or Storybook.', examples: ['In code, not in design'] },
  { title: 'Unused Tokens', description: 'Design tokens defined but never referenced in code.', examples: ['--color-unused', '--space-deprecated'] },
]

const how = [
  { title: 'Scan', text: 'Buoy parses your codebase to build a map of all components, props, and style values.' },
  { title: 'Analyze', text: 'Compares against your design system config to identify patterns that don\'t match.' },
  { title: 'Report', text: 'Outputs drift signals with severity, location, and suggested fixes.' },
]

const relatedFeatures = [
  { title: 'Coverage Metrics', description: 'Measure design system adoption with real data', href: '/features/coverage' },
  { title: 'GitHub App', description: 'Catch drift in every PR automatically', href: '/features/github-action' },
  { title: 'CI Integration', description: 'Add drift checks to your CI pipeline', href: '/features/ci' },
]
---

<FeatureLayout
  title="Design Drift Detection for React, Vue & Svelte | Buoy"
  description="Automatically detect when AI-generated code drifts from your design system. Find hardcoded values, naming inconsistencies, and deprecated patterns."
  keywords="design drift detection, AI code consistency, design system enforcement"
  heroTitle="Find drift. Catch it at the PR. Measure improvement."
  heroDescription="Buoy finds design drift, blocks it in CI, and shows you the measurable improvement in your design system adoption."
  exampleCaption="A Buoy review comment on a deprecated component."
  related={relatedFeatures}
  pattern="field"
  ctaPattern="tide"
>
  <p slot="hero-extra" class="fx-hero-note"><strong>100% deterministic.</strong> No AI. No API keys. No data sent externally.</p>

  <div slot="example" class="ui-tray">
    <div class="ui-panel">
      <div class="ui-panel-head"><span class="ui-mono">src/components/Header.tsx</span></div>
      <div class="fx-diff" role="img" aria-label="Diff of Header.tsx. Line 3 imports the deprecated NavHeader component.">
        <div class="fx-line fx-add"><span class="fx-ln">3</span><span class="fx-sign">+</span><span class="fx-code">{"import { NavHeader } from '@/ui'"}</span></div>
      </div>
      <div class="fx-comment-row">
        <div class="fx-comment">
          <div class="fx-comment-head">
            <span class="fx-avatar"><BuoyMark size={16} /></span>
            <span class="fx-author">buoy-design</span><span class="fx-tag">bot</span>
            <span class="fx-meta">commented on line <span class="ui-tnum">3</span></span>
          </div>
          <p class="fx-body">Deprecated component <code class="fx-was">NavHeader</code>. Use <code class="fx-fix">Navigation</code> instead.</p>
          <div class="fx-suggest">
            <div class="fx-suggest-label">Suggested change</div>
            <div class="fx-diff">
              <div class="fx-line fx-del"><span class="fx-ln">3</span><span class="fx-sign">-</span><span class="fx-code">{"import { NavHeader } from '@/ui'"}</span></div>
              <div class="fx-line fx-add"><span class="fx-ln">3</span><span class="fx-sign">+</span><span class="fx-code">{"import { Navigation } from '@/ui'"}</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="fx-diff" aria-hidden="true">
        <div class="fx-line fx-add"><span class="fx-ln">8</span><span class="fx-sign">+</span><span class="fx-code">{"  <div style={{ background: '#ffffff' }}>"}</span></div>
      </div>
    </div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>All drift types</h2>
        <p>Comprehensive drift detection for modern frontend codebases.</p>
      </div>
      <table class="ui-table ui-table--hover fx-block fx-table">
        <caption class="ui-sr">Drift types Buoy detects</caption>
        <thead><tr><th scope="col">Drift type</th><th scope="col">What it finds</th></tr></thead>
        <tbody>
          {features.map((f) => (
            <tr>
              <th scope="row">{f.href ? <a href={f.href} class="ui-rowlink">{f.title}</a> : f.title}</th>
              <td>{f.description}<br /><span class="ui-mono ui-c-crit fx-ex">{f.examples.join(', ')}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split">
      <div>
        <div class="ui-head"><h2>How drift detection works</h2></div>
        <ol class="ui-steps fx-block">
          {how.map((s, i) => (
            <li><span class="ui-step-n" aria-hidden="true">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
          ))}
        </ol>
      </div>
      <div>
        <p class="ui-note">Step 1: find drift. Every issue includes the exact file, line, and what to change.</p>
        <Terminal command="buoy drift check" lines={terminalLines} />
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>Step 2: catch at the PR</h2>
        <p>Add Buoy to CI. Design drift never reaches main.</p>
      </div>
      <div class="ui-tray fx-block">
        <div class="ui-panel">
          <div class="fx-check fx-check-fail">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z"/></svg>
            <span>Buoy Design Check: 3 critical issues found</span>
          </div>
          <div class="fx-scroll">
            <table class="fx-mini">
              <thead><tr><th>File</th><th>Line</th><th>Issue</th><th>Fix</th></tr></thead>
              <tbody>
                <tr><td class="ui-mono">src/components/Button.tsx</td><td class="ui-tnum">12</td><td>Missing aria-label <span class="ui-sev ui-sev-critical">Critical</span></td><td><code class="ui-c-ok">aria-label=&#123;buttonText&#125;</code></td></tr>
                <tr><td class="ui-mono">src/components/Card.tsx</td><td class="ui-tnum">8</td><td>Hardcoded color <code class="ui-c-crit">#ffffff</code></td><td><code class="ui-c-ok">var(--color-bg)</code></td></tr>
                <tr><td class="ui-mono">src/components/Header.tsx</td><td class="ui-tnum">3</td><td>Deprecated component <code class="ui-c-crit">NavHeader</code></td><td><code class="ui-c-ok">Navigation</code></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What you get</h2><p>Clarity, not just data. Every scan ends with concrete next steps.</p></div>
      <div class="ui-cols ui-cols--3">
        <div class="ui-col"><h3>PR checks</h3><p>Catch drift at the PR. Every issue shows the exact token to use instead.</p><p class="ui-col-foot"><code class="ui-code">buoy drift check --ci</code></p></div>
        <div class="ui-col"><h3>Clear explanations</h3><p>Every issue includes the file, line, and exactly what needs to change.</p><p class="ui-col-foot"><code class="ui-code">buoy drift check --format detailed</code></p></div>
        <div class="ui-col"><h3>Coverage score</h3><p>Track design system adoption over time. Show leadership real numbers.</p><p class="ui-col-foot"><code class="ui-code">buoy show health</code></p></div>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Visible outcomes</h2></div>
      <div class="ui-cols fx-vs">
        <div class="ui-col">
          <h3>For developers</h3>
          <ul class="ui-ruled">
            <li>No guessing: exact file, line, and fix</li>
            <li>CI catches issues before they merge</li>
            <li>PR checks catch issues before review</li>
            <li>Less time debating, more time building</li>
          </ul>
        </div>
        <div class="ui-col">
          <h3>For leaders</h3>
          <ul class="ui-ruled">
            <li>Real adoption numbers, not estimates</li>
            <li>Track improvement week over week</li>
            <li>Prove design system ROI with data</li>
            <li>Identify which teams need help</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap fx-narrow">
      <LeadMagnetCallout
        leadMagnet="drift-checklist"
        headline="Not ready to install? Start with a manual audit."
        subhead="20 warning signs to look for in your next code review. Spot drift before it spreads."
        buttonText="Get the Checklist"
      />
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Why design drift matters</h2></div>
      <div class="ui-cols fx-vs">
        <div class="ui-col">
          <h3>Without drift detection</h3>
          <ul class="ui-ruled">
            <li>Inconsistent UI across the app</li>
            <li>Design system becomes optional</li>
            <li>Harder to maintain and update</li>
            <li>No way to measure adoption</li>
          </ul>
        </div>
        <div class="ui-col">
          <h3>With Buoy</h3>
          <ul class="ui-ruled">
            <li>Consistent, cohesive UI</li>
            <li>Design system enforcement</li>
            <li>Easy global updates via tokens</li>
            <li>Real adoption metrics</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</FeatureLayout>
