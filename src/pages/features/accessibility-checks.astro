---
import FeatureLayout from '../../layouts/FeatureLayout.astro'
import BuoyMark from '../../components/BuoyMark.astro'

const checks = [
  { title: 'Color Contrast', description: 'Ensures text meets WCAG 2.1 contrast requirements (4.5:1 for normal text, 3:1 for large text)', severity: 'critical' },
  { title: 'Alt Text', description: 'Detects images without alt attributes or with empty alt on decorative images', severity: 'critical' },
  { title: 'ARIA Labels', description: 'Catches buttons with only icons and no accessible label', severity: 'warning' },
  { title: 'Focus Indicators', description: 'Warns when focus styles are removed without replacement', severity: 'warning' },
  { title: 'Semantic HTML', description: 'Suggests semantic elements over divs with roles', severity: 'info' },
  { title: 'Heading Order', description: 'Ensures headings follow logical hierarchy (h1 → h2 → h3)', severity: 'info' },
]

const why = [
  { title: 'Legal requirement', text: 'ADA, Section 508, and WCAG compliance is legally required for many organizations.' },
  { title: '15% of users', text: 'Over 1 billion people worldwide have some form of disability.' },
  { title: 'Better for everyone', text: 'Good contrast and clear labels help all users, not just those with disabilities.' },
]

const relatedFeatures = [
  { title: 'Drift Detection', description: 'All design system checks', href: '/features/drift-detection' },
  { title: 'CI Integration', description: 'Block PRs on a11y issues', href: '/features/ci' },
  { title: 'Coverage', description: 'Track a11y compliance', href: '/features/coverage' },
]
---

<FeatureLayout
  title="Accessibility Checks in Your Design System | Buoy"
  description="Catch accessibility issues at build time. Check color contrast, missing alt text, ARIA labels, and more."
  keywords="accessibility checks, wcag compliance, design system accessibility"
  heroTitle="Accessibility checks at build time"
  heroDescription="Catch a11y issues before they ship. Color contrast, alt text, ARIA labels, and more."
  exampleCaption="A Buoy review comment on an icon button with no label."
  related={relatedFeatures}
  pattern="pulse"
  ctaPattern="wake"
>
  <div slot="example" class="ui-tray">
    <div class="ui-panel">
      <div class="ui-panel-head"><span class="ui-mono">src/components/IconButton.tsx</span></div>
      <div class="fx-diff" role="img" aria-label="Diff of IconButton.tsx. Line 5 adds a button with only an icon and no label.">
        <div class="fx-line"><span class="fx-ln">4</span><span class="fx-sign"></span><span class="fx-code">{"export const Close = () => ("}</span></div>
        <div class="fx-line fx-add"><span class="fx-ln">5</span><span class="fx-sign">+</span><span class="fx-code">{"  <button><Icon name=\"x\" /></button>"}</span></div>
      </div>
      <div class="fx-comment-row">
        <div class="fx-comment">
          <div class="fx-comment-head">
            <span class="fx-avatar"><BuoyMark size={16} /></span>
            <span class="fx-author">buoy-design</span><span class="fx-tag">bot</span>
            <span class="fx-meta">commented on line <span class="ui-tnum">5</span></span>
          </div>
          <p class="fx-body"><span class="ui-sev ui-sev-warning">Warning</span> Missing aria-label. Icon-only buttons need an accessible name.</p>
          <div class="fx-suggest">
            <div class="fx-suggest-label">Suggested change</div>
            <div class="fx-diff">
              <div class="fx-line fx-del"><span class="fx-ln">5</span><span class="fx-sign">-</span><span class="fx-code">{"<button><Icon name=\"x\" /></button>"}</span></div>
              <div class="fx-line fx-add"><span class="fx-ln">5</span><span class="fx-sign">+</span><span class="fx-code">{"<button aria-label=\"Close\"><Icon name=\"x\" /></button>"}</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Why accessibility matters</h2></div>
      <div class="ui-cols ui-cols--3">
        {why.map((w) => (
          <div class="ui-col"><h3>{w.title}</h3><p>{w.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split">
      <div class="ui-head">
        <h2>See it in action</h2>
        <p>One run of <code class="ui-code">buoy drift check</code> lists each issue with its severity, file and line.</p>
      </div>
      <div class="ui-term fx-term">
        <div class="ui-term-bar"><span>Terminal</span></div>
        <pre><span class="ui-t-prompt">$</span> <span class="ui-t-hi">buoy drift check</span>
<span class="ui-t-dim">Running accessibility checks...</span>

<span class="ui-t-crit">✗</span> Found <span class="ui-t-hi">3</span> accessibility issues

<span class="ui-t-crit">[Critical]</span> Missing alt text
  <span class="ui-t-dim">└─ src/components/Avatar.tsx:12</span>
     <span class="ui-t-dim">&lt;img src=&#123;user.avatar&#125; /&gt;</span>

<span class="ui-t-warn">[Warning]</span> Low color contrast
  <span class="ui-t-dim">└─ src/components/Badge.tsx:8</span>
     <span class="ui-t-dim">text-gray-400 on bg-gray-100 (ratio: 2.5:1)</span>

<span class="ui-t-warn">[Warning]</span> Missing aria-label
  <span class="ui-t-dim">└─ src/components/IconButton.tsx:5</span>
     <span class="ui-t-dim">&lt;button&gt;&lt;Icon /&gt;&lt;/button&gt;</span></pre>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What we check</h2></div>
      <div class="fx-block">
        <table class="ui-table ui-table--stack">
          <caption class="ui-sr">Accessibility checks and their severity</caption>
          <thead><tr><th scope="col">Check</th><th scope="col">What it catches</th><th scope="col" class="ui-end">Severity</th></tr></thead>
          <tbody>
            {checks.map((c) => (
              <tr>
                <th scope="row">{c.title}</th>
                <td>{c.description}</td>
                <td class="ui-end"><span class={`ui-sev ui-sev-${c.severity}`}>{c.severity[0].toUpperCase() + c.severity.slice(1)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Color contrast checking</h2></div>
      <div class="ui-cols">
        <div class="ui-col">
          <h3>Failing contrast</h3>
          <p class="ui-col-sub ui-c-crit">Contrast ratio: 2.5:1 (needs 4.5:1)</p>
          <div class="a11y-sample fx-mt"><p class="a11y-fail">This text is hard to read</p></div>
        </div>
        <div class="ui-col">
          <h3>Passing contrast</h3>
          <p class="ui-col-sub ui-c-ok">Contrast ratio: 5.3:1 (passes AA)</p>
          <div class="a11y-sample fx-mt"><p class="a11y-pass">This text is easy to read</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap ui-split">
      <div class="ui-head">
        <h2>Works with your design tokens</h2>
        <p>Buoy checks your token color pairs for WCAG compliance and suggests the token to use instead.</p>
      </div>
      <div class="ui-term fx-term">
        <div class="ui-term-bar"><span>Checks token combinations</span></div>
        <pre><span class="ui-t-dim">Checking token color pairs for WCAG compliance...</span>

<span class="ui-t-ok">✓</span> --color-text on --color-bg           <span class="ui-t-ok">7.2:1 (AAA)</span>
<span class="ui-t-ok">✓</span> --color-text-muted on --color-bg     <span class="ui-t-ok">5.1:1 (AA)</span>
<span class="ui-t-crit">✗</span> --color-text-muted on --color-bg-alt <span class="ui-t-crit">2.8:1 (FAIL)</span>
  <span class="ui-t-dim">└─ Suggest:</span> Use <span class="ui-t-ok">--color-text</span> instead

<span class="ui-t-ok">✓</span> --color-primary on --color-bg        <span class="ui-t-ok">4.8:1 (AA)</span>
<span class="ui-t-crit">✗</span> --color-primary on --color-primary-bg <span class="ui-t-crit">1.9:1 (FAIL)</span>
  <span class="ui-t-dim">└─ Suggest:</span> Darken <span class="ui-t-ok">--color-primary-bg</span></pre>
      </div>
    </div>
  </section>
</FeatureLayout>

<style>
  /* A literal light sample: these colours are the example being judged, not brand colours. */
  .a11y-sample { padding: 20px; border-radius: var(--radius-inner); background: #f3f4f6; box-shadow: var(--ring); }
  .a11y-sample p { margin: 0; font-size: 15px; }
  .a11y-fail { color: #9ca3af; }
  .a11y-pass { color: #374151; }
</style>
