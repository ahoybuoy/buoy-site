---
import FeatureLayout from '../../layouts/FeatureLayout.astro'

const sprawlTypes = [
  { title: 'Multiple UI Libraries', description: 'Using Radix AND Chakra AND MUI in the same project', impact: 'Massive bundle bloat, inconsistent UX' },
  { title: 'Framework Mixing', description: 'React components alongside jQuery or vanilla JS', impact: 'Hydration issues, maintenance nightmare' },
  { title: 'CSS-in-JS Sprawl', description: 'Styled-components, Emotion, AND Tailwind together', impact: 'Conflicting styles, specificity wars' },
  { title: 'State Management Chaos', description: 'Redux + MobX + Zustand + Context in one app', impact: 'Unpredictable state, debugging hell' },
]

const history = [
  { year: 'Year 1', quote: '"We\'ll use Material UI, it has everything."' },
  { year: 'Year 2', quote: '"This new feature needs Radix for the dropdown."' },
  { year: 'Year 3', quote: '"The contractor used Chakra, we\'ll migrate later."' },
  { year: 'Year 4', quote: '"Why is our bundle 2MB?"' },
]

const bundles = [
  { name: '@radix-ui (headless)', size: '~45KB gzipped', pct: 15, tone: 'ok' },
  { name: '@chakra-ui/react', size: '~120KB gzipped', pct: 40, tone: 'warn' },
  { name: '@mui/material', size: '~300KB gzipped', pct: 100, tone: 'crit' },
]

const relatedFeatures = [
  { title: 'Duplicate Detection', description: 'Find component duplicates', href: '/features/duplicate-detection' },
  { title: 'Coverage', description: 'Track library adoption', href: '/features/coverage' },
  { title: 'React Integration', description: 'React-specific checks', href: '/integrations/react' },
]
---

<FeatureLayout
  title="Detect Framework Sprawl in Your Codebase | Buoy"
  description="Find multiple UI libraries, CSS solutions, and frameworks competing in your codebase. Consolidate for smaller bundles."
  keywords="framework sprawl, multiple ui libraries, bundle size optimization"
  heroTitle="Detect framework sprawl"
  heroDescription="Using three UI libraries at once? Buoy finds the overlap so you can consolidate."
  exampleCaption="Three UI libraries, the overlap between them, and where to consolidate."
  related={relatedFeatures}
  pattern="swell"
  ctaPattern="rain"
>
  <div slot="example" class="ui-term fx-term">
    <div class="ui-term-bar"><span>Terminal</span></div>
    <pre><span class="ui-t-prompt">$</span> <span class="ui-t-hi">buoy drift check</span>
<span class="ui-t-dim">Analyzing framework usage...</span>

<span class="ui-t-warn">⚠</span> Found <span class="ui-t-hi">3</span> UI libraries in use

<span class="ui-t-dim">Libraries detected:</span>
  ├─ @radix-ui/react-*     <span class="ui-t-ok">47 imports</span> (primary)
  ├─ @chakra-ui/react      <span class="ui-t-warn">12 imports</span> (secondary)
  └─ @mui/material         <span class="ui-t-crit">3 imports</span> (legacy?)

<span class="ui-t-dim">Component overlap:</span>
  ├─ Button: 3 implementations (Radix, Chakra, MUI)
  ├─ Modal: 2 implementations (Radix, Chakra)
  └─ Select: 2 implementations (Radix, MUI)

<span class="ui-t-prompt">Recommendation:</span> Consolidate to <span class="ui-t-ok">Radix UI</span></pre>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>How framework sprawl happens</h2></div>
      <ol class="sprawl-years">
        {history.map((h, i) => (
          <li class={i === history.length - 1 ? 'sprawl-last' : ''}><p class="ui-mono sprawl-year">{h.year}</p><p class="sprawl-quote">{h.quote}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Types of sprawl we detect</h2></div>
      <table class="ui-table fx-block">
        <caption class="ui-sr">Types of sprawl and their impact</caption>
        <thead><tr><th scope="col">Type</th><th scope="col">Looks like, and the impact</th></tr></thead>
        <tbody>
          {sprawlTypes.map((t) => <tr><th scope="row">{t.title}</th><td>{t.description}<br /><span class="ui-c-crit">{t.impact}</span></td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap fx-narrow">
      <div class="ui-head"><h2>The bundle size impact</h2></div>
      <ul class="ui-ruled ui-ruled--top sprawl-bars">
        {bundles.map((b) => (
          <li>
            <div class="sprawl-row"><span>{b.name}</span><span class="ui-tnum sprawl-size">{b.size}</span></div>
            <div class="sprawl-track"><div class={`sprawl-fill sprawl-${b.tone}`} style={`--w:${b.pct}%`}></div></div>
          </li>
        ))}
      </ul>
      <p class="ui-after">Using all three = <span class="ui-c-crit">~465KB</span> just for UI components. Pick one = <span class="ui-c-ok">~45-120KB</span> depending on choice.</p>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Plan your migration</h2></div>
      <div class="ui-tray fx-block">
        <div class="ui-panel">
          <div class="ui-panel-head"><span class="ui-mono">buoy sprawl report --output json</span></div>
          <pre class="fx-pre">{`{
  "primary": {
    "library": `}<span class="s">"@radix-ui"</span>{`,
    "imports": 47,
    "recommendation": `}<span class="s">"Keep as primary"</span>{`
  },
  "secondary": [
    {
      "library": `}<del>"@chakra-ui/react"</del>{`,
      "imports": 12,
      "components": ["Button", "Modal", "Toast"],
      "migrationEffort": "medium",
      "recommendation": `}<span class="s">"Replace with Radix equivalents"</span>{`
    },
    {
      "library": `}<del>"@mui/material"</del>{`,
      "imports": 3,
      "components": ["DataGrid"],
      "migrationEffort": "low",
      "recommendation": `}<span class="s">"Replace with @tanstack/table + Radix"</span>{`
    }
  ]
}`}</pre>
        </div>
      </div>
    </div>
  </section>
</FeatureLayout>

<style>
  .sprawl-years { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--color-line-strong); }
  .sprawl-years li { padding: 20px 24px 0 0; }
  .sprawl-years li + li { padding-left: 24px; border-left: 1px solid var(--color-line); }
  .sprawl-year { margin: 0; font-size: 14px; color: var(--color-buoy-light); }
  .sprawl-quote { margin: 8px 0 0; font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.3; color: var(--color-ink); }
  .sprawl-last .sprawl-quote { color: var(--color-crit); }
  @media (max-width: 760px) {
    .sprawl-years { grid-template-columns: minmax(0, 1fr); }
    .sprawl-years li, .sprawl-years li + li { padding: 16px 0; border-left: 0; border-bottom: 1px solid var(--color-line); }
  }
  .sprawl-bars li { padding-block: 16px; }
  .sprawl-row { display: flex; justify-content: space-between; gap: 16px; font-size: 15px; }
  .sprawl-size { color: var(--color-muted); }
  .sprawl-track { margin-top: 10px; height: 8px; border-radius: 99px; background: var(--color-sunken); overflow: hidden; }
  .sprawl-fill { height: 100%; width: var(--w); border-radius: inherit; }
  .sprawl-ok { background: var(--color-ok); }
  .sprawl-warn { background: var(--color-warn); }
  .sprawl-crit { background: var(--color-crit); }
</style>
