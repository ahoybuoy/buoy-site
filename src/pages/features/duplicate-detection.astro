---
import FeatureLayout from '../../layouts/FeatureLayout.astro'
import Terminal from '../../components/Terminal.astro'
import BuoyMark from '../../components/BuoyMark.astro'

const terminalLines = [
  { text: '', delay: 600 },
  { text: '<span class="text-slate">Scanning for duplicate components...</span>', type: 'output', delay: 800 },
  { text: '', delay: 1200 },
  { text: '<span class="text-warning">⚠</span> Found <span class="text-light">3</span> duplicate component patterns', type: 'warning', delay: 1400 },
  { text: '', delay: 1600 },
  { text: '<span class="text-slate">Duplicate 1:</span> Button implementations', type: 'output', delay: 1800 },
  { text: '  ├─ src/components/Button.tsx', type: 'muted', delay: 2000 },
  { text: '  ├─ src/features/auth/LoginButton.tsx', type: 'muted', delay: 2200 },
  { text: '  └─ src/legacy/OldButton.tsx', type: 'muted', delay: 2400 },
  { text: '', delay: 2600 },
  { text: '<span class="text-slate">Duplicate 2:</span> Card layouts', type: 'output', delay: 2800 },
  { text: '  ├─ src/components/Card.tsx', type: 'muted', delay: 3000 },
  { text: '  └─ src/features/dashboard/InfoCard.tsx', type: 'muted', delay: 3200 },
  { text: '', delay: 3400 },
  { text: '<span class="text-slate">Duplicate 3:</span> Modal dialogs', type: 'output', delay: 3600 },
  { text: '  ├─ src/components/Modal.tsx', type: 'muted', delay: 3800 },
  { text: '  └─ src/components/Dialog.tsx', type: 'muted', delay: 4000 },
]

const duplicateTypes = [
  { title: 'Component Clones', description: 'Multiple implementations of the same UI pattern (buttons, cards, modals)', severity: 'critical' },
  { title: 'Style Duplicates', description: 'Same styles defined in multiple places instead of shared tokens', severity: 'warning' },
  { title: 'Utility Overlap', description: 'Helper functions that do the same thing with different names', severity: 'info' },
  { title: 'Pattern Similarity', description: 'Components that could be consolidated with props/variants', severity: 'info' },
]

const how = [
  { title: 'AST Analysis', text: 'Parses component structure, not just text matching' },
  { title: 'Pattern Matching', text: 'Identifies similar prop signatures and render patterns' },
  { title: 'Similarity Score', text: 'Ranks duplicates by how similar they are (80%+ = likely duplicate)' },
]

const relatedFeatures = [
  { title: 'Drift Detection', description: 'Find all design inconsistencies', href: '/features/drift-detection' },
  { title: 'Naming Consistency', description: 'Enforce naming conventions', href: '/features/naming-consistency' },
  { title: 'Coverage', description: 'Measure component adoption', href: '/features/coverage' },
]
---

<FeatureLayout
  title="Find Duplicate Components in Your Codebase | Buoy"
  description="Detect duplicate UI implementations, redundant components, and consolidation opportunities. Reduce bundle size and maintenance burden."
  keywords="detect duplicate components, find redundant code, component consolidation"
  heroTitle="Find duplicate components"
  heroDescription="Three different button implementations? Two modal components? Buoy finds them all."
  exampleCaption="A new button that already exists, caught at the PR."
  related={relatedFeatures}
  pattern="wake"
  ctaPattern="field"
>
  <div slot="example" class="ui-tray">
    <div class="ui-panel">
      <div class="ui-panel-head"><span class="ui-mono">src/features/auth/LoginButton.tsx</span></div>
      <div class="fx-diff" role="img" aria-label="Diff adding a new LoginButton component that duplicates Button.">
        <div class="fx-line fx-add"><span class="fx-ln">1</span><span class="fx-sign">+</span><span class="fx-code">{"export function LoginButton({ children }) {"}</span></div>
        <div class="fx-line fx-add"><span class="fx-ln">2</span><span class="fx-sign">+</span><span class="fx-code">{"  return <button className=\"btn btn-primary\">"}</span></div>
      </div>
      <div class="fx-comment-row">
        <div class="fx-comment">
          <div class="fx-comment-head">
            <span class="fx-avatar"><BuoyMark size={16} /></span>
            <span class="fx-author">buoy-design</span><span class="fx-tag">bot</span>
            <span class="fx-meta">commented on line <span class="ui-tnum">1</span></span>
          </div>
          <p class="fx-body">Duplicate component. <code class="fx-was">LoginButton</code> matches <code>src/components/Button.tsx</code>. Use <code class="fx-fix">{'<Button>'}</code> instead.</p>
          <div class="fx-suggest">
            <div class="fx-suggest-label">Suggested change</div>
            <div class="fx-diff">
              <div class="fx-line fx-del"><span class="fx-ln">12</span><span class="fx-sign">-</span><span class="fx-code">{"<LoginButton>Sign in</LoginButton>"}</span></div>
              <div class="fx-line fx-add"><span class="fx-ln">12</span><span class="fx-sign">+</span><span class="fx-code">{"<Button variant=\"primary\">Sign in</Button>"}</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>The duplication problem</h2></div>
      <div class="ui-cols fx-vs">
        <div class="ui-col">
          <h3>How it happens</h3>
          <ul class="ui-ruled">
            <li>New dev doesn't know Button exists, creates LoginButton</li>
            <li>Feature team copies component instead of importing</li>
            <li>Legacy code kept "just in case" alongside new version</li>
            <li>AI generates new component instead of using existing</li>
          </ul>
        </div>
        <div class="ui-col">
          <h3>Why it matters</h3>
          <ul class="ui-ruled">
            <li>Larger bundle size = slower load times</li>
            <li>More components = more maintenance</li>
            <li>Inconsistent behavior confuses users</li>
            <li>Design changes need N updates instead of 1</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split">
      <div class="ui-head"><h2>See it in action</h2><p>Every clone, grouped with the files that implement it.</p></div>
      <Terminal command="buoy drift check" lines={terminalLines} />
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What we detect</h2></div>
      <table class="ui-table ui-table--stack fx-block">
        <caption class="ui-sr">Duplicate types and severity</caption>
        <thead><tr><th scope="col">Type</th><th scope="col">What it catches</th><th scope="col" class="ui-end">Severity</th></tr></thead>
        <tbody>
          {duplicateTypes.map((t) => (
            <tr><th scope="row">{t.title}</th><td>{t.description}</td><td class="ui-end"><span class={`ui-sev ui-sev-${t.severity}`}>{t.severity[0].toUpperCase() + t.severity.slice(1)}</span></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>How detection works</h2></div>
      <ol class="ui-steps fx-block">
        {how.map((s, i) => (
          <li><span class="ui-step-n" aria-hidden="true">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>
</FeatureLayout>
