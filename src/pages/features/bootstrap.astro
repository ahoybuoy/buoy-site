---
import FeatureLayout from '../../layouts/FeatureLayout.astro'

const outputFormats = [
  { name: 'CSS Variables', file: 'tokens.css' },
  { name: 'JSON', file: 'tokens.json' },
  { name: 'Tailwind Config', file: 'tailwind.config.js' },
  { name: 'SCSS Variables', file: '_tokens.scss' },
  { name: 'TypeScript', file: 'tokens.ts' },
  { name: 'Style Dictionary', file: 'tokens.sd.json' },
]

const steps = [
  { title: 'Scan', text: 'Buoy scans your codebase for all hardcoded style values' },
  { title: 'Dedupe', text: 'Groups similar values and suggests consolidation' },
  { title: 'Generate', text: 'Outputs token files in your preferred format' },
]

const relatedFeatures = [
  { title: 'Token Generation', description: 'Generate tokens with AI', href: '/features/token-generation' },
  { title: 'Hardcoded Values', description: 'Find values to tokenize', href: '/features/hardcoded-values' },
  { title: 'Coverage', description: 'Measure token adoption', href: '/features/coverage' },
]
---

<FeatureLayout
  title="Extract Design Tokens from Existing Code | Buoy"
  description="Turn hardcoded colors, spacing, and fonts into design tokens. Scan your codebase and generate tokens.json, CSS variables, or Tailwind config."
  keywords="extract design tokens, create design tokens cli, hardcoded to design tokens"
  heroTitle="Turn hardcoded values into design tokens"
  heroDescription="You have colors and spacing scattered everywhere. Buoy extracts them into a token file in seconds."
  exampleCaption="Values found in the code become named tokens."
  related={relatedFeatures}
  pattern="rain"
  ctaPattern="field"
>
  <div slot="example" class="ui-term fx-term">
    <div class="ui-term-bar"><span>Terminal</span></div>
    <pre><span class="ui-t-prompt">$</span> <span class="ui-t-hi">buoy anchor</span>
<span class="ui-t-dim">Scanning codebase for style values...</span>

Found <span class="ui-t-hi">47</span> unique colors
Found <span class="ui-t-hi">12</span> unique spacing values
Found <span class="ui-t-hi">8</span> unique font sizes

<span class="ui-t-ok">✓</span> Generated tokens.css
<span class="ui-t-ok">✓</span> Generated tokens.json
<span class="ui-t-ok">✓</span> Generated tailwind.config.js extension</pre>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>How it works</h2></div>
      <ol class="ui-steps fx-block">
        {steps.map((s, i) => (
          <li><span class="ui-step-n" aria-hidden="true">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split">
      <div>
        <div class="ui-head"><h2>Output formats</h2><p>Pick the files your stack reads.</p></div>
        <table class="ui-table fx-block">
          <caption class="ui-sr">Output formats and file names</caption>
          <thead><tr><th scope="col">Format</th><th scope="col" class="ui-end">File</th></tr></thead>
          <tbody>
            {outputFormats.map((f) => (
              <tr><th scope="row">{f.name}</th><td class="ui-end ui-mono">{f.file}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="ui-tray">
        <div class="ui-panel">
          <div class="ui-panel-head"><span class="ui-mono">Example: tokens.css output</span></div>
          <pre class="fx-pre">{`:root {
  `}<span class="c">/* Colors - extracted from codebase */</span>{`
  `}<ins>--color-primary</ins>{`: #3b82f6;
  `}<ins>--color-primary-dark</ins>{`: #2563eb;
  `}<ins>--color-secondary</ins>{`: #10b981;
  `}<ins>--color-text</ins>{`: #1f2937;
  `}<ins>--color-text-muted</ins>{`: #6b7280;
  `}<ins>--color-bg</ins>{`: #ffffff;
  `}<ins>--color-bg-secondary</ins>{`: #f3f4f6;

  `}<span class="c">/* Spacing */</span>{`
  `}<ins>--spacing-xs</ins>{`: 4px;
  `}<ins>--spacing-sm</ins>{`: 8px;
  `}<ins>--spacing-md</ins>{`: 16px;
  `}<ins>--spacing-lg</ins>{`: 24px;
  `}<ins>--spacing-xl</ins>{`: 32px;

  `}<span class="c">/* Typography */</span>{`
  `}<ins>--font-size-sm</ins>{`: 14px;
  `}<ins>--font-size-base</ins>{`: 16px;
  `}<ins>--font-size-lg</ins>{`: 18px;
  `}<ins>--font-size-xl</ins>{`: 24px;
}`}</pre>
        </div>
      </div>
    </div>
  </section>
</FeatureLayout>
