---
import FeatureLayout from '../../layouts/FeatureLayout.astro'
import CodeBlock from '../../components/CodeBlock.astro'

const filterTypes = [
  { title: '--file', description: 'Ignore drift in matching files or directories. Perfect for legacy code you won\'t be touching.', examples: ['src/legacy/**', 'vendor/**'] },
  { title: '--type', description: 'Ignore an entire drift type. Useful when a category doesn\'t apply to your project.', examples: ['hardcoded-color', 'hardcoded-spacing'] },
  { title: '--component', description: 'Ignore drift from a specific component. For intentional one-offs or third-party wrappers.', examples: ['LegacyCard', 'OldButton'] },
  { title: '--value', description: 'Ignore a specific hardcoded value. When a particular value is intentional and shouldn\'t be a token.', examples: ['#ff0000', '16px'] },
]

const how = [
  { title: 'Detect', text: 'Run buoy drift check to see all drift signals in your codebase.' },
  { title: 'Ignore intentional', text: 'Add ignore rules for legacy code, known exceptions, and intentional deviations.' },
  { title: 'Focus on real drift', text: 'Future checks only surface actionable issues. CI stays green for known exceptions.' },
]

const dashboard = [
  { title: 'Mark as ignored', text: 'Click "Ignore" on any existing issue in the dashboard. Add a reason so your team knows why.' },
  { title: 'Batch decisions', text: 'Pending ignores accumulate. Your whole team sees who proposed what. Undo anytime before syncing.' },
  { title: 'Sync via PR', text: 'One click creates a PR that adds ignore rules to your .buoy.yaml. Code stays the source of truth.' },
]

const relatedFeatures = [
  { title: 'Drift Detection', description: 'Find every inconsistency across your codebase', href: '/features/drift-detection' },
  { title: 'CI Integration', description: 'Add drift checks to your CI pipeline', href: '/features/ci' },
  { title: 'GitHub App', description: 'Catch drift in every PR automatically', href: '/features/github-action' },
]
---

<FeatureLayout
  title="Ignore Rules: Intentional Exceptions for Design Drift | Buoy"
  description="Tell Buoy what drift is intentional. Ignore by file, type, component, or value so your team focuses on real issues, not noise."
  keywords="design drift ignore, drift exceptions, design system noise, buoy ignore rules"
  heroTitle="Not all drift is a bug."
  heroDescription="Legacy code, intentional deviations, third-party wrappers: some drift is fine. Ignore rules let you tell Buoy what's intentional so your team focuses on what matters."
  exampleCaption="One command hides known legacy drift. Every rule stays visible."
  related={relatedFeatures}
  pattern="tide"
  ctaPattern="field"
>
  <div slot="example" class="ui-term fx-term">
    <div class="ui-term-bar"><span>Terminal</span></div>
    <pre><span class="ui-t-prompt">$</span> <span class="ui-t-hi">buoy drift ignore add --file "src/legacy/**"</span>
<span class="ui-t-ok">Added ignore rule:</span> files matching <span class="ui-t-info">"src/legacy/**"</span>
<span class="ui-t-dim">14 drift signals will be hidden.</span>

<span class="ui-t-prompt">$</span> <span class="ui-t-hi">buoy drift ignore show</span>
Ignore Rules
<span class="ui-t-dim">────────────</span>
1. files matching <span class="ui-t-info">"src/legacy/**"</span>     <span class="ui-t-dim">(14 signals)</span>
2. type: <span class="ui-t-warn">hardcoded-color</span>              <span class="ui-t-dim">(9 signals)</span>
3. component: <span class="ui-t-info">"LegacyCard"</span>            <span class="ui-t-dim">(3 signals)</span>

<span class="ui-t-dim">Total: 26 signals ignored</span></pre>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>The problem with no exceptions</h2>
        <p>A drift tool that can't be told "I know" becomes a noise machine. Teams stop trusting the output. Real issues hide behind a wall of known exceptions. Ignore rules fix that.</p>
      </div>
      <div class="ui-cols fx-vs">
        <div class="ui-col">
          <h3>Without ignore rules</h3>
          <p class="ui-col-sub ui-c-crit"><span class="ui-tnum">47</span> drift signals, but 30 are in legacy code</p>
          <ul class="ui-ruled">
            <li>CI fails on code nobody plans to change</li>
            <li>Team ignores the report entirely</li>
            <li>Real drift slips through the noise</li>
          </ul>
        </div>
        <div class="ui-col">
          <h3>With ignore rules</h3>
          <p class="ui-col-sub ui-c-ok"><span class="ui-tnum">17</span> drift signals, all actionable</p>
          <ul class="ui-ruled">
            <li>CI passes on known exceptions</li>
            <li>Team trusts the output</li>
            <li>Real drift gets caught immediately</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Four ways to filter</h2><p>Target exactly what you want to ignore. Combine flags for precision.</p></div>
      <table class="ui-table fx-block fx-table">
        <caption class="ui-sr">Ignore filters</caption>
        <thead><tr><th scope="col">Flag</th><th scope="col">What it ignores</th></tr></thead>
        <tbody>
          {filterTypes.map((f) => (
            <tr><th scope="row" class="ui-mono ui-c-buoy">{f.title}</th><td>{f.description}<br /><span class="ui-mono fx-ex">{f.examples.join(', ')}</span></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap ui-split">
      <div>
        <div class="ui-head"><h2>How it works</h2></div>
        <ol class="ui-steps fx-block">
          {how.map((s, i) => (
            <li><span class="ui-step-n" aria-hidden="true">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
          ))}
        </ol>
      </div>
      <div>
        <div class="ui-head"><h2>Combine filters for precision</h2><p>Stack flags to create targeted rules that match exactly what you need.</p></div>
        <div class="fx-block">
          <CodeBlock code={`# Ignore hardcoded colors in legacy files
buoy drift ignore add --file "src/legacy/**" --type hardcoded-color

# Ignore a specific value in a specific component
buoy drift ignore add --component "OldButton" --value "#333"

# Ignore all drift in vendor code
buoy drift ignore add --file "vendor/**"

# View your rules anytime
buoy drift ignore show`} language="bash" />
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>Ignore from the dashboard</h2>
        <p>Designers and non-CLI users can ignore existing issues directly from the Buoy Cloud dashboard. Batch your decisions, then sync to code with a single PR.</p>
      </div>
      <div class="ui-cols ui-cols--3">
        {dashboard.map((d, i) => (
          <div class="ui-col"><p class="ui-col-sub ui-c-buoy ui-tnum">{i + 1}</p><h3>{d.title}</h3><p>{d.text}</p></div>
        ))}
      </div>
      <p class="ui-after">When developers fix the underlying issue, stale pending ignores are cleaned up automatically on the next scan.</p>
    </div>
  </section>
</FeatureLayout>
