---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import DocTerminal from '../components/DocTerminal.astro'
import MarkPattern from '../components/MarkPattern.astro'
import { siteConfig } from '../config'

const aligned = ['NavigationPartial', 'LayoutCshtml', 'FooterCshtml', 'SidebarCshtml', 'BannerCshtml', 'PaginationPartial', 'ShareButtonsCshtml', 'SocialsPartial', 'LoginPartialCshtml', 'MessagesPartial', 'TagsPartialCshtml', 'LabelsPartialCshtml', 'PhotoViewerPartial', 'RecaptchaCshtml', 'TurnstileCshtml']
const uses = [
  { t: 'Match to Figma', d: 'Create Figma components for each one. Build your design library from code truth.' },
  { t: 'Add to Storybook', d: 'Know exactly which components need stories. Prioritize what matters.' },
  { t: 'Sync with Framer', d: 'Build prototypes with the real components your codebase actually has.' },
  { t: 'Document', d: 'Create a component inventory. Share it with your team. Everyone knows what exists.' },
]
const oldQs = ['"What components do we actually have?"', '"Is there already a sidebar component?"', '"Where\'s the navigation partial?"', '"What can I actually affect as a designer?"']
const questions = [
  { q: '"What components exist?"', a: 'Get a complete inventory of every reusable piece in your codebase.' },
  { q: '"Where\'s that sidebar thing?"', a: 'Find components by name. See exactly where they live.' },
  { q: '"What are the building blocks?"', a: 'See layouts, partials, views: the architecture of your UI.' },
  { q: '"What can I design for?"', a: 'Know which components exist so you can create matching designs.' },
  { q: '"What needs documenting?"', a: 'Use the list to prioritize which components to add to Storybook.' },
  { q: '"Where do I start?"', a: 'This list IS your starting point. Build your design system from here.' },
]
const designers = ['See if your design system is actually being used', 'Prove adoption with real numbers', 'Find where tokens are being bypassed', 'No code knowledge required']
const engineers = ['Quick codebase health check before PRs', 'Find and fix drift during development', 'Exact file paths and line numbers', 'Integrates with CI/CD pipelines']
---

<Layout title="One Command - Understand Your Codebase Instantly | Buoy">
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="pulse" drift={0.3} class="ui-pattern lp-pat-side" />
      <div class="ui-wrap lp-hero ui-split lp-hero-split">
        <div>
        <p class="ui-eyebrow ui-mono">npx ahoybuoy show health</p>
        <div class="ui-head"><h1>One command.<br /><span class="ui-c-buoy">See every component.</span></h1></div>
        <p class="ui-lede">Don't have a formal design system? Doesn't matter. See what's actually in your codebase.</p>
        <div class="ui-actions">
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary ui-btn--lg">Try it now</a>
          <a href="#the-output" class="ui-btn ui-btn--secondary ui-btn--lg">See the output</a>
        </div>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-term">
          <div class="ui-term-bar"><span>Terminal</span></div>
          <div class="ui-term-body">
            <div><span class="ui-t-prompt">$</span> <span class="ui-t-hi">npx ahoybuoy show health</span></div>
            <div class="oc-gap ui-t-hi">Component Alignment</div>
            <div class="oc-grid" aria-hidden="true">{Array(46).fill(0).map((_, i) => <span style={`--d:${i * 20}ms`}></span>)}</div>
            <div><span class="ui-t-ok">46/46 components</span> <span class="ui-t-dim">·</span> <span class="ui-t-ok">100% aligned</span></div>
            <div class="oc-gap ui-t-dim">Aligned:</div>
            <div class="oc-names">{aligned.map((n) => <span>{n}</span>)}</div>
            <div class="ui-t-dim">... and 31 more</div>
            <div class="oc-gap ui-t-ok">✓ 46 components discovered.</div>
          </div>
        </div>
        </figure>
      </div>
    </section>

    <section id="the-output" class="ui-section ui-section--band">
      <div class="ui-wrap ui-split">
        <div class="ui-head">
          <h2>Your component inventory.</h2>
          <p>Every component in your codebase, listed and categorized. Finally, clarity.</p>
          <p>Finally see what's actually in your codebase: the building blocks you can affect, improve, document, and design for. No more guessing. No more "I think we have a sidebar somewhere."</p>
        </div>
        <div>
          <h3 class="oc-sub">Now you know what's there.</h3>
          <p class="lp-muted">Use this list to build a real design system, or just understand what you're working with.</p>
          <table class="ui-table oc-uses"><tbody>{uses.map((u) => <tr><th scope="row">{u.t}</th><td>{u.d}</td></tr>)}</tbody></table>
          <p class="ui-after">You can't design for components you don't know exist. <strong class="ui-c-ok">Now you know.</strong></p>
        </div>
      </div>
    </section>

    

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>The codebase is a black box.</h2><p>For designers, code has always been invisible. You know your Figma file. You don't know the codebase.</p></div>
        <div class="ui-cols">
          <article class="ui-col">
            <h3 class="ui-c-crit">The old way</h3>
            <ul class="ui-ruled">{oldQs.map((q) => <li>{q}</li>)}</ul>
            <p class="ui-col-foot lp-muted">Ask a developer. Wait. Maybe get an answer.</p>
          </article>
          <article class="ui-col">
            <h3 class="ui-c-ok">With Buoy</h3>
            <div class="ui-term oc-mini">
              <pre><span class="ui-t-prompt">$</span> <span class="ui-t-hi">npx ahoybuoy show health</span>
<span class="ui-t-dim">...2 seconds later...</span>
NavigationPartial, LayoutCshtml, FooterCshtml,
SidebarCshtml, BannerCshtml...
<span class="ui-t-ok">✓ Every component. Listed. Named. Visible.</span></pre>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>No formal design system? Perfect.</h2><p>You don't need tokens or Storybook to use Buoy. It finds what's already there.</p></div>
        <table class="ui-table lp-table"><tbody>{questions.map((q) => <tr><th scope="row">{q.q}</th><td>{q.a}</td></tr>)}</tbody></table>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>One language. Two audiences.</h2><p>Whether you're a designer or a frontend engineer, the output speaks to you.</p></div>
        <div class="ui-cols">
          <article class="ui-col"><h3>For Designers</h3><p class="ui-col-sub ui-c-buoy">Design System Leads</p><ul class="ui-ruled">{designers.map((l) => <li>{l}</li>)}</ul></article>
          <article class="ui-col"><h3>For Engineers</h3><p class="ui-col-sub ui-c-ok">Frontend Developers</p><ul class="ui-ruled">{engineers.map((l) => <li>{l}</li>)}</ul></article>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="rain" drift={0.3} fade class="ui-pattern" />

      <div class="ui-wrap ui-split lp-cta">
        <div class="ui-head">
          <h2>Just one line.</h2>
          <p>No install. No config. No learning curve. Copy, paste, understand.</p>
          <div class="ui-actions"><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--secondary">View on GitHub</a></div>
        </div>
        <div>
          <DocTerminal command="npx ahoybuoy show health" />
          <p class="ui-note">Works with React, Vue, Svelte, Angular, and more.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .lp-hero-split { align-items: center; }
  .lp-hero-split .ui-head h1 { font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem); }

  :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 72%); mask-image: linear-gradient(100deg, transparent 38%, #000 72%); }
  @media (max-width: 960px) { :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); } }

  .lp-hero { padding-block: 32px 24px; }
  .lp-muted { color: var(--color-muted); font-size: 15px; }
  .lp-table { margin-top: 32px; }
  .lp-cta { align-items: center; }
  .ui-col h3 { font-size: 1.2rem; }
  .oc-gap { margin-top: 12px; }
  .oc-grid { display: grid; grid-template-columns: repeat(23, 12px); gap: 4px; margin: 8px 0; }
  .oc-grid span { width: 12px; height: 12px; border-radius: 3px; background: var(--color-ok); opacity: 0.85; animation: oc-in 300ms var(--ease-out-expo) both; animation-delay: var(--d); }
  @keyframes oc-in { from { opacity: 0; transform: scale(0.6); } }
  @media (prefers-reduced-motion: reduce) { .oc-grid span { animation: none; } }
  @media (max-width: 760px) { .oc-grid { grid-template-columns: repeat(12, 12px); } }
  .oc-names { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 16px; }
  .oc-mini { margin-top: 16px; }
  .oc-sub { margin: 0; font-size: 1.25rem; }
  .oc-uses { margin-top: 20px; }
</style>
