---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import LeadMagnetForm from '../components/LeadMagnetForm.astro'
import MarkPattern from '../components/MarkPattern.astro'

const patterns = [
  'Slight Variation', 'Opacity Hack', 'Eyedropper', 'Framework Default', 'Magic Number',
  'Inline Emergency', 'Copy-Paste Chain', 'Dark Mode Disaster', 'Multiple Sources', 'Abandoned Variable',
]
const swatches = [
  { hex: '#3B82F6', note: 'the token', ok: true },
  { hex: '#3A81F5', note: 'off by one', ok: false },
  { hex: '#3C83F7', note: '"close enough"', ok: false },
  { hex: '#3b82f6', note: 'hardcoded', ok: false },
]
const chain = [
  { file: 'components/Button.tsx (2019)', prop: 'backgroundColor', note: '' },
  { file: 'components/Link.tsx (2020)', prop: 'color', note: '"copied from Button"' },
  { file: 'features/dashboard/Card.tsx (2021)', prop: 'borderColor', note: '"same blue as buttons"' },
  { file: 'pages/marketing/Hero.tsx (2022)', prop: 'background', note: '"our brand blue"' },
  { file: 'mobile/components/Tab.tsx (2023)', prop: 'tintColor', note: '"matches web"' },
]
const chainHtml = chain.map((c) => `<span class="ui-t-dim">// ${c.file}</span>\n${c.prop}: <span class="ui-t-crit">'#3B82F6'</span>${c.note ? `<span class="ui-t-dim"> // ${c.note}</span>` : ''}\n\n`).join('') + '<span class="ui-t-warn">5 files. 5 years. One hardcoded value copied forward.</span>'
---

<Layout
  title="10 Hardcoded Color Patterns | Free PDF | Buoy"
  description="Ten ways hardcoded colors creep into a codebase, how to spot each one, and how to fix it. A free PDF from Buoy."
>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="rain" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap ui-split lm-hero">
        <div>
          <p class="ui-eyebrow">Free PDF</p>
          <div class="ui-head"><h1>10 Hardcoded Color Patterns</h1></div>
          <p class="ui-lede">Ten ways hardcoded colors creep into a codebase, how to spot each one, and how to fix it. Most repos have a few.</p>
          <div class="lm-form"><LeadMagnetForm leadMagnet="hall-of-shame" buttonText="Get the PDF" successMessage="Check your email for the download!" /></div>
          <p class="ui-note">No spam. Unsubscribe anytime.</p>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-tray">
            <div class="ui-panel">
              <div class="ui-panel-head"><span>One brand blue, four values</span></div>
              <ul class="hc-swatches">
                {swatches.map((w) => (
                  <li>
                    <span class="hc-chip" style={`background:${w.hex}`}></span>
                    <span class={`ui-mono hc-hex ${w.ok ? 'ui-c-ok' : 'ui-old'}`}>{w.hex}</span>
                    <span class="hc-note">{w.note}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <figcaption>The design system says <code class="ui-code">--color-primary: #3B82F6</code>. Side by side, nobody can tell them apart.</figcaption>
        </figure>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>The 10 patterns</h2></div>
        <ol class="lm-ten">
          {patterns.map((p, i) => <li><span class="ui-tnum lm-num">{String(i + 1).padStart(2, '0')}</span>{p}</li>)}
        </ol>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Sneak peek: the Copy-Paste Chain</h2></div>
        <div class="ui-term lm-code">
          <div class="ui-term-bar"><span>git log -S '#3B82F6'</span></div>
<pre set:html={chainHtml}></pre>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--band ui-section--patterned">
      <MarkPattern pattern="wake" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head"><h2>See all 10 patterns</h2><p>Each pattern comes with how to find it and how to fix it.</p></div>
          <div><LeadMagnetForm leadMagnet="hall-of-shame" idSuffix="end" buttonText="Send It to Me" successMessage="Done! Check your inbox." /><p class="ui-note">No spam. Unsubscribe anytime.</p></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .lm-hero { align-items: center; }
  .lm-form { margin-top: 32px; max-width: 480px; }
  .lm-ten { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; border-top: 1px solid var(--color-line-strong); }
  .lm-ten li { display: flex; gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--color-line); color: var(--color-ink); font-weight: 500; }
  .lm-num { font-family: var(--font-mono); font-size: 13px; color: var(--color-crit); }
  .lm-code { margin-top: 32px; max-width: 760px; }
  @media (max-width: 760px) { .lm-ten { grid-template-columns: minmax(0, 1fr); } }
  .hc-swatches { list-style: none; margin: 0; padding: 18px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .hc-swatches li { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .hc-chip { display: block; aspect-ratio: 3 / 4; border-radius: 10px; box-shadow: var(--ring); }
  .hc-hex { font-size: 13px; }
  .hc-note { font-size: 13px; color: var(--color-muted); }
  @media (max-width: 760px) { .hc-swatches { gap: 8px; padding: 12px; } .hc-hex, .hc-note { font-size: 11.5px; } }
</style>
