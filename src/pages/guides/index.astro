---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import MarkPattern from '../../components/MarkPattern.astro'

const guides = [
  { slug: 'how-to-audit-a-design-system', title: 'How to audit a design system in code', blurb: 'Inventory tokens and components, find what bypasses them, rank fixes by payoff, and keep it fixed.' },
  { slug: 'find-hardcoded-colors-and-spacing', title: 'How to find hardcoded colors and spacing in React, Vue and Tailwind', blurb: 'Search patterns that work, lint rules that keep literals out, and how to tell real drift from correct literals.' },
  { slug: 'design-system-health-score', title: 'How to measure design system health', blurb: 'The four pillars of a 0 to 100 health score, what does not count, and the path to 100.' },
  { slug: 'what-is-design-drift', title: 'What is design drift?', blurb: 'The gap between a design system and the code that ships: causes, examples, and prevention.' },
]
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Design system guides',
  url: 'https://buoy.design/guides',
  hasPart: guides.map((g) => ({ '@type': 'TechArticle', headline: g.title, url: `https://buoy.design/guides/${g.slug}` })),
}
---

<Layout title="Design System Guides: Audits, Hardcoded Values and Health Scores | Buoy" description="Practical guides to auditing a design system in code: finding hardcoded colors and spacing, measuring design system health, and preventing design drift." keywords="design system guides, design system audit, hardcoded values, design system health, design drift" jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.25} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head">
          <h1>Design system guides</h1>
          <p>How to check whether a codebase actually uses its design system, and keep it that way.</p>
        </div>
      </div>
    </section>
    <section class="ui-section ui-section--last">
      <div class="ui-wrap">
        <ol class="gi-list">
          {guides.map((g, i) => (
            <li>
              <span class="gi-n ui-tnum">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2><a href={`/guides/${g.slug}`}>{g.title}</a></h2>
                <p>{g.blurb}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="ui-after">Want the answer for a specific repository? <a href="/scan" class="ui-link">Scan it</a>.</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .gi-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line-strong); max-width: 820px; }
  .gi-list li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 8px; padding: 24px 0; border-bottom: 1px solid var(--color-line); }
  .gi-n { font-family: var(--font-mono); font-size: 14px; color: var(--color-buoy-light); padding-top: 6px; }
  .gi-list h2 { margin: 0; font-size: 1.375rem; line-height: 1.3; }
  .gi-list h2 a { color: var(--color-ink); text-decoration: none; }
  .gi-list h2 a:hover { color: var(--color-buoy-light); }
  .gi-list p { margin: 6px 0 0; color: var(--color-body); }
</style>
