---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'
import FreeSpots from '../components/FreeSpots.astro'

const MARKETPLACE_URL = 'https://github.com/marketplace/buoy-design'
const BOOKING_URL = 'https://cal.com/tarre/rescue'

const plans = [
  {
    name: 'Open source',
    tier: 'free',
    price: '$0',
    period: 'forever',
    audience: 'For anyone, in any repo',
    description: 'The same deterministic engine the GitHub App runs, on your machine and in your CI. MIT licensed.',
    features: [
      'CLI: drift check, health score, token-exact fixes',
      'MCP server that gives coding agents your tokens',
      'GitHub Action with fail-on-drift to block merges in your CI',
      'Unlimited repos, contributors, agents and runs',
      'Sends nothing to Buoy (telemetry is opt-in, counts only)',
    ],
    cta: 'View on GitHub',
    ctaHref: 'https://github.com/ahoybuoy/buoy',
    external: true,
    variant: 'secondary',
  },
  {
    name: 'GitHub App',
    price: '$0',
    period: 'for life',
    audience: 'For the first 100 installs',
    description: 'Hosted pull request reviews with no workflow files. Install while spots remain and your organization keeps it free for life.',
    features: [
      'Reviews only the lines a pull request adds',
      'Committable fixes that use your existing tokens',
      'Remembers suggestions your team declines',
      '@ahoybuoy answers questions on the pull request',
      'Dashboard and scan history',
      'Unlimited repos, contributors and agents',
    ],
    after: 'After the first 100 installs: Free for one private repo (50 reviewed pull requests a month), or Team at $149/month per design system. Public repos stay free.',
    cta: 'Install from GitHub',
    ctaHref: MARKETPLACE_URL,
    external: true,
    variant: 'primary',
    featured: true,
    tier: 'app',
  },
  {
    name: 'Organization',
    tier: 'org',
    price: 'From $500',
    period: 'per month',
    audience: 'For companies with several products or design systems',
    description: 'Everything in Team, across your products, plus the record of how your system holds up across the organization.',
    features: [
      'Everything in Team, for several products or design systems',
      'Org-wide drift record across every repo that uses your system',
      'SSO',
      'Design-partner relationship with the people building Buoy',
    ],
    cta: 'Talk to Dylan',
    ctaHref: BOOKING_URL,
    external: true,
    variant: 'secondary',
    secondaryHref: '/services',
    secondaryLabel: 'Hands-on help from Dylan',
  },
]

const comparison = [
  { feature: 'Deterministic drift engine (same rules everywhere)', open: true, app: true, ds: true },
  { feature: 'Block merges in your own CI (fail-on-drift)', open: true, app: true, ds: true },
  { feature: 'MCP server for coding agents', open: true, app: true, ds: true },
  { feature: 'Unlimited repos, contributors and agents', open: true, app: true, ds: true },
  { feature: 'Hosted pull request reviews, no workflow files', open: false, app: true, ds: true },
  { feature: 'Committable inline fixes on the pull request', open: false, app: true, ds: true },
  { feature: 'Remembers declined suggestions', open: false, app: true, ds: true },
  { feature: 'Dashboard and scan history', open: false, app: true, ds: true },
  { feature: 'Org-wide drift record', open: false, app: false, ds: true },
  { feature: 'Several products or design systems', open: false, app: false, ds: true },
  { feature: 'SSO', open: false, app: false, ds: true },
  { feature: 'Design-partner relationship', open: false, app: false, ds: true },
]

const faqs = [
  {
    question: 'What does "free for life" mean?',
    answer: 'If your GitHub organization or account installs the Buoy GitHub App while it is one of the first 100 installs, that organization keeps the GitHub App free for life: every repo, contributor and agent, including what we add to Team later. It belongs to the organization that installed, not to a person, and it does not transfer to another organization. It lasts for as long as Buoy runs the GitHub App. The Organization plan is separate.',
  },
  {
    question: 'What happens after the first 100 installs?',
    answer: 'New installs get one private repo free, with 50 reviewed pull requests a month. Team is $149 a month per design system, with unlimited repos, contributors, agents and runs. Public repositories stay free on every install. The open source CLI, MCP server and GitHub Action stay free for everyone.',
  },
  {
    question: 'Why no per-seat pricing?',
    answer: 'Agents write more and more of the code, and agents do not have seats. Per-person pricing would mean counting bots, or capping runs and skipping checks just when agent volume spikes. A deterministic check costs us almost nothing to run, so Team is one flat price per design system and every pull request gets the same check.',
  },
  {
    question: 'What counts as one design system?',
    answer: 'One set of tokens and components that your repos share. Five apps built on the same tokens are one design system. A separate token set, such as a second brand, is a second design system.',
  },
  {
    question: 'Can I block merges without paying?',
    answer: 'Yes. Add the open source GitHub Action with fail-on-drift (or run buoy check --fail-on) in your own CI and make it a required check. The GitHub App adds hosted reviews, committable fixes, remembered declines and history without any workflow files.',
  },
  {
    question: 'What data leaves my repo?',
    answerHtml: 'The CLI, MCP server and Action run on your machine or in your CI and send nothing to Buoy. The GitHub App reads pull request diffs and files through GitHub and scans them on Cloudflare. Some review prose, such as builder-mode coaching and @ahoybuoy answers, is written by an LLM through OpenRouter, which receives diff excerpts and file history. Findings are always deterministic; models never decide them. <a href="/privacy#subprocessors" class="ui-link">See exactly what is sent where</a>.',
  },
  {
    question: 'What does the Organization plan include?',
    answer: 'Everything in Team across several products or design systems, plus an org-wide drift record across every repo that uses them, SSO, and a design-partner relationship with the people building Buoy. It starts at $500 a month; talk to Dylan for a quote.',
  },
  {
    question: 'Can Dylan do the work for us?',
    answerHtml: 'Yes. <strong>System found</strong> ($10,000, one week): Dylan consolidates your tokens and theme, and writes DESIGN.md and the agent rules so Cursor or Claude stay on them. <strong>System in place</strong> ($20,000, two weeks): all of that, plus your worst components migrated in merged pull requests and a first adoption baseline. <strong>Keep it holding</strong> ($1,500 a month per product): Team plus a monthly adoption review. <a href="/services" class="ui-link">See services</a>.',
  },
]

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: (faq.answer ?? faq.answerHtml ?? '').replace(/<[^>]+>/g, ''),
    },
  })),
}

import MarkPattern from '../components/MarkPattern.astro'
---

<Layout
  title="Pricing | Buoy - Design Drift Detection"
  jsonLd={faqJsonLd}
  description="Open source CLI, MCP server and GitHub Action free forever. GitHub App free for life for the first 100 installs, then $149/month per design system. No seats."
  keywords="buoy pricing, design drift tool pricing, design system tool cost"
>
  <Nav />

  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned pr-hero">
      <MarkPattern pattern="tide" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head">
          <p class="ui-eyebrow"><FreeSpots class="ui-c-ok ui-tnum" /></p>
          <h1>One price per design system. No seats.</h1>
          <p class="ui-lede">
            The open source CLI, MCP server and GitHub Action are free forever. The GitHub App is
            free for life for the first 100 installs. After that, one private repo is free and Team is $149 a
            month per design system, with unlimited repos, contributors and agents.
          </p>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--first pr-plans-sec">
      <div class="ui-wrap">
        <div class="ui-cols ui-cols--3 pr-plans">
          {plans.map((plan) => (
            <article class="ui-col">
              <p class={`ui-tier-name ui-tier-${plan.tier}`}>{plan.audience}</p>
              <h2 class="pr-name">{plan.name}</h2>
              <p class="pr-price"><span class="ui-tnum">{plan.price}</span> <span>{plan.period}</span></p>
              <p>{plan.description}</p>
              <ul class="ui-ruled ui-ruled--tight">
                {plan.features.map((feature) => <li>{feature}</li>)}
              </ul>
              {plan.after && <p class="pr-after">{plan.after}</p>}
              <div class="pr-cta">
                <Button
                  href={plan.ctaHref}
                  variant={plan.variant as 'primary' | 'secondary'}
                  external={plan.external}
                  class="ui-btn--block"
                >
                  {plan.cta}
                </Button>
                {plan.secondaryHref && (
                  <a href={plan.secondaryHref} class="ui-rowlink pr-sub">{plan.secondaryLabel}</a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap pr-team">
        <div>
          <p class="ui-tier-name ui-tier-app">After the first 100 installs</p>
          <h2>Team</h2>
          <p class="pr-price"><span class="ui-tnum">$149</span> <span>per month, per design system</span></p>
          <p>
            The GitHub App for new installs once the 100 free-for-life spots are gone.
            Installs that got a spot keep it free for life.
          </p>
        </div>
        <ul class="ui-ruled ui-ruled--top">
          <li>Unlimited repos, contributors, agents and runs</li>
          <li>No seats: agents write the code, and every pull request gets the same check</li>
          <li>Public repos are always free</li>
          <li>Everything in the GitHub App column above</li>
        </ul>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Feature comparison</h2></div>
        <div class="pr-scroll">
          <table class="ui-table ui-table--hover pr-table">
            <thead>
              <tr>
                <th scope="col">Feature</th>
                <th scope="col"><span class="ui-tier-free"><span class="pr-long">Open source</span><span class="pr-short">Open</span></span></th>
                <th scope="col"><span class="ui-tier-app"><span class="pr-long">GitHub App / Team</span><span class="pr-short">App</span></span></th>
                <th scope="col"><span class="ui-tier-org"><span class="pr-long">Organization</span><span class="pr-short">Org</span></span></th>
              </tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  {[row.open, row.app, row.ds].map((included) => (
                    <td>
                      {included
                        ? <span class="pr-yes"><span class="pr-long">Included</span><span class="pr-short" aria-hidden="true">✓</span><span class="pr-short ui-sr">Included</span></span>
                        : <span class="pr-no"><span class="pr-long">Not included</span><span class="pr-short" aria-hidden="true">–</span><span class="pr-short ui-sr">Not included</span></span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band ui-section--last">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Frequently asked questions</h2></div>
        <div class="pr-faq">
          {faqs.map((faq) => (
            <details>
              <summary>
                <span>{faq.question}</span>
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="pr-answer">
                {faq.answerHtml ? <Fragment set:html={faq.answerHtml} /> : faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .pr-plans { margin-top: 0; }
  .pr-plans-sec { padding-top: 0; }
  .pr-name { margin: 6px 0 0; font-size: var(--text-h3); color: var(--color-ink); }
  .pr-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin: 14px 0 4px; }
  .pr-price > span:first-child { font-family: var(--font-display); font-size: 40px; font-weight: 700; line-height: 1; color: var(--color-ink); letter-spacing: -0.02em; }
  .pr-price > span + span { font-size: 14px; color: var(--color-muted); }
  .pr-plans .ui-ruled { margin-top: 20px; font-size: 14.5px; }
  .pr-after { margin-top: 18px !important; padding-top: 14px; border-top: 1px solid var(--color-line); font-size: 13.5px !important; color: var(--color-muted); }
  .pr-cta { margin-top: auto; padding-top: 24px; display: grid; gap: 12px; }
  .pr-sub { justify-self: center; font-size: 14px; }
  .pr-team { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .pr-team h2 { margin: 6px 0 0; font-size: var(--text-h2); color: var(--color-ink); }
  .pr-team .ui-ruled { margin: 0; }
  @media (max-width: 860px) { .pr-team { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
  .pr-scroll { margin-top: 40px; }
  .pr-table { width: 100%; }
  .pr-short { display: none; }
  @media (max-width: 640px) {
    .pr-long { display: none; }
    .pr-short:not(.ui-sr) { display: inline; }
    .pr-table thead th:not(:first-child), .pr-table td { width: 52px; padding-left: 4px; padding-right: 4px; }
    .pr-table th[scope="row"] { font-size: 14.5px; padding-right: 8px; }
    .pr-yes, .pr-no { font-size: 16px; }
  }
  .pr-table th[scope="row"] { font-weight: 400; color: var(--color-ink); text-align: left; text-transform: none; letter-spacing: 0; font-size: 15px; }
  .pr-table thead th:not(:first-child), .pr-table td { text-align: center; width: 18%; }
  .pr-yes { color: var(--color-ok); font-size: 14px; font-weight: 500; }
  .pr-no { color: var(--color-muted); font-size: 14px; opacity: 0.7; }
  .pr-faq { margin-top: 40px; max-width: 760px; border-top: 1px solid var(--color-line-strong); }
  .pr-faq details { border-bottom: 1px solid var(--color-line); }
  .pr-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; cursor: pointer; list-style: none; font-weight: 500; color: var(--color-ink); }
  .pr-faq summary::-webkit-details-marker { display: none; }
  .pr-faq summary svg { flex-shrink: 0; color: var(--color-muted); transition: transform 200ms var(--ease-out-expo); }
  .pr-faq details[open] summary svg { transform: rotate(180deg); }
  .pr-answer { padding: 0 0 22px; color: var(--color-body); max-width: 68ch; }
  @media (prefers-reduced-motion: reduce) { .pr-faq summary svg { transition: none; } }
</style>
