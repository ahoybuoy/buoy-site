---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'
import FreeSpots from '../components/FreeSpots.astro'

const MARKETPLACE_URL = 'https://github.com/marketplace/buoy-design'
const BOOKING_URL = 'https://cal.com/tarre/rescue'

const plans = [
  {
    name: 'Open source',
    price: '$0',
    period: 'forever',
    audience: 'For anyone, in any repo',
    description: 'The same deterministic engine the GitHub App runs, on your machine and in your CI. MIT licensed.',
    features: [
      'CLI: drift check, health score, token-exact fixes',
      'MCP server that gives coding agents your tokens',
      'GitHub Action with fail-on-drift to block merges in your CI',
      'Unlimited repos, contributors, agents and runs',
      'Sends nothing to Buoy (telemetry is opt-in, counts only)',
    ],
    cta: 'View on GitHub',
    ctaHref: 'https://github.com/ahoybuoy/buoy',
    external: true,
    variant: 'secondary',
  },
  {
    name: 'GitHub App',
    price: '$0',
    period: 'for life',
    audience: 'For the first 100 installs',
    description: 'Hosted pull request reviews with no workflow files. Install while spots remain and your organization keeps it free for life.',
    features: [
      'Reviews only the lines a pull request adds',
      'Committable fixes that use your existing tokens',
      'Remembers suggestions your team declines',
      '@ahoybuoy answers questions on the pull request',
      'Dashboard and scan history',
      'Unlimited repos, contributors and agents',
    ],
    after: 'After the first 100 installs: Team, $49/month per design system. Public repos stay free.',
    cta: 'Install from GitHub',
    ctaHref: MARKETPLACE_URL,
    external: true,
    variant: 'primary',
    featured: true,
  },
  {
    name: 'Design System',
    price: '$5,000',
    period: 'per year, per design system',
    audience: 'For design-system owners',
    description: 'Everything in Team for one design system, plus the record of how it holds up across your organization.',
    features: [
      'Everything in Team',
      'Org-wide drift record across every repo that uses your system',
      'Calibration in year one: your product rules, codified for agents, with agreed fixes shipped as pull requests',
      'Design-partner relationship with the people building Buoy',
    ],
    cta: 'Talk to Dylan',
    ctaHref: BOOKING_URL,
    external: true,
    variant: 'secondary',
    secondaryHref: '/services',
    secondaryLabel: 'What the plan includes',
  },
]

const comparison = [
  { feature: 'Deterministic drift engine (same rules everywhere)', open: true, app: true, ds: true },
  { feature: 'Block merges in your own CI (fail-on-drift)', open: true, app: true, ds: true },
  { feature: 'MCP server for coding agents', open: true, app: true, ds: true },
  { feature: 'Unlimited repos, contributors and agents', open: true, app: true, ds: true },
  { feature: 'Hosted pull request reviews, no workflow files', open: false, app: true, ds: true },
  { feature: 'Committable inline fixes on the pull request', open: false, app: true, ds: true },
  { feature: 'Remembers declined suggestions', open: false, app: true, ds: true },
  { feature: 'Dashboard and scan history', open: false, app: true, ds: true },
  { feature: 'Org-wide drift record', open: false, app: false, ds: true },
  { feature: 'Calibration in year one', open: false, app: false, ds: true },
  { feature: 'Design-partner relationship', open: false, app: false, ds: true },
]

const faqs = [
  {
    question: 'What does "free for life" mean?',
    answer: 'If your GitHub organization or account installs the Buoy GitHub App while it is one of the first 100 installs, that organization keeps the GitHub App free for life: every repo, contributor and agent, including what we add to Team later. It belongs to the organization that installed, not to a person, and it does not transfer to another organization. It lasts for as long as Buoy runs the GitHub App. The Design System plan is separate.',
  },
  {
    question: 'What happens after the first 100 installs?',
    answer: 'New installs use Team: $49 a month per design system, with unlimited repos, contributors, agents and runs. Public repositories stay free on every install. The open source CLI, MCP server and GitHub Action stay free for everyone.',
  },
  {
    question: 'Why no per-seat pricing?',
    answer: 'Agents write more and more of the code, and agents do not have seats. Per-person pricing would mean counting bots, or capping runs and skipping checks just when agent volume spikes. A deterministic check costs us almost nothing to run, so Team is one flat price per design system and every pull request gets the same check.',
  },
  {
    question: 'What counts as one design system?',
    answer: 'One set of tokens and components that your repos share. Five apps built on the same tokens are one design system. A separate token set, such as a second brand, is a second design system.',
  },
  {
    question: 'Can I block merges without paying?',
    answer: 'Yes. Add the open source GitHub Action with fail-on-drift (or run buoy check --fail-on) in your own CI and make it a required check. The GitHub App adds hosted reviews, committable fixes, remembered declines and history without any workflow files.',
  },
  {
    question: 'What data leaves my repo?',
    answerHtml: 'The CLI, MCP server and Action run on your machine or in your CI and send nothing to Buoy. The GitHub App reads pull request diffs and files through GitHub and scans them on Cloudflare. Some review prose, such as builder-mode coaching and @ahoybuoy answers, is written by an LLM through OpenRouter, which receives diff excerpts and file history. Findings are always deterministic; models never decide them. <a href="/privacy#subprocessors" class="text-buoy hover:underline">See exactly what is sent where</a>.',
  },
  {
    question: 'What does the Design System plan include?',
    answer: 'Everything in Team for one design system, plus an org-wide drift record across every repo that uses it, calibration in year one (we capture your product rules, codify them for your coding agents, ship agreed fixes as reviewable pull requests and set up guardrails), and a design-partner relationship with the people building Buoy. It costs $5,000 a year per design system.',
  },
]
---

<Layout
  title="Pricing | Buoy - Design Drift Detection"
  description="Open source CLI, MCP server and GitHub Action free forever. GitHub App free for life for the first 100 installs, then $49/month per design system. No seats."
  keywords="buoy pricing, design drift tool pricing, design system tool cost"
>
  <Nav />

  <!-- Hero -->
  <section class="relative pt-32 pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-navy to-navy-dark"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-success/10 border border-success/30 mb-6">
        <FreeSpots class="text-success font-medium text-sm" />
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-light mb-6">
        One price per design system. No seats.
      </h1>
      <p class="text-lg text-slate max-w-2xl mx-auto">
        The open source CLI, MCP server and GitHub Action are free forever. The GitHub App is
        free for life for the first 100 installs. After that, Team is $49 a month per design
        system, with unlimited repos, contributors and agents.
      </p>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="py-16 bg-navy-dark">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        {plans.map((plan) => (
          <div class={`relative flex flex-col bg-navy/50 border rounded-2xl p-8 ${plan.featured ? 'border-buoy' : 'border-navy-light/20'}`}>
            {plan.featured && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-sunrise text-navy-dark text-xs font-semibold rounded-full whitespace-nowrap">
                First 100 installs
              </div>
            )}

            <div class="text-center mb-6">
              <h2 class="text-xl font-bold text-light mb-1">{plan.name}</h2>
              <p class="text-xs text-slate mb-4">{plan.audience}</p>
              <div class="flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1">
                <span class="text-4xl font-bold text-light">{plan.price}</span>
                <span class="text-slate text-sm">{plan.period}</span>
              </div>
              <p class="text-sm text-slate mt-3">{plan.description}</p>
            </div>

            <ul class="space-y-3 mb-6">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2 text-sm text-slate">
                  <svg class="w-5 h-5 text-success flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            {plan.after && (
              <p class="text-sm text-light bg-navy-dark border border-navy-light/30 rounded-lg p-3 mb-6">
                {plan.after}
              </p>
            )}

            <div class="mt-auto space-y-3">
              <Button
                href={plan.ctaHref}
                variant={plan.variant as 'primary' | 'secondary'}
                external={plan.external}
                class="w-full justify-center"
              >
                {plan.cta}
              </Button>
              {plan.secondaryHref && (
                <a href={plan.secondaryHref} class="block text-center text-sm text-buoy hover:underline">
                  {plan.secondaryLabel} →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-16 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-navy-dark border border-navy-light/30 rounded-2xl p-8">
        <div class="grid md:grid-cols-2 gap-8 items-start">
          <div>
            <p class="text-buoy font-medium mb-2">After the first 100 installs</p>
            <h2 class="text-2xl font-bold text-light mb-2">Team</h2>
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 mb-4">
              <span class="text-3xl font-bold text-light">$49</span>
              <span class="text-slate text-sm">per month, per design system</span>
            </div>
            <p class="text-slate text-sm">
              The GitHub App for new installs once the 100 free-for-life spots are gone.
              Installs that got a spot keep it free for life.
            </p>
          </div>
          <ul class="space-y-3 text-sm text-slate">
            <li class="flex items-start gap-2"><span class="text-success">✓</span> Unlimited repos, contributors, agents and runs</li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span> No seats: agents write the code, and every pull request gets the same check</li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span> Public repos are always free</li>
            <li class="flex items-start gap-2"><span class="text-success">✓</span> Everything in the GitHub App column above</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Comparison -->
  <section class="py-16 bg-navy-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-light mb-8 text-center">Feature comparison</h2>

      <div class="overflow-x-auto">
        <div class="min-w-xl bg-navy-dark border border-navy-light/30 rounded-xl overflow-hidden">
          <div class="grid grid-cols-4 bg-navy border-b border-navy-light/20 text-sm">
            <div class="p-4 font-semibold text-slate">Feature</div>
            <div class="p-4 font-semibold text-slate text-center border-l border-navy-light/20">Open source</div>
            <div class="p-4 font-semibold text-buoy text-center border-l border-navy-light/20">GitHub App / Team</div>
            <div class="p-4 font-semibold text-slate text-center border-l border-navy-light/20">Design System</div>
          </div>

          {comparison.map((row, index) => (
            <div class={`grid grid-cols-4 text-sm ${index % 2 === 0 ? 'bg-navy/30' : ''}`}>
              <div class="p-4 text-light">{row.feature}</div>
              {[row.open, row.app, row.ds].map((included) => (
                <div class="p-4 text-center border-l border-navy-light/20">
                  {included
                    ? <span class="text-success" aria-label="Included">✓</span>
                    : <span class="text-slate-dark" aria-label="Not included">—</span>}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-navy">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-light mb-8 text-center">Frequently asked questions</h2>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-navy-dark/50 border border-navy-light/20 rounded-xl">
            <summary class="flex items-center justify-between gap-4 p-4 cursor-pointer list-none">
              <span class="font-medium text-light">{faq.question}</span>
              <svg class="w-5 h-5 text-slate flex-shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-4 pb-4 text-slate">
              {faq.answerHtml ? <Fragment set:html={faq.answerHtml} /> : faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
