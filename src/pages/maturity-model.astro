---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import LeadMagnetForm from '../components/LeadMagnetForm.astro'
import MarkPattern from '../components/MarkPattern.astro'

const levels = [
  { level: '5', title: 'Automated Governance', desc: 'System enforces itself' },
  { level: '4', title: 'Measured Adoption', desc: 'You know what\'s used' },
  { level: '3', title: 'Documented Standards', desc: 'Anyone can find answers' },
  { level: '2', title: 'Shared Components', desc: 'Code exists, adoption varies' },
  { level: '1', title: 'Ad Hoc', desc: 'Every dev for themselves' },
]
const inside = [
  { title: '5 Levels Defined', desc: 'Clear characteristics for each maturity stage' },
  { title: 'Self-Assessment', desc: 'Checklists to identify your current level' },
  { title: 'Focus Areas', desc: 'What to prioritize at each level' },
  { title: 'Common Mistakes', desc: 'Pitfalls to avoid at each stage' },
]
const benchmarks = [
  { level: '1', pct: 35, size: '1-10' },
  { level: '2', pct: 30, size: '5-30' },
  { level: '3', pct: 20, size: '20-100' },
  { level: '4', pct: 10, size: '50-500' },
  { level: '5', pct: 5, size: '100+' },
]
---

<Layout
  title="Design System Maturity Model | Free Guide | Buoy"
  description="5 levels from ad hoc to automated governance. Self-assessment checklists and roadmap for each level."
>
  <Nav />
  <main id="main" class="ui-nav-offset lm">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="pulse" drift={0.25} fade class="ui-pattern" />
      <div class="ui-wrap ui-split lm-hero">
        <div>
          <p class="ui-eyebrow">Free framework</p>
          <div class="ui-head"><h1>The Design System Maturity Model</h1></div>
          <p class="ui-lede">Understand where you are, where you're going, and what to focus on next. 5 levels from ad hoc to automated governance.</p>
          <div class="lm-form">
            <LeadMagnetForm leadMagnet="maturity-model" buttonText="Get the Guide" successMessage="Check your email for the download!" />
          </div>
          <p class="ui-note">No spam. Unsubscribe anytime.</p>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-tray">
            <div class="ui-panel mm-stairs-panel">
              <div class="ui-panel-head"><span>The five levels</span></div>
              <ol class="mm-stairs" aria-label="Five maturity levels, from 1 Ad Hoc to 5 Automated Governance">
                {[...levels].reverse().map((l, i) => (
                  <li style={`--h:${(i + 1) * 20}%`}>
                    <span class="mm-step"><span class="mm-n ui-tnum">L{l.level}</span></span>
                    <strong>{l.title}</strong>
                    <span class="lm-desc">{l.desc}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <figcaption>Most teams sit at levels 1 and 2. The guide shows what moves you up a step.</figcaption>
        </figure>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>What's inside</h2></div>
        <table class="ui-table lm-table">
          <tbody>
            {inside.map((i) => <tr><th scope="row">{i.title}</th><td>{i.desc}</td></tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <blockquote class="lm-quote">
          <p>"Design systems fail not because they're poorly designed, but because organizations try to solve <span class="ui-c-buoy">Level 4</span> problems with <span class="ui-c-crit">Level 1</span> infrastructure."</p>
          <footer>Know your level. Focus on the right things.</footer>
        </blockquote>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Industry benchmarks</h2><p>% of teams at each level, typical team size.</p></div>
        <table class="ui-table lm-table lm-bench">
          <thead><tr><th scope="col">Level</th><th scope="col">Share of teams</th><th scope="col" class="ui-end">Team size</th></tr></thead>
          <tbody>
            {benchmarks.map((b) => (
              <tr>
                <th scope="row">L{b.level}</th>
                <td>
                  <span class="lm-bar-row">
                    <span class="lm-bar" style={`--w:${b.pct / 35}`}></span>
                    <span class="ui-tnum lm-pct">{b.pct}%</span>
                  </span>
                </td>
                <td class="ui-end ui-tnum">{b.size} devs</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="tide" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head"><h2>Find your level</h2><p>Self-assessment checklists. Level-up roadmaps. Free.</p></div>
          <div><LeadMagnetForm leadMagnet="maturity-model" idSuffix="end" buttonText="Send It to Me" successMessage="Done! Check your inbox." /><p class="ui-note">No spam. Unsubscribe anytime.</p></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .lm-hero { align-items: center; }
  .lm-form { margin-top: 32px; max-width: 480px; }
  .lm-levels { list-style: none; margin: 0; padding: 0; }
  .lm-levels li { display: flex; gap: 16px; align-items: baseline; padding: 14px 18px; border-top: 1px solid var(--color-line); }
  .lm-levels li:first-child { border-top: 0; }
  .lm-levels strong { display: block; color: var(--color-ink); font-weight: 600; font-size: 15px; }
  .lm-desc { display: block; color: var(--color-muted); font-size: 14px; }
  .lm-n { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--color-buoy-light); width: 1ch; }
  .lm-table { margin-top: 32px; }
  .lm-quote { margin: 0 auto; max-width: 820px; text-align: center; }
  .lm-quote p { margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); line-height: 1.3; font-weight: 600; color: var(--color-ink); text-wrap: balance; }
  .lm-quote footer { margin-top: 16px; color: var(--color-muted); font-size: 15px; }
  .lm-bar-row { display: flex; align-items: center; gap: 12px; }
  .lm-bar { display: block; height: 10px; width: calc(var(--w) * min(320px, 40vw)); min-width: 8px; border-radius: 3px; background: var(--color-buoy); flex: 0 1 auto; }
  .lm-bench td:nth-child(2) { width: 60%; }
  .lm-pct { color: var(--color-ink); font-weight: 600; }
  .mm-stairs { list-style: none; margin: 0; padding: 20px 18px 18px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; align-items: end; height: 340px; }
  .mm-stairs li { display: flex; flex-direction: column; justify-content: flex-end; height: 100%; min-width: 0; }
  .mm-step { display: flex; align-items: flex-start; height: var(--h); padding: 10px; border-radius: 10px 10px 4px 4px; background: color-mix(in oklab, var(--color-buoy) calc(var(--h) * 0.55), var(--color-sunken)); }
  .mm-n { font-family: var(--font-display); font-weight: 700; color: var(--color-ink); }
  .mm-stairs strong { margin-top: 10px; font-size: 13px; line-height: 1.25; }
  .mm-stairs .lm-desc { font-size: 12.5px; line-height: 1.35; margin-top: 2px; }
  @media (max-width: 760px) { .mm-stairs { height: 300px; gap: 6px; padding-inline: 12px; } .mm-stairs .lm-desc { display: none; } }
</style>
