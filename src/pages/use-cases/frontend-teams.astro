---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro'
import Terminal from '../../components/Terminal.astro'
import LeadMagnetCTA from '../../components/LeadMagnetCTA.astro'

const challenges = [
  {
    title: 'AI code drift',
    description: 'Copilot and Claude write code that works but ignores your design system. Hardcoded colors, recreated components, inconsistent naming.',
  },
  {
    title: 'Component sprawl',
    description: 'Button, ButtonNew, MyButton, CustomButton. Same component, four implementations. Which one is the "right" one?',
  },
  {
    title: 'Code review fatigue',
    description: 'Manually checking every PR for design system compliance doesn\'t scale. Things slip through.',
  },
  {
    title: 'Inconsistent patterns',
    description: 'Different developers use different patterns. onClick vs onPress. size="lg" vs size="large". No enforcement.',
  },
]

const steps = [
  { title: 'Automated PR checks', text: 'Every pull request gets scanned automatically. No manual review needed for design system compliance. Focus code review on logic, not style.' },
  { title: 'Catch AI drift', text: 'AI tools write working code but ignore your design system. Buoy catches hardcoded values and recreated components before they merge.' },
  { title: 'Consolidate components', text: 'Find duplicate implementations and decide which to keep. Reduce your component surface area and maintenance burden.' },
  { title: 'Enforce conventions', text: 'Automatically enforce naming conventions, prop types, and patterns. New developers get immediate feedback on team standards.' },
]

const terminalLines = [
  { text: '', delay: 600 },
  { text: 'Scanning frontend codebase...', type: 'output', delay: 800 },
  { text: '', delay: 1200 },
  { text: 'Found <span class="ui-t-hi">156</span> components across <span class="ui-t-hi">89</span> files', type: 'output', delay: 1400 },
  { text: '', delay: 1600 },
  { text: '<span class="ui-t-warn">COMPONENT DUPLICATES</span>', type: 'output', delay: 1800 },
  { text: '├─ Button (4 implementations)', type: 'warning', delay: 2000 },
  { text: '│  ├─ src/components/Button.tsx', type: 'muted', delay: 2200 },
  { text: '│  ├─ src/ui/ButtonNew.tsx', type: 'muted', delay: 2400 },
  { text: '│  ├─ src/features/checkout/MyButton.tsx', type: 'muted', delay: 2600 },
  { text: '│  └─ src/common/CustomButton.tsx', type: 'muted', delay: 2800 },
  { text: '└─ Card (2 implementations)', type: 'warning', delay: 3000 },
]
---

<UseCaseLayout
  title="Frontend Component Consistency Tools | Buoy"
  description="Keep components aligned as your frontend team scales. Catch hardcoded values, prop inconsistencies, and naming drift."
  keywords="frontend consistency, component library health, react team tools"
  heroTitle="Frontend Teams"
  heroDescription="Keep your components aligned as your team scales. Catch drift before it becomes technical debt."
>
  <div slot="hero">
    <div class="ui-tray">
      <div class="ui-panel">
        <div class="ui-panel-head">PR review · src/features/checkout/MyButton.tsx</div>
        <div class="fe-review">
          <p class="fe-who"><span class="ui-c-buoy">Buoy</span> <span class="ui-sev ui-sev-warning">Warning</span></p>
          <p class="fe-msg">Button already exists in <span class="ui-mono">src/components/Button.tsx</span>. This is the 4th implementation.</p>
          <pre class="fe-diff"><span class="fe-del">- export function MyButton(props) {'{'} … {'}'}</span>
<span class="fe-add">+ import {'{'} Button {'}'} from '@/components/Button'</span></pre>
        </div>
      </div>
    </div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Frontend team challenges</h2></div>
      <div class="fe-cols mt-10">
        {challenges.map((c) => (
          <article class="fe-col"><h3>{c.title}</h3><p class="mt-3">{c.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split fe-split">
      <div>
        <div class="ui-head"><h2>Find problems automatically</h2><p>No signup. No config file needed. Just run it.</p></div>
        <p class="mt-6"><code class="ui-code">npx ahoybuoy drift scan</code></p>
      </div>
      <Terminal command="buoy drift check" lines={terminalLines} />
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>How Buoy helps</h2></div>
      <ol class="ui-steps mt-10">
        {steps.map((s, i) => (
          <li><span class="ui-step-n">{i + 1}</span><div><h3>{s.title}</h3><p>{s.text}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <LeadMagnetCTA
    leadMagnet="drift-checklist"
    headline="Start catching drift today"
    subhead="20 warning signs to spot design drift in your next code review. Even before you automate."
    buttonText="Get the Checklist"
  />
</UseCaseLayout>

<style>
  .fe-review { padding: 20px 24px; }
  .fe-who { margin: 0 0 8px; font-weight: 600; display: flex; gap: 10px; align-items: baseline; }
  .fe-msg { margin: 0 0 16px; color: var(--color-body); }
  .fe-diff { margin: 0; padding: 12px 0; border-radius: var(--radius-btn); background: var(--color-term); font-size: .8125rem; line-height: 1.7; white-space: pre-wrap; word-break: break-word; }
  .fe-del, .fe-add { display: block; padding: 0 14px; }
  .fe-del { background: var(--color-del-bg); color: var(--color-del-ink); }
  .fe-add { background: var(--color-add-bg); color: var(--color-add-ink); }
  .fe-split { align-items: center; }
  .fe-cols { display: grid; gap: 40px 48px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .fe-col { border-top: 1px solid var(--color-line-strong); padding-top: 20px; }
  @media (max-width: 720px) { .fe-cols { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .fe-review { padding: 16px; } }
</style>
