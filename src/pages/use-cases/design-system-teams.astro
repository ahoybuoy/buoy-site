---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro'
import Terminal from '../../components/Terminal.astro'
import LeadMagnetCallout from '../../components/LeadMagnetCallout.astro'

const painPoints = [
  {
    problem: 'Spending hours on manual audits',
    solution: 'Automated scans in seconds, run on every PR'
  },
  {
    problem: 'No data on which teams are adopting',
    solution: 'Per-directory adoption metrics and trends'
  },
  {
    problem: 'Can\'t prove ROI of design system investment',
    solution: 'Real numbers: adoption %, drift reduction over time'
  },
  {
    problem: '"We think we have 60% adoption" isn\'t good enough',
    solution: 'Know exactly: 47% component coverage, 63% token coverage'
  },
]

const metrics = [
  { label: 'Component coverage', value: '47%', change: '+12% this month' },
  { label: 'Token adoption', value: '63%', change: '+8% this month' },
  { label: 'Drift signals', value: '23', change: '-15 from last week' },
  { label: 'Teams onboarded', value: '4/6', change: '+1 this sprint' },
]

const terminalLines = [
  { text: '', delay: 600 },
  { text: '<span class="ui-t-hi">Design System Coverage</span>', type: 'output', delay: 800 },
  { text: '═══════════════════════════════════════', type: 'muted', delay: 1000 },
  { text: '', delay: 1200 },
  { text: 'Components: <span class="ui-t-warn">47%</span> ████████░░░░░░░░░░', type: 'output', delay: 1400 },
  { text: 'Tokens:     <span class="ui-t-ok">63%</span> ████████████░░░░░░', type: 'output', delay: 1600 },
  { text: 'Overall:    <span class="ui-t-warn">52%</span> ██████████░░░░░░░░', type: 'output', delay: 1800 },
  { text: '', delay: 2000 },
  { text: '<span class="ui-t-dim">By Source:</span>', type: 'output', delay: 2200 },
  { text: '├─ src/components/    <span class="ui-t-ok">78%</span> ███████████████░', type: 'output', delay: 2400 },
  { text: '├─ src/features/      <span class="ui-t-warn">34%</span> ██████░░░░░░░░░', type: 'warning', delay: 2600 },
  { text: '└─ src/pages/         <span class="ui-t-crit">23%</span> ████░░░░░░░░░░░', type: 'critical', delay: 2800 },
]

const groups = [
  { title: 'Adoption metrics', items: ['Percentage of components using design system', 'Token coverage across the codebase', 'Per-directory and per-team breakdowns', 'Trend tracking over time'] },
  { title: 'Drift detection', items: ['Find hardcoded values that bypass tokens', 'Detect duplicate component implementations', 'Track deprecated component usage', 'Catch naming inconsistencies'] },
  { title: 'CI/CD integration', items: ['Automatic checks on every PR', 'Block merges with critical drift', 'PR comments with drift reports', 'GitHub App ready to use'] },
  { title: 'ROI reporting', items: ['Before/after adoption comparisons', 'Time saved from reduced drift', 'Team adoption leaderboards', 'Executive-ready dashboards'] },
]
---

<UseCaseLayout
  title="Design System Adoption Tools for Teams | Buoy"
  description="Measure design system adoption without manual audits. Track which teams use components, see coverage trends, prove ROI."
  keywords="design system adoption, design system metrics, design system ROI"
  heroTitle="Design System Teams"
  heroDescription="Measure design system adoption without manual audits. Track which teams use components, see coverage trends, and prove ROI."
>
  <div slot="hero">
    <div class="ui-tray">
      <div class="ui-panel">
        <div class="ui-panel-head">Design system health</div>
        <div class="dst-stats">
          {metrics.map((m) => (
            <div>
              <p class="dst-num ui-tnum">{m.value}</p>
              <p class="dst-lab">{m.label}</p>
              <p class="dst-chg ui-c-ok ui-tnum">{m.change}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Your pain points, solved</h2></div>
      <table class="ui-table cmp-table mt-10">
        <thead><tr><th scope="col">Problem</th><th scope="col" class="cmp-buoy">With Buoy</th></tr></thead>
        <tbody>
          {painPoints.map((p) => (
            <tr><td class="cmp-them">{p.problem}</td><td class="cmp-buoy">{p.solution}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split dst-split">
      <div class="ui-head">
        <h2>Coverage by directory</h2>
        <p>See where adoption is strong and where it lags, down to the folder.</p>
      </div>
      <Terminal command="buoy show health" lines={terminalLines} />
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What you get</h2></div>
      <div class="dst-cols mt-10">
        {groups.map((g) => (
          <article class="dst-col">
            <h3>{g.title}</h3>
            <ul>
              {g.items.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <LeadMagnetCallout
        leadMagnet="why-developers-bypass"
        headline="Why do developers bypass your design system?"
        subhead="It's not laziness. Get the research on the real friction points and what high-adoption teams do differently."
        buttonText="Get the Report"
      />
    </div>
  </section>
</UseCaseLayout>

<style>
  .dst-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dst-stats > div { padding: 20px 24px; }
  .dst-stats > div:nth-child(even) { border-left: 1px solid var(--color-line); }
  .dst-stats > div:nth-child(n+3) { border-top: 1px solid var(--color-line); }
  .dst-num { font-family: var(--font-display); font-weight: 700; font-size: 2.5rem; line-height: 1; color: var(--color-ink); margin: 0 0 8px; }
  .dst-lab { margin: 0; font-size: .875rem; color: var(--color-body); }
  .dst-chg { margin: 4px 0 0; font-size: .8125rem; }
  .dst-split { align-items: center; }
  .dst-cols { display: grid; gap: 40px 48px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dst-col { border-top: 1px solid var(--color-line-strong); padding-top: 20px; }
  .dst-col ul { list-style: none; margin: 12px 0 0; padding: 0; }
  .dst-col li { padding: 10px 0; border-top: 1px solid var(--color-line); }
  .dst-col li:first-child { border-top: 0; }
  @media (max-width: 720px) { .dst-cols { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .dst-stats > div { padding: 16px; } .dst-num { font-size: 2rem; } }
</style>
