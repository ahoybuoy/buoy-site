---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro'
import LeadMagnetCallout from '../../components/LeadMagnetCallout.astro'

const phases = [
  {
    phase: 'Assess',
    description: 'Scan your legacy codebase to understand the current state. How many hardcoded values? How many duplicate components?',
  },
  {
    phase: 'Track',
    description: 'As you migrate, track progress with real metrics. See adoption grow week over week, sprint over sprint.',
  },
  {
    phase: 'Enforce',
    description: 'Once migrated, enforce the new patterns. Block PRs that introduce new legacy patterns.',
  },
  {
    phase: 'Report',
    description: 'Show leadership exactly how much is done, what\'s left, and the trend. No more "we think 60%".',
  },
]

const progress = [
  { label: 'Migrated', value: 47, cls: 'ok' },
  { label: 'In progress', value: 15, cls: 'warn' },
  { label: 'Legacy code', value: 38, cls: 'crit' },
]
---

<UseCaseLayout
  title="Legacy Code Modernization Tracking | Buoy"
  description="Track your frontend migration from legacy to modern design system. Know what's migrated, what's legacy, and what's drifting."
  keywords="legacy modernization tracking, frontend migration, legacy code migration"
  heroTitle="Modernization Tracking"
  heroDescription="Track your migration from legacy to modern with data, not guesswork. Leadership asks 'how much is done?' Now you'll know."
>
  <div slot="hero">
    <div class="ui-tray">
      <div class="ui-panel">
        <div class="ui-panel-head">Migration progress · buoy show health</div>
        <div class="mod-body">
          <div class="mod-bar" role="img" aria-label="47% migrated, 15% in progress, 38% legacy">
            {progress.map((p) => <span class={`mod-seg mod-${p.cls}`} style={`flex-basis:${p.value}%`}></span>)}
          </div>
          <ul class="mod-legend">
            {progress.map((p) => (
              <li><span class={`mod-pct ui-tnum ui-c-${p.cls}`}>{p.value}%</span><span>{p.label}</span></li>
            ))}
          </ul>
          <dl class="mod-facts">
            <div><dt>This sprint</dt><dd class="ui-c-ok">+8% migrated</dd></div>
            <div><dt>Velocity</dt><dd>~12% per sprint</dd></div>
            <div><dt>ETA</dt><dd class="ui-c-info">3 more sprints to 100%</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap ui-split mod-split">
      <div class="ui-head"><h2>The modernization question</h2><p>The answer on the right is what Buoy replaces it with.</p></div>
      <blockquote class="mod-q">
        <p>Leadership asks: "How much of the legacy code is migrated?"</p>
        <p class="mod-answer ui-mono ui-c-warn">You say: "We think... maybe 60%?"</p>
      </blockquote>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Migration phases with Buoy</h2></div>
      <ol class="ui-steps mt-10">
        {phases.map((p, i) => (
          <li><span class="ui-step-n">{i + 1}</span><div><h3>{p.phase}</h3><p>{p.description}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap ui-split mod-split">
      <div>
        <div class="ui-head"><h2>Configuration for migrations</h2><p>Tell Buoy what legacy means in your codebase, and it tracks the rest.</p></div>
        <ul class="ui-ruled ui-ruled--top mt-8">
          <li><strong>Exact numbers.</strong> Not "we think 60%" but "<span class="ui-c-ok">47.3% migrated</span>, up 8% from last sprint"</li>
          <li><strong>Velocity tracking.</strong> Know your migration velocity and estimate completion dates</li>
          <li><strong>Prevent regression.</strong> Block PRs that add new legacy code to migrated areas</li>
        </ul>
      </div>
      <div class="ui-tray">
        <div class="ui-panel">
          <div class="ui-panel-head">.buoy.yaml</div>
          <pre class="mod-pre"><code><span class="ui-t-dim"># Define what "legacy" means</span>
legacy:
  <span class="ui-t-dim"># Legacy directories to track</span>
  directories:
    - <span class="ui-t-ok">"src/legacy/"</span>
    - <span class="ui-t-ok">"src/old-components/"</span>

  <span class="ui-t-dim"># Legacy patterns to detect</span>
  patterns:
    - <span class="ui-t-ok">'className="legacy-*"'</span>
    - <span class="ui-t-ok">"import.*from.*@old-design-system"</span>

  <span class="ui-t-dim"># Mark files with this comment as legacy</span>
  markers:
    - <span class="ui-t-ok">"@legacy"</span>
    - <span class="ui-t-ok">"deprecated-marker"</span>

<span class="ui-t-dim"># Modern design system reference</span>
tokens:
  source: <span class="ui-t-ok">"./src/tokens"</span>

<span class="ui-t-dim"># Track migration progress</span>
migration:
  enabled: <span class="ui-t-info">true</span>
  trackBy: directory  <span class="ui-t-dim"># or file or component</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <LeadMagnetCallout
        leadMagnet="token-migration"
        headline="Planning a token migration?"
        subhead="Step-by-step playbook for migrating from hardcoded values to design tokens. Avoid the common pitfalls."
        buttonText="Get the Playbook"
      />
    </div>
  </section>
</UseCaseLayout>

<style>
  .mod-body { padding: 24px; }
  .mod-bar { display: flex; gap: 3px; height: 14px; border-radius: 7px; overflow: hidden; }
  .mod-seg { display: block; flex-grow: 0; flex-shrink: 1; }
  .mod-ok { background: var(--color-ok); }
  .mod-warn { background: var(--color-warn); }
  .mod-crit { background: var(--color-crit); opacity: .8; }
  .mod-legend { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .mod-legend li { display: flex; flex-direction: column; gap: 4px; font-size: .8125rem; color: var(--color-muted); }
  .mod-legend li + li { border-left: 1px solid var(--color-line); padding-left: 16px; }
  .mod-pct { font-family: var(--font-display); font-weight: 700; font-size: 2.25rem; line-height: 1; }
  .mod-facts { margin: 20px 0 0; font-size: .875rem; }
  .mod-facts > div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--color-line); }
  .mod-facts dt { color: var(--color-muted); }
  .mod-facts dd { margin: 0; color: var(--color-ink); text-align: right; }
  .mod-split { align-items: center; }
  .mod-q { margin: 0; padding: 0 0 0 24px; border-left: 2px solid var(--color-line-strong); font-size: 1.125rem; }
  .mod-q p { margin: 0; }
  .mod-answer { font-size: 1.25rem; margin-top: 12px !important; }
  .mod-pre { margin: 0; padding: 1.25rem 1.5rem; font-size: .8125rem; line-height: 1.6; color: var(--color-body); white-space: pre-wrap; word-break: break-word; }
  @media (max-width: 420px) { .mod-body { padding: 16px; } .mod-pct { font-size: 1.75rem; } .mod-pre { padding: 1rem; } }
</style>
