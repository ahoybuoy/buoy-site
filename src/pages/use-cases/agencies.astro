---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro'

const benefits = [
  {
    title: 'Per-project configs',
    description: 'Each client project can have its own .buoy.yaml with their specific design tokens and conventions.',
  },
  {
    title: 'Client-ready reports',
    description: 'Generate professional drift reports to show clients the health of their codebase during handoff.',
  },
  {
    title: 'Quick onboarding',
    description: 'New developers can run a scan to understand the design system before writing their first line of code.',
  },
  {
    title: 'Handoff documentation',
    description: 'Include Buoy reports in your handoff package showing design system adoption and any remaining drift.',
  },
  {
    title: 'Maintenance contracts',
    description: 'Offer ongoing drift monitoring as part of maintenance retainers. Automated monthly reports.',
  },
  {
    title: 'Team consistency',
    description: 'Ensure all agency developers follow the same patterns across projects with CI enforcement.',
  },
]

const workflow = [
  { step: 'Kickoff', description: 'Set up .buoy.yaml with client\'s design tokens' },
  { step: 'Development', description: 'Run drift checks in CI on every PR' },
  { step: 'Review', description: 'Generate reports before client reviews' },
  { step: 'Handoff', description: 'Include comprehensive drift report in deliverables' },
  { step: 'Maintenance', description: 'Ongoing monitoring for maintenance clients' },
]
---

<UseCaseLayout
  title="Agency Design System Workflow | Buoy"
  description="Maintain design consistency across client projects. Per-project configuration, client-ready reports, and handoff documentation."
  keywords="agency design system, client design consistency, agency workflow tools"
  heroTitle="Digital Agencies"
  heroDescription="Maintain design consistency across all your client projects. Per-project configs, client-ready reports, and seamless handoffs."
>
  <div slot="hero">
    <figure class="ui-tray">
      <div class="ui-panel">
        <div class="ui-panel-head">Acme Corp: project handoff report</div>
        <div class="ag-body">
          <div class="ag-stats">
            <div><p class="ag-num ui-c-ok ui-tnum">87%</p><p class="ag-lab">Component coverage</p></div>
            <div><p class="ag-num ui-c-ok ui-tnum">92%</p><p class="ag-lab">Token adoption</p></div>
            <div><p class="ag-num ui-c-warn ui-tnum">3</p><p class="ag-lab">Minor drift items</p></div>
          </div>
          <ul class="ag-items">
            <li><span class="ui-sev ui-sev-warning">Warning</span> <span><span class="ui-mono">Footer.tsx:23</span> hardcoded color <span class="ui-old">#666</span></span></li>
            <li><span class="ui-sev ui-sev-warning">Warning</span> <span><span class="ui-mono">LegacyBanner.tsx</span> deprecated component</span></li>
            <li><span class="ui-sev ui-sev-info">Info</span> <span>3 naming inconsistencies (cosmetic only)</span></li>
          </ul>
        </div>
      </div>
      <figcaption class="ag-cap">Generated by Buoy, December 2024</figcaption>
    </figure>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Why agencies love Buoy</h2><p>One tool across every client codebase, with each project keeping its own rules.</p></div>
      <table class="ui-table ui-table--stack mt-10">
        <tbody>
          {benefits.map((b) => (
            <tr><th scope="row">{b.title}</th><td>{b.description}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split ag-split">
      <div class="ui-head">
        <h2>Agency workflow</h2>
        <p>From kickoff to the maintenance retainer. The report above is what the client gets at handoff.</p>
      </div>
      <ol class="ui-steps">
        {workflow.map((item, i) => (
          <li><span class="ui-step-n">{i + 1}</span><div><h3>{item.step}</h3><p>{item.description}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-card ui-card--pad ag-price">
        <div>
          <h2 class="ag-price-h">Agency-friendly pricing</h2>
          <p>
            The CLI is <span class="ui-c-ok">free and open source</span>: use it on unlimited client projects.
            Team features available when you need dashboards and trend tracking.
          </p>
        </div>
        <a href="/pricing" class="ui-btn ui-btn--secondary">View pricing</a>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  .ag-body { padding: 20px 24px 8px; }
  .ag-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ag-stats > div + div { border-left: 1px solid var(--color-line); padding-left: 16px; }
  .ag-num { font-family: var(--font-display); font-weight: 700; font-size: 2.25rem; line-height: 1; margin: 0 0 6px; }
  .ag-lab { font-size: .8125rem; color: var(--color-muted); margin: 0; }
  .ag-items { list-style: none; margin: 20px 0 0; padding: 0; font-size: .875rem; }
  .ag-items li { display: flex; gap: 10px; align-items: baseline; padding: 12px 0; border-top: 1px solid var(--color-line); }
  .ag-items .ui-sev { flex: 0 0 4.5rem; }
  .ag-cap { margin-top: 10px; font-size: .8125rem; color: var(--color-muted); text-align: center; }
  .ag-split { align-items: start; }
  .ag-price { display: flex; gap: 24px; align-items: center; justify-content: space-between; }
  .ag-price-h { font-size: var(--text-h3); margin: 0 0 8px; }
  .ag-price p { margin: 0; max-width: 560px; }
  @media (max-width: 720px) { .ag-price { flex-direction: column; align-items: stretch; } }
  @media (max-width: 420px) { .ag-body { padding: 16px 16px 4px; } .ag-num { font-size: 1.75rem; } }
</style>
