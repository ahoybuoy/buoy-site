---
import UseCaseLayout from '../../layouts/UseCaseLayout.astro'

const capabilities = [
  {
    title: 'Local deterministic scanning',
    description: 'Run the open-source scanner inside your own development or CI environment without requiring an LLM or uploading source code.',
  },
  {
    title: 'Repository-owned policy',
    description: 'Keep design-system paths, severity rules, accepted exceptions, and enforcement thresholds in version-controlled configuration.',
  },
  {
    title: 'Legacy-safe adoption',
    description: 'Record existing drift as a reviewed baseline, then focus pull-request checks on drift introduced after adoption.',
  },
  {
    title: 'Pull-request feedback',
    description: 'Use the GitHub App or CI output to surface file-level findings where developers already review implementation changes.',
  },
  {
    title: 'Ownership and impact mapping',
    description: 'Map canonical and unmanaged components, observed consumers, and configured owners to help teams prioritize migration work.',
  },
  {
    title: 'Machine-readable output',
    description: 'Use JSON and agent-oriented output in internal reporting, automation, and review workflows.',
  },
]

const privacy = [
  ['License', 'MIT, open-source scanner', 'ok'],
  ['AI provider', 'Not required, deterministic scanning', ''],
  ['Network', 'Local and offline for CLI workflows', ''],
  ['Source upload', 'Not required for local reports', 'ok'],
]
---

<UseCaseLayout
  title="Design-System Governance for Larger Teams | Buoy"
  description="Local scanning, repository-owned policy, legacy-safe adoption, and pull-request enforcement for larger frontend organizations."
  keywords="enterprise design system, design system governance, multi-team design system"
  heroTitle="Govern the code you actually ship"
  heroDescription="Buoy helps larger teams measure design-system drift locally, document accepted exceptions, and review newly introduced drift in pull requests."
>
  <div slot="hero">
    <div class="ui-tray">
      <div class="ui-panel">
        <div class="ui-panel-head">Local-mode privacy</div>
        <dl class="ent-dl">
          {privacy.map(([k, v, c]) => (
            <div><dt>{k}</dt><dd class={c ? `ui-c-${c}` : ''}>{v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head">
        <h2>Capabilities available today</h2>
        <p>These are product capabilities you can evaluate directly in the open-source CLI and GitHub workflow.</p>
      </div>
      <table class="ui-table ui-table--stack mt-10">
        <tbody>
          {capabilities.map((c) => (
            <tr><th scope="row">{c.title}</th><td>{c.description}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap ui-split ent-split">
      <div class="ui-head">
        <h2>Procurement and deployment</h2>
        <p>
          Security reviews, identity requirements, data handling, deployment models, and contractual controls are evaluated against your requirements before we make a commitment.
        </p>
        <p>
          Contact us for a current capability review. Buoy does not claim certifications or deployment options that have not been independently verified and delivered.
        </p>
      </div>
      <div class="ui-card ui-card--pad">
        <h3>Evaluate Buoy on one repository</h3>
        <p class="mt-3">Start with a local baseline and one representative pull request before discussing a broader rollout.</p>
        <div class="ui-actions mt-6">
          <a href="/contact" class="ui-btn ui-btn--primary">Contact Buoy</a>
        </div>
      </div>
    </div>
  </section>
</UseCaseLayout>

<style>
  .ent-dl { margin: 0; padding: 4px 24px 8px; }
  .ent-dl > div { display: grid; grid-template-columns: 8rem 1fr; gap: 16px; padding: 14px 0; border-top: 1px solid var(--color-line); }
  .ent-dl > div:first-child { border-top: 0; }
  .ent-dl dt { color: var(--color-muted); font-size: .875rem; }
  .ent-dl dd { margin: 0; color: var(--color-ink); }
  .ent-split { align-items: center; }
  .ent-split .ui-head p + p { margin-top: 12px; }
  @media (max-width: 420px) { .ent-dl { padding: 4px 16px 8px; } .ent-dl > div { grid-template-columns: 1fr; gap: 2px; } }
</style>
