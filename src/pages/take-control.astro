---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import DocTerminal from '../components/DocTerminal.astro'
import MarkPattern from '../components/MarkPattern.astro'
import { siteConfig } from '../config'

const builtVsShipped = [
  { prop: '--color-primary', built: '#00D4AA', shipped: 'background: "#10B981"' },
  { prop: '--spacing-md', built: '16px', shipped: 'padding: "14px"' },
  { prop: '--radius-lg', built: '12px', shipped: 'borderRadius: "8px"' },
  { prop: '<Button>', built: 'component', shipped: '<div style=...' },
]
const culprits = ["AI that doesn't know your tokens exist", 'Developers in a hurry', 'Copy-pasted Stack Overflow code']
const caught = [
  { t: 'Hardcoded values', d: 'Caught & flagged' },
  { t: 'Duplicate components', d: 'Identified & linked' },
  { t: 'Naming drift', d: 'Detected & suggested' },
]
const steps = [
  { t: 'Check Status', cmd: 'npx ahoybuoy show health', d: 'Run it in your codebase. In seconds, see every place your design system is being bypassed. Zero config needed.' },
  { t: 'Review', cmd: 'buoy drift check', d: "Get a clear report: what's wrong, where it is, and exactly how to fix it. No guesswork." },
  { t: 'Enforce', cmd: 'buoy drift check --fail-on critical', d: "Add to CI/CD. See what's drifting before it ships. Critical issues get flagged. You decide the threshold." },
]
const rules = [
  { t: 'Color Tokens', d: 'No more #FF5733 when you defined --color-warning. Every color maps to your palette.', old: '#FF5733', token: 'var(--color-warning)' },
  { t: 'Spacing Scale', d: "14px padding? That's not in your 4px grid. Buoy catches it, suggests the fix.", old: '14px', token: 'var(--spacing-md)' },
  { t: 'Typography', d: 'font-size: 13px? You use a type scale. Buoy knows and enforces it.', old: '13px', token: 'var(--text-sm)' },
  { t: 'Components', d: 'Someone built a new button? You already have <Button>. Buoy shows them.', old: '<div className="btn">', token: '<Button>' },
  { t: 'Naming', d: 'You use "primary". They wrote "main". Buoy catches naming drift instantly.', old: '--main-color', token: '--color-primary' },
  { t: 'Dark Mode', d: 'Hardcoded white backgrounds break dark mode. Buoy ensures tokens are used.', old: '#FFFFFF', token: 'var(--bg-surface)' },
]
const newYou = [
  { t: 'Join the conversation', d: 'When developers discuss "technical debt," you can point to the Buoy report and say "here\'s exactly where it is."' },
  { t: 'Prove your impact', d: '"Design system adoption: 47% → 89%." Real metrics that show leadership the value of your work.' },
  { t: 'Bridge the gap', d: 'Developers respect you more when you understand their world. Buoy gives you that understanding without the learning curve.' },
  { t: 'Focus on what matters', d: 'Stop policing code manually. Let Buoy handle enforcement while you focus on designing the next great experience.' },
]
const ladder = [
  { t: 'Detect', d: "See what's drifting", c: 'ui-c-info' },
  { t: 'Warn', d: 'Flag in PRs', c: 'ui-c-warn' },
  { t: 'Enforce', d: 'Fail on critical', c: 'ui-c-crit' },
]
---

<Layout title="Take Control - Design Tokens Were Step One | Buoy">
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="tide" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap lp-hero">
        <p class="ui-eyebrow">The Code Control layer</p>
        <div class="ui-head"><h1>Design tokens were step one.<br /><span class="ui-c-buoy">Code Control is step two.</span></h1></div>
        <p class="ui-lede">You built the design system. You defined the tokens. Now take control of how they're used in code.</p>
        <div class="ui-actions">
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary ui-btn--lg">Take control now</a>
          <a href="#the-problem" class="ui-btn ui-btn--secondary ui-btn--lg">See how it works</a>
        </div>
      </div>
    </section>

    <section id="the-problem" class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>You did everything right.</h2><p>You built the design system. You documented every token. You created the components.</p></div>
        <table class="ui-table ui-table--stack lp-table">
          <thead><tr><th scope="col">What you built</th><th scope="col">Value</th><th scope="col">What gets shipped</th></tr></thead>
          <tbody>
            {builtVsShipped.map((r) => <tr><th scope="row" class="ui-mono ui-c-ok">{r.prop}</th><td class="ui-mono">{r.built}</td><td class="ui-mono"><span class="ui-old">{r.shipped}</span></td></tr>)}
          </tbody>
        </table>
        <p class="ui-after">And the culprits? {culprits.join('. ')}.</p>
      </div>
    </section>

    <section class="ui-section ui-section--patterned">
      <MarkPattern pattern="wake" drift={0.25} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head"><h2>Insert design into the pipeline.</h2><p>Every pull request. Every commit. Every line of AI-generated code. Now it answers to you.</p></div>
        <ol class="tc-pipe">
          <li><h3>Developer</h3><p class="lp-muted">+ AI Assistant</p></li>
          <li class="tc-buoy"><p class="ui-c-buoy tc-k">Design is here</p><h3>Buoy</h3><p class="lp-muted">Design's Control Layer</p></li>
          <li><h3 class="ui-c-ok">Production</h3><p class="lp-muted">Clean & Consistent</p></li>
        </ol>
        <table class="ui-table lp-table"><tbody>{caught.map((c) => <tr><th scope="row">{c.t}</th><td class="ui-end ui-c-ok">{c.d}</td></tr>)}</tbody></table>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Zero config. Instant visibility.</h2><p>No setup required. Run it, see results. Enforce when you're ready.</p></div>
        <ol class="ui-steps lp-steps">
          {steps.map((s, i) => <li><span class="ui-step-n">{i + 1}</span><div><h3>{s.t}</h3><p><code class="ui-code">{s.cmd}</code></p><p>{s.d}</p></div></li>)}
        </ol>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Your rules. Automatically detected.</h2><p>Every decision you made in your design system? Now it's visible and measurable.</p></div>
        <table class="ui-table ui-table--stack lp-table">
          <thead><tr><th scope="col">Rule</th><th scope="col">What Buoy checks</th><th scope="col" class="ui-end">Fix</th></tr></thead>
          <tbody>{rules.map((r) => <tr><th scope="row">{r.t}</th><td>{r.d}</td><td class="ui-end ui-mono tc-fix"><del>{r.old}</del> <ins>{r.token}</ins></td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Sleep well tonight.</h2><p>Every PR is checked. Every commit is scanned. Every AI suggestion is validated. Your design system is protected 24/7.</p></div>
        <dl class="lp-stats">
          <div><dt>% of PRs checked</dt><dd class="ui-tnum">100</dd></div>
          <div><dt>manual audits needed</dt><dd class="ui-tnum ui-c-ok">0</dd></div>
          <div><dt>/7 protection</dt><dd class="ui-tnum">24</dd></div>
        </dl>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Speak code. Stay designer.</h2><p>You don't need to become a developer. But now you can see what they see, catch what they miss, and speak their language when it matters.</p></div>
        <table class="ui-table lp-table"><tbody>{newYou.map((n) => <tr><th scope="row">{n.t}</th><td>{n.d}</td></tr>)}</tbody></table>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Start where you are.</h2><p>Don't have a design system yet? Buoy can extract tokens from your existing code. Already have one? Start with visibility, add enforcement when ready.</p></div>
        <div class="ui-split lp-split">
          <div>
            <ul class="ui-ruled ui-ruled--top tc-start">
              <li><h3>Extract tokens from code</h3><p><code class="ui-code">buoy tokens</code></p><p>No design tokens yet? Buoy scans your existing code and extracts colors, spacing, and typography into a starting token file.</p></li>
              <li><h3>Visual coverage grid</h3><p><code class="ui-code">buoy show health</code></p><p>See a visual grid of your design system coverage across files. Track improvements over time.</p></li>
            </ul>
            <h3 class="tc-ladder-h">Progressive enforcement ladder</h3>
            <p class="lp-muted">Start informing, enforce when you're ready</p>
            <ol class="tc-ladder">{ladder.map((l) => <li><strong class={l.c}>{l.t}</strong><span class="lp-muted">{l.d}</span></li>)}</ol>
          </div>
          <figure class="ui-figure">
            <div class="ui-term">
              <div class="ui-term-bar"><span>terminal</span><span class="ui-t-dim">proposed CLI score format</span></div>
<pre><span class="ui-t-prompt">$</span> <span class="ui-t-hi">buoy show health</span>

<span class="ui-t-hi">Buoy Health Score</span>
<span class="ui-t-dim">────────────────</span>

Score        <span class="ui-t-ok">88/100   Great</span>
Threshold    <span class="ui-t-ok">PASS</span> <span class="ui-t-dim">(failBelow: 70)</span>
Trend        <span class="ui-t-ok">+4</span> since last scan

Meter        <span class="ui-t-ok">[██████████████████░░]</span> 88

<span class="ui-t-hi">Pillars (weighted)</span>
  valueDiscipline  60/60  <span class="ui-t-ok">████████████████████</span>
  tokenHealth       8/20  <span class="ui-t-warn">████████</span><span class="ui-t-dim">░░░░░░░░░░░░</span>
  consistency      10/10  <span class="ui-t-ok">████████████████████</span>
  criticalIssues   10/10  <span class="ui-t-ok">████████████████████</span>

<span class="ui-t-info">Suggestion</span>
  Tailwind detected but token coverage is low
  - extend your theme config with custom values</pre>
            </div>
            <figcaption>Human-readable score output that still maps directly to the real <code class="ui-code">buoy show health --json</code> fields.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap ui-split lp-cta">
        <div class="ui-head">
          <h2>Take control in 30 seconds.</h2>
          <p>Free. Open source. No signup required. Just run the command and see what you've been missing.</p>
          <div class="ui-actions"><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--secondary">View on GitHub</a></div>
        </div>
        <div>
          <DocTerminal command="npx ahoybuoy show health" />
          <p class="ui-note">The Code Control layer that design has been missing.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .lp-hero { padding-block: 32px 24px; }
  .lp-split { margin-top: 40px; }
  .lp-muted { color: var(--color-muted); font-size: 15px; }
  .lp-table { margin-top: 32px; }
  .lp-steps { margin-top: 32px; }
  .lp-steps p { margin-top: 8px; }
  .lp-cta { align-items: center; }
  .ui-col h3 { font-size: 1.2rem; }
  .ui-col p { margin-top: 8px; }
  .tc-fix { white-space: nowrap; font-size: 13px; }
  .tc-pipe { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .tc-pipe li { padding: 22px 24px; border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--ring); position: relative; }
  .tc-pipe li + li::before { content: '→'; position: absolute; left: -14px; top: 50%; transform: translate(-50%, -50%); color: var(--color-muted); }
  .tc-pipe .tc-buoy { box-shadow: var(--ring-lift); }
  .tc-pipe h3 { margin: 0; font-size: 1.25rem; }
  .tc-pipe p { margin: 4px 0 0; }
  .tc-k { font-size: 14px; font-weight: 600; margin: 0 0 4px !important; }
  .tc-start h3 { margin: 0; font-size: 1.1rem; }
  .tc-start p { margin: 8px 0 0; color: var(--color-body); font-size: 15px; }
  .tc-start li { padding-block: 18px; }
  .tc-ladder-h { margin: 40px 0 0; font-size: 1.1rem; }
  .tc-ladder { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-line-strong); }
  .tc-ladder li { padding: 14px 12px 0 0; display: flex; flex-direction: column; gap: 4px; }
  .lp-stats { margin: 40px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-line-strong); }
  .lp-stats > div { padding-top: 20px; display: flex; flex-direction: column-reverse; gap: 6px; }
  .lp-stats dd { margin: 0; font-family: var(--font-display); font-size: 3rem; font-weight: 700; line-height: 1; color: var(--color-ink); }
  .lp-stats dt { color: var(--color-muted); font-size: 15px; }
  @media (max-width: 760px) {
    .tc-pipe { grid-template-columns: minmax(0, 1fr); }
    .tc-pipe li + li::before { content: none; }
    .tc-fix { white-space: normal; }
  }
</style>
