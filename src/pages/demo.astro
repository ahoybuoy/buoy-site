---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Terminal from '../components/Terminal.astro'
import MarkPattern from '../components/MarkPattern.astro'
import { siteConfig } from '../config'

const installSteps = [
  {
    title: 'Run your first scan',
    description: 'No install required. Just run this command in your project:',
    command: 'npx ahoybuoy scan',
  },
  {
    title: 'Check for drift',
    description: 'Analyze your codebase for design drift signals:',
    command: 'npx ahoybuoy drift check',
  },
  {
    title: 'See your status',
    description: 'Get a summary of your design system adoption:',
    command: 'npx ahoybuoy status',
  },
]

const demoTerminalLines = [
  { text: '', delay: 400 },
  { text: '<span class="ui-t-prompt">›</span> Scanning codebase...', type: 'output', delay: 600 },
  { text: '', delay: 1000 },
  { text: 'Found <span class="ui-t-hi">127</span> components', type: 'output', delay: 1200 },
  { text: 'Found <span class="ui-t-hi">34</span> design tokens', type: 'output', delay: 1400 },
  { text: '', delay: 1600 },
  { text: '<span class="ui-t-ok">✓</span> Scan complete! Run <span class="ui-t-info">buoy drift check</span> to analyze', type: 'success', delay: 1800 },
]
---

<Layout
  title="Get Started | Buoy - Design Drift Detection"
  description="Get your first design drift scan in 2 minutes. No signup required. Free and open source."
  keywords="buoy cli, design drift detection, get started"
>
  <Nav />
  <main class="ui-nav-offset">
  <section class="ui-section ui-section--first ui-section--patterned">
    <MarkPattern pattern="swell" drift={0.3} fade class="ui-pattern" />
    <div class="ui-wrap ui-split items-center">
      <div>
        <p class="ui-eyebrow ui-c-ok">No signup required</p>
        <div class="ui-head"><h1>Get your first scan in 2 minutes</h1>
        <p class="ui-lede">One command. Full visibility into your design drift. Free and open source.</p></div>
        <div class="mt-8 inline-flex items-center gap-3 pl-5 pr-2 h-14 rounded-[var(--radius-inner)] bg-[var(--color-term)] shadow-[var(--ring-term)] font-[family-name:var(--font-mono)] max-w-full">
          <span class="ui-c-buoy">$</span>
          <code class="text-[var(--color-ink)] truncate">npx ahoybuoy scan</code>
          <button class="ui-icon-btn ml-2" aria-label="Copy command" id="copy-btn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>
        </div>
      </div>
      <Terminal command="npx ahoybuoy scan" lines={demoTerminalLines} />
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Three commands to full visibility</h2></div>
      <ol class="ui-steps">
        {installSteps.map((step, index) => (
          <li>
            <span class="ui-step-n">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
              <code class="ui-code mt-3 inline-block"><span class="ui-c-buoy">$</span> {step.command}</code>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head"><h2>Optional: configure for your project</h2></div>
      <div class="ui-tray mt-8 max-w-3xl">
        <div class="ui-panel">
          <div class="ui-panel-head flex justify-between"><span class="font-[family-name:var(--font-mono)]">.buoy.yaml</span><span class="text-[var(--color-muted)]">Optional configuration</span></div>
          <pre class="p-5 text-sm font-[family-name:var(--font-mono)] overflow-x-auto leading-relaxed"><code><span class="ui-t-dim"># .buoy.yaml</span>
<span class="ui-c-info">drift</span>:
  <span class="ui-t-dim"># Files Buoy should skip</span>
  <span class="ui-c-info">ignore</span>:
    - <span class="ui-c-ok">"**/*.test.tsx"</span>
    - <span class="ui-c-ok">"**/stories/**"</span>
  <span class="ui-t-dim"># Fail `buoy drift check` only on critical drift</span>
  <span class="ui-c-info">failOn</span>: <span class="ui-c-crit">critical</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band ui-section--last">
    <div class="ui-wrap">
      <div class="ui-head"><h2>What's next?</h2></div>
      <table class="ui-table ui-table--hover mt-8">
        <tbody>
          <tr><th><a href="/docs" class="ui-rowlink">Read the Docs</a></th><td class="ui-end">Full CLI reference and configuration options</td></tr>
          <tr><th><a href="/features/github-action" class="ui-rowlink">Add to CI</a></th><td class="ui-end">Get drift reports on every pull request</td></tr>
          <tr><th><a href={siteConfig.githubUrl} target="_blank" rel="noopener" class="ui-rowlink">Star on GitHub</a></th><td class="ui-end">Support the project and stay updated</td></tr>
        </tbody>
      </table>
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<script>
  const copyBtn = document.getElementById('copy-btn')
  copyBtn?.addEventListener('click', async () => {
    await navigator.clipboard.writeText('npx ahoybuoy scan')
    copyBtn.innerHTML = `<svg class="w-4 h-4 text-[var(--color-ok)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>`
    setTimeout(() => {
      copyBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`
    }, 2000)
  })
</script>
