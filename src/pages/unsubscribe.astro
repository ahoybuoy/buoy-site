---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

export const prerender = false

const token = Astro.url.searchParams.get('token') ?? ''
const done = Astro.url.searchParams.get('done')
---

<Layout title="Unsubscribe | Buoy" description="Stop getting emails from Buoy." noindex>
  <Nav />
  <section class="pt-32 pb-24 bg-navy-dark min-h-[60vh]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {done === '1' && (
        <>
          <h1 class="text-3xl font-bold text-light">You're unsubscribed</h1>
          <p class="text-slate mt-3">You won't get any more emails from Buoy. If you sign up for something again later, you'll be back on the list.</p>
        </>
      )}
      {done === '0' && (
        <>
          <h1 class="text-3xl font-bold text-light">That link didn't work</h1>
          <p class="text-slate mt-3">It may be old or cut off. Email <a href="mailto:support@buoy.design" class="text-buoy hover:underline">support@buoy.design</a> and we'll take you off the list by hand.</p>
        </>
      )}
      {done === null && (
        <>
          <h1 class="text-3xl font-bold text-light">Unsubscribe from Buoy emails?</h1>
          <p class="text-slate mt-3">One click and you're off the list.</p>
          <form method="post" action="/api/unsubscribe" class="mt-6">
            <input type="hidden" name="token" value={token} />
            <button type="submit" class="px-5 py-2.5 rounded-lg bg-buoy text-navy-dark font-semibold hover:opacity-90">Unsubscribe</button>
          </form>
        </>
      )}
    </div>
  </section>
  <Footer />
</Layout>
