---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

export const prerender = false

const token = Astro.url.searchParams.get('token') ?? ''
const done = Astro.url.searchParams.get('done')
---

<Layout title="Unsubscribe | Buoy" description="Stop getting emails from Buoy." noindex>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--last un-section">
      <div class="ui-wrap">
        <div class="ui-head">
          {done === '1' && (
            <>
              <h1>You're unsubscribed</h1>
              <p>You won't get any more emails from Buoy. If you sign up for something again later, you'll be back on the list.</p>
            </>
          )}
          {done === '0' && (
            <>
              <h1>That link didn't work</h1>
              <p>It may be old or cut off. Email <a href="mailto:support@buoy.design" class="ui-link">support@buoy.design</a> and we'll take you off the list by hand.</p>
            </>
          )}
          {done === null && (
            <>
              <h1>Unsubscribe from Buoy emails?</h1>
              <p>One click and you're off the list.</p>
              <form method="post" action="/api/unsubscribe" class="ui-actions un-form">
                <input type="hidden" name="token" value={token} />
                <button type="submit" class="ui-btn ui-btn--primary">Unsubscribe</button>
              </form>
            </>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .un-section { min-height: 60vh; }
  .un-form { margin-top: 28px; }
</style>
