---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import LeadMagnetForm from '../components/LeadMagnetForm.astro'
import MarkPattern from '../components/MarkPattern.astro'

const phases = [
  { title: 'Audit', desc: 'Find all hardcoded values' },
  { title: 'Design', desc: 'Structure your tokens' },
  { title: 'Plan', desc: 'Choose your strategy' },
  { title: 'Execute', desc: 'Migrate incrementally' },
  { title: 'Prevent', desc: 'Stop regression' },
]
const inside = [
  { title: 'Audit Scripts', desc: 'Ready-to-run commands to find every hardcoded value' },
  { title: 'Token Architecture', desc: 'Flat vs semantic vs component tokens: which to use' },
  { title: 'Naming Conventions', desc: 'Patterns for colors, spacing, and typography' },
  { title: 'Timeline Template', desc: 'Week-by-week plan from audit to enforcement' },
]
const rowsTmp = [
  { prop: 'background', old: '#3B82F6', token: 'var(--color-primary)' },
  { prop: 'padding', old: '12px 24px', token: 'var(--space-3) var(--space-6)' },
  { prop: 'font-size', old: '14px', token: 'var(--font-size-sm)' },
]
const rows = rowsTmp
const diffHtml = '.button {\n' + rows.map((r) => `<span class="ui-t-crit">-  ${r.prop}: ${r.old};</span>`).join('\n') + '\n' + rows.map((r) => `<span class="ui-t-ok">+  ${r.prop}: ${r.token};</span>`).join('\n') + '\n}'
---

<Layout
  title="Design Token Migration Playbook | Free Guide | Buoy"
  description="Step-by-step guide to replacing hardcoded values with design tokens. Audit scripts, naming conventions, and timeline included."
>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="tide" drift={0.25} fade class="ui-pattern" />
      <div class="ui-wrap ui-split lm-hero">
        <div>
          <p class="ui-eyebrow">Free playbook</p>
          <div class="ui-head"><h1>Design Token Migration Playbook</h1></div>
          <p class="ui-lede">Your codebase is full of hardcoded values. You want to migrate to tokens. This playbook tells you how, without breaking production.</p>
          <div class="lm-form"><LeadMagnetForm leadMagnet="token-migration" buttonText="Get the Playbook" successMessage="Check your email for the download!" /></div>
          <p class="ui-note">No spam. Unsubscribe anytime.</p>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-term">
            <div class="ui-term-bar"><span>button.css</span><span class="ui-t-dim">before / after</span></div>
            <pre set:html={diffHtml}></pre>
          </div>
          <figcaption>The whole playbook in one rule: every literal becomes a token, without changing what renders.</figcaption>
        </figure>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>What's inside</h2></div>
        <table class="ui-table lm-table"><tbody>{inside.map((i) => <tr><th scope="row">{i.title}</th><td>{i.desc}</td></tr>)}</tbody></table>
      </div>
    </section>

    <section class="ui-section ui-section--patterned">
      <MarkPattern pattern="wake" drift={0.2} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head"><h2>The 5-phase process</h2><p>From the first audit to a codebase that stays tokenized.</p></div>
        <ol class="tm-phases">
          {phases.map((p, i) => <li><span class="tm-n ui-tnum">{i + 1}</span><h3>{p.title}</h3><p>{p.desc}</p></li>)}
        </ol>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--band ui-section--patterned">
      <MarkPattern pattern="scan" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head"><h2>Start your migration</h2><p>Audit scripts. Naming conventions. Timeline. Everything you need.</p></div>
          <div><LeadMagnetForm leadMagnet="token-migration" idSuffix="end" buttonText="Send It to Me" successMessage="Done! Check your inbox." /><p class="ui-note">No spam. Unsubscribe anytime.</p></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .lm-hero { align-items: center; }
  .lm-form { margin-top: 32px; max-width: 480px; }
  .tm-phases { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--color-line-strong); }
  .tm-phases li { padding: 20px 20px 0 0; }
  .tm-phases li + li { padding-left: 20px; border-left: 1px solid var(--color-line); }
  .tm-n { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: var(--color-ok); line-height: 1; }
  .tm-phases h3 { margin: 12px 0 0; font-size: 1.125rem; }
  .tm-phases p { margin: 6px 0 0; color: var(--color-body); font-size: 15px; }
  @media (max-width: 960px) { .tm-phases { grid-template-columns: minmax(0, 1fr); } .tm-phases li, .tm-phases li + li { padding: 16px 0; border-left: 0; border-bottom: 1px solid var(--color-line); display: grid; grid-template-columns: 40px 1fr; } .tm-phases h3 { margin: 0; } .tm-phases p { grid-column: 2; } }
  .lm-table { margin-top: 32px; }
</style>
