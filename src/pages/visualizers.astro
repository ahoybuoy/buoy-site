---
/**
 * buoy.design/visualizers: browse every Buoy visualizer, from Buoy and from
 * the community. Each one opens live on a real public repo. People build new
 * ones with their own coding agents (Buoy's models never write them).
 */
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import MarkPattern from '../components/MarkPattern.astro'

export const prerender = false

const API = 'https://api.buoy.design'
const DEMO = 'shadcn-ui/next-template'
type Builtin = { slug: string; name: string; description: string; author: string }
type Community = { id: string; name: string; description: string | null; author: string | null; installs: number; remixedFrom: string | null }
let builtins: Builtin[] = []
let community: Community[] = []
let apiDown = false
try {
  const [a, b] = await Promise.all([fetch(`${API}/viz`), fetch(`${API}/viz/community`)])
  if (a.ok) builtins = ((await a.json()) as { visualizers: Builtin[] }).visualizers
  if (b.ok) community = ((await b.json()) as { visualizers: Community[] }).visualizers
  apiDown = !a.ok
} catch { apiDown = true }
Astro.response.headers.set('Cache-Control', 'public, max-age=120')
---

<Layout title="Visualizers: see inside any UI codebase | Buoy" description="Browse visualizers for design systems: component galleries, system maps, colour quilts and more, built by Buoy and by people with their own coding agents. Open any of them on a real repo.">
  <Nav />
  <main class="ui-nav-offset">
  <section class="ui-section ui-section--first ui-section--patterned">
    <MarkPattern pattern="field" drift={0.3} fade class="ui-pattern !opacity-[0.16]" />
    <div class="ui-wrap ui-split items-center">
      <div class="ui-head">
        <h1>Visualizers</h1>
        <p class="ui-lede">
          Ways to see inside a codebase's UI: every component, token and page, drawn so a design team can get a handle on the whole app.
          Open any of them on a real repo, add them to your Buoy workspace, or build your own with your coding agent.
        </p>
      </div>
      <ol class="ui-steps !my-0">
        <li><span class="ui-step-n">1</span><div><h3>Open one on a real repo</h3><p>Every visualizer below runs live on <code class="ui-code">{DEMO}</code>.</p></div></li>
        <li><span class="ui-step-n">2</span><div><h3>Add it to your workspace</h3><p>See it drawn from your own repository in Buoy.</p></div></li>
        <li><span class="ui-step-n">3</span><div><h3>Build your own</h3><p>Copy the brief below into your coding agent.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="ui-section !pt-16">
    <div class="ui-wrap">
      {apiDown && <p class="ui-msg ui-msg--err">The library is unavailable right now. Try again in a minute.</p>}

      {builtins.length > 0 && (
        <>
          <h2 class="text-[length:var(--text-h3)]">From <span class="ui-c-buoy">Buoy</span></h2>
          <table class="ui-table ui-table--hover ui-table--stack mt-5">
            <thead><tr><th>Visualizer</th><th>What it shows</th><th class="ui-end">Open</th></tr></thead>
            <tbody>
              {builtins.map((v) => (
                <tr>
                  <th>{v.name}</th>
                  <td>{v.description}</td>
                  <td class="ui-end whitespace-nowrap"><a href={`/scan/${DEMO}/v/${v.slug}`} class="ui-rowlink text-sm">Open →</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      <h2 class="text-[length:var(--text-h3)] mt-16">From the <span class="ui-c-lavender">community</span></h2>
      {community.length === 0 ? (
        <p class="mt-4 max-w-2xl">Nothing shared yet. Build the first one: describe the view you want, let your coding agent write it, and share it from your Buoy workspace.</p>
      ) : (
        <table class="ui-table ui-table--hover ui-table--stack mt-5">
          <thead><tr><th>Visualizer</th><th>What it shows</th><th class="ui-end">Open</th></tr></thead>
          <tbody>
            {community.map((v) => (
              <tr>
                <th>{v.name}<span class="block mt-1 text-xs font-normal text-[var(--color-muted)]">by {v.author ?? 'someone'}{v.remixedFrom ? ' · remix' : ''} · in <span class="ui-tnum">{v.installs}</span> {v.installs === 1 ? 'workspace' : 'workspaces'}</span></th>
                <td>{v.description}</td>
                <td class="ui-end whitespace-nowrap"><a href={`/scan/${DEMO}/v/c-${v.id}`} class="ui-rowlink text-sm">Open →</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </section>

  <section class="ui-section ui-section--last ui-section--patterned">
    <MarkPattern pattern="rain" drift={0.3} fade class="ui-pattern !opacity-20" />
    <div class="ui-wrap">
      <div class="ui-cta">
        <div>
          <h2 class="text-[length:var(--text-h2)]">Build your own with your coding agent</h2>
          <p class="mt-3">
            Copy the brief, add what you want to see, and paste it into Claude, ChatGPT, Cursor or any coding agent. It writes one HTML file;
            paste that into your Buoy workspace to see it live on your repo and share it here.
          </p>
          <p class="ui-msg ui-msg--err hidden" role="alert" data-brief-error></p>
        </div>
        <div class="ui-actions !mt-0 lg:justify-end">
          <button type="button" class="ui-btn ui-btn--primary" data-copy-brief>Copy the brief</button>
          <a href="https://app.buoy.design/visualize" class="ui-btn ui-btn--secondary">Open your workspace</a>
        </div>
      </div>
    </div>
  </section>
  </main>
  <Footer />
</Layout>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy-brief]')
  const err = document.querySelector<HTMLElement>('[data-brief-error]')
  btn?.addEventListener('click', async () => {
    try {
      const text = await fetch('https://api.buoy.design/viz/prompt').then((r) => { if (!r.ok) throw new Error(); return r.text() })
      await navigator.clipboard.writeText(text)
      btn.textContent = 'Copied'
      setTimeout(() => { btn.textContent = 'Copy the brief' }, 4000)
    } catch {
      if (err) { err.textContent = 'Could not copy. Open https://api.buoy.design/viz/prompt and copy it from there.'; err.classList.remove('hidden') }
    }
  })
</script>
