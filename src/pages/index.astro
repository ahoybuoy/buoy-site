---
// Homepage. Built from the chosen design at /taste/dark/feel-better, on the shared
// Nav/Footer and the ui-* classes (src/styles/site.css). Only the hero and the
// pull-request mock are styled on this page.
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import BuoyMark from '../components/BuoyMark.astro'
import BoatHero from '../components/taste/BoatHero.astro'
import BoatGlyph from '../components/taste/BoatGlyph.astro'
import LockOn from '../components/taste/dark/feel-better/LockOnAligned.astro'
import MarkPattern from '../components/MarkPattern.astro'

const APP_URL = 'https://github.com/marketplace/buoy-design'

const catches = [
  { title: 'Hardcoded colors', from: '#ffffff', to: 'var(--bg)' },
  { title: 'Magic numbers', from: '16px', to: 'var(--space-4)' },
  { title: 'Duplicate components', from: 'a second Card', to: '<Card>' },
]

const steps = [
  { title: 'Set up', command: 'npx ahoybuoy dock', description: 'Sets Buoy up in your project.' },
  { title: 'Detect', command: 'buoy drift check', description: 'Lists every issue with the exact file and line.' },
  { title: 'Measure', command: 'buoy show health', description: 'Tracks design system health over time.' },
]

const driftTypes = [
  { title: 'Hardcoded values', severity: 'Warning', description: 'Colors, spacing and fonts that do not use tokens.', href: '/features/hardcoded-values' },
  { title: 'Duplicate components', severity: 'Warning', description: 'Similar components that should be consolidated.', href: '/features/duplicate-detection' },
  { title: 'Naming inconsistency', severity: 'Info', description: 'Component and prop names that do not match your conventions.', href: '/features/naming-consistency' },
  { title: 'Deprecated patterns', severity: 'Warning', description: 'Components marked as deprecated that are still in use.' },
  { title: 'Inline styles', severity: 'Warning', description: 'Inline CSS that should use tokens or classes.' },
  { title: 'Accessibility conflicts', severity: 'Critical', description: 'Missing ARIA labels and focus issues.', href: '/features/accessibility-checks' },
  { title: 'Framework sprawl', severity: 'Warning', description: 'Multiple UI frameworks in the same codebase.', href: '/features/framework-sprawl' },
  { title: 'Orphaned components', severity: 'Info', description: 'Components that are in code but not in design.' },
]

const core = [
  'All scanning and drift detection',
  'Fix suggestions with exact token replacements',
  'Deterministic, with no LLM',
  'No data leaves your machine',
  'Works air-gapped and offline',
]

const app = [
  'Runs the same open-source scanner on every pull request',
  'Inline fix suggestions you can commit',
  'LLM-written summaries and coaching. Findings stay deterministic',
  'Dashboard with health scores and trends',
  'Builder mode coaching for new design systems',
]

const tiers = [
  { tier: 'free', tag: 'Open source, free', title: 'Detect locally', text: 'Run buoy drift check in any project. See every hardcoded value and naming issue.', items: ['Unlimited scans', 'All detection rules', 'Fix suggestions'] },
  { tier: 'app', tag: 'GitHub App', title: 'Catch it at the PR', text: 'Install the Buoy GitHub App and every pull request gets checked before merge.', items: ['Inline PR comments', 'Check status integration', 'Committable fix suggestions'] },
  { tier: 'org', tag: 'Organization', title: 'Own the record', text: 'For design-system owners: how your system holds up across every repo that uses it.', items: ['Org-wide drift record', 'Design-partner relationship'] },
]

const integrations = [
  { name: 'React', href: '/integrations/react' },
  { name: 'Vue', href: '/integrations/vue' },
  { name: 'Svelte', href: '/integrations/svelte' },
  { name: 'Angular', href: '/integrations/angular' },
  { name: 'Next.js', href: '/integrations/nextjs' },
  { name: 'Tailwind', href: '/integrations/tailwind' },
  { name: 'GitHub', href: '/integrations/github' },
]

const siteUrl = 'https://buoy.design'
const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Buoy',
    url: siteUrl,
    logo: `${siteUrl}/og/home.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Buoy',
    url: siteUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web, macOS, Linux, Windows',
    description:
      'Design systems drift over time. Buoy catches it before it ships. Scan your codebase for hardcoded values, duplicate components, and values that skip your design tokens.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Open source CLI, MCP server and GitHub Action are free. GitHub App has a free tier.',
    },
  },
]
---

<Layout
  jsonLd={homeJsonLd}
  title="Buoy: catch design drift before it ships"
  description="On every pull request, Buoy comments the exact fix for hardcoded colors, off-token values and rogue components. Free open-source CLI, GitHub App for PR review."
>
  <a href="#main" class="ui-skip">Skip to content</a>
  <Nav />

  <main id="main" class="hp ui-nav-offset">
    <!-- Hero -->
    <BoatHero minHeight="calc(100svh - 65px)" class="hp-hero">
      <div class="ui-wrap hp-hero-grid">
        <div class="hp-hero-copy">
          <!-- "before it ships." lands as the boat wiggles free (850ms). -->
          <h1 class="hp-h1">
            <span class="hero-reveal" style="animation-delay: 0s">Catch</span>
            <span class="hero-reveal hero-drift-highlight" style="animation-delay: 0.22s">design drift</span>
            <br />
            <span class="hero-reveal" style="animation-delay: 0.82s">before</span>
            <span class="hero-reveal" style="animation-delay: 0.93s">it</span>
            <span class="hero-reveal" style="animation-delay: 1.04s">ships.</span>
          </h1>
          <p class="ui-lede">
            On every pull request, Buoy comments the exact fix for hardcoded colors, off-token values and rogue components.<BoatGlyph />
          </p>
          <div class="ui-actions">
            <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary ui-btn--icon">
              <span>Install the GitHub App</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/scan" class="ui-btn ui-btn--secondary">Scan a public repo</a>
          </div>
        </div>

        <!-- Phones: the sea band sits here, between the copy and the review card -->
        <div data-boat-sea-slot aria-hidden="true"></div>

        <figure class="ui-figure ui-enter" style="animation-delay:1200ms">
          <div class="ui-tray">
            <div class="ui-panel">
              <div class="ui-panel-head">
                <span class="ui-mono">src/components/Card.tsx</span>
              </div>
              <div class="hp-diff ui-mono" role="img" aria-label="Card.tsx. Line 23 sets a hardcoded background color, #3b82f6.">
                <div class="hp-line"><span class="hp-ln">21</span><span class="hp-sign"></span><span class="hp-code">{"const Card = ({ children }) => ("}</span></div>
                <div class="hp-line"><span class="hp-ln">22</span><span class="hp-sign"></span><span class="hp-code">{"  <div style={{"}</span></div>
                <div class="hp-line hp-flag"><span class="hp-ln">23</span><span class="hp-sign"></span><span class="hp-code">{'    background: "#3b82f6",'}</span></div>
              </div>
              <div class="hp-comment-row">
                <div class="hp-comment">
                  <div class="hp-comment-head">
                    <span class="hp-avatar"><BuoyMark size={16} /></span>
                    <span class="hp-comment-author">buoy-design</span>
                    <span class="hp-tag">bot</span>
                    <span class="hp-comment-meta">commented on line <span class="ui-tnum">23</span></span>
                  </div>
                  <p class="hp-comment-body">
                    Hardcoded color <code>#3b82f6</code>. Use <code>var(--color-primary)</code> instead.
                  </p>
                  <div class="hp-suggest">
                    <div class="hp-suggest-label">Suggested change</div>
                    <div class="hp-diff ui-mono">
                      <div class="hp-line hp-del"><span class="hp-ln">23</span><span class="hp-sign">-</span><span class="hp-code">background: "#3b82f6",</span></div>
                      <div class="hp-line hp-add"><span class="hp-ln">23</span><span class="hp-sign">+</span><span class="hp-code">background: "var(--color-primary)",</span></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="hp-diff ui-mono" aria-hidden="true">
                <div class="hp-line hp-flag"><span class="hp-ln">24</span><span class="hp-sign"></span><span class="hp-code">{'    padding: "24px",'}</span></div>
                <div class="hp-line"><span class="hp-ln">25</span><span class="hp-sign"></span><span class="hp-code">{"  }}>"}</span></div>
              </div>
              <p class="hp-panel-foot">What a Buoy review comment looks like on a pull request.</p>
            </div>
          </div>
        </figure>
      </div>
    </BoatHero>

    <!-- Why -->
    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head">
          <h2>Coding agents write a lot of UI. They do not know your tokens.</h2>
          <p>
            Hardcoded values creep in, and the drift compounds. Buoy compares each change with the tokens and components your team already has.
          </p>
        </div>

        <div class="hp-lockon">
          <LockOn />
        </div>

        <table class="ui-table hp-fixes">
          <caption class="ui-sr">What Buoy catches, and the fix it suggests</caption>
          <thead><tr><th scope="col">Catch</th><th scope="col">Found</th><th scope="col">Suggested</th></tr></thead>
          <tbody>
            {catches.map((c) => (
              <tr>
                <th scope="row">{c.title}</th>
                <td class="ui-mono">{c.from.startsWith('a ') ? <span class="hp-plain">{c.from}</span> : <del>{c.from}</del>}</td>
                <td class="ui-mono"><ins>{c.to}</ins></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- CLI -->
    <section class="ui-section ui-section--band ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.35} fade class="ui-pattern" />
      <div class="ui-wrap ui-split hp-cli">
        <div>
          <div class="ui-head">
            <h2>Find drift from the command line.</h2>
            <p>
              The CLI is free and open source. It reports every issue with the exact file, line and suggested fix.
            </p>
          </div>
          <ol class="ui-steps">
            {steps.map((s, i) => (
              <li>
                <span class="ui-step-n" aria-hidden="true">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.description}</p>
                  <code class="ui-code">{s.command}</code>
                </div>
              </li>
            ))}
          </ol>
          <a href="/docs" class="ui-btn ui-btn--secondary">Read the docs</a>
        </div>

        <figure class="ui-figure">
          <div class="ui-tray">
            <div class="ui-term hp-term" data-type-on-view role="img" aria-label="Terminal output of buoy drift check: 23 issues found in 142 files, each with a file, a line and a suggested token.">
              <div class="ui-term-bar">Terminal</div>
<pre><span class="ui-t-dim">$</span> <span class="ui-t-hi">buoy drift check</span>

Scanning for design drift...

Found <span class="ui-t-warn">23</span> issues in 142 files

<span class="ui-t-crit">CRITICAL (2)</span>
<span class="ui-t-dim">├─</span> Button.tsx:12 Missing aria-label
<span class="ui-t-dim">└─</span> Modal.tsx:45 Focus trap not implemented

<span class="ui-t-warn">HARDCODED VALUES (8)</span>
<span class="ui-t-dim">├─</span> Card.tsx:8 #ffffff <span class="ui-t-dim">→ use</span> var(--bg-surface)
<span class="ui-t-dim">├─</span> Badge.tsx:3 8px <span class="ui-t-dim">→ use</span> var(--spacing-sm)
<span class="ui-t-dim">└─ ... and 6 more</span></pre>
            </div>
          </div>
          <figcaption>Example output of <span class="ui-mono">buoy drift check</span>.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Detects -->
    <section class="ui-section ui-section--patterned" id="detects">
      <MarkPattern pattern="field" drift={0.25} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head">
          <h2>What Buoy detects</h2>
          <p>Each finding has a severity, so you can decide what to fix first.</p>
        </div>
        <table class="ui-table ui-table--hover ui-table--stack hp-table">
          <caption class="ui-sr">Drift types Buoy detects, with severity</caption>
          <thead><tr><th scope="col">Drift type</th><th scope="col">What it finds</th><th scope="col" class="ui-end">Severity</th></tr></thead>
          <tbody>
            {driftTypes.map((d) => (
              <tr>
                <th scope="row">{d.href ? <a href={d.href} class="ui-rowlink">{d.title}</a> : d.title}</th>
                <td>{d.description}</td>
                <td class={`ui-end ui-sev ui-sev-${d.severity.toLowerCase()}`}>{d.severity}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="hp-stack">
          <p>Works with your stack</p>
          <ul>
            {integrations.map((it) => <li><a href={it.href} class="ui-chip">{it.name}</a></li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Journey -->
    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head">
          <h2>Start free, scale when ready.</h2>
          <p>From a first local scan to review on every pull request, to a record of how your design system holds up.</p>
        </div>
        <ol class="ui-cols ui-cols--3 hp-tiers">
          {tiers.map((t) => (
            <li class="ui-col">
              <p class={`ui-tier-name ui-tier-${t.tier}`}>{t.tag}</p>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
              <ul class="ui-ruled ui-ruled--tight">{t.items.map((x) => <li>{x}</li>)}</ul>
            </li>
          ))}
        </ol>
        <p class="ui-after">
          <span class="hp-path"><span class="ui-tier-free">Open source (free)</span> <span aria-hidden="true">→</span> <span class="ui-tier-app">GitHub App</span> <span aria-hidden="true">→</span> <span class="ui-tier-org">Organization</span></span>
          <a href="/pricing" class="ui-link">See pricing</a>
        </p>
      </div>
    </section>

    <!-- Deterministic -->
    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head">
          <h2>The scanner works without AI.</h2>
          <p>
            Core drift detection is deterministic. There are no LLMs and no API keys, and no data leaves your machine, so it suits teams where AI tools are restricted.
          </p>
        </div>
        <div class="ui-cols">
          <article class="ui-col">
            <h3>Buoy Core</h3>
            <p class="ui-col-sub ui-c-ok">Open-source CLI</p>
            <ul class="ui-ruled">{core.map((x) => <li>{x}</li>)}</ul>
            <p class="ui-col-foot">No API keys required. No external calls. MIT licensed.</p>
          </article>
          <article class="ui-col">
            <h3>Buoy GitHub App</h3>
            <p class="ui-col-sub ui-c-buoy">The same engine, hosted on every pull request</p>
            <ul class="ui-ruled">{app.map((x) => <li>{x}</li>)}</ul>
            <p class="ui-col-foot">
              No API key needed. Prose is written through OpenRouter. <a href="/privacy#subprocessors" class="ui-link">See what is sent</a>.
            </p>
          </article>
        </div>
        <p class="ui-after">
          The CLI is free. <a href="/pricing" class="ui-link">See pricing</a> for the GitHub App and for organizations.
        </p>
      </div>
    </section>

    <!-- Scan -->
    <section class="ui-section ui-section--last ui-section--band ui-section--patterned">
      <MarkPattern pattern="tide" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head">
            <h2>See what Buoy finds in a public repo.</h2>
            <p>Paste a GitHub repository URL. The scan is free and takes about a minute.</p>
          </div>
          <div>
            <form action="/scan" method="get" class="ui-scan">
              <label for="hp-scan-url" class="ui-sr">GitHub repository URL</label>
              <input id="hp-scan-url" name="url" type="text" required autocomplete="off" spellcheck="false" placeholder="https://github.com/owner/repo" />
              <button type="submit" class="ui-btn ui-btn--primary">Scan repository</button>
            </form>
            <p class="ui-note">
              Or <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="ui-link">install the GitHub App</a> to have every pull request reviewed.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hp { color: var(--color-body); font-size: 16px; line-height: 1.6; }
  .hp h1, .hp h2, .hp h3 { color: var(--color-ink); }

  /* ---------- Hero ---------- */
  .hp :global(.hp-hero) {
    --boat-hero-bg: var(--color-bg);
    --boat-hero-sky: linear-gradient(180deg, oklch(0.155 0.045 248 / 0) 0%, oklch(0.17 0.056 248) 45%, oklch(0.14 0.048 248) 100%);
    --boat-hero-wave-1: oklch(0.55 0.09 248 / 0.12);
    --boat-hero-wave-2: oklch(0.6 0.081 248 / 0.1);
    --boat-hero-wave-3: oklch(0.5 0.081 248 / 0.13);
    --boat-hero-stars-opacity: 0.35;
  }
  :global(html.light) .hp :global(.hp-hero) {
    --boat-hero-sky: linear-gradient(180deg, #fff0 0%, #EEF3F8 45%, #E6EDF5 100%);
    --boat-hero-wave-1: rgb(26 39 68 / 0.06);
    --boat-hero-wave-2: rgb(99 102 241 / 0.05);
    --boat-hero-wave-3: rgb(26 39 68 / 0.07);
    --boat-hero-stars-opacity: 0;
  }
  /* Desktop: the sea starts at the hero sentence, so the boat drops past the buttons into open water. */
  @media (min-width: 768px) {
    .hp :global(.hp-hero) { --boat-hero-sea-height: 62%; --boat-hero-sink: 70px; }
    .hp :global(.hp-hero .wave-background) {
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
    }
  }
  .hp-hero-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: 72px; align-items: center;
    padding-block: 24px 200px;
  }
  /* The headline keeps two lines: "Catch design drift" is about 8.1em wide, so size it from the column. */
  .hp-hero-copy { container-type: inline-size; }
  .hp-h1 {
    margin: 0;
    font-size: min(var(--text-h1), calc(100cqi / 8.4));
    white-space: nowrap;
    line-height: 1.02; letter-spacing: -0.03em; font-weight: 700;
  }

  /* ---------- Pull-request mock ---------- */
  .hp-diff { font-size: 13px; line-height: 26px; overflow-x: auto; }
  .hp-line { display: grid; grid-template-columns: 44px 20px minmax(0, 1fr); min-width: max-content; }
  .hp-ln { text-align: right; padding-right: 10px; color: var(--color-muted); user-select: none; font-variant-numeric: tabular-nums; }
  .hp-sign { text-align: center; user-select: none; }
  .hp-code { white-space: pre; padding-right: 16px; }
  .hp-add { background: var(--color-add-bg); }
  .hp-add .hp-sign { color: var(--color-add-ink); }
  .hp-del { background: var(--color-del-bg); }
  .hp-del .hp-sign { color: var(--color-del-ink); }
  .hp-comment-row { padding: 8px; border-block: 1px solid var(--color-line); background: var(--color-raised); }
  .hp-comment { border-radius: 8px; background: var(--color-surface); box-shadow: var(--ring); overflow: hidden; }
  .hp-comment-head { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; padding: 12px 14px 0; font-size: 13px; }
  .hp-avatar {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 6px;
    background: var(--color-surface); box-shadow: 0 0 0 1px var(--color-line-strong);
  }
  .hp-comment-author { font-weight: 600; }
  /* GitHub's own "bot" label, reproduced in the mock; not a site badge pattern */
  .hp-tag { padding: 1px 6px; border-radius: 999px; font-size: 11px; font-weight: 500; line-height: 16px; color: var(--color-body); box-shadow: 0 0 0 1px var(--color-line-strong); }
  .hp-comment-meta { color: var(--color-muted); }
  .hp-comment-body { margin: 0; padding: 8px 14px 14px; font-size: 14px; line-height: 1.55; color: var(--color-ink); }
  .hp-comment-body code { padding: 1px 4px; border-radius: 4px; font-size: 12.5px; white-space: nowrap; background: var(--color-sunken); }
  .hp-suggest { border-top: 1px solid var(--color-line); }
  /* Flagged lines: hardcoded values Buoy catches (amber = warning; green stays for the fix). */
  .hp-flag { background: color-mix(in oklab, var(--color-warn) 9%, transparent); box-shadow: inset 2px 0 0 color-mix(in oklab, var(--color-warn) 80%, transparent); }
  .hp-panel-foot { margin: 0; padding: 10px 14px; border-top: 1px solid var(--color-line); font-size: 12px; line-height: 1.4; color: var(--color-muted); }
  .hp-suggest-label { padding: 8px 14px; font-size: 12px; font-weight: 500; color: var(--color-body); border-bottom: 1px solid var(--color-line); }

  /* ---------- Sections ---------- */
  .hp-lockon { margin-top: 48px; }
  .hp-fixes { margin-top: 40px; }
  .hp-fixes td { font-size: 14px; }
  .hp-fixes thead th:nth-child(1) { width: 34%; }
  .hp-fixes thead th:nth-child(2) { width: 28%; }
  .hp-plain { color: var(--color-muted); }
  /* Detects table on a slightly raised panel so it separates from the pattern behind it. */
  .hp-table {
    margin-top: 44px;
    background: color-mix(in oklab, var(--color-surface) 88%, transparent);
    border-collapse: separate; border-spacing: 0;
    border-radius: var(--radius-card);
    box-shadow: var(--ring), 0 18px 40px -24px oklch(0 0 0 / 0.6);
    overflow: hidden;
  }
  .hp-table :is(th, td):first-child { padding-left: 24px; }
  .hp-table :is(th, td):last-child { padding-right: 24px; }
  .hp-table thead th { padding-top: 16px; }
  .hp-table tbody tr:last-child :is(th, td) { border-bottom: 0; }
  @media (max-width: 720px) {
    .hp-table :is(th, td):first-child { padding-left: 16px; }
    .hp-table :is(th, td):last-child { padding-right: 16px; }
  }

  /* CLI section: the terminal runs the full height of the copy beside it. */
  @media (min-width: 961px) {
    .hp-cli { align-items: stretch; }
    .hp-cli > .ui-figure { display: flex; flex-direction: column; position: relative; }
    .hp-cli > .ui-figure > figcaption { position: absolute; top: 100%; left: 0; right: 0; }
    .hp-cli > .ui-figure > .ui-tray { flex: 1; display: flex; }
    .hp-cli .hp-term { flex: 1; display: flex; flex-direction: column; }
    .hp-cli .hp-term pre { flex: 1; }
  }
  /* Typing on view: lines keep their space (no shift) and appear in turn. */
  .hp-term .hp-ln { transition: opacity 120ms ease-out; }
  .hp-term .hp-ln.is-off { opacity: 0; }
