---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import MarkPattern from '../../components/MarkPattern.astro'
---

<Layout
  title="You're on the list | Buoy"
  description="You're on Buoy's update list."
>
  <Nav />

  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--last ui-section--patterned ok-section">
      <MarkPattern pattern="pulse" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head ui-head--center">
          <p class="ui-eyebrow ui-c-ok">Subscribed</p>
          <h1>You're on the list</h1>
          <p class="ui-lede">
            We'll email you with updates. You don't need to wait for us: the first 100 GitHub App installs are free for life, so install it from GitHub Marketplace whenever you're ready.
          </p>
        </div>
        <div class="ui-actions ok-actions">
          <a href="/" class="ui-btn ui-btn--secondary ui-btn--lg">Back to Home</a>
          <a href="https://github.com/ahoybuoy/buoy" class="ui-btn ui-btn--primary ui-btn--lg">Try the Free CLI</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .ok-section { min-height: 60vh; display: flex; align-items: center; }
  .ok-section > .ui-wrap { width: 100%; }
  .ok-actions { justify-content: center; margin-top: 32px; }
</style>
