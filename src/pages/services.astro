---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'

const stages = [
  {
    number: '01',
    name: 'Capture',
    description: 'Identify the product principles, strongest existing screens, component patterns, and anti-patterns that make the product feel like yours.',
  },
  {
    number: '02',
    name: 'Codify',
    description: 'Turn that judgment into a Design Contract: rules, examples, rationale, and task-specific context an AI coding agent can use.',
  },
  {
    number: '03',
    name: 'Calibrate',
    description: 'Test the contract against real product work and deliver 20 agreed high-confidence fixes through reviewable pull requests.',
  },
  {
    number: '04',
    name: 'Guard',
    description: 'Install Buoy in GitHub or CI so provable violations are caught automatically and subjective decisions stay human-reviewed.',
  },
]

const deliverables = [
  'One agreed frontend codebase and a complete Buoy baseline',
  'Three to five exemplary screens or components selected with your team',
  'Product principles, contextual rules, and explicit anti-patterns',
  'A human-readable Design Contract for your repository',
  'Agent context for the AI coding workflow your team already uses',
  '20 agreed high-confidence fixes delivered through reviewable pull requests',
  'GitHub App or CI guardrails for supported deterministic rules',
  'A before-and-after report, team handoff, and 30-day recheck',
]
---

<Layout
  title="Buoy Design Calibration | Keep AI-Generated UI True to Your Product"
  description="A fixed-scope implementation pilot that turns your product vision, design system, and strongest work into guidance AI agents can follow and guardrails your team can trust."
>
  <Nav />

  <main>
    <section class="relative pt-32 pb-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-navy to-navy-dark"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-sunrise/10 rounded-full blur-3xl"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-sunrise/10 border border-sunrise/30 mb-6">
          <span class="text-sunrise font-medium text-sm">Fixed-scope pilot · $5,000</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-bold text-light mb-6">
          Keep AI-generated UI<br />true to your product.
        </h1>
        <p class="text-xl text-slate max-w-3xl mx-auto mb-10">
          In one week, we capture your product's design logic, connect it to your AI coding workflow, repair the clearest violations, and install guardrails that keep generic UI from creeping back in.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="https://cal.com/tarre/rescue" size="lg" external>
            Book a Design Calibration call →
          </Button>
          <Button href="#what-you-get" variant="secondary" size="lg">
            See what you get
          </Button>
        </div>
      </div>
    </section>

    <section class="py-16 bg-navy border-y border-navy-light/20">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div>
            <p class="text-buoy font-medium mb-3">The missing layer</p>
            <h2 class="text-3xl font-bold text-light mb-4">A design system gives AI the parts. Buoy gives it context and judgment.</h2>
          </div>
          <p class="text-slate text-lg">
            Coding agents can assemble a valid interface and still produce something generic, off-brand, or wrong for the moment. Buoy connects product intent to implementation: what to use, why it belongs, and what should never ship.
          </p>
        </div>
      </div>
    </section>

    <section class="py-20 bg-navy-dark">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-12">
          <p class="text-buoy font-medium mb-3">One coherent workflow</p>
          <h2 class="text-3xl font-bold text-light mb-4">Capture → Codify → Calibrate → Guard</h2>
          <p class="text-slate text-lg">
            Buoy Rescue remains the implementation engine underneath the engagement. Design Calibration adds the product context AI needs before it writes code.
          </p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {stages.map((stage) => (
            <article class="bg-navy border border-navy-light/20 rounded-xl p-7">
              <div class="text-sm font-semibold text-buoy mb-3">{stage.number}</div>
              <h3 class="text-xl font-semibold text-light mb-2">{stage.name}</h3>
              <p class="text-slate">{stage.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="what-you-get" class="py-20 bg-navy scroll-mt-24">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-10 items-start">
          <div>
            <p class="text-sunrise font-medium mb-3">Pilot scope</p>
            <h2 class="text-3xl font-bold text-light mb-6">What the $5,000 engagement includes</h2>
            <ul class="space-y-4 text-slate">
              {deliverables.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="text-success mt-0.5">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <aside class="bg-navy-dark border border-buoy/30 rounded-2xl p-8">
            <h3 class="text-xl font-semibold text-light mb-4">What Buoy will—and will not—automate</h3>
            <ul class="space-y-4 text-sm text-slate">
              <li>Tokens, components, accessibility, and supported code rules can be enforced deterministically.</li>
              <li>Hierarchy, mood, and brand expression remain documented guidance until the evidence is strong.</li>
              <li>Ambiguous findings stay review-required.</li>
              <li>Fixes land on branches with visible diffs and existing checks.</li>
              <li>Private code can be scanned locally without uploading it to Buoy Cloud.</li>
            </ul>
            <div class="border-t border-navy-light/20 mt-6 pt-6">
              <p class="text-sm text-slate">Payment</p>
              <p class="text-light font-medium mt-1">50% to begin · 50% at implementation handoff</p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="py-20 bg-navy-dark">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-6">
          <article class="border border-success/30 rounded-xl p-7">
            <p class="text-success font-medium mb-3">A strong fit</p>
            <h2 class="text-xl font-semibold text-light mb-4">Your product already has an identity worth protecting.</h2>
            <p class="text-slate">
              You have a working frontend, an existing component library or recognizable product language, and a team using AI to ship UI faster.
            </p>
          </article>
          <article class="border border-navy-light/20 rounded-xl p-7">
            <p class="text-slate font-medium mb-3">Not the right engagement</p>
            <h2 class="text-xl font-semibold text-light mb-4">You need someone to invent the entire brand from scratch.</h2>
            <p class="text-slate">
              Design Calibration operationalizes existing product judgment. It is not a replacement for foundational brand strategy or zero-to-one product design.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="py-20 bg-navy">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-light mb-4">Start with evidence from your codebase.</h2>
        <p class="text-slate text-lg mb-8">
          Run Buoy locally or bring one representative UI pull request. We will use the actual product and implementation to decide whether calibration is worthwhile.
        </p>
        <div class="bg-navy-dark border border-navy-light/30 rounded-xl p-5 mb-8 text-left">
          <code class="text-buoy">npx ahoybuoy show health</code>
        </div>
        <Button href="https://cal.com/tarre/rescue" size="lg" external>
          Book a Design Calibration call →
        </Button>
        <p class="text-sm text-slate mt-4">No commitment. No invented ROI math. We will tell you if the product is not ready for this.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
