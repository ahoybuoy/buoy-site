---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'
import MarkPattern from '../components/MarkPattern.astro'

const offers = [
  {
    name: 'System found',
    price: '$10,000',
    period: 'one week',
    description: 'Dylan finds the design system your code already has and makes it real, so your coding agents stop inventing new values.',
    items: [
      'A full Buoy baseline of one frontend codebase',
      'Your color, spacing and type sprawl consolidated into tokens and a theme',
      'A DESIGN.md your team and your agents can read',
      'Agent rules and MCP setup for Cursor, Claude Code or the agent you already use',
      'A before-and-after report',
    ],
  },
  {
    name: 'System in place',
    price: '$20,000',
    period: 'two weeks',
    featured: true,
    description: 'Everything in System found, then the code is moved onto it, so the product looks like one product.',
    items: [
      'Everything in System found',
      'Your worst components migrated, in pull requests your team reviews and merges',
      'The Buoy GitHub App set up so new drift is caught on every pull request',
      'A first adoption baseline and a 30-day recheck',
    ],
  },
  {
    name: 'Keep it holding',
    price: '$1,500',
    period: 'per month, per product',
    description: 'After a sprint, Dylan keeps watching so the system holds as your agents write more of the code.',
    items: [
      'Team plan included',
      'A monthly adoption report, with agent-written pull requests split out',
      'A monthly review call with Dylan',
    ],
  },
]
---

<Layout
  title="Work with Dylan | Buoy"
  description="System found: $10,000 for one week. System in place: $20,000 for two weeks. Keep it holding: $1,500 a month per product."
>
  <Nav />

  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="field" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap sv-hero">
      <div>
        <div class="ui-head">
          <p class="ui-eyebrow">Work with Dylan · from $10,000</p>
          <h1>Keep AI-generated UI true to your product.</h1>
          <p class="ui-lede">
            Dylan uses Buoy to find the design system your code already has, turn it into tokens and rules your coding agents follow, and move your product onto it. One or two weeks, fixed price.
          </p>
        </div>
        <div class="ui-actions sv-actions">
          <Button href="https://cal.com/tarre/rescue" size="lg" external>Talk to Dylan</Button>
          <Button href="#what-you-get" variant="secondary" size="lg">See what you get</Button>
        </div>
      </div>
      <div class="ui-tray sv-menu">
        <div class="ui-panel">
          <div class="ui-panel-head">Fixed price</div>
          <ul class="sv-menu-list">
            {offers.map((o) => (
              <li><span class="sv-menu-name">{o.name}</span><span class="sv-menu-period">{o.period}</span><span class="sv-menu-price ui-tnum">{o.price}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap ui-split">
        <div>
          <p class="ui-eyebrow">The missing layer</p>
          <h2 class="sv-h2">A design system gives AI the parts. Buoy gives it context and judgment.</h2>
        </div>
        <p class="ui-lede">
          Coding agents can assemble a valid interface and still produce something generic, off-brand, or wrong for the moment. Buoy connects product intent to implementation: what to use, why it belongs, and what should never ship.
        </p>
      </div>
    </section>

    <section id="what-you-get" class="ui-section sv-anchor">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Three ways to work together.</h2></div>
        <ol class="ui-cols ui-cols--3">
          {offers.map((offer, i) => (
            <li class="ui-col">
              <p class={`ui-tier-name ${i === 2 ? 'ui-tier-free' : 'ui-tier-app'}`}>{offer.period}</p>
              <h3>{offer.name}</h3>
              <p class="sv-price ui-tnum">{offer.price}</p>
              <p>{offer.description}</p>
              <ul class="ui-ruled ui-ruled--tight">{offer.items.map((item) => <li>{item}</li>)}</ul>
            </li>
          ))}
        </ol>

        <div class="sv-auto">
          <h3>What Buoy will, and will not, automate</h3>
          <table class="ui-table">
            <tbody>
              <tr><th scope="row" class="ui-c-ok">Enforced</th><td>Tokens, components, accessibility, and supported code rules can be enforced deterministically.</td></tr>
              <tr><th scope="row" class="ui-c-info">Guidance</th><td>Hierarchy, mood, and brand expression remain documented guidance until the evidence is strong.</td></tr>
              <tr><th scope="row" class="ui-c-warn">Review</th><td>Ambiguous findings stay review-required.</td></tr>
              <tr><th scope="row" class="ui-c-buoy">Fixes</th><td>Fixes land on branches with visible diffs and existing checks.</td></tr>
            </tbody>
          </table>
          <p class="ui-after">Sprints are fixed price: half to begin, half at handoff. Just want the GitHub App? See <a href="/pricing" class="ui-link">pricing</a>.</p>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-cols sv-fit">
          <article class="ui-col">
            <p class="ui-col-sub ui-c-ok">A strong fit</p>
            <h3>Your product already has an identity worth protecting.</h3>
            <p>You have a working frontend, an existing component library or recognizable product language, and a team using AI to ship UI faster.</p>
          </article>
          <article class="ui-col">
            <p class="ui-col-sub ui-c-crit">Not the right plan</p>
            <h3>You need someone to invent the entire brand from scratch.</h3>
            <p>A sprint puts existing product judgment to work. It is not a replacement for foundational brand strategy or zero-to-one product design.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="tide" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap sv-close">
        <div class="ui-head ui-head--center">
          <h2>Start with evidence from your codebase.</h2>
          <p>Run Buoy locally or bring one representative UI pull request. We will use the actual product and implementation to decide which sprint fits, if any.</p>
        </div>
        <div class="ui-term sv-term">
          <div class="ui-term-bar">Terminal</div>
          <pre><span class="ui-t-dim">$</span> <span class="ui-t-hi">npx ahoybuoy show health</span></pre>
        </div>
        <div class="ui-actions sv-center">
          <Button href="https://cal.com/tarre/rescue" size="lg" external>Talk to Dylan</Button>
        </div>
        <p class="ui-note sv-center-text">No commitment. No invented ROI math. We will tell you if the product is not ready for this.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .sv-actions { margin-top: 32px; }
  .sv-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  @media (max-width: 960px) { .sv-hero { grid-template-columns: minmax(0, 1fr); gap: 36px; } }
  .sv-menu-list { list-style: none; margin: 0; padding: 4px 22px; }
  .sv-menu-list li { display: grid; grid-template-columns: 1fr auto; column-gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--color-line); }
  .sv-menu-list li:last-child { border-bottom: 0; }
  .sv-menu-name { font-weight: 600; color: var(--color-ink); }
  .sv-menu-period { grid-row: 2; font-size: 13.5px; color: var(--color-muted); }
  .sv-menu-price { grid-row: 1 / 3; grid-column: 2; align-self: center; font-family: var(--font-display); font-size: 24px; font-weight: 700; color: var(--color-ink); }
  .sv-fit { margin-top: 0; }
  .sv-h2 { margin: 0; font-size: var(--text-h2); line-height: 1.15; color: var(--color-ink); }
  .sv-anchor { scroll-margin-top: 72px; }
  .sv-price { margin-top: 10px !important; font-family: var(--font-display); font-size: 34px !important; font-weight: 700; line-height: 1; color: var(--color-ink); }
  .ui-col .ui-ruled { margin-top: 18px; font-size: 14.5px; }
  .sv-auto { margin-top: 72px; max-width: 760px; }
  .sv-auto h3 { margin: 0 0 16px; font-size: var(--text-h3); color: var(--color-ink); }
  .sv-auto th { width: 110px; font-weight: 600; text-transform: none; letter-spacing: 0; font-size: 14px; vertical-align: top; }
  .sv-close { max-width: 720px; }
  .sv-term { margin-top: 32px; }
  .sv-center { justify-content: center; margin-top: 28px; }
  .sv-center-text { text-align: center; margin: 14px auto 0; }
</style>
