---
import Layout from '../../../layouts/Layout.astro'
import Nav from '../../../components/Nav.astro'
import Footer from '../../../components/Footer.astro'
import { allReports, fileUrl, formatStars, mergeColors, scoreBg, scoreColor, type Report } from '../../../utils/reports'

export function getStaticPaths() {
  return allReports().map((report) => ({ params: { owner: report.owner, repo: report.name }, props: { report } }))
}

const { report } = Astro.props as { report: Report }
const r = report
const topColors = mergeColors(r.topColors)
const pillarLabels: Record<string, string> = {
  valueDiscipline: 'Value discipline',
  tokenHealth: 'Token health',
  consistency: 'Consistency',
  criticalIssues: 'Critical issues',
}
// Findings in vendored shadcn/ui templates are shown apart: the score leaves them out.
const vendored = r.metrics.vendoredDriftCount ?? 0
const ownHardcoded = Math.max(0, r.metrics.hardcodedValueCount - vendored)
const pathLabels: Record<string, string> = { ...pillarLabels, driftCap: 'Drift cap' }
const typeLabels: Record<string, string> = {
  'hardcoded-value': 'Hardcoded values',
  'unused-component': 'Unused components',
  'repeated-pattern': 'Repeated patterns',
  'naming-inconsistency': 'Naming inconsistencies',
  'unused-token': 'Unused tokens',
  'orphaned-component': 'Orphaned components',
  'color-contrast': 'Colour contrast',
}
const title = `${r.repo}: design health ${r.score}/100`
const description = `${ownHardcoded.toLocaleString()} hardcoded-value findings across ${r.metrics.componentCount.toLocaleString()} components in ${r.repo}, scanned by Buoy.`
---

<Layout title={`${title} | Buoy`} description={description} keywords={`${r.name} design system, ${r.repo} hardcoded values, design drift`}>
  <Nav />

  <section class="relative pt-32 pb-12 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-navy-dark via-navy to-navy-dark"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/reports" class="text-sm text-slate hover:text-buoy">← All reports</a>
      <div class="mt-4 flex flex-wrap items-start justify-between gap-6">
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-light">
            <a href={`https://github.com/${r.repo}`} class="hover:text-buoy">{r.repo}</a>
          </h1>
          {r.description && <p class="text-slate mt-2 max-w-2xl">{r.description}</p>}
          <p class="text-sm text-slate/70 mt-2">
            ★ {formatStars(r.stars)} · {r.metrics.detectedFrameworkNames.join(', ') || r.language} · scanned {r.generatedAt.slice(0, 10)} at <code>{r.commit.slice(0, 7)}</code>
          </p>
        </div>
        <div class="text-center">
          <div class={`text-6xl font-bold ${scoreColor(r.score)}`}>{r.score}</div>
          <div class="text-sm text-slate">design health · {r.tier}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 bg-navy-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-4 gap-4">
      {Object.entries(r.pillars).map(([key, p]) => (
        <div class="bg-navy/50 border border-navy-light/20 rounded-2xl p-5">
          <div class="text-sm text-slate">{pillarLabels[key] ?? key}</div>
          <div class="text-2xl font-bold text-light mt-1">{p.score}<span class="text-slate text-base">/{p.max}</span></div>
          <div class="h-1.5 bg-navy-light/30 rounded mt-3"><div class={`h-1.5 rounded ${scoreBg(Math.round((p.score / p.max) * 100))}`} style={`width:${Math.round((p.score / p.max) * 100)}%`}></div></div>
        </div>
      ))}
    </div>
  </section>

  {r.pathTo100 && r.score !== null && (
    <section class="py-6 bg-navy-dark">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-navy/50 border border-buoy/40 rounded-2xl p-6">
          <h2 class="text-xl font-bold text-light">
            {r.pathTo100.length === 0 ? 'A perfect 100' : `The path to 100: ${100 - r.score} points`}
          </h2>
          {r.pathTo100.length === 0 ? (
            <p class="text-slate mt-2">Every pillar is at full marks.</p>
          ) : (
            <ul class="mt-4 space-y-3">
              {r.pathTo100.map((step) => (
                <li class="flex gap-4 items-baseline">
                  <span class="text-buoy font-bold w-12 shrink-0 text-right">+{step.points}</span>
                  <span class="text-light">{step.action}<span class="text-slate text-sm"> · {pathLabels[step.pillar] ?? step.pillar}</span></span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="py-6 bg-navy-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-3 gap-4 text-center">
      <div class="bg-navy/50 border border-navy-light/20 rounded-2xl p-5"><div class="text-3xl font-bold text-light">{ownHardcoded.toLocaleString()}</div><div class="text-sm text-slate">hardcoded-value findings</div>{vendored > 0 && <div class="text-xs text-slate/70 mt-1">plus {vendored} in vendored shadcn/ui files, not scored</div>}</div>
      <div class="bg-navy/50 border border-navy-light/20 rounded-2xl p-5"><div class="text-3xl font-bold text-light">{r.metrics.tokenCount}</div><div class="text-sm text-slate">design tokens found</div></div>
      <div class="bg-navy/50 border border-navy-light/20 rounded-2xl p-5"><div class="text-3xl font-bold text-light">{r.metrics.componentCount.toLocaleString()}</div><div class="text-sm text-slate">components</div></div>
    </div>
  </section>

  <section class="py-10 bg-navy-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
      <div>
        <h2 class="text-xl font-bold text-light mb-4">Most repeated literal colours</h2>
        {topColors.length ? (
          <ul class="space-y-2">
            {topColors.map((c) => (
              <li class="flex items-center gap-3 text-sm">
                <span class="w-5 h-5 rounded border border-navy-light/40 flex-shrink-0" style={`background:${c.value}`}></span>
                <code class="text-light">{c.value}</code>
                <span class="text-slate ml-auto">{c.count}×</span>
              </li>
            ))}
          </ul>
        ) : <p class="text-slate text-sm">No literal colours in components.</p>}
      </div>
      <div>
        <h2 class="text-xl font-bold text-light mb-4">Most repeated literal spacing</h2>
        {r.topSpacing.length ? (
          <ul class="space-y-2">
            {r.topSpacing.map((s) => (
              <li class="flex items-center gap-3 text-sm"><code class="text-light">{s.value}</code><span class="text-slate ml-auto">{s.count}×</span></li>
            ))}
          </ul>
        ) : <p class="text-slate text-sm">No literal spacing in components.</p>}
      </div>
    </div>
  </section>

  <section class="py-10 bg-navy-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
      <div>
        <h2 class="text-xl font-bold text-light mb-4">Files with the most drift</h2>
        <ul class="space-y-2 text-sm">
          {r.worstFiles.map((f) => (
            <li class="flex gap-3"><a href={fileUrl(r, f.file)} class="text-buoy hover:underline truncate">{f.file}</a><span class="text-slate ml-auto flex-shrink-0">{f.count}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold text-light mb-4">Drift by type</h2>
        <ul class="space-y-2 text-sm">
          {Object.entries(r.driftByType).sort((a, b) => b[1] - a[1]).map(([type, n]) => (
            <li class="flex gap-3"><span class="text-light">{typeLabels[type] ?? type}</span><span class="text-slate ml-auto">{n.toLocaleString()}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {r.samples.length > 0 && (
    <section class="py-10 bg-navy-dark">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-light mb-4">Examples</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {r.samples.map((s) => (
            <div class="bg-navy/50 border border-navy-light/20 rounded-xl p-4 text-sm">
              <a href={fileUrl(r, s.location)} class="text-buoy hover:underline">{s.location}</a>
              <div class="text-slate mt-1">{s.component}</div>
              <ul class="mt-2 space-y-1">{s.entries.map((e) => <li><code class="text-light">{e}</code></li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-10 bg-navy-dark">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-light mb-4">What Buoy would do about it</h2>
      <ul class="space-y-2 text-sm text-slate list-disc pl-5">{r.suggestions.map((s) => <li>{s}</li>)}</ul>
      <div class="mt-8 bg-navy/50 border border-buoy/40 rounded-2xl p-6">
        <p class="text-light">Maintainers: this scan used the MIT-licensed CLI at commit <code>{r.commit.slice(0, 7)}</code>. Run it yourself with
          <code class="text-buoy">npx @buoy-design/cli show health</code>, or <a href="https://github.com/marketplace/buoy-design" class="text-buoy">install the GitHub App</a>
          to get the fix suggested on every PR. If anything here is wrong, <a href="https://github.com/ahoybuoy/buoy/issues" class="text-buoy">open an issue</a> and we will correct the page.</p>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
