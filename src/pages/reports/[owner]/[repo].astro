---
import Layout from '../../../layouts/Layout.astro'
import Nav from '../../../components/Nav.astro'
import Footer from '../../../components/Footer.astro'
import ReportView from '../../../components/ReportView.astro'
import { allReports, reportJsonLd, type Report } from '../../../utils/reports'

export function getStaticPaths() {
  return allReports().map((report) => ({ params: { owner: report.owner, repo: report.name }, props: { report } }))
}

const { report: r } = Astro.props as { report: Report }
const vendored = r.metrics.vendoredDriftCount ?? 0
const ownHardcoded = Math.max(0, r.metrics.hardcodedValueCount - vendored)
const title = `${r.repo}: design health ${r.score}/100`
const description = `${ownHardcoded.toLocaleString()} hardcoded-value findings across ${r.metrics.componentCount.toLocaleString()} components in ${r.repo}, scanned by Buoy.`
---

<Layout title={`${title} | Buoy`} description={description} keywords={`${r.name} design system, ${r.repo} hardcoded values, design drift`} jsonLd={reportJsonLd(r, `/reports/${r.repo}`)}>
  <Nav />
  <ReportView report={r} />
  <Footer />
</Layout>
