---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import ScanForm from '../../components/ScanForm.astro'
import { reportStats } from '../../utils/reports'

const s = reportStats()
const faqs = [
  {
    q: 'How do I scan a design system?',
    a: 'Paste a public GitHub repository URL above. Buoy clones it, finds its design tokens and components, and lists the hardcoded colors, spacing and font sizes that bypass them, with a 0 to 100 design health score and the changes that would raise it. For a private repository, run `npx @buoy-design/cli show health` in a checkout.',
  },
  {
    q: 'What does the scan check?',
    a: 'Hardcoded design values (colors, spacing, font sizes, radii, shadows) in React, Vue, Svelte, Angular, Tailwind, CSS and Sass; whether a token system exists and its tokens are used; naming conflicts; and color contrast between text and background on the same element.',
  },
  {
    q: 'What does it leave alone?',
    a: 'Icons and logos, email templates, Open Graph images, tests and stories, example and demo apps, layout math such as calc() and 100dvh, 1px hairlines, and values the code marks as deliberate with a comment or a 2 to 3px optical nudge.',
  },
  {
    q: 'Is it free, and what happens to my code?',
    a: 'It is free. Only public GitHub repositories are scanned here: Buoy clones the default branch, runs the open-source CLI, keeps the report and deletes the checkout. Reports are cached for a day.',
  },
  {
    q: 'How long does a scan take?',
    a: `Usually under a minute. The ${s.scoredCount} codebases on the reports page took about half a minute each at the median; very large monorepos take a few minutes.`,
  },
  {
    q: 'How do I keep drift from coming back?',
    a: 'Install the Buoy GitHub App to get the same checks on every pull request, limited to lines the PR adds and with a committable fix when a token exists, or run `npx @buoy-design/cli drift check --staged` before each commit.',
  },
]
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Buoy design system scanner',
    url: 'https://buoy.design/scan',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any',
    description: 'Scan any public GitHub repository for design drift: hardcoded colors, spacing and font sizes that bypass the design system, with a design health score and the path to 100.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'Buoy', url: 'https://buoy.design' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Scan a design system from a GitHub URL',
    totalTime: 'PT1M',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Paste the repository URL', text: 'Enter a public GitHub repository URL, such as https://github.com/owner/repo.' },
      { '@type': 'HowToStep', position: 2, name: 'Wait for the scan', text: 'Buoy clones the default branch and runs its open-source CLI, usually in under a minute.' },
      { '@type': 'HowToStep', position: 3, name: 'Read the report', text: 'See the design health score, the hardcoded values to fix first, and the path to 100.' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
]
const examples = ['formbricks/formbricks', 'twentyhq/twenty', 'calcom/cal.com', 'shadcn-ui/ui']
import MarkPattern from '../../components/MarkPattern.astro'
---

<Layout
  title="Design System Scanner: Check Any GitHub Repo for Design Drift | Buoy"
  description="Scan a GitHub repository for design drift in under a minute. Find hardcoded colors, spacing and font sizes that bypass your design tokens, get a design health score, and see the path to 100. Free."
  keywords="design system scanner, scan design system, design system audit tool, design drift checker, find hardcoded colors, design token checker, design system health check"
  jsonLd={jsonLd}
>
  <Nav />
  <main class="ui-nav-offset">
  <section class="ui-section ui-section--first ui-section--patterned">
    <MarkPattern pattern="scan" drift={0.3} fade class="ui-pattern" />
    <div class="ui-wrap">
      <div class="ui-head">
        <h1>Scan a design system from a GitHub URL</h1>
        <p class="ui-lede">
          Find the hardcoded colors, spacing and font sizes that bypass the design system, get a design health score,
          and see exactly what it would take to reach 100. Free, for any public repository.
        </p>
      </div>
      <div class="mt-8 max-w-[640px]">
        <ScanForm autofocus />
        <p class="ui-note mt-4">
          Try {examples.map((e, i) => <>{i > 0 && ', '}<a href={`/reports/${e}`} class="ui-rowlink">{e}</a></>)}
        </p>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-cols ui-cols--3 !mt-0">
        <article class="ui-col">
          <h2 class="text-[length:var(--text-h3)]">What it finds</h2>
          <p class="ui-col-sub !text-[var(--color-crit)]">Literals where a token belongs</p>
          <p>Literal colors, spacing, font sizes, radii and shadows where a token belongs, in React, Vue, Svelte, Angular, Tailwind, CSS and Sass, each with the existing token to use when there is one.</p>
        </article>
        <article class="ui-col">
          <h2 class="text-[length:var(--text-h3)]">What it leaves alone</h2>
          <p class="ui-col-sub !text-[var(--color-info)]">Deliberate values stay</p>
          <p>Icons, email templates, tests, demo apps, layout math, and values the code marks as deliberate with a comment. A scan that flags correct code gets ignored.</p>
        </article>
        <article class="ui-col">
          <h2 class="text-[length:var(--text-h3)]">What you get</h2>
          <p class="ui-col-sub ui-c-ok">A score and the path to 100</p>
          <p>A 0 to 100 <a href="/guides/design-system-health-score" class="ui-link">design health score</a>, the most repeated literals, the worst files, and the path to 100: every point missing and the change that earns it.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--last">
    <div class="ui-wrap grid gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
      <div>
        <div class="ui-head">
          <h2>Scanned so far</h2>
          <p>
            <span class="ui-tnum text-[var(--color-ink)]">{s.scoredCount}</span> well-known open-source codebases, <span class="ui-tnum">{s.components.toLocaleString()}</span> components:
            median design health <span class="ui-tnum ui-c-ok">{s.medianScore}/100</span>, <span class="ui-tnum ui-c-crit">{s.findings.toLocaleString()}</span> hardcoded-value findings, and
            <span class="ui-tnum">{s.noted.toLocaleString()}</span> values left alone as deliberate. <a href="/reports" class="ui-link">See every report</a>.
          </p>
        </div>
        <div class="ui-head mt-14">
          <h2>Private repository?</h2>
          <p>Run the same scan locally. Nothing leaves your machine.</p>
        </div>
        <div class="ui-term mt-6">
          <div class="ui-term-bar">Terminal</div>
          <pre><span class="ui-t-prompt">$</span> npx @buoy-design/cli show health</pre>
        </div>
        <p class="ui-note mt-10">
          Guides: <a href="/guides/how-to-audit-a-design-system" class="ui-rowlink">how to audit a design system</a> ·
          <a href="/guides/find-hardcoded-colors-and-spacing" class="ui-rowlink">find hardcoded colors and spacing</a> ·
          <a href="/guides/what-is-design-drift" class="ui-rowlink">what is design drift</a>
        </p>
      </div>
      <div>
        <div class="ui-head"><h2>Frequently asked questions</h2></div>
        <dl class="mt-6 border-t border-[var(--color-line-strong)]">
          {faqs.map((f) => (
            <div class="py-5 border-b border-[var(--color-line)]">
              <dt class="font-semibold text-[var(--color-ink)]">{f.q}</dt>
              <dd class="mt-2 leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
  </main>
  <Footer />
</Layout>
