---
/**
 * An on-demand design health report for one public GitHub repository.
 * Rendered per request: the report when it is ready, progress while the scan
 * runs (the page polls and reloads), and a clear fallback when it fails.
 * These pages are noindex: the curated /reports pages are the indexed ones.
 */
import InlineVisualizers from '../../../components/InlineVisualizers.astro'
import Layout from '../../../layouts/Layout.astro'
import Nav from '../../../components/Nav.astro'
import Footer from '../../../components/Footer.astro'
import ReportView from '../../../components/ReportView.astro'
import MarkPattern from '../../../components/MarkPattern.astro'
import ScanForm from '../../../components/ScanForm.astro'
import { allReports, type Report } from '../../../utils/reports'

export const prerender = false

const API = 'https://api.buoy.design'
const { owner = '', repo = '' } = Astro.params
const valid = /^[A-Za-z0-9-]+$/.test(owner) && /^[A-Za-z0-9_.-]+$/.test(repo)
const fullName = `${owner}/${repo}`

type View = { repo: string; status: 'queued' | 'running' | 'done' | 'failed' | 'none'; error: string | null; report: Report | null }
let view: View = { repo: fullName, status: 'none', error: null, report: null }
let apiDown = false
if (valid) {
  try {
    const res = await fetch(`${API}/public/reports/${owner}/${repo}`, { headers: { Accept: 'application/json' } })
    if (res.ok) view = await res.json() as View
    else if (res.status !== 404) apiDown = true
  } catch {
    apiDown = true
  }
}
if (!valid) Astro.response.status = 404

const curated = allReports().find((r) => r.repo.toLowerCase() === fullName.toLowerCase())
const report = view.report
const pending = view.status === 'queued' || view.status === 'running'
if (report && !pending) Astro.response.headers.set('Cache-Control', 'public, max-age=300')
else Astro.response.headers.set('Cache-Control', 'no-store')

const title = report
  ? `${report.repo}: design health ${report.score ?? 'N/A'}/100 | Buoy scan`
  : `Scanning ${fullName} | Buoy`
const description = report
  ? `Design health ${report.score ?? 'N/A'}/100 for ${report.repo}: hardcoded values, token health and the path to 100.`
  : `Buoy is scanning ${fullName} for design drift.`
---

<Layout title={title} description={description} noindex canonical={curated ? `/reports/${curated.repo}` : undefined}>
  <Nav />

  {!valid && (
    <main class="ui-nav-offset">
      <section class="ui-section ui-section--first ui-section--last">
        <div class="ui-wrap max-w-[760px]">
          <div class="ui-head"><h1>That is not a GitHub repository name</h1><p class="ui-lede">Paste a repository URL like https://github.com/owner/repo.</p></div>
          <div class="mt-8"><ScanForm id="scan-invalid" /></div>
        </div>
      </section>
    </main>
  )}

  {valid && report && (
    <ReportView report={report} backHref="/scan" backLabel="← Scan another repository">
      {pending && (
        <div slot="after-score" class="ui-wrap pt-8">
          <p class="ui-note" data-scan-poll={fullName}>A fresh scan is running; this page updates when it finishes.</p>
        </div>
      )}
      <InlineVisualizers slot="after-score" repo={report.repo} />
      <section slot="after" class="ui-section ui-section--last !pt-0">
        <div class="ui-wrap max-w-3xl grid gap-4 !mx-0 lg:!mx-auto">
          {!(report as Report & { hasSnapshot?: boolean }).hasSnapshot && (report as Report & { hasMap?: boolean }).hasMap && (
            <a href={`/scan/${report.repo}/map`} class="ui-card ui-card--pad block transition-shadow hover:shadow-[var(--ring-hover)]">
              <h2 class="text-[length:var(--text-h3)]">See how {report.repo}'s UI is wired →</h2>
              <p class="mt-2">Tokens, components and pages, and which pages each one reaches.</p>
            </a>
          )}
          <div class="ui-card ui-card--pad">
            <h2 class="text-[length:var(--text-h3)]">Keep it from drifting back</h2>
            <p class="mt-2">
              Install the <a href="https://github.com/marketplace/buoy-design" class="ui-link">Buoy GitHub App</a> to get
              these checks on every pull request, limited to the lines a PR adds and with a one-click fix when a token exists.
              Or run <code class="ui-code">npx @buoy-design/cli drift check --staged</code> before each commit.
            </p>
            {curated && <p class="ui-note mt-3">This repository also has a <a href={`/reports/${curated.repo}`} class="ui-rowlink">curated report</a>, refreshed daily.</p>}
          </div>
        </div>
      </section>
    </ReportView>
  )}

  {valid && !report && (
    <main class="ui-nav-offset">
      <section class="ui-section ui-section--first ui-section--last ui-section--patterned">
        <MarkPattern pattern="scan" drift={0.3} fade class="ui-pattern !opacity-[0.14]" />
        <div class="ui-wrap">
          <a href="/scan" class="ui-rowlink text-sm">← Scan another repository</a>
          <div class="ui-split items-start mt-6 !gap-14">
            <div class="min-w-0">
              <h1 class="text-[clamp(2rem,4.5vw,3.25rem)] leading-[1.08] [overflow-wrap:anywhere]">{fullName}</h1>
              {view.status === 'failed' ? (
                <>
                  <p class="ui-lede mt-4"><span class="ui-c-crit">The scan did not finish.</span> Try again, or run it locally in a checkout.</p>
                  <div class="mt-8"><ScanForm id="scan-retry" /></div>
                </>
              ) : apiDown ? (
                <>
                  <p class="ui-lede mt-4">The scanner is <span class="ui-c-warn">not answering</span> right now. Try again in a minute, or run the same scan locally.</p>
                  <div class="ui-actions mt-8">
                    <a href={`/scan/${fullName}`} class="ui-btn ui-btn--primary">Try again</a>
                    <a href="/reports" class="ui-btn ui-btn--secondary">Browse reports</a>
                  </div>
                </>
              ) : (
                <div data-scan-poll={fullName} data-scan-start={view.status === 'none' ? 'true' : undefined}>
                  <p class="ui-lede mt-4 flex items-center gap-3">
                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--color-buoy)] motion-safe:animate-pulse shrink-0"></span>
                    <span class="text-[var(--color-ink)] font-medium" data-scan-status>{view.status === 'none' ? 'Starting the scan…' : 'Scanning…'}</span>
                  </p>
                  <p class="mt-3 max-w-xl">
                    Buoy is cloning the default branch and running its open-source CLI. Most repositories take under a minute;
                    large monorepos take a few. This page updates by itself.
                  </p>
                  <p class="ui-msg ui-msg--err hidden" role="alert" data-scan-poll-error></p>
                  <p class="ui-note mt-8">While you wait: <a href="/reports" class="ui-rowlink">browse reports</a> for well-known open-source codebases.</p>
                </div>
              )}
            </div>
            <div class="ui-term min-w-0">
              <div class="ui-term-bar">{view.status === 'failed' || apiDown ? 'Run it locally' : 'buoy.design scanner'}</div>
              {view.status === 'failed' ? (
                <pre class="whitespace-pre-wrap"><span class="ui-t-prompt">$</span> npx @buoy-design/cli show health
<span class="ui-t-dim"># the hosted scan stopped with:</span>
<span class="ui-t-crit">{view.error ?? 'unknown error'}</span></pre>
              ) : apiDown ? (
                <pre class="whitespace-pre-wrap"><span class="ui-t-prompt">$</span> npx @buoy-design/cli show health
<span class="ui-t-dim"># same scan, nothing leaves your machine</span></pre>
              ) : (
                <pre class="whitespace-pre-wrap scan-steps"><span class="ui-t-prompt">$</span> scan {fullName}
<span class="ui-t-info">›</span> Cloning the default branch
<span class="ui-t-info">›</span> Running the open-source CLI
<span class="ui-t-info">›</span> Scoring design health<span class="scan-caret ui-t-hi">▍</span></pre>
              )}
            </div>
          </div>
        </div>
      </section>
    </main>
  )}

  <Footer />
</Layout>

<script>
  const API = 'https://api.buoy.design'
  const el = document.querySelector<HTMLElement>('[data-scan-poll]')
  if (el) {
    const repo = el.dataset.scanPoll!
    const status = document.querySelector<HTMLElement>('[data-scan-status]')
    const error = document.querySelector<HTMLElement>('[data-scan-poll-error]')
    const fail = (msg: string) => { if (error) { error.textContent = msg; error.classList.remove('hidden') } }

    const poll = async (attempt = 0): Promise<void> => {
      if (attempt > 180) return fail('This is taking longer than usual. Reload the page to check again.')
      try {
        const res = await fetch(`${API}/public/reports/${repo}`, { cache: 'no-store' })
        const body = res.ok ? await res.json() : null
        if (body && (body.status === 'done' || body.status === 'failed')) { window.location.reload(); return }
        if (status && body?.status === 'running') status.textContent = 'Scanning…'
      } catch { /* keep polling */ }
      setTimeout(() => poll(attempt + 1), 4000)
    }

    const start = async () => {
      try {
        const res = await fetch(`${API}/public/scan`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ repo }),
        })
        const body = await res.json().catch(() => ({}))
        if (!res.ok) return fail(body.error ?? 'The scan could not start.')
        if (body.repo && body.repo !== repo) { window.location.replace(`/scan/${body.repo}`); return }
        if (status) status.textContent = 'Scanning…'
      } catch {
        return fail('The scanner is not answering right now. Try again in a minute.')
      }
      poll()
    }

    // Crawlers that run JavaScript must not start scans; people see the page as usual.
    const isBot = /bot|crawl|spider|slurp|headless|lighthouse/i.test(navigator.userAgent)
    if (el.dataset.scanStart === 'true' && !isBot) start()
    else if (el.dataset.scanStart !== 'true') poll()
  }
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .scan-caret { animation: scan-blink 1s steps(1) infinite; }
    @keyframes scan-blink { 50% { opacity: 0; } }
  }
</style>
