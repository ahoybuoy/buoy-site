</Layout>

<style is:global>
  .t-vercel-guidelines { -webkit-tap-highlight-color: color-mix(in srgb, var(--color-buoy) 25%, transparent); }
  .t-vercel-guidelines :is(h1, h2, h3, h4) { text-wrap: balance; }
  .t-vercel-guidelines p { text-wrap: pretty; }
  .t-vercel-guidelines [id] { scroll-margin-top: 5rem; }
  .t-vercel-guidelines main:focus { outline: none; }
  .t-vercel-guidelines :is(a, button) { touch-action: manipulation; }

  .t-vercel-guidelines .vg-skip {
    position: fixed; top: 0.5rem; left: 0.5rem; z-index: 60;
    padding: 0.5rem 0.875rem; border-radius: 0.5rem;
    background: var(--color-light); color: var(--color-navy-dark); font-size: 0.875rem; font-weight: 600;
    transform: translateY(-200%);
  }
  .t-vercel-guidelines .vg-skip:focus-visible { transform: none; }

  .t-vercel-guidelines .vg-hero { min-height: calc(100svh - 7rem); }

  /* Hero word reveal: transform and opacity only */
  @keyframes vgReveal {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  .t-vercel-guidelines .vg-reveal {
    display: inline-block;
    animation: vgReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .t-vercel-guidelines .vg-motion-toggle {
    position: absolute; right: 1rem; bottom: 1rem; z-index: 20;
    padding: 0.375rem 0.75rem; border-radius: 0.5rem;
    font-size: 0.75rem; font-weight: 500; color: var(--color-slate);
    background: color-mix(in srgb, var(--color-navy-dark) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-navy-light) 60%, transparent);
    transition: color 0.2s, border-color 0.2s;
  }
  .t-vercel-guidelines .vg-motion-toggle:hover { color: var(--color-light); border-color: var(--color-slate-dark); }

  /* Nav dropdowns open for keyboard focus as well as hover */
  .t-vercel-guidelines nav .group:focus-within > div { opacity: 1; visibility: visible; }

  /* Whole-card link target, with the focus ring on the card */
  .t-vercel-guidelines .vg-card-link::after { content: ''; position: absolute; inset: 0; border-radius: 0.75rem; }
  .t-vercel-guidelines .vg-card-link:focus-visible { outline: none; }
  .t-vercel-guidelines .vg-card-link:focus-visible::after { outline: 2px solid var(--color-buoy); outline-offset: 2px; }

  .t-vercel-guidelines .vg-footer-links a { color: var(--color-slate); transition: color 0.2s; }
  .t-vercel-guidelines .vg-footer-links a:hover { color: var(--color-light); text-decoration: underline; text-underline-offset: 4px; }

  .t-vercel-guidelines .vg-pattern img { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* Pause control: stops every CSS loop on the page */
  html[data-motion-paused] .t-vercel-guidelines *,
  html[data-motion-paused] .t-vercel-guidelines *::before,
  html[data-motion-paused] .t-vercel-guidelines *::after { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .t-vercel-guidelines .vg-reveal,
    .t-vercel-guidelines .wave-container,
    .t-vercel-guidelines .particle,
    .t-vercel-guidelines .star,
    .t-vercel-guidelines .grid-lines line,
    .t-vercel-guidelines .cursor-blink::after { animation: none !important; }
    .t-vercel-guidelines .particle { display: none; }
    .t-vercel-guidelines .vg-motion-toggle { display: none; }
    .t-vercel-guidelines * { transition-duration: 0.01ms !important; }
  }
</style>

<script>
  // Pause / play for the looping motion (waves, boat, terminal scan line, lock-on demo, mark pattern).
  const toggle = document.getElementById('vg-motion-toggle')
  const holder = document.querySelector<HTMLElement>('.vg-pattern')
  toggle?.addEventListener('click', () => {
    const paused = document.documentElement.toggleAttribute('data-motion-paused')
    toggle.setAttribute('aria-pressed', String(paused))
    toggle.textContent = paused ? 'Play Motion' : 'Pause Motion'
    // The mark pattern is a canvas loop owned by a shared script: swap it for a still while paused.
    const canvas = holder?.querySelector('canvas')
    if (!holder || !canvas) return
    holder.querySelector('img')?.remove()
    if (paused) {
      const still = new Image()
      still.alt = ''
      still.className = canvas.className
      still.src = canvas.toDataURL()
      holder.appendChild(still)
      canvas.style.display = 'none'
    } else {
      canvas.style.display = ''
    }
  })
</script>
