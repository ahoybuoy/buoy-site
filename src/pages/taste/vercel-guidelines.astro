      </section>
    </main>

    <footer class="border-t border-navy-light/20 bg-navy-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
