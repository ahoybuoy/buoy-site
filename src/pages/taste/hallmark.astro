---
import Layout from '../../layouts/Layout.astro'
import BuoyLogo from '../../components/BuoyLogo.astro'
import BuoyMark from '../../components/BuoyMark.astro'
import { siteConfig } from '../../config'

const installUrl = 'https://github.com/marketplace/buoy-design'

const fixes = [
  { name: 'Hardcoded color', found: '#3b82f6', use: 'var(--color-primary)' },
  { name: 'Hardcoded spacing', found: '24px', use: 'var(--spacing-lg)' },
  { name: 'Hardcoded border radius', found: '8px', use: 'var(--radius-md)' },
  { name: 'Duplicate component', found: '<div style={{…}}>', use: '<Card variant="elevated">' },
]

const driftTypes = [
  { title: 'Accessibility conflict', severity: 'Critical', description: 'Missing ARIA labels, focus issues', href: '/features/accessibility-checks' },
  { title: 'Hardcoded values', severity: 'Warning', description: 'Colors, spacing and fonts not using tokens', href: '/features/hardcoded-values' },
  { title: 'Duplicate components', severity: 'Warning', description: 'Similar components that should be consolidated', href: '/features/duplicate-detection' },
  { title: 'Deprecated patterns', severity: 'Warning', description: 'Components marked as deprecated still in use' },
  { title: 'Inline styles', severity: 'Warning', description: 'Inline CSS that should use tokens or classes' },
  { title: 'Framework sprawl', severity: 'Warning', description: 'Multiple UI frameworks in the same codebase', href: '/features/framework-sprawl' },
  { title: 'Naming inconsistency', severity: 'Info', description: 'Component and prop names that do not match conventions', href: '/features/naming-consistency' },
  { title: 'Orphaned components', severity: 'Info', description: 'Components in code but not in design' },
]

const stack = [
  { name: 'React', href: '/integrations/react' },
  { name: 'Vue', href: '/integrations/vue' },
  { name: 'Svelte', href: '/integrations/svelte' },
  { name: 'Angular', href: '/integrations/angular' },
  { name: 'Next.js', href: '/integrations/nextjs' },
  { name: 'Tailwind', href: '/integrations/tailwind' },
  { name: 'GitHub', href: '/integrations/github' },
]
---

<Layout title="Buoy: catch design drift before it ships" noindex>
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="t-hallmark">
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="container nav__in">
        <a class="nav__logo" href="/" aria-label="Buoy home"><BuoyLogo size="1.5rem" /></a>
        <nav class="nav__links" aria-label="Main">
          <a href="/scan">Scan a repo</a>
          <a href="/docs">Docs</a>
          <a href="/pricing">Pricing</a>
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
        <a class="btn btn--quiet btn--nav" href={installUrl} target="_blank" rel="noopener noreferrer">Install the app</a>
      </div>
    </header>

    <main id="main">
      <!-- Hero: Stage -->
      <section class="hero">
        <div class="container hero__in">
          <div class="hero__text">
            <h1>Catch design drift before it ships.</h1>
            <p class="lead">Buoy reviews every pull request against your design system, with the fix.</p>
            <div class="actions">
              <a class="btn btn--primary" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
              <a class="btn btn--quiet" href="/scan">Scan a public repo</a>
            </div>
          </div>

          <figure class="well ticks pr" data-slot="hero" data-kind="product" data-alt="A Buoy review comment on a pull request diff">
            <div class="pr__head">
              <span class="pr__title">feat: add new Card component</span>
              <span class="mono pr__num">#247</span>
            </div>
            <div class="pr__file mono">src/components/Card.tsx</div>
            <pre class="code" tabindex="0" aria-label="Diff of Card.tsx"><code><span class="ln">21</span>  export function Card(&#123; children &#125;) &#123;
<span class="ln">22</span>    const styles = &#123;
<span class="ln">23</span>      background: <span class="found">'#3b82f6'</span>,</code></pre>
            <div class="note">
              <div class="note__by">
                <BuoyMark size={16} />
                <span class="note__name">buoy</span>
                <span class="note__meta">commented on line 23</span>
              </div>
              <p class="note__body">Hardcoded color <code class="found">#3b82f6</code>. Use <code class="token">var(--color-primary)</code> instead.</p>
              <pre class="code code--sug" tabindex="0" aria-label="Suggested change"><code><span class="ln">-</span>      background: <span class="found">'#3b82f6'</span>,
<span class="ln">+</span>      background: <span class="token">'var(--color-primary)'</span>,</code></pre>
            </div>
            <pre class="code" tabindex="0" aria-label="Diff of Card.tsx, continued"><code><span class="ln">24</span>      borderRadius: <span class="found">'8px'</span>,
<span class="ln">25</span>      padding: <span class="found">'24px'</span>,
<span class="ln">26</span>    &#125;</code></pre>
            <figcaption class="pr__foot">
              <span>Buoy Design Check</span>
              <span>3 issues found</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- Table: the value found, the token to use -->
      <section class="sec sec--ruled sec--first">
        <div class="container">
          <div class="head head--split">
            <h2>Agents do not know your tokens.</h2>
            <p class="lead">Buoy names the hardcoded value and the token that already exists for it.</p>
          </div>
          <table class="fixes">
            <thead>
              <tr><th scope="col">Finding</th><th scope="col">In the pull request</th><th scope="col">Buoy suggests</th></tr>
            </thead>
            <tbody>
              {fixes.map((f) => (
                <tr>
                  <th scope="row">{f.name}</th>
                  <td data-label="In the pull request"><span class="mono fixes__val found">{f.found}</span></td>
                  <td data-label="Buoy suggests"><span class="mono fixes__val token">{f.use}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Split: the CLI -->
      <section class="sec sec--l">
        <div class="container cli">
          <div class="cli__text">
            <h2>One command scans the repository.</h2>
            <p class="lead">Every issue comes with its file, its line and a suggested token.</p>
            <dl class="cmds">
              <div><dt class="mono">npx ahoybuoy dock</dt><dd>Sets Buoy up in a project.</dd></div>
              <div><dt class="mono">buoy drift check</dt><dd>Scans the code against your design system.</dd></div>
              <div><dt class="mono">buoy show health</dt><dd>Tracks design system health over time.</dd></div>
            </dl>
          </div>
          <figure class="well ticks term" data-slot="cli" data-kind="product" data-alt="Terminal output of buoy drift check">
            <pre class="code code--term" tabindex="0" aria-label="Output of buoy drift check"><code><span class="dim">$</span> buoy drift check

<span class="dim">Scanning for design drift...</span>

Found 23 issues in 142 files

CRITICAL (2)
<span class="dim">├─</span> Button.tsx:12  Missing aria-label
<span class="dim">└─</span> Modal.tsx:45   Focus trap not implemented

HARDCODED VALUES (8)
<span class="dim">├─</span> Card.tsx:8     <span class="found">#ffffff</span> <span class="dim">→ use</span> <span class="token">var(--bg-surface)</span>
<span class="dim">├─</span> Badge.tsx:3    <span class="found">8px</span> <span class="dim">→ use</span> <span class="token">var(--spacing-sm)</span>
<span class="dim">└─ ... and 6 more</span></code></pre>
            <figcaption class="cap">Sample output from <span class="mono">buoy drift check</span>.</figcaption>
          </figure>
        </div>
      </section>

      <!-- Statement band: deterministic -->
      <section class="band">
        <div class="container">
          <p class="statement">The scanner is deterministic. No LLM, no API keys, and nothing leaves your machine.</p>
          <dl class="facts">
            <div><dt>MIT licensed</dt><dd>The CLI is open source and makes no external calls.</dd></div>
            <div><dt>Works offline</dt><dd>It runs air-gapped, for teams where AI tools are restricted.</dd></div>
            <div><dt>In the GitHub App</dt><dd>Summaries are written by an LLM. Findings stay deterministic. <a href="/privacy#subprocessors">See what is sent</a>.</dd></div>
          </dl>
        </div>
      </section>

      <!-- Index: what it detects -->
      <section class="sec" id="features">
        <div class="container index">
          <div class="index__head">
            <h2>Eight kinds of drift.</h2>
            <p class="lead">Sorted by severity, so you can fix the worst first.</p>
            <p class="stack">Works with {stack.map((s, i) => (
              <Fragment><a href={s.href}>{s.name}</a>{i < stack.length - 2 ? ', ' : i === stack.length - 2 ? ' and ' : '.'}</Fragment>
            ))}</p>
          </div>
          <ul class="index__rows">
            {driftTypes.map((d) => (
              <li>
                <span class="index__name">{d.href ? <a href={d.href}>{d.title}</a> : d.title}</span>
                <span class="index__desc">{d.description}</span>
                <span class={`index__sev index__sev--${d.severity.toLowerCase()}`}>{d.severity}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Rows: how to start -->
      <section class="sec sec--ruled sec--s">
        <div class="container">
          <div class="head">
            <h2>Start with the free CLI.</h2>
          </div>
          <ul class="plans">
            <li>
              <h3>Open source CLI</h3>
              <p>Free. Unlimited scans, all detection rules and fix suggestions, on your machine.</p>
              <a class="link" href="/docs">Read the docs</a>
            </li>
            <li>
              <h3>GitHub App</h3>
              <p>The same scanner on every pull request, with inline comments, a check status and fixes you can commit.</p>
              <a class="link" href={installUrl} target="_blank" rel="noopener noreferrer">Install the app</a>
            </li>
            <li>
              <h3>Organization</h3>
              <p>For design-system owners: a record of how your system holds up across every repo that uses it.</p>
              <a class="link" href="/pricing">See pricing</a>
            </li>
          </ul>
        </div>
      </section>

      <!-- Band: the action again -->
      <section class="close">
        <div class="container close__in">
          <h2>Add Buoy to a repository.</h2>
          <div class="close__act">
            <div class="actions">
              <a class="btn btn--primary" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
              <a class="btn btn--quiet" href="/scan">Scan a public repo</a>
            </div>
            <p class="close__cmd">Or set up the CLI with <span class="mono">npx ahoybuoy dock</span></p>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="container">
        <a class="foot__logo" href="/" aria-label="Buoy home"><BuoyLogo size="3.5rem" /></a>
        <div class="foot__cols">
          <ul aria-label="Product">
            <li><a href="/scan">Scan a repo</a></li>
            <li><a href="/docs">Docs</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/guides">Guides</a></li>
            <li><a href="/reports">Reports</a></li>
            <li><a href="/compare">Compare</a></li>
          </ul>
          <ul aria-label="Community">
            <li><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href={siteConfig.twitterUrl} target="_blank" rel="noopener noreferrer">Twitter</a></li>
            <li><a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a></li>
          </ul>
          <ul aria-label="Legal">
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
            <li><a href="/support">Support</a></li>
          </ul>
        </div>
        <p class="foot__legal">&copy; {new Date().getFullYear()} Buoy. The scanner is open source under MIT.</p>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
/* Hallmark · shape: Workbench · genre: modern-minimal · theme: Rim (deal: manual, accent anchored to the brand token) · job: sign up · draw: manual
 * hero: Stage · nav: edge-aligned, the logo, four links and one quiet action · footer: a mast, the logo over the links · imagery: the product built, 2 (pull request review, CLI output) · signature: Buoy's review comment on a diff line, the found value in orange and the token in blue · rim: night
 * axes: Hanging|Asymmetric spans|Hairline|Solid|Tightly cropped|None · contrast: pass · fold: pass · v2.0.0 */
/* Hallmark · pre-emit critique: P4 H4 E4 S4 R4 V3 · weakest: V, text beside a product is the common dev-tool hero; kept because the review comment is the strongest real thing, and made the second section a table of found value against token instead of feature tiles */
/* Hallmark · waive 84 · two built samples in data-slots, content taken from the live homepage · capture.mjs may not be run in this build, so the Buoy review and CLI output are set from the homepage's own samples */
/* Hallmark · waive 47b · one terminal block, no frame or title bar, real buoy drift check output inside · the CLI is the Buoy product being shown */
.t-hallmark {
  --color-paper: oklch(9% 0.008 75); --color-paper-2: oklch(12.5% 0.009 75); --color-paper-3: oklch(6.5% 0.007 75);
  --color-ink: oklch(94% 0.010 80); --color-ink-2: oklch(84% 0.011 80); --color-muted: oklch(68% 0.012 80); --color-muted-2: oklch(50% 0.010 80);
  --color-rule: oklch(25% 0.010 78); --color-rule-2: oklch(16% 0.009 78);
  --color-accent: var(--color-buoy); --color-accent-hover: var(--color-buoy-light); --color-accent-ink: oklch(10% 0.02 45); --color-accent-2: oklch(74% 0.12 250); --color-focus: var(--color-buoy-light);
  --font-display: "Switzer", ui-sans-serif, system-ui, sans-serif; --font-body: var(--font-display);
  --font-outlier: "Geist Mono", ui-monospace, monospace;
  --radius-card: 0; --radius-pill: 0; --rule-hair: 1px; --shadow-card: none;
  --tracking-display: -0.04em; --display-weight: 500;
  --space-3xs: 2px; --space-2xs: 4px; --space-xs: 8px; --space-sm: 12px; --space-md: 16px; --space-lg: 24px; --space-xl: 40px; --space-2xl: 64px; --space-3xl: 96px; --space-4xl: 144px;
  --text-xs: 0.8125rem; --text-sm: 0.875rem; --text-md: 1rem; --text-lg: 1.25rem; --text-xl: 1.5625rem; --text-2xl: 1.953rem;
  --text-display-s: clamp(2.25rem, 4vw + 0.5rem, 3.75rem); --text-display: clamp(2.75rem, 5vw + 1rem, 5.25rem);
  --text-section: clamp(2rem, 2.5vw + 1rem, 3.5rem); --text-title: clamp(1.25rem, 0.75vw + 0.875rem, 1.625rem); --text-lead: clamp(1.125rem, 0.35vw + 1rem, 1.375rem);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-micro: 120ms; --dur-short: 220ms;
  --container: 1440px; --gutter: 64px; --gap-columns: 32px; --section-gap-s: 120px; --section-gap: 144px; --section-gap-l: 176px;
  --nav-h: 72px; --control-h: 48px;
  --z-raised: 10; --z-toast: 500;
}
@media (max-width: 60rem) { .t-hallmark { --gutter: 24px; --section-gap-s: 80px; --section-gap: 96px; --section-gap-l: 120px; } }
@media (max-width: 40rem) { .t-hallmark { --gutter: 16px; --section-gap-s: 56px; --section-gap: 72px; --section-gap-l: 96px; --gap-columns: 16px; } }

html:has(.t-hallmark), body:has(.t-hallmark) { overflow-x: clip; }
html:has(.t-hallmark) { scrollbar-color: oklch(50% 0.010 80) oklch(9% 0.008 75); scroll-padding-top: 96px; }
body:has(.t-hallmark) { background: oklch(9% 0.008 75); }

.t-hallmark { background: var(--color-paper); color: var(--color-ink); font-family: var(--font-body); font-size: var(--text-md); line-height: 1.55; font-synthesis: none; caret-color: var(--color-accent); min-height: 100dvh; }
.t-hallmark *, .t-hallmark *::before, .t-hallmark *::after { box-sizing: border-box; }
.t-hallmark ::selection { background: color-mix(in oklab, var(--color-accent) 35%, transparent); color: var(--color-ink); }
.t-hallmark :focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
.t-hallmark a { color: inherit; text-decoration: none; }
.t-hallmark h1, .t-hallmark h2, .t-hallmark h3 { margin: 0; font-family: var(--font-display); font-weight: var(--display-weight); line-height: 1.02; color: var(--color-ink); overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
.t-hallmark h1 { max-width: 12ch; font-size: var(--text-display); letter-spacing: var(--tracking-display); }
.t-hallmark h2 { max-width: 18ch; font-size: var(--text-section); letter-spacing: -0.03em; }
.t-hallmark h3 { font-size: var(--text-title); letter-spacing: -0.02em; line-height: 1.2; }
.t-hallmark p { margin: 0; text-wrap: pretty; color: var(--color-ink-2); }
.t-hallmark .lead { font-size: var(--text-lead); line-height: 1.45; max-width: 44ch; }
.t-hallmark ul, .t-hallmark dl, .t-hallmark dd, .t-hallmark figure { margin: 0; padding: 0; list-style: none; }
.t-hallmark .mono, .t-hallmark code, .t-hallmark pre { font-family: var(--font-outlier); font-variant-numeric: tabular-nums; font-weight: 400; }
.t-hallmark .container { width: 100%; max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter); }
.t-hallmark .found { color: var(--color-accent); }
.t-hallmark .token { color: var(--color-accent-2); }
.t-hallmark .dim { color: var(--color-muted); }

.t-hallmark .skip { position: absolute; left: var(--space-md); top: calc(-1 * var(--space-3xl)); z-index: var(--z-toast); padding: var(--space-xs) var(--space-md); background: var(--color-ink); color: var(--color-paper); }
.t-hallmark .skip:focus { top: var(--space-md); }

/* Controls */
.t-hallmark .btn { display: inline-flex; align-items: center; justify-content: center; min-height: var(--control-h); padding: 0 var(--space-lg); border: var(--rule-hair) solid var(--color-rule); border-radius: var(--radius-pill); background: transparent; color: var(--color-ink); font: 500 var(--text-md)/1 var(--font-body); white-space: nowrap; cursor: pointer; transition: background-color var(--dur-short) var(--ease-out), border-color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out); }
.t-hallmark .btn:hover { background: var(--color-paper-2); border-color: var(--color-muted-2); }
.t-hallmark .btn:active { transform: translateY(1px); }
.t-hallmark .btn--primary { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }
.t-hallmark .btn--primary:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); }
.t-hallmark .btn--nav { min-height: 44px; padding: 0 var(--space-md); font-size: var(--text-sm); }
.t-hallmark .actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
.t-hallmark .link { font-weight: 500; color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-muted-2); text-decoration-thickness: 1px; text-underline-offset: 0.2em; transition: text-decoration-color var(--dur-short) var(--ease-out); }
.t-hallmark .link:hover { text-decoration-color: var(--color-accent); }

/* Nav */
.t-hallmark .nav { border-bottom: var(--rule-hair) solid var(--color-rule-2); }
.t-hallmark .nav__in { display: flex; align-items: center; gap: var(--space-xl); height: var(--nav-h); }
.t-hallmark .nav__logo { display: inline-flex; margin-right: auto; }
.t-hallmark .nav__links { display: flex; gap: var(--space-lg); font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); }
.t-hallmark .nav__links a { display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; transition: color var(--dur-short) var(--ease-out); }
.t-hallmark .nav__links a:hover { color: var(--color-ink); }

/* Hero */
.t-hallmark .hero { display: grid; align-items: center; min-height: min(calc(100dvh - var(--nav-h)), 828px); padding-block: var(--space-2xl); }
.t-hallmark .hero__in { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 7fr); gap: var(--space-2xl); align-items: center; }
.t-hallmark .hero__text { display: grid; gap: var(--space-lg); justify-items: start; }
.t-hallmark .hero__text .lead { max-width: 34ch; }
.t-hallmark .hero__text .actions { margin-top: var(--space-md); }

/* Wells and the product samples */
.t-hallmark .well { position: relative; background: var(--color-paper-2); }
.t-hallmark .sunk { position: relative; background: var(--color-paper-3); }
.t-hallmark .ticks::before, .t-hallmark .ticks::after { content: ""; position: absolute; width: 12px; height: 12px; border: 0 solid var(--color-muted); pointer-events: none; z-index: var(--z-raised); }
.t-hallmark .ticks::before { top: calc(-1 * var(--space-xs)); left: calc(-1 * var(--space-xs)); border-width: 1px 0 0 1px; }
.t-hallmark .ticks::after { right: calc(-1 * var(--space-xs)); bottom: calc(-1 * var(--space-xs)); border-width: 0 1px 1px 0; }
.t-hallmark .code { margin: 0; padding: var(--space-md) var(--space-lg); font-size: var(--text-sm); line-height: 1.75; color: var(--color-ink-2); overflow-x: auto; white-space: pre; background: none; }
.t-hallmark .ln { display: inline-block; width: 2ch; margin-right: var(--space-md); color: var(--color-muted-2); text-align: right; user-select: none; }
.t-hallmark .pr__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-md); padding: var(--space-md) var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule); font-weight: 500; }
.t-hallmark .pr__num { color: var(--color-muted); font-size: var(--text-sm); }
.t-hallmark .pr__file { padding: var(--space-sm) var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-rule-2); font-size: var(--text-sm); color: var(--color-muted); }
.t-hallmark .note { background: var(--color-paper-3); padding: var(--space-lg); display: grid; gap: var(--space-sm); }
.t-hallmark .note__by { display: flex; align-items: center; gap: var(--space-xs); font-size: var(--text-sm); }
.t-hallmark .note__name { font-weight: 500; color: var(--color-ink); }
.t-hallmark .note__meta { color: var(--color-muted); }
.t-hallmark .note__body { font-size: var(--text-lg); line-height: 1.4; color: var(--color-ink); }
