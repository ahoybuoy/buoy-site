---
import Layout from '../../layouts/Layout.astro'
import BuoyLogo from '../../components/BuoyLogo.astro'
import BuoyMark from '../../components/BuoyMark.astro'
import FreeSpots from '../../components/FreeSpots.astro'
import { siteConfig } from '../../config'

const installUrl = 'https://github.com/marketplace/buoy-design'

const checks = [
  { name: 'Hardcoded values', what: 'Colors, spacing and fonts that do not use tokens', severity: 'Warning', href: '/features/hardcoded-values' },
  { name: 'Duplicate components', what: 'Similar components that should be consolidated', severity: 'Warning', href: '/features/duplicate-detection' },
  { name: 'Inline styles', what: 'Inline CSS that should use tokens or classes', severity: 'Warning' },
  { name: 'Deprecated patterns', what: 'Components marked as deprecated that are still in use', severity: 'Warning' },
  { name: 'Framework sprawl', what: 'Multiple UI frameworks in the same codebase', severity: 'Warning', href: '/features/framework-sprawl' },
  { name: 'Accessibility conflicts', what: 'Missing ARIA labels and focus issues', severity: 'Critical', href: '/features/accessibility-checks' },
  { name: 'Naming inconsistency', what: 'Component and prop names that do not match your conventions', severity: 'Info', href: '/features/naming-consistency' },
  { name: 'Orphaned components', what: 'Components in code but not in design', severity: 'Info' },
]

const stack = [
  { name: 'React', href: '/integrations/react' },
  { name: 'Vue', href: '/integrations/vue' },
  { name: 'Svelte', href: '/integrations/svelte' },
  { name: 'Angular', href: '/integrations/angular' },
  { name: 'Next.js', href: '/integrations/nextjs' },
  { name: 'Tailwind', href: '/integrations/tailwind' },
  { name: 'GitHub', href: '/integrations/github' },
]

const annotations = [
  { file: 'src/components/Card.tsx', line: 23, found: 'Hardcoded color', value: '#3b82f6', fix: 'var(--color-primary)' },
  { file: 'src/components/Card.tsx', line: 31, found: 'Hardcoded spacing', value: '24px', fix: 'var(--spacing-lg)' },
  { file: 'src/components/Modal.tsx', line: 8, found: 'Hardcoded border radius', value: '8px', fix: 'var(--radius-md)' },
]
---

<Layout title="Buoy: catch design drift before it ships" noindex>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="t-frontend-design">
    <a class="fd-skip" href="#main">Skip to content</a>

    <header class="fd-header">
      <div class="fd-wrap fd-header-row">
        <a href="/" class="fd-logo" aria-label="Buoy home"><BuoyLogo size="1.6rem" /></a>
        <nav class="fd-nav" aria-label="Main">
          <a href="/docs">Docs</a>
          <a href="/pricing">Pricing</a>
          <a href="/scan">Scan a repo</a>
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
        <a class="fd-btn fd-btn-quiet fd-btn-sm" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="fd-hero">
        <div class="fd-wrap">
          <h1 class="fd-h1">
            <span>Catch design drift</span>
            <span>before it ships.</span>
          </h1>

          <div class="fd-hero-row">
            <div class="fd-hero-copy">
              <p class="fd-lede">
                Buoy checks UI code against your design system. It reviews every pull request and
                leaves an inline comment with the exact fix, such as the token that already exists
                for a hardcoded color.
              </p>
              <div class="fd-actions">
                <a class="fd-btn fd-btn-primary" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
                <a class="fd-btn fd-btn-quiet" href="/scan">Scan a public repo</a>
              </div>
              <p class="fd-note">
                The scanner is open source under MIT. It runs without an LLM, and nothing leaves your machine.
              </p>
            </div>

            <figure class="fd-review" aria-label="A Buoy review comment on a pull request">
              <div class="fd-review-head">
                <span class="fd-path">src/components/Card.tsx</span>
                <span class="fd-dim">Pull request #247</span>
              </div>
              <pre class="fd-code" tabindex="0"><code><span class="fd-ln"><i>21</i>const Card = () =&gt; (</span>
<span class="fd-ln"><i>22</i>  &lt;div style=&#123;&#123;</span>
<span class="fd-ln fd-flagged"><i>23</i>    background: "<b class="fd-drift">#3b82f6</b>",</span>
</code></pre>
              <div class="fd-comment">
                <div class="fd-comment-by">
                  <span class="fd-avatar"><BuoyMark size={18} /></span>
                  <strong>buoy-design</strong>
                  <span class="fd-bot">bot</span>
                </div>
                <p>
                  Hardcoded color <code>#3b82f6</code>. Use <code>var(--color-primary)</code> instead.
                </p>
                <div class="fd-suggest">
                  <div class="fd-suggest-head">Suggested change</div>
                  <pre class="fd-code fd-code-inset"><code><span class="fd-ln fd-del"><i>-</i>background: "#3b82f6",</span>
<span class="fd-ln fd-add"><i>+</i>background: "var(--color-primary)",</span>
</code></pre>
                </div>
              </div>
              <pre class="fd-code fd-code-tail" aria-hidden="true"><code><span class="fd-ln"><i>24</i>    padding: "24px",</span>
<span class="fd-ln"><i>25</i>    borderRadius: "8px",</span>
</code></pre>
            </figure>
          </div>
        </div>
      </section>

      <!-- Why -->
      <section class="fd-section">
        <div class="fd-wrap">
          <div class="fd-intro fd-intro-wide">
            <h2 class="fd-h2">Coding agents write a lot of UI. They do not know your tokens.</h2>
            <p>
              Hardcoded values creep in, and drift compounds. The first component below is what
              gets generated. The second is what your design system already provides.
            </p>
          </div>

          <div class="fd-pair">
            <figure class="fd-panel">
              <figcaption class="fd-panel-head">
                <span>What gets generated</span>
                <span class="fd-path">Card.tsx</span>
              </figcaption>
              <pre class="fd-code" tabindex="0"><code>const Card = () =&gt; (
  &lt;div style=&#123;&#123;
    background: "<b class="fd-drift">#ffffff</b>",
    padding: "<b class="fd-drift">16px</b>",
    borderRadius: "<b class="fd-drift">8px</b>",
    boxShadow: "<b class="fd-drift">0 2px 4px rgba...</b>"
  &#125;&#125;&gt;
    &#123;children&#125;
  &lt;/div&gt;
)</code></pre>
            </figure>
            <figure class="fd-panel">
              <figcaption class="fd-panel-head">
                <span>What your system already has</span>
                <span class="fd-path">Card.tsx</span>
              </figcaption>
              <pre class="fd-code" tabindex="0"><code>import &#123; Card &#125; from "@/components"

const MyCard = () =&gt; (
  <b class="fd-ok">&lt;Card variant="elevated"&gt;</b>
    &#123;children&#125;
  <b class="fd-ok">&lt;/Card&gt;</b>
)</code></pre>
            </figure>
          </div>
          <p class="fd-caption">
            Buoy underlines each hardcoded value and names the replacement: <code>#ffffff</code> becomes
            <code>var(--bg)</code>, <code>16px</code> becomes <code>var(--space-4)</code>, and the
            hand-built div becomes <code>&lt;Card&gt;</code>.
          </p>
        </div>
      </section>

      <!-- What it checks -->
      <section class="fd-section fd-ruled" id="checks">
        <div class="fd-wrap fd-split">
          <div class="fd-intro">
            <h2 class="fd-h2">What Buoy checks for</h2>
            <p>Each finding has a severity, so you can decide what to fix first.</p>
            <p><a class="fd-link" href="/features/drift-detection">Read how drift detection works</a></p>
          </div>
          <table class="fd-table">
            <thead>
              <tr>
                <th scope="col">Check</th>
                <th scope="col">What it finds</th>
                <th scope="col">Severity</th>
              </tr>
            </thead>
            <tbody>
              {checks.map((c) => (
                <tr>
                  <th scope="row">
                    {c.href ? <a class="fd-link" href={c.href}>{c.name}</a> : c.name}
                  </th>
                  <td>{c.what}</td>
                  <td class="fd-sev">{c.severity}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Two ways to run it -->
      <section class="fd-section fd-ruled">
        <div class="fd-wrap">
          <div class="fd-intro">
            <h2 class="fd-h2">Run it in your terminal, or on every pull request</h2>
          </div>

          <div class="fd-pair fd-pair-top">
            <div class="fd-way">
              <figure class="fd-panel" aria-label="Terminal output of buoy drift check">
                <figcaption class="fd-panel-head">
                  <span>Terminal</span>
                </figcaption>
                <pre class="fd-code" tabindex="0"><code><span class="fd-dim">$</span> buoy drift check

Scanning for design drift...
Found 23 issues in 142 files

CRITICAL (2)
  Button.tsx:12  Missing aria-label
  Modal.tsx:45   Focus trap not implemented

HARDCODED VALUES (8)
  Card.tsx:8   <b class="fd-drift">#ffffff</b>  <span class="fd-ok">use var(--bg-surface)</span>
  Badge.tsx:3  <b class="fd-drift">8px</b>      <span class="fd-ok">use var(--spacing-sm)</span>
  <span class="fd-dim">... and 6 more</span></code></pre>
              </figure>
              <h3 class="fd-h3">The command line tool</h3>
              <p>
                Set it up with <code>npx ahoybuoy dock</code>, then scan with <code>buoy drift check</code>.
                Every issue comes with the file, the line and a suggested fix.
                <code>buoy show health</code> tracks the health of your design system over time.
              </p>
              <p><a class="fd-link" href="/docs">Read the docs</a></p>
            </div>

            <div class="fd-way">
              <figure class="fd-panel" aria-label="Buoy check result on a pull request">
                <figcaption class="fd-panel-head">
                  <span>feat: add new Card component</span>
                  <span class="fd-dim">#247</span>
                </figcaption>
                <div class="fd-check-title">Buoy Design Check: 3 issues found</div>
                <ul class="fd-annotations">
                  {annotations.map((a) => (
                    <li>
                      <div class="fd-path">{a.file}<span class="fd-dim"> line {a.line}</span></div>
                      <div>
                        {a.found} <code class="fd-drift">{a.value}</code>. Use <code class="fd-ok">{a.fix}</code> instead.
                      </div>
                    </li>
                  ))}
                </ul>
                <div class="fd-check-foot">Fix these issues to merge</div>
              </figure>
              <h3 class="fd-h3">The GitHub App</h3>
              <p>
                Install it and every pull request gets checked. Comments are inline, on the line that
                drifted, with a fix you can commit.
              </p>
              <p class="fd-free"><FreeSpots /></p>
              <p><a class="fd-link" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Deterministic -->
      <section class="fd-deep">
        <div class="fd-wrap">
          <h2 class="fd-h2 fd-h2-wide">
            The scanner is deterministic. No LLM, no API keys, and no data leaves your machine.
          </h2>
          <div class="fd-pair fd-pair-top fd-cols">
            <div>
              <h3 class="fd-h3">Open source CLI</h3>
              <ul class="fd-list">
                <li>All scanning and drift detection</li>
                <li>Fix suggestions with exact token replacements</li>
                <li>Works offline and air-gapped</li>
                <li>No external calls. MIT licensed.</li>
              </ul>
            </div>
            <div>
              <h3 class="fd-h3">GitHub App</h3>
              <ul class="fd-list">
                <li>Runs the same open-source scanner on every pull request</li>
                <li>Summaries and coaching are written by an LLM. The findings stay deterministic.</li>
                <li>Inline fix suggestions you can commit</li>
                <li>A dashboard with health scores and trends</li>
              </ul>
              <p class="fd-small">
                The written summaries go through OpenRouter.
                <a class="fd-link" href="/privacy#subprocessors">See what is sent</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Stack + cost -->
      <section class="fd-section">
        <div class="fd-wrap">
          <p class="fd-stack">
            Works with
            {stack.map((s, i) => (
              <Fragment>
                <a href={s.href}>{s.name}</a>{i < stack.length - 2 ? ', ' : i === stack.length - 2 ? ' and ' : '.'}
              </Fragment>
            ))}
          </p>

          <div class="fd-tiers">
            <div>
              <h3 class="fd-h3">CLI</h3>
              <p class="fd-price">Free and open source</p>
              <p>Unlimited scans, all detection rules and fix suggestions, in any project.</p>
            </div>
            <div>
              <h3 class="fd-h3">GitHub App</h3>
              <p class="fd-price fd-free"><FreeSpots /></p>
              <p>Inline pull request comments, a check status and fix suggestions.</p>
            </div>
            <div>
              <h3 class="fd-h3">Organization</h3>
              <p class="fd-price">For design-system owners</p>
              <p>An org-wide record of how your system holds up across every repo that uses it.</p>
            </div>
          </div>
          <p><a class="fd-link" href="/pricing">See pricing</a></p>
        </div>
      </section>

      <!-- Close -->
      <section class="fd-section fd-ruled fd-close">
        <div class="fd-wrap">
          <h2 class="fd-h2 fd-h2-wide">See what Buoy finds in your code.</h2>
          <p class="fd-lede">
            Install the GitHub App to have your next pull request reviewed, or scan any public GitHub
            repository for free in about a minute.
          </p>
          <div class="fd-actions">
            <a class="fd-btn fd-btn-primary" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
            <a class="fd-btn fd-btn-quiet" href="/scan">Scan a public repo</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="fd-footer">
      <div class="fd-wrap fd-footer-row">
        <div class="fd-footer-brand">
          <BuoyLogo size="1.25rem" />
          <p>&copy; {new Date().getFullYear()} Buoy. The scanner is open source under MIT.</p>
        </div>
        <nav class="fd-footer-nav" aria-label="Footer">
          <a href="/docs">Docs</a>
          <a href="/pricing">Pricing</a>
          <a href="/scan">Scan a repo</a>
          <a href="/guides">Guides</a>
          <a href="/reports">Reports</a>
          <a href="/compare">Compare</a>
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={siteConfig.twitterUrl} target="_blank" rel="noopener noreferrer">Twitter</a>
          <a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/support">Support</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  html:has(.t-frontend-design) body {
    background: #e7eded;
  }

  .t-frontend-design {
    /* Fog, deck, deep water, tide, line. The orange comes from the brand token. */
    --fd-fog: #e7eded;
    --fd-deck: #f5f8f8;
    --fd-deep: #0b2a32;
    --fd-deep-2: #12363f;
    --fd-tide: #44626a;
    --fd-line: #bccacc;
    --fd-code: #cfdcde;
    --fd-code-dim: #86a1a6;
    --fd-add: #a4e0c4;
    --fd-del: #f3ada0;
    --fd-accent: var(--color-buoy);

    --fd-sans: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    --fd-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;

    background: var(--fd-fog);
    color: var(--fd-deep);
    font-family: var(--fd-sans);
    font-size: 1.0625rem;
    line-height: 1.55;
    min-height: 100vh;
    overflow-x: clip;
  }

  .t-frontend-design ::selection {
    background: var(--fd-deep);
    color: var(--fd-fog);
  }

  .t-frontend-design .fd-wrap {
    max-width: 82rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .t-frontend-design p {
    max-width: 62ch;
  }

  .t-frontend-design code,
  .t-frontend-design pre {
    font-family: var(--fd-mono);
  }

  .t-frontend-design p code {
    font-size: 0.86em;
    background: color-mix(in srgb, var(--fd-deep) 9%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    white-space: nowrap;
  }

  /* Skip link */
  .t-frontend-design .fd-skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: var(--fd-deep);
    color: var(--fd-fog);
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
    z-index: 10;
  }
  .t-frontend-design .fd-skip:focus {
    top: 1rem;
  }

  /* Header */
  .t-frontend-design .fd-header-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.5rem;
  }
  .t-frontend-design .fd-logo {
    color: var(--fd-deep);
    border-radius: 4px;
  }
  .t-frontend-design .fd-nav {
    display: flex;
    gap: 1.75rem;
    margin-left: auto;
    font-weight: 500;
    font-size: 0.98rem;
  }
  .t-frontend-design .fd-nav a,
  .t-frontend-design .fd-footer-nav a {
    text-decoration: none;
    border-radius: 3px;
  }
  .t-frontend-design .fd-nav a:hover,
  .t-frontend-design .fd-footer-nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--fd-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Buttons */
  .t-frontend-design .fd-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 3.25rem;
    padding-inline: 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1.0625rem;
    font-stretch: 96%;
    text-decoration: none;
    border: 2px solid var(--fd-deep);
    white-space: nowrap;
    transition: background-color 0.12s ease, color 0.12s ease;
  }
  .t-frontend-design .fd-btn-primary {
    background: var(--fd-accent);
    color: var(--fd-deep);
  }
  .t-frontend-design .fd-btn-primary:hover {
    background: var(--fd-deep);
    color: var(--fd-fog);
  }
  .t-frontend-design .fd-btn-quiet {
    background: transparent;
    color: var(--fd-deep);
  }
  .t-frontend-design .fd-btn-quiet:hover {
    background: var(--fd-deep);
    color: var(--fd-fog);
  }
  .t-frontend-design .fd-btn-sm {
    height: 2.5rem;
    padding-inline: 1rem;
    font-size: 0.95rem;
  }
  .t-frontend-design .fd-btn:focus-visible {
    outline: 3px solid var(--fd-deep);
    outline-offset: 3px;
  }
  .t-frontend-design .fd-deep :focus-visible {
    outline-color: var(--fd-fog);
  }
  .t-frontend-design .fd-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Links */
  .t-frontend-design .fd-link {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--fd-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.28em;
    border-radius: 3px;
  }
  .t-frontend-design .fd-link:hover {
    text-decoration-thickness: 4px;
  }

  /* Type */
  .t-frontend-design .fd-h1,
  .t-frontend-design .fd-h2,
  .t-frontend-design .fd-h3 {
    font-family: var(--fd-sans);
    color: inherit;
  }
  .t-frontend-design .fd-h1 {
    font-stretch: 62%;
    font-weight: 800;
    font-size: clamp(3.5rem, 13.4vw, 12.75rem);
    line-height: 0.86;
    letter-spacing: -0.012em;
    margin: 0;
  }
  .t-frontend-design .fd-h1 span {
    display: block;
  }
  .t-frontend-design .fd-h2 {
    font-stretch: 78%;
    font-weight: 700;
    font-size: clamp(2rem, 4.1vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    max-width: 19ch;
    margin: 0;
    text-wrap: balance;
  }
  .t-frontend-design .fd-h2-wide {
    max-width: 24ch;
  }
  .t-frontend-design .fd-h3 {
    font-stretch: 90%;
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: 0;
    margin: 0;
  }
  .t-frontend-design .fd-lede {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.45;
    max-width: 44ch;
  }
  .t-frontend-design .fd-note,
  .t-frontend-design .fd-small,
  .t-frontend-design .fd-caption {
    font-size: 0.95rem;
    color: var(--fd-tide);
  }

  /* Hero */
  .t-frontend-design .fd-hero {
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(4rem, 8vw, 7rem);
  }
  .t-frontend-design .fd-hero-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3.25rem);
    align-items: start;
  }
  .t-frontend-design .fd-hero-copy {
    display: grid;
    gap: 1.5rem;
  }
  .t-frontend-design .fd-hero-copy .fd-note {
    max-width: 40ch;
  }

  /* Code surfaces */
  .t-frontend-design .fd-review,
  .t-frontend-design .fd-panel {
    background: var(--fd-deep);
    color: var(--fd-code);
    border-radius: 12px;
    overflow: hidden;
    margin: 0;
    min-width: 0;
  }
  .t-frontend-design .fd-review-head,
  .t-frontend-design .fd-panel-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--fd-code) 16%, transparent);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .t-frontend-design .fd-path {
    font-family: var(--fd-mono);
    font-size: 0.82rem;
  }
  .t-frontend-design .fd-dim {
    color: var(--fd-code-dim);
  }
  .t-frontend-design .fd-code {
    margin: 0;
    padding: 1rem 1.25rem;
    font-size: 0.875rem;
    line-height: 1.75;
