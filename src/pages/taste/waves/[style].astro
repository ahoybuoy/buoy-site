---
// Wave style preview: a faithful copy of the homepage hero (markup + styles copied
// from src/pages/index.astro, not imported) with the chosen sea. Viewer: /taste/waves
import Layout from '../../../layouts/Layout.astro'
import Nav from '../../../components/Nav.astro'
import BuoyMark from '../../../components/BuoyMark.astro'
import BoatHero from '../../../components/taste/BoatHero.astro'
import BoatGlyph from '../../../components/taste/BoatGlyph.astro'
import { waveStyles } from '../../../components/taste/waves/registry'

export const prerender = true
export function getStaticPaths() {
  return Object.keys(waveStyles).map((style) => ({ params: { style } }))
}

const { style } = Astro.params
const meta = waveStyles[style as string]
const APP_URL = 'https://github.com/marketplace/buoy-design'
---

<Layout title={`Waves: ${meta.name}`} noindex>
  <a href="#main" class="ui-skip">Skip to content</a>
  <Nav />

  <main id="main" class="hp ui-nav-offset">
    <!-- Hero -->
    <BoatHero minHeight="calc(100svh - 65px)" class="hp-hero" sea={style}>
      <div class="ui-wrap hp-hero-grid">
        <div class="hp-hero-copy">
          <!-- "before it ships." lands as the boat wiggles free (850ms). -->
          <h1 class="hp-h1">
            <span class="hero-reveal" style="animation-delay: 0s">Catch</span>
            <span class="hero-reveal hero-drift-highlight" style="animation-delay: 0.22s">design drift</span>
            <br />
            <span class="hero-reveal" style="animation-delay: 0.82s">before</span>
            <span class="hero-reveal" style="animation-delay: 0.93s">it</span>
            <span class="hero-reveal" style="animation-delay: 1.04s">ships.</span>
          </h1>
          <p class="ui-lede">
            On every pull request, Buoy comments the exact fix for hardcoded colors, off-token values and rogue components.<BoatGlyph />
          </p>
          <div class="ui-actions">
            <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary ui-btn--icon">
              <span>Install the GitHub App</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <a href="/scan" class="ui-btn ui-btn--secondary">Scan a public repo</a>
          </div>
        </div>

        <!-- Phones: the sea band sits here, between the copy and the review card -->
        <div data-boat-sea-slot aria-hidden="true"></div>

        <figure class="ui-figure ui-enter" style="animation-delay:1200ms">
          <div class="ui-tray">
            <div class="ui-panel">
              <div class="ui-panel-head">
                <span class="ui-mono">src/components/Card.tsx</span>
              </div>
              <div class="hp-diff ui-mono" role="img" aria-label="Diff of Card.tsx. Line 23 adds a hardcoded background color, #3b82f6.">
                <div class="hp-line"><span class="hp-ln">21</span><span class="hp-sign"></span><span class="hp-code">{"const Card = ({ children }) => ("}</span></div>
                <div class="hp-line"><span class="hp-ln">22</span><span class="hp-sign"></span><span class="hp-code">{"  <div style={{"}</span></div>
                <div class="hp-line hp-add"><span class="hp-ln">23</span><span class="hp-sign">+</span><span class="hp-code">{'    background: "#3b82f6",'}</span></div>
              </div>
              <div class="hp-comment-row">
                <div class="hp-comment">
                  <div class="hp-comment-head">
                    <span class="hp-avatar"><BuoyMark size={16} /></span>
                    <span class="hp-comment-author">buoy-design</span>
                    <span class="hp-tag">bot</span>
                    <span class="hp-comment-meta">commented on line <span class="ui-tnum">23</span></span>
                  </div>
                  <p class="hp-comment-body">
                    Hardcoded color <code>#3b82f6</code>. Use <code>var(--color-primary)</code> instead.
                  </p>
                  <div class="hp-suggest">
                    <div class="hp-suggest-label">Suggested change</div>
                    <div class="hp-diff ui-mono">
                      <div class="hp-line hp-del"><span class="hp-ln">23</span><span class="hp-sign">-</span><span class="hp-code">background: "#3b82f6",</span></div>
                      <div class="hp-line hp-add"><span class="hp-ln">23</span><span class="hp-sign">+</span><span class="hp-code">background: "var(--color-primary)",</span></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="hp-diff ui-mono" aria-hidden="true">
                <div class="hp-line hp-add"><span class="hp-ln">24</span><span class="hp-sign">+</span><span class="hp-code">{'    padding: "24px",'}</span></div>
                <div class="hp-line"><span class="hp-ln">25</span><span class="hp-sign"></span><span class="hp-code">{"  }}>"}</span></div>
              </div>
              <p class="hp-panel-foot">What a Buoy review comment looks like on a pull request.</p>
            </div>
          </div>
        </figure>
      </div>
    </BoatHero>
  </main>
  <!-- ?intensity=&speed=&chop=&variation= set the live wave params (waves/params.ts) -->
  <script is:inline>
    new URLSearchParams(location.search).forEach(function (v, k) {
      if (['intensity', 'speed', 'chop', 'variation'].indexOf(k) > -1 && isFinite(+v)) document.documentElement.style.setProperty('--wave-' + k, v)
    })
  </script>
</Layout>

<style>
  .hp { color: var(--color-body); font-size: 16px; line-height: 1.6; }
  .hp h1, .hp h2, .hp h3 { color: var(--color-ink); }

  /* ---------- Hero ---------- */
  .hp :global(.hp-hero) {
    --boat-hero-bg: var(--color-bg);
    --boat-hero-sky: linear-gradient(180deg, oklch(0.155 0.045 248 / 0) 0%, oklch(0.17 0.056 248) 45%, oklch(0.14 0.048 248) 100%);
    --boat-hero-wave-1: oklch(0.55 0.09 248 / 0.12);
    --boat-hero-wave-2: oklch(0.6 0.081 248 / 0.1);
    --boat-hero-wave-3: oklch(0.5 0.081 248 / 0.13);
    --boat-hero-stars-opacity: 0.35;
  }
  :global(html.light) .hp :global(.hp-hero) {
    --boat-hero-sky: linear-gradient(180deg, #fff0 0%, #EEF3F8 45%, #E6EDF5 100%);
    --boat-hero-wave-1: rgb(26 39 68 / 0.06);
    --boat-hero-wave-2: rgb(99 102 241 / 0.05);
    --boat-hero-wave-3: rgb(26 39 68 / 0.07);
    --boat-hero-stars-opacity: 0;
  }
  /* Desktop: the sea starts at the hero sentence, so the boat drops past the buttons into open water. */
  @media (min-width: 768px) {
    .hp :global(.hp-hero) { --boat-hero-sea-height: 62%; --boat-hero-sink: 70px; }
    .hp :global(.hp-hero .wave-background) {
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
    }
  }
  .hp-hero-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr); gap: 72px; align-items: center;
    padding-block: 24px 200px;
  }
  /* The headline keeps two lines: "Catch design drift" is about 8.1em wide, so size it from the column. */
  .hp-hero-copy { container-type: inline-size; }
  .hp-h1 {
    margin: 0;
    font-size: min(var(--text-h1), calc(100cqi / 8.4));
    white-space: nowrap;
    line-height: 1.02; letter-spacing: -0.03em; font-weight: 700;
  }

  /* ---------- Pull-request mock ---------- */
  .hp-diff { font-size: 13px; line-height: 26px; overflow-x: auto; }
  .hp-line { display: grid; grid-template-columns: 44px 20px minmax(0, 1fr); min-width: max-content; }
  .hp-ln { text-align: right; padding-right: 10px; color: var(--color-muted); user-select: none; font-variant-numeric: tabular-nums; }
  .hp-sign { text-align: center; user-select: none; }
  .hp-code { white-space: pre; padding-right: 16px; }
  .hp-add { background: var(--color-add-bg); }
  .hp-add .hp-sign { color: var(--color-add-ink); }
  .hp-del { background: var(--color-del-bg); }
  .hp-del .hp-sign { color: var(--color-del-ink); }
  .hp-comment-row { padding: 8px; border-block: 1px solid var(--color-line); background: var(--color-raised); }
  .hp-comment { border-radius: 8px; background: var(--color-surface); box-shadow: var(--ring); overflow: hidden; }
  .hp-comment-head { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; padding: 12px 14px 0; font-size: 13px; }
  .hp-avatar {
    display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; border-radius: 6px;
    background: var(--color-surface); box-shadow: 0 0 0 1px var(--color-line-strong);
  }
  .hp-comment-author { font-weight: 600; }
  /* GitHub's own "bot" label, reproduced in the mock; not a site badge pattern */
  .hp-tag { padding: 1px 6px; border-radius: 999px; font-size: 11px; font-weight: 500; line-height: 16px; color: var(--color-body); box-shadow: 0 0 0 1px var(--color-line-strong); }
  .hp-comment-meta { color: var(--color-muted); }
  .hp-comment-body { margin: 0; padding: 8px 14px 14px; font-size: 14px; line-height: 1.55; color: var(--color-ink); }
  .hp-comment-body code { padding: 1px 4px; border-radius: 4px; font-size: 12.5px; white-space: nowrap; background: var(--color-sunken); }
  .hp-suggest { border-top: 1px solid var(--color-line); }
  .hp-panel-foot { margin: 0; padding: 10px 14px; border-top: 1px solid var(--color-line); font-size: 12px; line-height: 1.4; color: var(--color-muted); }
  .hp-suggest-label { padding: 8px 14px; font-size: 12px; font-weight: 500; color: var(--color-body); border-bottom: 1px solid var(--color-line); }
  @media (max-width: 960px) {
    .hp-hero-grid { grid-template-columns: minmax(0, 1fr); gap: 48px; padding-block: 40px 0; }
  }
  @media (max-width: 760px) {
    .hp-diff { font-size: 12px; }
    .hp-line { grid-template-columns: 36px 16px minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-h1 :global(.hero-reveal) { animation: none; opacity: 1; }
  }
</style>
