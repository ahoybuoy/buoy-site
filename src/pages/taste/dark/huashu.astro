---
/*
  Harness: huashu-design. Round 3 direction: "Proof on the light table"
  (web style library no. 19 Swiss Monochrome, set in its night edition).
  - Ground: one night ramp on the brand navy hue (oklch H 262), never neutral black.
    Every section is night; product UI sits on it as white paper proofs, square-cornered.
  - One chromatic: the brand orange token. It marks drifted values (underline) and fills
    the primary action. No glow, no gradients on content, no glass.
  - Type: Schibsted Grotesk (display + text), JetBrains Mono (code, captions).
  - Shape language: rectangles and hairlines only. The sea keeps its waves (the live boat).
  - Form comes from the content: a review is a printed proof with marks on it.
*/
import Layout from '../../../layouts/Layout.astro'
import BuoyLogo from '../../../components/BuoyLogo.astro'
import BuoyMark from '../../../components/BuoyMark.astro'
import LockOn from '../../../components/LockOn.astro'
import ScanForm from '../../../components/ScanForm.astro'
import BoatHero from '../../../components/taste/BoatHero.astro'
import BoatGlyph from '../../../components/taste/BoatGlyph.astro'
import { siteConfig } from '../../../config'

const installUrl = 'https://github.com/marketplace/buoy-design'

const fixes = [
  { id: 'color', from: "'#3b82f6'", to: "'var(--color-primary)'" },
  { id: 'spacing', from: "'24px'", to: "'var(--spacing-lg)'" },
]

const checks = [
  { name: 'Hardcoded values', level: 'Warning', what: 'Colors, spacing and fonts that do not use tokens.', eg: '#ffffff → var(--bg-surface)', href: '/features/hardcoded-values' },
  { name: 'Duplicate components', level: 'Warning', what: 'Similar components that should be one.', eg: 'Use <Card> instead', href: '/features/duplicate-detection' },
  { name: 'Accessibility conflicts', level: 'Critical', what: 'Missing ARIA labels and focus issues.', eg: 'Button.tsx:12 Missing aria-label', href: '/features/accessibility-checks' },
  { name: 'Inline styles', level: 'Warning', what: 'Inline CSS that should use tokens or classes.' },
  { name: 'Deprecated patterns', level: 'Warning', what: 'Components marked as deprecated that are still in use.' },
  { name: 'Framework sprawl', level: 'Warning', what: 'More than one UI framework in the same codebase.', href: '/features/framework-sprawl' },
  { name: 'Naming inconsistency', level: 'Info', what: 'Component and prop names that do not match your conventions.', href: '/features/naming-consistency' },
  { name: 'Orphaned components', level: 'Info', what: 'Components that are in code but not in design.' },
]

const steps = [
  { cmd: 'npx ahoybuoy dock', what: 'Set up Buoy in your repository.' },
  { cmd: 'buoy drift check', what: 'Scan. Every issue comes with the exact file, line and suggested fix.' },
  { cmd: 'buoy show health', what: 'Track design system health over time.' },
]

const stack = [
  { name: 'React', href: '/integrations/react' },
  { name: 'Vue', href: '/integrations/vue' },
  { name: 'Svelte', href: '/integrations/svelte' },
  { name: 'Angular', href: '/integrations/angular' },
  { name: 'Next.js', href: '/integrations/nextjs' },
  { name: 'Tailwind', href: '/integrations/tailwind' },
  { name: 'GitHub', href: '/integrations/github' },
]

const cli = [
  'All scanning and drift detection',
  'Fix suggestions with exact token replacements',
  'Deterministic, no LLMs',
  'No data leaves your machine',
  'Works air-gapped and offline',
  'No API keys. MIT licensed.',
]
const app = [
  'Runs the same open-source scanner on every pull request',
  'Inline comments with fix suggestions you can commit',
  'Summaries and coaching are written by an LLM. Findings stay deterministic.',
  'Dashboard with health scores and trends',
  'Builder mode coaching for new design systems',
]
---

<Layout title="Buoy: catch design drift before it ships" noindex>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400..900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="t-hsd">
    <a class="skip" href="#main">Skip to content</a>

    <header class="hd">
      <div class="wrap hd-in">
        <a href="/" class="hd-logo" aria-label="Buoy home"><BuoyLogo size="1.5rem" /></a>
        <nav class="hd-nav" aria-label="Main">
          <a href="/scan">Scan a repo</a>
          <a href="/docs">Docs</a>
          <a href="/pricing">Pricing</a>
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
        <a class="btn btn-paper btn-sm" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
      </div>
    </header>

    <main id="main">
      <BoatHero minHeight="calc(100svh - 69px)" class="hsd-hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <h1>Catch design drift before it ships.</h1>
            <p class="lede">Buoy checks UI code against your design system. It reviews every pull request and leaves an inline comment with the exact fix.</p>
            <div class="btns">
              <a class="btn btn-go" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
              <a class="btn btn-line" href="/scan">Scan a public repo</a>
            </div>
            <p class="hero-foot">The scanner is deterministic and MIT licensed.<BoatGlyph /></p>
          </div>

          <div class="pr" data-pr>
            <div class="pr-top">
              <span class="pr-name">feat: add new Card component <span class="pr-num">#247</span></span>
              <span class="pr-check" data-pr-status aria-live="polite">Buoy Design Check: 2 to fix</span>
            </div>
            <div class="pr-file">src/components/Card.tsx</div>
            <div class="code" role="group" aria-label="Changed lines in Card.tsx">
              <div class="ln"><span class="no">22</span><span class="sg"> </span><code class="i3">style=&#123;&#123;</code></div>
              <div class="ln add"><span class="no">23</span><span class="sg">+</span><code class="i4">background: <span class="val" data-val="color">'#3b82f6'</span>,</code></div>
            </div>
            <div class="cm" data-fix="color">
              <div class="cm-who"><BuoyMark size={14} /><strong>buoy</strong><span class="cm-bot">bot</span><span class="cm-on">on line 23</span></div>
              <p class="cm-msg">Hardcoded color <code>#3b82f6</code>. Use <code>var(--color-primary)</code>, the token that already exists.</p>
              <div class="sug">
                <div class="sug-row del"><span class="sg">-</span><code>background: '#3b82f6',</code></div>
                <div class="sug-row ins"><span class="sg">+</span><code>background: 'var(--color-primary)',</code></div>
              </div>
              <button type="button" class="cm-btn" data-commit="color">Commit suggestion</button>
            </div>
            <div class="code" role="group" aria-label="More changed lines in Card.tsx">
              <div class="ln"><span class="no">30</span><span class="sg"> </span><code class="i3">&lt;header</code></div>
              <div class="ln add"><span class="no">31</span><span class="sg">+</span><code class="i4">style=&#123;&#123; padding: <span class="val" data-val="spacing">'24px'</span> &#125;&#125;</code></div>
            </div>
            <div class="cm" data-fix="spacing">
              <div class="cm-who"><BuoyMark size={14} /><strong>buoy</strong><span class="cm-bot">bot</span><span class="cm-on">on line 31</span></div>
              <p class="cm-msg">Hardcoded spacing <code>24px</code>. Use <code>var(--spacing-lg)</code> instead.</p>
              <div class="sug">
                <div class="sug-row ins"><span class="sg">+</span><code>style=&#123;&#123; padding: 'var(--spacing-lg)' &#125;&#125;</code></div>
              </div>
              <button type="button" class="cm-btn" data-commit="spacing">Commit suggestion</button>
            </div>
            <div class="pr-foot">
              <span>Example pull request. The buttons work.</span>
              <button type="button" class="pr-reset" data-reset disabled>Start over</button>
            </div>
          </div>
        </div>
      </BoatHero>

      <!-- Why now -->
      <section class="sec">
        <div class="wrap split">
          <div class="split-text">
            <h2>Coding agents write a lot of UI. They do not know your tokens.</h2>
            <p>An agent will write <code>#3b82f6</code> and <code>13px 22px</code> when your system already has a token for both. Each value looks fine in review. Together they are drift.</p>
            <p>Buoy finds each hardcoded value and replaces it with the token that already exists.</p>
          </div>
          <div class="split-fig"><LockOn /></div>
        </div>
      </section>

      <!-- What it checks -->
      <section class="sec" id="checks">
        <div class="wrap">
          <div class="sec-head">
            <h2>What Buoy checks</h2>
            <p>Each finding has a severity, so you know what to fix first.</p>
          </div>
          <div class="tbl" role="table" aria-label="Drift types Buoy detects">
            <div class="tr th" role="row">
              <span role="columnheader">Check</span>
              <span role="columnheader">What it finds</span>
              <span role="columnheader">Severity</span>
            </div>
            {checks.map((c) => (
              <div class="tr" role="row">
                <span class="td-name" role="cell">{c.href ? <a href={c.href}>{c.name}</a> : c.name}</span>
                <span class="td-what" role="cell">{c.what}{c.eg && <code class="eg">{c.eg}</code>}</span>
                <span class:list={['td-lv', c.level === 'Critical' && 'crit']} role="cell">{c.level}</span>
              </div>
            ))}
          </div>
          <p class="more"><a href="/features/drift-detection">Read how drift detection works</a></p>
        </div>
      </section>

      <!-- CLI -->
      <section class="sec">
        <div class="wrap cli">
          <div class="cli-text">
            <h2>Three commands on your machine</h2>
            <p>The CLI is open source. The GitHub App runs the same check on every pull request.</p>
            <ol class="steps">
              {steps.map((s) => (<li><code>{s.cmd}</code><span>{s.what}</span></li>))}
            </ol>
            <p class="more"><a href="/docs">Read the docs</a></p>
          </div>
          <figure class="term">
            <figcaption>Example output</figcaption>
            <pre><span class="t-m">$</span> buoy drift check

Scanning for design drift...

Found <b>23</b> issues in 142 files

<b class="t-crit">CRITICAL (2)</b>
├─ Button.tsx:12 Missing aria-label
└─ Modal.tsx:45 Focus trap not implemented

<b class="t-warn">HARDCODED VALUES (8)</b>
├─ Card.tsx:8 <span class="t-bad">#ffffff</span> <span class="t-m">→ use var(--bg-surface)</span>
├─ Badge.tsx:3 <span class="t-bad">8px</span> <span class="t-m">→ use var(--spacing-sm)</span>
└─ <span class="t-m">... and 6 more</span></pre>
          </figure>
        </div>
      </section>

      <!-- Deterministic -->
      <section class="sec">
        <div class="wrap">
          <p class="big"><span>No LLM in the scanner.</span><span>Nothing leaves your machine.</span><span>MIT licensed.</span></p>
          <div class="two">
            <div>
              <h3>Open source CLI</h3>
              <ul>{cli.map((t) => <li>{t}</li>)}</ul>
              <p class="two-foot"><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">View the source on GitHub</a></p>
            </div>
            <div>
              <h3>GitHub App</h3>
              <ul>{app.map((t) => <li>{t}</li>)}</ul>
              <p class="two-foot">That prose is written through OpenRouter. <a href="/privacy#subprocessors">See what is sent</a>.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Stack -->
      <section class="sec sec-tight">
        <div class="wrap stack">
          <h2>Works with</h2>
          <ul>{stack.map((s) => <li><a href={s.href}>{s.name}</a></li>)}</ul>
        </div>
      </section>

      <!-- Close: a paper proof on the night ground -->
      <section class="sec end">
        <div class="wrap">
          <div class="sheet">
            <div class="sheet-main">
              <h2>Scan a public GitHub repository</h2>
              <p>Free, and it takes about a minute. You get a report of the drift Buoy finds.</p>
              <div class="end-form"><ScanForm id="hsd-scan" /></div>
            </div>
            <div class="sheet-side">
              <h3>Or put it on every pull request</h3>
              <p>The CLI is free and open source. The GitHub App reviews every pull request.</p>
              <div class="btns">
                <a class="btn btn-go" href={installUrl} target="_blank" rel="noopener noreferrer">Install the GitHub App</a>
                <a class="btn btn-ink-line" href="/pricing">See pricing</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="ft">
      <div class="wrap ft-in">
        <div class="ft-brand">
          <span class="ft-mark"><BuoyMark size={18} /></span>
          <span>&copy; {new Date().getFullYear()} Buoy. Scanner is open source under MIT.</span>
        </div>
        <nav class="ft-nav" aria-label="Footer">
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={siteConfig.twitterUrl} target="_blank" rel="noopener noreferrer">Twitter</a>
          <a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="/scan">Scan a repo</a>
          <a href="/docs">Docs</a>
          <a href="/pricing">Pricing</a>
          <a href="/guides">Guides</a>
          <a href="/reports">Reports</a>
          <a href="/compare">Compare</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/support">Support</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<script define:vars={{ fixes }}>
  const pr = document.querySelector('[data-pr]')
  if (pr) {
    const status = pr.querySelector('[data-pr-status]')
    const reset = pr.querySelector('[data-reset]')
    const done = new Set()
    const render = () => {
      for (const f of fixes) {
        const on = done.has(f.id)
        const val = pr.querySelector(`[data-val="${f.id}"]`)
        const cm = pr.querySelector(`[data-fix="${f.id}"]`)
        const btn = pr.querySelector(`[data-commit="${f.id}"]`)
        val.textContent = on ? f.to : f.from
        val.classList.toggle('ok', on)
        cm.classList.toggle('ok', on)
        btn.disabled = on
        btn.textContent = on ? 'Committed' : 'Commit suggestion'
      }
      const left = fixes.length - done.size
      status.textContent = left ? `Buoy Design Check: ${left} to fix` : 'Buoy Design Check: passed'
      status.classList.toggle('ok', left === 0)
      reset.disabled = done.size === 0
    }
    pr.addEventListener('click', (e) => {
      const t = e.target.closest('button')
      if (!t) return
      if (t.dataset.commit) { done.add(t.dataset.commit); render() }
      if (t.hasAttribute('data-reset')) { done.clear(); render(); pr.querySelector('[data-commit]').focus() }
    })
  }
</script>

<style is:global>
  body:has(.t-hsd) { background: oklch(0.18 0.035 262); }

  .t-hsd {
    --night: oklch(0.18 0.035 262);
    --night-2: oklch(0.215 0.04 262);
    --night-rule: oklch(0.33 0.035 262);
    --night-rule-2: oklch(0.45 0.035 262);
    --moon: oklch(0.96 0.006 262);
    --moon-2: oklch(0.78 0.025 262);
    --moon-3: oklch(0.66 0.025 262);
    --paper: oklch(0.975 0.004 262);
    --paper-2: oklch(0.945 0.008 262);
    --paper-rule: oklch(0.86 0.012 262);
    --ink: oklch(0.19 0.04 262);
    --ink-2: oklch(0.43 0.03 262);
    --del: oklch(0.94 0.035 25);
    --ins: oklch(0.945 0.045 155);
    --ins-2: oklch(0.89 0.07 155);
    --ins-ink: oklch(0.4 0.1 155);
    --crit: oklch(0.76 0.13 27);
    --sans: 'Schibsted Grotesk', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;

    background: var(--night);
    color: var(--moon);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.55;
    font-synthesis: none;
    min-height: 100vh;
  }
  .t-hsd *, .t-hsd *::before, .t-hsd *::after { box-sizing: border-box; }
  .t-hsd h1, .t-hsd h2, .t-hsd h3 { font-family: var(--sans); color: inherit; margin: 0; text-wrap: balance; }
  .t-hsd p { margin: 0; text-wrap: pretty; }
  .t-hsd code, .t-hsd pre { font-family: var(--mono); }
  .t-hsd a { color: inherit; }
  .t-hsd :focus-visible { outline: 2px solid var(--color-buoy); outline-offset: 3px; }
  .t-hsd ::selection { background: var(--moon); color: var(--night); }

  .t-hsd .wrap { width: 100%; max-width: 1360px; margin-inline: auto; padding-inline: 16px; }
  @media (min-width: 720px) { .t-hsd .wrap { padding-inline: 40px; } }
  .t-hsd .skip { position: absolute; left: 16px; top: -60px; background: var(--moon); color: var(--night); padding: 10px 14px; z-index: 60; }
  .t-hsd .skip:focus { top: 12px; }

  /* Header */
  .t-hsd .hd { border-bottom: 1px solid var(--night-rule); background: var(--night); position: relative; z-index: 20; }
  .t-hsd .hd-in { display: flex; align-items: center; gap: 24px; height: 68px; }
  .t-hsd .hd-logo { display: inline-flex; align-items: center; min-height: 44px; color: var(--moon); }
  .t-hsd .hd-nav { display: none; gap: 4px; margin-left: auto; }
  .t-hsd .hd-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-size: 15px; text-decoration: none; color: var(--moon-2); }
  .t-hsd .hd-nav a:hover { color: var(--moon); text-decoration: underline; text-underline-offset: 5px; }
  .t-hsd .hd .btn { margin-left: auto; }
  @media (min-width: 900px) { .t-hsd .hd-nav { display: flex; } .t-hsd .hd .btn { margin-left: 12px; } }

  /* Buttons: one size per group, square */
  .t-hsd .btn { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 22px; font-family: var(--sans); font-size: 16px; font-weight: 600; text-decoration: none; border: 1.5px solid var(--moon); border-radius: 2px; white-space: nowrap; transition: background-color .15s ease, color .15s ease, border-color .15s ease; }
  .t-hsd .btn:active { transform: translateY(1px); }
  .t-hsd .btn-sm { height: 44px; padding: 0 16px; font-size: 15px; }
  .t-hsd .btn-go { background: var(--color-buoy); border-color: var(--color-buoy); color: var(--ink); }
  .t-hsd .btn-go:hover { background: var(--color-buoy-light); border-color: var(--color-buoy-light); }
  .t-hsd .btn-paper { background: var(--paper); border-color: var(--paper); color: var(--ink); }
  .t-hsd .btn-paper:hover { background: var(--moon-2); border-color: var(--moon-2); }
  .t-hsd .btn-line { background: var(--night); color: var(--moon); border-color: var(--moon-2); }
  .t-hsd .btn-line:hover { background: var(--moon); color: var(--night); }
  .t-hsd .btn-ink-line { background: transparent; color: var(--ink); border-color: var(--ink); }
  .t-hsd .btn-ink-line:hover { background: var(--ink); color: var(--paper); }
  .t-hsd .btns { display: grid; grid-template-columns: 1fr; gap: 12px; }
  @media (min-width: 480px) { .t-hsd .btns { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 460px; } }

  /* Hero: the live sea, tinted to the night ramp */
  .t-hsd .hsd-hero {
    --boat-hero-bg: oklch(0.18 0.035 262);
    --boat-hero-sky: linear-gradient(180deg, oklch(0.18 0.035 262) 0%, oklch(0.18 0.035 262) 45%, oklch(0.205 0.045 258) 100%);
    --boat-hero-wave-1: oklch(0.42 0.07 258 / 0.22);
    --boat-hero-wave-2: oklch(0.5 0.07 258 / 0.16);
    --boat-hero-wave-3: oklch(0.36 0.06 258 / 0.3);
    --boat-hero-stars-opacity: 0.18;
  }
  .t-hsd .hero-grid { display: grid; gap: 36px; padding-top: 40px; padding-bottom: 24px; }
  .t-hsd .hero-copy h1 { font-size: clamp(46px, 6.1vw, 90px); font-weight: 800; line-height: 0.94; letter-spacing: -0.048em; color: var(--moon); }
  .t-hsd .lede { margin-top: 24px; font-size: 20px; line-height: 1.42; color: var(--moon-2); max-width: 30em; }
  .t-hsd .hero-copy .btns { margin-top: 32px; }
  .t-hsd .hero-foot { margin-top: 20px; font-size: 15px; color: var(--moon-3); }
  @media (min-width: 1000px) {
    .t-hsd .hero-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 32px; align-items: start; padding-top: 48px; padding-bottom: 150px; }
    .t-hsd .hero-grid { align-items: stretch; }
    .t-hsd .hero-copy { grid-column: 1 / span 5; padding-top: 8px; display: flex; flex-direction: column; }
    .t-hsd .hero-foot { margin-top: auto; padding-top: 24px; }
    .t-hsd .hero-grid .pr { grid-column: 6 / -1; }
    .t-hsd .lede { font-size: 21px; }
  }

  /* PR proof: white paper on the night */
  .t-hsd .pr { background: var(--paper); color: var(--ink); border-radius: 2px; overflow: hidden; font-size: 14px; min-width: 0; box-shadow: 0 0 0 1px var(--night-rule-2); animation: hsd-rise .5s cubic-bezier(.2,.7,.2,1) .15s both; }
  .t-hsd .pr-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; padding: 11px 16px; border-bottom: 1.5px solid var(--ink); }
  .t-hsd .pr-name { font-weight: 600; font-size: 15px; }
  .t-hsd .pr-num { color: var(--ink-2); font-weight: 400; }
  .t-hsd .pr-check { font-family: var(--mono); font-size: 13px; font-weight: 500; color: oklch(0.48 0.16 27); min-width: 26ch; text-align: right; }
  .t-hsd .pr-check.ok { color: var(--ins-ink); }
  .t-hsd .pr-file { font-family: var(--mono); font-size: 13px; padding: 7px 16px; background: var(--paper-2); border-bottom: 1px solid var(--paper-rule); }
  .t-hsd .code { overflow-x: auto; }
  .t-hsd .ln { display: grid; grid-template-columns: 40px 20px minmax(max-content, 1fr); font-family: var(--mono); font-size: 13px; line-height: 25px; white-space: pre; }
  .t-hsd .ln .no { text-align: right; padding-right: 10px; color: var(--ink-2); user-select: none; }
  .t-hsd .ln .sg, .t-hsd .sug-row .sg { text-align: center; color: var(--ink-2); user-select: none; }
  .t-hsd .ln.add { background: var(--ins); }
  .t-hsd .ln.add .no { background: var(--ins-2); color: var(--ins-ink); }
