---
import Layout from '../../layouts/Layout.astro'
import BuoyLogo from '../../components/BuoyLogo.astro'
import BuoyMark from '../../components/BuoyMark.astro'
import { siteConfig } from '../../config'

const APP_URL = 'https://github.com/marketplace/buoy-design'

const headline = ['Catch', 'design', 'drift', 'before', 'it', 'ships.']

const catches = [
  { title: 'Hardcoded colors', from: '#ffffff', to: 'var(--bg)' },
  { title: 'Magic numbers', from: '16px', to: 'var(--space-4)' },
  { title: 'Duplicate components', from: 'a second Card', to: '<Card>' },
]

const steps = [
  { title: 'Set up', command: 'npx ahoybuoy dock', description: 'Sets Buoy up in your project.' },
  { title: 'Detect', command: 'buoy drift check', description: 'Lists every issue with the exact file and line.' },
  { title: 'Measure', command: 'buoy show health', description: 'Tracks design system health over time.' },
]

const driftTypes = [
  { title: 'Hardcoded values', severity: 'Warning', description: 'Colors, spacing and fonts that do not use tokens.', href: '/features/hardcoded-values' },
  { title: 'Duplicate components', severity: 'Warning', description: 'Similar components that should be consolidated.', href: '/features/duplicate-detection' },
  { title: 'Naming inconsistency', severity: 'Info', description: 'Component and prop names that do not match your conventions.', href: '/features/naming-consistency' },
  { title: 'Deprecated patterns', severity: 'Warning', description: 'Components marked as deprecated that are still in use.' },
  { title: 'Inline styles', severity: 'Warning', description: 'Inline CSS that should use tokens or classes.' },
  { title: 'Accessibility conflicts', severity: 'Critical', description: 'Missing ARIA labels and focus issues.', href: '/features/accessibility-checks' },
  { title: 'Framework sprawl', severity: 'Warning', description: 'Multiple UI frameworks in the same codebase.', href: '/features/framework-sprawl' },
  { title: 'Orphaned components', severity: 'Info', description: 'Components that are in code but not in design.' },
]

const core = [
  'All scanning and drift detection',
  'Fix suggestions with exact token replacements',
  'Deterministic, with no LLM',
  'No data leaves your machine',
  'Works air-gapped and offline',
]

const app = [
  'Runs the same open-source scanner on every pull request',
  'Inline fix suggestions you can commit',
  'LLM-written summaries and coaching. Findings stay deterministic',
  'Dashboard with health scores and trends',
  'Builder mode coaching for new design systems',
]

const integrations = [
  { name: 'React', href: '/integrations/react' },
  { name: 'Vue', href: '/integrations/vue' },
  { name: 'Svelte', href: '/integrations/svelte' },
  { name: 'Angular', href: '/integrations/angular' },
  { name: 'Next.js', href: '/integrations/nextjs' },
  { name: 'Tailwind', href: '/integrations/tailwind' },
  { name: 'GitHub', href: '/integrations/github' },
]

const navLinks = [
  { label: 'Scan a repo', href: '/scan' },
  { label: 'Docs', href: '/docs' },
  { label: 'Pricing', href: '/pricing' },
]
---

<Layout title="Buoy: catch design drift before it ships" noindex>
  <div class="t-feel-better">
    <a href="#fb-main" class="fb-skip">Skip to content</a>

    <header class="fb-header">
      <div class="fb-wrap fb-header-row">
        <a href="/" class="fb-logo" aria-label="Buoy home">
          <BuoyLogo size="1.5rem" />
        </a>

        <nav class="fb-nav" aria-label="Main">
          {navLinks.map((l) => <a href={l.href} class="fb-navlink">{l.label}</a>)}
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="fb-navlink">GitHub</a>
        </nav>

        <div class="fb-header-actions">
          <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="fb-btn fb-btn-primary fb-btn-sm">Install the app</a>
          <button type="button" class="fb-menu-btn" id="fb-menu-btn" aria-expanded="false" aria-controls="fb-menu" aria-label="Menu">
            <span class="fb-swap" aria-hidden="true">
              <svg class="fb-swap-a" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3.5 6.5h13M3.5 13.5h13"/></svg>
              <svg class="fb-swap-b" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l10 10M15 5L5 15"/></svg>
            </span>
          </button>
        </div>
      </div>

      <div class="fb-menu" id="fb-menu">
        <nav class="fb-wrap fb-menu-list" aria-label="Menu">
          {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="fb-main">
      <!-- Hero -->
      <section class="fb-hero">
        <div class="fb-wrap fb-hero-grid">
          <div class="fb-hero-copy">
            <h1 class="fb-h1">
              {headline.map((word, i) => (
                <><span class="fb-word" style={`animation-delay:${i * 80}ms`}>{word}</span>{' '}</>
              ))}
            </h1>
            <p class="fb-lede fb-enter" style="animation-delay:480ms">
              Buoy checks UI code against your design system. It reviews every pull request and leaves an inline comment with the exact fix, such as the token that already exists for a hardcoded color.
            </p>
            <div class="fb-actions fb-enter" style="animation-delay:580ms">
              <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="fb-btn fb-btn-primary fb-btn-icon">
                <span>Install the GitHub App</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a href="/scan" class="fb-btn fb-btn-secondary">Scan a public repo</a>
            </div>
            <p class="fb-note fb-enter" style="animation-delay:680ms">
              The scanner is open source under MIT. It is deterministic: no LLM, no API key, and the CLI runs entirely on your machine.
            </p>
          </div>

          <figure class="fb-figure fb-enter" style="animation-delay:380ms">
            <div class="fb-tray">
              <div class="fb-pr">
                <div class="fb-pr-file">
                  <span class="fb-mono">src/components/Card.tsx</span>
                </div>
                <div class="fb-diff fb-mono" role="img" aria-label="Diff of Card.tsx. Line 23 adds a hardcoded background color, #3b82f6.">
                  <div class="fb-line"><span class="fb-ln">21</span><span class="fb-sign"></span><span class="fb-code">{"const Card = ({ children }) => ("}</span></div>
                  <div class="fb-line"><span class="fb-ln">22</span><span class="fb-sign"></span><span class="fb-code">{"  <div style={{"}</span></div>
                  <div class="fb-line fb-add"><span class="fb-ln">23</span><span class="fb-sign">+</span><span class="fb-code">{'    background: "#3b82f6",'}</span></div>
                </div>
                <div class="fb-comment-row">
                  <div class="fb-comment">
                    <div class="fb-comment-head">
                      <span class="fb-avatar"><BuoyMark size={16} /></span>
                      <span class="fb-comment-author">buoy-design</span>
                      <span class="fb-tag">bot</span>
                      <span class="fb-comment-meta">commented on line <span class="fb-tnum">23</span></span>
                    </div>
                    <p class="fb-comment-body">
                      Hardcoded color <code>#3b82f6</code>. Use <code>var(--color-primary)</code> instead.
                    </p>
                    <div class="fb-suggest">
                      <div class="fb-suggest-label">Suggested change</div>
                      <div class="fb-diff fb-mono">
                        <div class="fb-line fb-del"><span class="fb-ln">23</span><span class="fb-sign">-</span><span class="fb-code">background: "#3b82f6",</span></div>
                        <div class="fb-line fb-add"><span class="fb-ln">23</span><span class="fb-sign">+</span><span class="fb-code">background: "var(--color-primary)",</span></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="fb-diff fb-mono" aria-hidden="true">
                  <div class="fb-line fb-add"><span class="fb-ln">24</span><span class="fb-sign">+</span><span class="fb-code">{'    padding: "24px",'}</span></div>
                  <div class="fb-line"><span class="fb-ln">25</span><span class="fb-sign"></span><span class="fb-code">{"  }}>"}</span></div>
                </div>
              </div>
            </div>
            <figcaption>What a Buoy review comment looks like on a pull request.</figcaption>
          </figure>
        </div>
      </section>

      <!-- Why -->
      <section class="fb-section">
        <div class="fb-wrap">
          <div class="fb-head">
            <h2>Coding agents write a lot of UI. They do not know your tokens.</h2>
            <p>
              Hardcoded values creep in, and the drift compounds. Buoy compares each change with the tokens and components your team already has.
            </p>
          </div>

          <div class="fb-compare">
            <figure class="fb-card fb-codecard">
              <figcaption><span>What an agent writes</span><span class="fb-mono">Card.tsx</span></figcaption>
<pre class="fb-mono"><code>const Card = () =&gt; (
  &lt;div style=&#123;&#123;
    <mark>background: "#ffffff"</mark>,
    <mark>padding: "16px"</mark>,
    <mark>borderRadius: "8px"</mark>,
  &#125;&#125;&gt;
    &#123;children&#125;
  &lt;/div&gt;
)</code></pre>
            </figure>
            <figure class="fb-card fb-codecard">
              <figcaption><span>What your design system already has</span><span class="fb-mono">Card.tsx</span></figcaption>
<pre class="fb-mono"><code>import &#123; Card &#125; from "@/components"

const MyCard = () =&gt; (
  <ins>&lt;Card variant="elevated"&gt;</ins>
    &#123;children&#125;
  <ins>&lt;/Card&gt;</ins>
)</code></pre>
            </figure>
          </div>

          <dl class="fb-catches">
            {catches.map((c) => (
              <div>
                <dt>{c.title}</dt>
                <dd class="fb-mono">
                  <span>{c.from}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="becomes"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  <span class="fb-to">{c.to}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- CLI -->
      <section class="fb-section">
        <div class="fb-wrap fb-split">
          <div>
            <div class="fb-head">
              <h2>Find drift from the command line.</h2>
              <p>
                The CLI is free and open source. It reports every issue with the exact file, line and suggested fix.
              </p>
            </div>
            <ol class="fb-steps">
              {steps.map((s, i) => (
                <li>
                  <span class="fb-step-n fb-tnum" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.description}</p>
                    <code class="fb-cmd fb-mono">{s.command}</code>
                  </div>
                </li>
              ))}
            </ol>
            <a href="/docs" class="fb-btn fb-btn-secondary">Read the docs</a>
          </div>

          <figure class="fb-figure">
            <div class="fb-tray">
              <div class="fb-term fb-mono" role="img" aria-label="Terminal output of buoy drift check: 23 issues found in 142 files, each with a file, a line and a suggested token.">
                <div class="fb-term-bar">Terminal</div>
<pre><span class="t-dim">$</span> <span class="t-hi">buoy drift check</span>

Scanning for design drift...

Found <span class="t-warn">23</span> issues in 142 files

<span class="t-crit">CRITICAL (2)</span>
<span class="t-dim">├─</span> Button.tsx:12 Missing aria-label
<span class="t-dim">└─</span> Modal.tsx:45 Focus trap not implemented

<span class="t-warn">HARDCODED VALUES (8)</span>
<span class="t-dim">├─</span> Card.tsx:8 #ffffff <span class="t-dim">→ use</span> var(--bg-surface)
<span class="t-dim">├─</span> Badge.tsx:3 8px <span class="t-dim">→ use</span> var(--spacing-sm)
<span class="t-dim">└─ ... and 6 more</span></pre>
              </div>
            </div>
            <figcaption>Example output of <span class="fb-mono">buoy drift check</span>.</figcaption>
          </figure>
        </div>
      </section>

      <!-- Detects -->
      <section class="fb-section" id="detects">
        <div class="fb-wrap">
          <div class="fb-head">
            <h2>What Buoy detects</h2>
            <p>Each finding has a severity, so you can decide what to fix first.</p>
          </div>
          <ul class="fb-types">
            {driftTypes.map((d) => (
              <li>
                {d.href ? (
                  <a href={d.href} class="fb-type">
                    <span class="fb-type-title">{d.title}</span>
                    <span class="fb-type-desc">{d.description}</span>
                    <span class="fb-type-sev">{d.severity}</span>
                  </a>
                ) : (
                  <div class="fb-type">
                    <span class="fb-type-title">{d.title}</span>
                    <span class="fb-type-desc">{d.description}</span>
                    <span class="fb-type-sev">{d.severity}</span>
                  </div>
                )}
              </li>
            ))}
          </ul>
          <p class="fb-after">
            Buoy works with
            {integrations.map((it, i) => (
              <>{i === integrations.length - 1 ? ' and ' : ' '}<a href={it.href} class="fb-link">{it.name}</a>{i < integrations.length - 2 ? ',' : ''}</>
            ))}.
          </p>
        </div>
      </section>

      <!-- Deterministic -->
      <section class="fb-section">
        <div class="fb-wrap">
          <div class="fb-head">
            <h2>The scanner works without AI.</h2>
            <p>
              Core drift detection is deterministic. There are no LLMs and no API keys, and no data leaves your machine, so it suits teams where AI tools are restricted.
            </p>
          </div>
          <div class="fb-two">
            <article class="fb-card fb-plan">
              <h3>Buoy Core</h3>
              <p class="fb-plan-sub">Open-source CLI</p>
              <ul>{core.map((x) => <li>{x}</li>)}</ul>
              <p class="fb-plan-foot">No API keys required. No external calls. MIT licensed.</p>
            </article>
            <article class="fb-card fb-plan">
              <h3>Buoy GitHub App</h3>
              <p class="fb-plan-sub">The same engine, hosted on every pull request</p>
              <ul>{app.map((x) => <li>{x}</li>)}</ul>
              <p class="fb-plan-foot">
                No API key needed. Prose is written through OpenRouter. <a href="/privacy#subprocessors" class="fb-link">See what is sent</a>.
              </p>
            </article>
          </div>
          <p class="fb-after">
            The CLI is free. <a href="/pricing" class="fb-link">See pricing</a> for the GitHub App and for organizations.
          </p>
        </div>
      </section>

      <!-- Scan -->
      <section class="fb-section fb-section-last">
        <div class="fb-wrap">
          <div class="fb-card fb-cta">
            <div class="fb-head">
              <h2>See what Buoy finds in a public repo.</h2>
              <p>Paste a GitHub repository URL. The scan is free and takes about a minute.</p>
            </div>
            <div class="fb-cta-form">
              <form action="/scan" method="get" class="fb-scan">
                <label for="fb-scan-url" class="fb-sr">GitHub repository URL</label>
                <input id="fb-scan-url" name="url" type="text" required autocomplete="off" spellcheck="false" placeholder="https://github.com/owner/repo" />
                <button type="submit" class="fb-btn fb-btn-primary">Scan repository</button>
              </form>
              <p class="fb-note">
                Or <a href={APP_URL} target="_blank" rel="noopener noreferrer" class="fb-link">install the GitHub App</a> to have every pull request reviewed.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="fb-footer">
      <div class="fb-wrap fb-footer-row">
        <p class="fb-footer-brand">
          <BuoyMark size={18} />
          <span>&copy; {new Date().getFullYear()} Buoy. Scanner is open source under MIT.</span>
        </p>
        <nav class="fb-footer-links" aria-label="Footer">
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={siteConfig.twitterUrl} target="_blank" rel="noopener noreferrer">Twitter</a>
          <a href={siteConfig.discordUrl} target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="/scan">Scan a repo</a>
          <a href="/docs">Docs</a>
          <a href="/pricing">Pricing</a>
          <a href="/guides">Guides</a>
          <a href="/reports">Reports</a>
          <a href="/compare">Compare</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/support">Support</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<script>
  const btn = document.getElementById('fb-menu-btn')
  const menu = document.getElementById('fb-menu')
  const setOpen = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open))
    menu?.classList.toggle('is-open', open)
  }
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false)
      btn.focus()
    }
  })
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false)
  })
</script>

<style is:global>
  body:has(.t-feel-better) {
    background: oklch(0.985 0.003 260);
  }

  .t-feel-better {
    /* Neutrals (the brand accent comes from the site tokens) */
    --fb-bg: oklch(0.985 0.003 260);
    --fb-surface: oklch(1 0 0);
    --fb-sunken: oklch(0 0 0 / 0.035);
    --fb-ink: oklch(0.22 0.035 262);
    --fb-body: oklch(0.42 0.025 262);
    --fb-muted: oklch(0.54 0.02 262);
    --fb-line: oklch(0 0 0 / 0.08);
    --fb-accent: var(--color-buoy);
    --fb-accent-text: color-mix(in oklab, var(--color-buoy) 76%, black);
    --fb-on-accent: oklch(0.2 0.035 262);

    --fb-add-bg: oklch(0.95 0.05 155);
    --fb-add-ink: oklch(0.42 0.11 155);
    --fb-del-bg: oklch(0.95 0.035 25);
    --fb-del-ink: oklch(0.5 0.17 25);

    /* Shadows instead of borders for anything whose edge only signals depth */
    --fb-shadow: 0 0 0 1px oklch(0 0 0 / 0.06), 0 1px 2px -1px oklch(0 0 0 / 0.06), 0 2px 4px 0 oklch(0 0 0 / 0.04);
    --fb-shadow-hover: 0 0 0 1px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.08), 0 2px 4px 0 oklch(0 0 0 / 0.06);
    --fb-shadow-lift: 0 0 0 1px oklch(0 0 0 / 0.06), 0 1px 2px -1px oklch(0 0 0 / 0.06), 0 8px 24px -8px oklch(0 0 0 / 0.12);

    /* Concentric radii: tray = inner + padding */
    --fb-r-inner: 14px;
    --fb-tray-pad: 6px;
    --fb-r-tray: calc(var(--fb-r-inner) + var(--fb-tray-pad));
    --fb-r-btn: 10px;

    --fb-gutter: 24px;

    min-height: 100vh;
    background: var(--fb-bg);
    color: var(--fb-body);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
  }

  .t-feel-better ::selection {
    background: color-mix(in oklab, var(--color-buoy) 28%, white);
    color: var(--fb-ink);
  }

  .t-feel-better h1,
  .t-feel-better h2,
  .t-feel-better h3 {
    color: var(--fb-ink);
    text-wrap: balance;
    margin: 0;
  }
  .t-feel-better p,
  .t-feel-better li,
  .t-feel-better figcaption,
  .t-feel-better dd {
    text-wrap: pretty;
  }
  .t-feel-better p { margin: 0; }
  .t-feel-better .fb-mono,
  .t-feel-better code,
  .t-feel-better pre { font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-variant-ligatures: none; }
  .t-feel-better .fb-tnum,
  .t-feel-better .fb-ln { font-variant-numeric: tabular-nums; }

  .t-feel-better .fb-wrap {
    width: 100%;
    max-width: calc(1120px + var(--fb-gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--fb-gutter);
  }

  .t-feel-better .fb-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .t-feel-better .fb-skip {
    position: absolute; left: 16px; top: -64px; z-index: 60;
    padding: 10px 14px; border-radius: var(--fb-r-btn);
    background: var(--fb-surface); color: var(--fb-ink); box-shadow: var(--fb-shadow-lift);
    font-size: 14px; font-weight: 500;
  }
  .t-feel-better .fb-skip:focus-visible { top: 12px; }

  /* ---------- Links ---------- */
  .t-feel-better .fb-link {
    color: var(--fb-ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--fb-accent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    border-radius: 3px;
    transition: color 120ms ease-out;
  }
  .t-feel-better .fb-link:hover { color: var(--fb-accent-text); }

  /* ---------- Buttons ---------- */
  .t-feel-better .fb-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    height: 44px; padding-inline: 18px;
    border: 0; border-radius: var(--fb-r-btn);
    font-family: var(--font-body); font-size: 15px; font-weight: 600; line-height: 1; white-space: nowrap;
    cursor: pointer; user-select: none;
    transition-property: scale, background-color, box-shadow;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }
  .t-feel-better .fb-btn:active { scale: 0.96; }
  /* Optical alignment: the icon side gets 2px less padding than the text side */
  .t-feel-better .fb-btn-icon { padding-inline: 18px 16px; }
  .t-feel-better .fb-btn svg { flex: none; }
  .t-feel-better .fb-btn-sm { height: 40px; padding-inline: 14px; font-size: 14px; }

  .t-feel-better .fb-btn-primary {
    background: var(--fb-accent);
    color: var(--fb-on-accent);
    box-shadow: inset 0 1px 0 oklch(1 0 0 / 0.22), 0 0 0 1px oklch(0 0 0 / 0.1), 0 1px 2px 0 oklch(0 0 0 / 0.16);
  }
  .t-feel-better .fb-btn-primary:hover { background: var(--color-buoy-light); }
  .t-feel-better .fb-btn-secondary {
    background: var(--fb-surface);
    color: var(--fb-ink);
    box-shadow: var(--fb-shadow);
  }
  .t-feel-better .fb-btn-secondary:hover { box-shadow: var(--fb-shadow-hover); background: oklch(0.99 0.002 260); }
  .t-feel-better .fb-btn:focus-visible { outline: 2px solid var(--fb-ink); outline-offset: 2px; }

  /* ---------- Header ---------- */
  .t-feel-better .fb-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--fb-bg) 86%, transparent);
