---
import IntegrationLayout from '../../layouts/IntegrationLayout.astro'
import Terminal from '../../components/Terminal.astro'

const features = [
  {
    title: 'SFC Parsing',
    description: 'Full support for Vue Single File Components: template, script, and style blocks.'
  },
  {
    title: 'Composition API',
    description: 'Understands Vue 3 Composition API, setup scripts, and composables.'
  },
  {
    title: 'Scoped Styles',
    description: 'Scans scoped and module CSS for hardcoded values and design token usage.'
  },
  {
    title: 'Props & Emits',
    description: 'Extracts defineProps, defineEmits, and validates prop consistency across components.'
  },
  {
    title: 'Template Analysis',
    description: 'Detects inline styles, class bindings, and dynamic style expressions in templates.'
  },
  {
    title: 'Nuxt Support',
    description: 'Works with Nuxt projects including auto-imports and component directories.'
  },
]

const terminalLines = [
  { text: '', delay: 600 },
  { text: '<span class="ui-t-prompt">›</span> Scanning Vue components...', type: 'output', delay: 800 },
  { text: '', delay: 1200 },
  { text: 'Found <span class="ui-t-hi">67</span> Vue SFCs', type: 'output', delay: 1400 },
  { text: 'Found <span class="ui-t-hi">23</span> composables', type: 'output', delay: 1600 },
  { text: '', delay: 1800 },
  { text: '<span class="ui-t-warn">WARNING</span> 15 hardcoded values in &lt;style&gt; blocks', type: 'warning', delay: 2000 },
  { text: '<span class="ui-t-warn">WARNING</span> 3 duplicate component implementations', type: 'warning', delay: 2200 },
  { text: '<span class="ui-t-info">INFO</span> 6 prop type inconsistencies', type: 'info', delay: 2400 },
]

const configExample = `# .buoy.yaml
sources:
  vue:
    enabled: true
    include:
      - "src/components/**/*.vue"
      - "src/composables/**/*.ts"

# Vue-specific options
vue:
  version: 3
  scriptSetup: true

tokens:
  source: "./src/assets/tokens.css"`

const heroCode = `&lt;template&gt;
  &lt;div class="price-card"&gt;{{ plan.name }}&lt;/div&gt;
&lt;/template&gt;

&lt;style scoped&gt;
.price-card {
  color: <span class="ui-old">#1e293b</span> <span class="ui-token">var(--color-text)</span>;
  padding: <span class="ui-old">24px</span> <span class="ui-token">var(--space-6)</span>;
  border: 1px solid <span class="ui-old">#e2e8f0</span> <span class="ui-token">var(--color-border)</span>;
}
&lt;/style&gt;`
---

<IntegrationLayout
  title="Vue Component Drift Detection | Buoy"
  description="Scan Vue SFC files for design drift. Detect hardcoded styles in template, script, and style blocks."
  keywords="vue design system, vue component audit, vue code consistency"
  heroTitle="Vue Component Drift Detection"
  heroDescription="Scan Vue Single File Components for design drift. Detect hardcoded styles in template, script, and style blocks. Works with Vue 2, Vue 3, and Nuxt."
>
  <div slot="hero">
    <div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">src/components/PriceCard.vue</div><pre class="p-5 text-sm" set:html={heroCode} /></div></div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>Vue-specific features</h2><p>Template, script and style blocks are read together, so a value in one is checked against tokens from another.</p></div>
      <ul class="ui-ruled ui-ruled--top grid md:grid-cols-2 md:gap-x-12">
        {features.map((f) => (
          <li><strong class="block text-ink mb-1">{f.title}</strong>{f.description}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>See it in action</h2></div>
      <Terminal command="buoy drift check --framework vue" lines={terminalLines} />
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>Configuration example</h2><p>Vue 3 with script setup, pointing at your own token file.</p></div>
      <div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">.buoy.yaml</div><pre class="p-5 text-sm">{configExample}</pre></div></div>
    </div>
  </section>
</IntegrationLayout>
