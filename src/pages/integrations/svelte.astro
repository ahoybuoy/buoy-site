---
import IntegrationLayout from '../../layouts/IntegrationLayout.astro'
import Terminal from '../../components/Terminal.astro'

const features = [
  {
    title: 'Svelte Component Parsing',
    description: 'Native support for .svelte files including script, style, and markup sections.'
  },
  {
    title: 'Runes Support',
    description: 'Understands Svelte 5 runes like $state, $derived, and $effect.'
  },
  {
    title: 'Style Directives',
    description: 'Detects hardcoded values in style: directives and class: bindings.'
  },
  {
    title: 'Props Analysis',
    description: 'Extracts $props() and export let declarations for consistency checking.'
  },
  {
    title: 'SvelteKit Support',
    description: 'Works with SvelteKit projects including routes, layouts, and +page components.'
  },
  {
    title: 'CSS Variables',
    description: 'Tracks --style-props usage and validates against your token definitions.'
  },
]

const terminalLines = [
  { text: '', delay: 600 },
  { text: '<span class="ui-t-prompt">›</span> Scanning Svelte components...', type: 'output', delay: 800 },
  { text: '', delay: 1200 },
  { text: 'Found <span class="ui-t-hi">54</span> Svelte components', type: 'output', delay: 1400 },
  { text: 'Found <span class="ui-t-hi">12</span> SvelteKit routes', type: 'output', delay: 1600 },
  { text: '', delay: 1800 },
  { text: '<span class="ui-t-warn">WARNING</span> 11 hardcoded values in &lt;style&gt;', type: 'warning', delay: 2000 },
  { text: '<span class="ui-t-info">INFO</span> 4 style directive inconsistencies', type: 'info', delay: 2200 },
]

const configExample = `# .buoy.yaml
sources:
  svelte:
    enabled: true
    include:
      - "src/lib/components/**/*.svelte"
      - "src/routes/**/*.svelte"

# Svelte-specific options
svelte:
  version: 5
  kit: true

tokens:
  source: "./src/lib/tokens.css"`

const heroCode = `&lt;script&gt;
  let { tone = 'info' } = $props();
&lt;/script&gt;

&lt;span class="badge"
  style:background="<span class="ui-old">#fef3c7</span>"
  <span class="ui-t-dim">→</span> style:background="<span class="ui-token">var(--color-warn-bg)</span>"&gt;
  &lt;slot /&gt;
&lt;/span&gt;

&lt;style&gt;
  .badge { font-size: <span class="ui-old">13px</span> <span class="ui-token">var(--text-sm)</span>; }
&lt;/style&gt;`
---

<IntegrationLayout
  title="Svelte Component Drift Detection | Buoy"
  description="Scan Svelte files for design drift. Detect hardcoded styles and component inconsistencies in your Svelte codebase."
  keywords="svelte design system, svelte component audit, svelte code consistency"
  heroTitle="Svelte Component Drift Detection"
  heroDescription="Scan Svelte components for design drift. Native support for Svelte 5 runes, style directives, and SvelteKit projects."
>
  <div slot="hero">
    <div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">src/lib/components/Badge.svelte</div><pre class="p-5 text-sm" set:html={heroCode} /></div></div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>Svelte-specific features</h2><p>From runes to style directives, Buoy understands the parts of Svelte where hardcoded values hide.</p></div>
      <div class="ui-cols ui-cols--3">
        {features.slice(0, 3).map((f) => (
          <article class="ui-col"><h3>{f.title}</h3><p>{f.description}</p></article>
        ))}
      </div>
      <div class="ui-cols ui-cols--3 mt-10">
        {features.slice(3).map((f) => (
          <article class="ui-col"><h3>{f.title}</h3><p>{f.description}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>Scan a SvelteKit app</h2><p>Components and routes in one pass, checked against the tokens in src/lib.</p></div>
      <div class="ui-split items-start">
        <div><Terminal command="buoy drift check --framework svelte" lines={terminalLines} /></div>
        <div><div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">.buoy.yaml</div><pre class="p-5 text-sm">{configExample}</pre></div></div></div>
      </div>
    </div>
  </section>
</IntegrationLayout>
