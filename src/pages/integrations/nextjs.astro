---
import IntegrationLayout from '../../layouts/IntegrationLayout.astro'
import Terminal from '../../components/Terminal.astro'

const features = [
  {
    title: 'App Router Support',
    description: 'Full support for Next.js 13+ App Router including layouts, pages, and server components.'
  },
  {
    title: 'Server Components',
    description: 'Distinguishes between server and client components for accurate drift detection.'
  },
  {
    title: 'CSS Modules',
    description: 'Scans .module.css files and validates against your design tokens.'
  },
  {
    title: 'Tailwind Integration',
    description: 'Works with Next.js + Tailwind setups, detecting arbitrary values and custom classes.'
  },
  {
    title: 'Image Component',
    description: 'Validates next/image usage for consistent styling across the app.'
  },
  {
    title: 'Route Groups',
    description: 'Respects route group boundaries for scoped drift analysis.'
  },
]

const terminalLines = [
  { text: '', delay: 600 },
  { text: '<span class="ui-t-prompt">›</span> Scanning Next.js project...', type: 'output', delay: 800 },
  { text: '', delay: 1200 },
  { text: 'Found <span class="ui-t-hi">45</span> pages/routes', type: 'output', delay: 1400 },
  { text: 'Found <span class="ui-t-hi">92</span> components', type: 'output', delay: 1600 },
  { text: 'Found <span class="ui-t-hi">23</span> server components', type: 'output', delay: 1800 },
  { text: '', delay: 2000 },
  { text: '<span class="ui-t-warn">WARNING</span> 28 hardcoded values detected', type: 'warning', delay: 2200 },
  { text: '<span class="ui-t-warn">WARNING</span> 6 CSS module inconsistencies', type: 'warning', delay: 2400 },
  { text: '<span class="ui-t-info">INFO</span> 9 Tailwind arbitrary values', type: 'info', delay: 2600 },
]

const configExample = `# .buoy.yaml
sources:
  nextjs:
    enabled: true
    include:
      - "app/**/*.tsx"
      - "components/**/*.tsx"

# Next.js-specific options
nextjs:
  appRouter: true
  serverComponents: true

# Tailwind config path
tailwind: "./tailwind.config.ts"

tokens:
  source: auto`

const heroCode = `export default async function Pricing() {
  const plans = await getPlans();
  return (
    &lt;section className="<span class="ui-old">py-[72px]</span> <span class="ui-token">py-18</span>"&gt;
      &lt;h1 className={styles.title}&gt;Pricing&lt;/h1&gt;
      &lt;Image src="/hero.png" width={1200}
        style={{ borderRadius: <span class="ui-old">12</span> }} /&gt;
    &lt;/section&gt;
  );
}

<span class="ui-t-dim">/* page.module.css */</span>
.title { color: <span class="ui-old">#111827</span> <span class="ui-token">var(--color-ink)</span>; }`
---

<IntegrationLayout
  title="Next.js Design System Integration | Buoy"
  description="Design drift detection for Next.js applications. Scan pages, components, and app router for design system drift."
  keywords="nextjs design system, next.js component audit, next.js code consistency"
  heroTitle="Next.js Design System Integration"
  heroDescription="Full support for Next.js 13+ App Router, server components, and CSS Modules. Detect drift across your entire Next.js application."
>
  <div slot="hero">
    <div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">app/(marketing)/pricing/page.tsx</div><pre class="p-5 text-sm" set:html={heroCode} /></div></div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>Next.js-specific features</h2><p>Built around the App Router: server and client components, CSS Modules and Tailwind in the same project.</p></div>
      <ul class="ui-ruled ui-ruled--top grid md:grid-cols-2 md:gap-x-12">
        {features.map((f) => (
          <li><strong class="block text-ink mb-1">{f.title}</strong>{f.description}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>One scan for the whole app</h2><p>Pages, routes, server components and CSS Modules, with your Tailwind config as a token source.</p></div>
      <div class="ui-split items-start">
        <div><Terminal command="buoy drift check --framework nextjs" lines={terminalLines} /></div>
        <div><div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">.buoy.yaml</div><pre class="p-5 text-sm">{configExample}</pre></div></div></div>
      </div>
    </div>
  </section>
</IntegrationLayout>
