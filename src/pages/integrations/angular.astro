---
import IntegrationLayout from '../../layouts/IntegrationLayout.astro'
import Terminal from '../../components/Terminal.astro'

const features = [
  {
    title: 'Component Templates',
    description: 'Scans inline and external HTML templates for hardcoded styles and classes.'
  },
  {
    title: 'Component Styles',
    description: 'Analyzes component stylesheets including :host selectors and encapsulated CSS.'
  },
  {
    title: 'Input/Output Detection',
    description: 'Extracts @Input() and @Output() decorators for prop consistency analysis.'
  },
  {
    title: 'Standalone Components',
    description: 'Full support for Angular 14+ standalone components and signals.'
  },
  {
    title: 'NgModule Analysis',
    description: 'Tracks component declarations and imports across modules.'
  },
  {
    title: 'Angular Material',
    description: 'Detects Angular Material theme overrides and custom styling.'
  },
]

const terminalLines = [
  { text: '', delay: 600 },
  { text: '<span class="ui-t-prompt">›</span> Scanning Angular components...', type: 'output', delay: 800 },
  { text: '', delay: 1200 },
  { text: 'Found <span class="ui-t-hi">78</span> Angular components', type: 'output', delay: 1400 },
  { text: 'Found <span class="ui-t-hi">8</span> NgModules', type: 'output', delay: 1600 },
  { text: '', delay: 1800 },
  { text: '<span class="ui-t-warn">WARNING</span> 19 hardcoded values in component styles', type: 'warning', delay: 2000 },
  { text: '<span class="ui-t-warn">WARNING</span> 4 Angular Material theme overrides', type: 'warning', delay: 2200 },
  { text: '<span class="ui-t-info">INFO</span> 7 @Input type inconsistencies', type: 'info', delay: 2400 },
]

const configExample = `# .buoy.yaml
sources:
  angular:
    enabled: true
    include:
      - "src/app/**/*.component.ts"
      - "src/app/**/*.component.html"
      - "src/app/**/*.component.scss"

# Angular-specific options
angular:
  standalone: true
  materialTheme: "./src/styles/theme.scss"

tokens:
  source: "./src/styles/tokens.scss"`

const heroCode = `:host {
  display: block;
  padding: <span class="ui-old">16px</span> <span class="ui-token">var(--space-4)</span>;
}

.order-card__total {
  color: <span class="ui-old">#0f766e</span> <span class="ui-token">var(--color-success)</span>;
  font-weight: <span class="ui-old">600</span> <span class="ui-token">var(--font-semibold)</span>;
}

<span class="ui-t-dim">// mat-button override</span>
.mat-mdc-button { border-radius: <span class="ui-old">4px</span> <span class="ui-token">var(--radius-sm)</span>; }`
---

<IntegrationLayout
  title="Angular Component Drift Detection | Buoy"
  description="Scan Angular components for design drift. Detect hardcoded styles in component templates and stylesheets."
  keywords="angular design system, angular component audit, angular code consistency"
  heroTitle="Angular Component Drift Detection"
  heroDescription="Scan Angular components for design drift. Analyze templates, component styles, and Angular Material theme usage."
>
  <div slot="hero">
    <div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">src/app/order/order-card.component.scss</div><pre class="p-5 text-sm" set:html={heroCode} /></div></div>
  </div>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>Angular-specific features</h2></div>
      <table class="ui-table">
        <tbody>
          {features.map((f) => (
            <tr><th scope="row">{f.title}</th><td>{f.description}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ui-section ui-section--band">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>See it in action</h2><p>Components, modules and Angular Material overrides in one report.</p></div>
      <Terminal command="buoy drift check --framework angular" lines={terminalLines} />
    </div>
  </section>

  <section class="ui-section">
    <div class="ui-wrap">
      <div class="ui-head mb-8"><h2>Configuration example</h2><p>Component files by suffix, standalone components and your Material theme.</p></div>
      <div class="ui-tray"><div class="ui-panel"><div class="ui-panel-head">.buoy.yaml</div><pre class="p-5 text-sm">{configExample}</pre></div></div>
    </div>
  </section>
</IntegrationLayout>
