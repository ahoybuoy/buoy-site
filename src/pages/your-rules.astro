---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import DocTerminal from '../components/DocTerminal.astro'
import MarkPattern from '../components/MarkPattern.astro'
import { siteConfig } from '../config'

const reality = [
  { t: "AI doesn't read your docs", d: 'It generates generic solutions', sev: 'warning' },
  { t: "AI doesn't know your tokens", d: 'It hardcodes values instead', sev: 'warning' },
  { t: "AI doesn't use your components", d: 'It rebuilds from scratch', sev: 'warning' },
  { t: 'And developers accept it', d: 'Because the code works', sev: 'critical' },
]
const sources = [
  { who: 'Copilot', what: 'AI suggestions' },
  { who: 'Claude/GPT', what: 'Generated code' },
  { who: 'Developers', what: 'Manual code' },
]
const rules = [
  { rule: '"Only use our color tokens"', d: "Any hex code, RGB, or named color that's not in your palette? Flagged with a suggested fix." },
  { rule: '"Use our components, not custom divs"', d: 'Building a button from scratch when <Button> exists? Detected and suggested.' },
  { rule: '"Spacing must follow our 4px grid"', d: '14px padding when you use multiples of 4? Caught immediately.' },
  { rule: '"Follow our naming conventions"', d: 'Mixed naming patterns like "btn" vs "button"? Detected and suggested.' },
]
const oldWay = ['You: "Please use our design tokens"', 'Dev: "Sure, next time"', 'You: "This PR has hardcoded colors..."', 'Dev: "We\'re on a deadline"']
const newWay = ['Dev: "Buoy caught some issues"', 'Buoy: "3 issues. Here\'s how to fix."', 'Dev: "Fixed. PR passing now."', "You: Don't even need to be involved"]
const power = [
  { t: 'You set the standards', d: 'Define what quality means' },
  { t: 'You control the gate', d: 'See everything before it ships' },
  { t: 'You see the metrics', d: 'Track adoption in real-time' },
]
---

<Layout title="AI Governance - Control What AI Ships | Buoy">
  <Nav />
  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.3} class="ui-pattern lp-pat-side" />
      <div class="ui-wrap lp-hero ui-split lp-hero-split">
        <div>
        <p class="ui-eyebrow">You're in charge</p>
        <div class="ui-head"><h1>AI writes code.<br /><span class="ui-c-buoy">You write the rules.</span></h1></div>
        <p class="ui-lede">Copilot, Claude, GPT: they're all writing code for your product. Now you decide what's allowed to ship.</p>
        <div class="ui-actions">
          <a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--primary ui-btn--lg">Write your rules</a>
          <a href="#the-shift" class="ui-btn ui-btn--secondary ui-btn--lg">See the power shift</a>
        </div>
        </div>
        <figure class="ui-figure ui-enter" style="animation-delay:150ms">
          <div class="ui-term">
            <div class="ui-term-bar"><span>AI-generated code</span></div>
<pre>const Card = () =&gt; (
  &lt;div
    style=&#123;&#123;
      background: <span class="ui-old">'#ffffff'</span>,
      padding: <span class="ui-old">'20px'</span>,
      borderRadius: <span class="ui-old">'8px'</span>,
      boxShadow: <span class="ui-old">'0 2px 8px...'</span>
    &#125;&#125;
  &gt;
    <span class="ui-t-dim">// AI doesn't know about</span>
    <span class="ui-t-dim">// your &lt;Card&gt; component</span>
  &lt;/div&gt;
)</pre>
          </div>
          <figcaption>What an assistant writes when it has never seen your tokens.</figcaption>
        </figure>
      </div>
    </section>

    <section id="the-shift" class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>AI doesn't know your design system exists.</h2><p>It was trained on the internet, not your Figma files. And it's writing code for you anyway.</p></div>
        <div class="lp-split">
          <table class="ui-table">
            <tbody>
              {reality.map((r) => <tr><th scope="row" class={`ui-sev ui-sev-${r.sev}`}>{r.t}</th><td>{r.d}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="ui-after">You have a choice: let AI run wild, or <strong class="ui-c-buoy">put yourself in control</strong>.</p>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>You're the gatekeeper now.</h2><p>See exactly what's drifting from your rules. From developers. From AI. All visible before merge.</p></div>
        <div class="lp-flow">
          <ul class="ui-ruled ui-ruled--top">
            {sources.map((s) => <li><strong>{s.who}</strong> <span class="lp-muted">{s.what}</span></li>)}
          </ul>
          <span class="lp-arrow" aria-hidden="true">→</span>
          <div class="ui-card ui-card--pad lp-gate"><p class="ui-c-buoy lp-k">You + Buoy</p><h3>The Gatekeeper</h3><p class="lp-muted">Your rules. Your call.</p></div>
          <span class="lp-arrow" aria-hidden="true">→</span>
          <div class="lp-out"><h3 class="ui-c-ok">Clean Code</h3><p class="lp-muted">Follows your system</p></div>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Define what's allowed. Block what's not.</h2><p>You decide the rules. Buoy enforces them on every line of code.</p></div>
        <table class="ui-table ui-table--stack lp-table">
          <thead><tr><th scope="col">Your rule</th><th scope="col">What Buoy does</th><th scope="col" class="ui-end">Status</th></tr></thead>
          <tbody>{rules.map((r) => <tr><th scope="row">{r.rule}</th><td>{r.d}</td><td class="ui-end ui-c-ok ui-mono lp-status">Enforced</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="ui-section">
      <div class="ui-wrap">
        <div class="ui-head"><h2>A new dynamic with your team.</h2><p>You're not policing anymore. The system does it for you.</p></div>
        <div class="ui-cols">
          <article class="ui-col">
            <h3 class="ui-c-crit">The old dynamic</h3>
            <ul class="ui-ruled">{oldWay.map((l) => <li>{l}</li>)}</ul>
            <p class="ui-col-foot lp-muted">Friction. Politics. Exhaustion.</p>
          </article>
          <article class="ui-col">
            <h3 class="ui-c-ok">The new dynamic</h3>
            <ul class="ui-ruled">{newWay.map((l) => <li>{l}</li>)}</ul>
            <p class="ui-col-foot lp-muted">Automated. Objective. Effortless.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--band ui-section--patterned">
      <MarkPattern pattern="field" drift={0.25} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head"><h2>AI is a tool. You're the operator.</h2><p>Stop being scared of AI-generated code. Start controlling it.</p></div>
        <div class="ui-cols ui-cols--3">
          {power.map((p) => <article class="ui-col"><h3>{p.t}</h3><p class="lp-muted">{p.d}</p></article>)}
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last">
      <div class="ui-wrap ui-split lp-cta">
        <div class="ui-head">
          <h2>Write your rules in 30 seconds.</h2>
          <p>Free. Open source. No signup required. AI writes code. You're in charge of what ships.</p>
          <div class="ui-actions"><a href={siteConfig.githubUrl} target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn--secondary">View on GitHub</a></div>
        </div>
        <div>
          <DocTerminal command="npx ahoybuoy show health" />
          <p class="ui-note">The Code Control layer that design has been missing.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .lp-hero-split { align-items: center; }
  .lp-hero-split .ui-head h1 { font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem); }

  :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 72%); mask-image: linear-gradient(100deg, transparent 38%, #000 72%); }
  @media (max-width: 960px) { :global(.lp-pat-side) { -webkit-mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); mask-image: linear-gradient(to bottom, transparent 60%, #000 95%); } }

  .lp-hero { padding-block: 32px 24px; }
  .lp-split { margin-top: 40px; align-items: center; }
  .lp-muted { color: var(--color-muted); font-size: 15px; }
  .lp-flow { margin-top: 40px; display: grid; grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1fr) auto minmax(0, 0.8fr); gap: 24px; align-items: center; }
  .lp-flow .ui-ruled { margin: 0; }
  .lp-flow strong { color: var(--color-ink); font-weight: 600; }
  .lp-arrow { color: var(--color-muted); font-size: 22px; }
  .lp-gate h3, .lp-out h3 { margin: 4px 0 0; font-size: 1.25rem; }
  .lp-k { margin: 0; font-size: 14px; font-weight: 600; }
  .lp-table { margin-top: 32px; }
  .lp-status { font-size: 13px; }
  .ui-col h3 { font-size: 1.2rem; }
  .ui-col p { margin-top: 8px; }
  .lp-cta { align-items: center; }
  @media (max-width: 960px) {
    .lp-flow { grid-template-columns: minmax(0, 1fr); }
    .lp-arrow { transform: rotate(90deg); justify-self: start; }
  }
</style>
