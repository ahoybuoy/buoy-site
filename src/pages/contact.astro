---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'
import MarkPattern from '../components/MarkPattern.astro'
import { siteConfig } from '../config'

const contactOptions = [
  {
    title: 'GitHub Issues',
    description: 'Report bugs, request features, or ask questions',
    action: 'Open an issue',
    href: `${siteConfig.githubUrl}/issues`,
  },
  {
    title: 'GitHub Discussions',
    description: 'Join the community for general discussion and help',
    action: 'Start a discussion',
    href: `${siteConfig.githubUrl}/discussions`,
  },
  {
    title: 'Twitter/X',
    description: 'Follow for updates, tips, and design system content',
    action: '@buoy_dev',
    href: 'https://twitter.com/buoy_dev'
  },
]
---

<Layout
  title="Contact Buoy | Get in Touch"
  description="Get help with Buoy, report issues, or reach out for enterprise inquiries."
>
  <Nav />

  <main id="main" class="ui-nav-offset">
    <section class="ui-section ui-section--first">
      <div class="ui-wrap">
        <div class="ui-head">
          <h1>Get in touch</h1>
          <p class="ui-lede">Questions, feedback, or just want to say hi? Here's how to reach us.</p>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--first ct-top">
      <div class="ui-wrap">
        <table class="ui-table ui-table--hover ui-table--stack ct-table">
          <thead><tr><th scope="col">Channel</th><th scope="col">For</th><th scope="col" class="ui-end">Link</th></tr></thead>
          <tbody>
            {contactOptions.map((option) => (
              <tr>
                <th scope="row">{option.title}</th>
                <td>{option.description}</td>
                <td class="ui-end"><a href={option.href} target="_blank" rel="noopener noreferrer" class="ui-rowlink">{option.action}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="ui-section ui-section--band ui-section--patterned">
      <MarkPattern pattern="field" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head">
            <p class="ui-tier-name ui-tier-org">Organizations</p>
            <h2>Enterprise inquiries</h2>
            <p>
              Evaluating Buoy across several repositories or working through a security review?
              Let's talk about how Buoy can work for your organization.
            </p>
          </div>
          <div class="ct-ent">
            <Button href="mailto:enterprise@buoy.design" size="lg">Contact Sales</Button>
            <p class="ui-note">Enterprise inquiries receive priority response within 1 business day.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last">
      <div class="ui-wrap">
        <div class="ui-head"><h2>Quick help</h2></div>
        <div class="ct-help">
          <article>
            <h3>Installation issues?</h3>
            <p>Make sure you have Node.js 18+ installed. Then run:</p>
            <p><code class="ui-code">npx ahoybuoy drift scan</code></p>
          </article>
          <article>
            <h3>Configuration questions?</h3>
            <p>Check out our documentation for detailed setup guides.</p>
            <p><a href="/demo" class="ui-link">Read the docs</a></p>
          </article>
          <article>
            <h3>Feature request?</h3>
            <p>We love hearing what features would help your team.</p>
            <p><a href={`${siteConfig.githubUrl}/issues/new?template=feature_request.md`} target="_blank" rel="noopener noreferrer" class="ui-link">Request a feature</a></p>
          </article>
          <article>
            <h3>Found a bug?</h3>
            <p>Help us fix it! Include your config and error output.</p>
            <p><a href={`${siteConfig.githubUrl}/issues/new?template=bug_report.md`} target="_blank" rel="noopener noreferrer" class="ui-link">Report a bug</a></p>
          </article>
        </div>
        <p class="ui-after">
          We typically respond to GitHub issues within 24-48 hours.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .ct-table { margin-top: 0; }
  .ct-hero { padding-bottom: 48px; }
  .ct-top { padding-top: 0; }
  .ct-table th[scope="row"] { color: var(--color-ink); font-weight: 600; text-transform: none; letter-spacing: 0; font-size: 15px; }
  .ct-ent { align-self: center; }
  .ct-h2 { margin: 6px 0 0; font-size: var(--text-h2); color: var(--color-ink); }
  .ct-mt { margin-top: 24px; }
  .ct-help { margin-top: 40px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; border-top: 1px solid var(--color-line-strong); }
  .ct-help article { padding: 22px 0; border-bottom: 1px solid var(--color-line); }
  .ct-help h3 { margin: 0; font-size: 19px; color: var(--color-ink); }
  .ct-help p { margin: 8px 0 0; }
  @media (max-width: 760px) { .ct-help { grid-template-columns: minmax(0, 1fr); } }
</style>
