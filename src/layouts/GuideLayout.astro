---
/**
 * Guides: practical answers to how teams audit and measure a design system in
 * code. Each guide leads with a short answer, then steps, then FAQs, with
 * Article, FAQPage and BreadcrumbList structured data so search engines and
 * AI answer engines can cite it.
 */
import Layout from './Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import MarkPattern from '../components/MarkPattern.astro'

export interface Faq { q: string; a: string }

interface Props {
  title: string
  seoTitle: string
  description: string
  keywords: string
  slug: string
  answer: string
  updated: string
  faqs?: Faq[]
  howTo?: { name: string; steps: Array<{ name: string; text: string }> }
}

const { title, seoTitle, description, keywords, slug, answer, updated, faqs = [], howTo } = Astro.props
const url = `https://buoy.design/guides/${slug}`
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    url,
    datePublished: updated,
    dateModified: updated,
    author: { '@type': 'Organization', name: 'Buoy', url: 'https://buoy.design' },
    publisher: { '@type': 'Organization', name: 'Buoy', url: 'https://buoy.design', logo: { '@type': 'ImageObject', url: 'https://buoy.design/buoy-logo.jpg' } },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Guides', item: 'https://buoy.design/guides' },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
]
if (faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })
}
if (howTo) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: howTo.name,
    step: howTo.steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text })),
  })
}
const guides = [
  { slug: 'how-to-audit-a-design-system', title: 'How to audit a design system in code' },
  { slug: 'find-hardcoded-colors-and-spacing', title: 'How to find hardcoded colors and spacing' },
  { slug: 'design-system-health-score', title: 'How to measure design system health' },
  { slug: 'what-is-design-drift', title: 'What is design drift?' },
].filter((g) => g.slug !== slug)
---

<Layout title={seoTitle} description={description} keywords={keywords} jsonLd={jsonLd}>
  <Nav />
  <main id="main" class="ui-nav-offset">
    <article class="ui-section ui-section--first gl">
      <div class="ui-wrap">
        <div class="gl-col">
          <nav class="gl-crumb" aria-label="Breadcrumb"><a href="/guides" class="ui-rowlink">Guides</a> <span aria-hidden="true">/</span></nav>
          <h1 class="gl-h1">{title}</h1>
          <p class="gl-meta">Updated <time datetime={updated} class="ui-tnum">{updated}</time> · Buoy</p>

          <aside class="gl-answer" aria-label="Short answer">
            <p class="gl-answer-label">Short answer</p>
            <p>{answer}</p>
          </aside>

          <div class="ui-prose gl-body">
            <slot />
          </div>

          {faqs.length > 0 && (
            <section class="gl-faq">
              <h2>Frequently asked questions</h2>
              <dl>
                {faqs.map((f) => (
                  <div>
                    <dt>{f.q}</dt>
                    <dd>{f.a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          <section class="gl-more">
            <h2>More guides</h2>
            <ul class="ui-ruled ui-ruled--top">
              {guides.map((g) => <li><a href={`/guides/${g.slug}`} class="ui-rowlink">{g.title}</a></li>)}
            </ul>
          </section>
        </div>
      </div>
    </article>

    <section class="ui-section ui-section--last ui-section--band ui-section--patterned">
      <MarkPattern pattern="tide" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-cta">
          <div class="ui-head">
            <h2>Scan a repository now</h2>
            <p>Paste a public GitHub URL and get a design health report in under a minute: score, the hardcoded values to fix first, and the path to 100.</p>
          </div>
          <div>
            <form action="/scan" method="get" class="ui-scan">
              <label for="guide-scan-url" class="ui-sr">GitHub repository URL</label>
              <input id="guide-scan-url" name="url" type="text" required autocomplete="off" spellcheck="false" placeholder="https://github.com/owner/repo" />
              <button type="submit" class="ui-btn ui-btn--primary">Scan</button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .gl-col { max-width: 72ch; }
  .gl-crumb { font-size: 14px; color: var(--color-muted); }
  .gl-h1 { margin: 14px 0 0; font-size: clamp(2.1rem, 1.6rem + 2vw, 3rem); line-height: 1.08; letter-spacing: -0.03em; color: var(--color-ink); }
  .gl-meta { margin: 12px 0 0; font-size: 14px; color: var(--color-muted); }
  .gl-answer { margin-top: 36px; padding: 22px 24px; border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--ring); }
  .gl-answer-label { margin: 0; font-size: 14px; font-weight: 600; color: var(--color-buoy-light); }
  .gl-answer p + p { margin-top: 8px; color: var(--color-ink); font-size: 17px; line-height: 1.6; }
  .gl-body { margin-top: 40px; }
  .gl-faq, .gl-more { margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--color-line-strong); }
  .gl-faq h2, .gl-more h2 { margin: 0; font-size: 1.5rem; color: var(--color-ink); }
  .gl-faq dl { margin: 20px 0 0; }
  .gl-faq dl > div { padding: 18px 0; border-bottom: 1px solid var(--color-line); }
  .gl-faq dt { font-weight: 600; color: var(--color-ink); }
  .gl-faq dd { margin: 8px 0 0; color: var(--color-body); line-height: 1.65; }
  .gl-more h2 { font-size: 1.25rem; }
  .gl-body :global(.gl-pull) { margin: 2.2em 0; padding: 4px 0 4px 22px; border-left: 2px solid var(--color-buoy); font-family: var(--font-display); font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem); line-height: 1.35; font-weight: 600; color: var(--color-ink); text-wrap: balance; }
  .gl-body :global(.gl-pull p) { margin: 0; }
  .gl-body :global(.gl-diff) { margin-top: 1.4em; }
  .gl-body :global(.gl-diff figcaption), .gl-body :global(.gl-cap) { margin-top: 10px; font-size: 14px; color: var(--color-muted); }
  .gl-body :global(.gl-bar) { display: inline-block; height: 8px; border-radius: 2px; background: var(--color-buoy); vertical-align: middle; }
  .gl-body :global(td.gl-num), .gl-body :global(th.gl-num) { white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
