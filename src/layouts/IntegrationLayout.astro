---
import Layout from './Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Button from '../components/Button.astro'
import MarkPattern from '../components/MarkPattern.astro'

interface Props {
  title: string
  description: string
  keywords?: string
  heroTitle: string
  heroDescription: string
  /** Ignored: the old emoji icon. */
  icon?: string
  iconBg?: string
}

const { title, description, keywords, heroTitle, heroDescription } = Astro.props
const current = Astro.url.pathname.replace(/\/$/, '')

const others = [
  { name: 'React', href: '/integrations/react' },
  { name: 'Vue', href: '/integrations/vue' },
  { name: 'Svelte', href: '/integrations/svelte' },
  { name: 'Angular', href: '/integrations/angular' },
  { name: 'Next.js', href: '/integrations/nextjs' },
  { name: 'Tailwind', href: '/integrations/tailwind' },
  { name: 'Figma', href: '/integrations/figma' },
  { name: 'GitHub', href: '/integrations/github' },
].filter((i) => i.href !== current)
---

<Layout title={title} description={description} keywords={keywords}>
  <Nav />

  <main class="ui-nav-offset cmp">
    <section class="ui-section ui-section--first ui-section--patterned">
      <MarkPattern pattern="field" drift={0.25} fade class="ui-pattern" />
      <div class="ui-wrap">
        <nav aria-label="Breadcrumb" class="cmp-crumbs">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/integrations/react">Integrations</a><span aria-hidden="true">/</span><span aria-current="page">{heroTitle.split(' ')[0]}</span>
        </nav>
        <div class:list={["cmp-hero-grid", Astro.slots.has("hero") && "ui-split"]}>
          <div>
            <div class="ui-head">
              <p class="ui-eyebrow">Integrations</p>
              <h1>{heroTitle}</h1>
              <p>{heroDescription}</p>
            </div>
            <div class="ui-actions">
              <Button href="/demo" size="lg">Get started free</Button>
              <Button href="/docs" variant="secondary" size="lg">Read the docs</Button>
            </div>
          </div>
          {Astro.slots.has("hero") && <div class="cmp-hero-fig"><slot name="hero" /></div>}
        </div>
      </div>
    </section>

    <slot />

    <section class="ui-section ui-section--band">
      <div class="ui-wrap">
        <h2 class="cmp-other-h">Other integrations</h2>
        <div class="cmp-chips">
          {others.map((item) => <a href={item.href} class="ui-chip">{item.name}</a>)}
        </div>
      </div>
    </section>

    <section class="ui-section ui-section--last ui-section--patterned">
      <MarkPattern pattern="swell" drift={0.3} fade class="ui-pattern" />
      <div class="ui-wrap">
        <div class="ui-head ui-head--center">
          <h2>Ready to catch design drift?</h2>
          <p>Free. Open source. No signup required.</p>
        </div>
        <div class="ui-actions cmp-center">
          <Button href="/demo">Get your first scan</Button>
          <Button href="/docs" variant="secondary">Read the docs</Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  .cmp-crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; font-size: 13px; color: var(--color-muted); }
  .cmp-crumbs a { color: var(--color-muted); text-decoration: none; transition: color 150ms ease-out; }
  .cmp-crumbs a:hover { color: var(--color-ink); }
  .cmp-crumbs [aria-current] { color: var(--color-body); }
  .cmp-vs { color: var(--color-muted); font-weight: 500; }
  .cmp-other-h { margin: 0 0 20px; font-size: var(--text-h3); color: var(--color-ink); }
  .cmp-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .cmp-center { justify-content: center; }
  .cmp-hero-grid.ui-split { align-items: center; }
  .cmp-hero-fig { min-width: 0; }
  @media (max-width: 960px) { .cmp-hero-fig { margin-top: 40px; } }
  /* Code in comparison pages wraps or scrolls inside its own block. */
  .cmp pre { max-width: 100%; overflow-x: auto; }
  .cmp pre code { white-space: pre-wrap; overflow-wrap: anywhere; }
  .cmp .ui-term, .cmp .ui-tray, .cmp .ui-panel { min-width: 0; max-width: 100%; }
  /* Comparison table: Buoy column marked once, at the head, with a quiet accent wash on its cells. */
  .cmp-table { table-layout: fixed; }
  .cmp-table thead th.cmp-buoy { color: var(--color-buoy-light); }
  .cmp-table tbody td.cmp-buoy { color: var(--color-ink); background: color-mix(in oklab, var(--color-buoy) 5%, transparent); padding-left: 14px; }
  .cmp-table thead th.cmp-buoy { padding-left: 14px; }
  .cmp-table tbody td.cmp-them { color: var(--color-muted); }
  @media (max-width: 640px) {
    .cmp-table { table-layout: auto; font-size: 14px; }
    .cmp-table thead th:first-child, .cmp-table tbody th { width: 34%; }
  }
</style>
